    {
      "id": "aw-1",
      "name": "Trophy Awards Grid",
      "html": "\n<style>\n.aw1{padding:100px 20px;background:linear-gradient(135deg,#fffbeb,#fef3c7);font-family:'Inter',sans-serif}\n.aw1 h2{text-align:center;font-size:clamp(30px,4vw,44px);font-weight:800;color:#78350f;margin:0 0 15px}\n.aw1 p{text-align:center;color:#92400e;font-size:16px;margin:0 0 60px}\n.aw1-grid{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:30px}\n.aw1-card{background:#fff;border-radius:20px;padding:35px 20px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.06);border:2px solid transparent;transition:all .3s}\n.aw1-card:hover{border-color:#f59e0b;transform:translateY(-5px);box-shadow:0 12px 30px rgba(245,158,11,.15)}\n.aw1-icon{font-size:48px;margin-bottom:20px}\n.aw1-name{font-size:16px;font-weight:700;color:#111;margin:0 0 8px}\n.aw1-year{font-size:13px;color:#f59e0b;font-weight:600}\n.aw1-org{font-size:13px;color:#888;margin-top:5px}\n</style>\n<section class=\"aw1\">\n  <h2>Recognition & Awards</h2>\n  <p>Proud to be recognized by industry leaders worldwide</p>\n  <div class=\"aw1-grid\">\n    <div class=\"aw1-card\"><div class=\"aw1-icon\">🏆</div><div class=\"aw1-name\">Best SaaS Product</div><div class=\"aw1-year\">2024</div><div class=\"aw1-org\">TechCrunch Awards</div></div>\n    <div class=\"aw1-card\"><div class=\"aw1-icon\">🥇</div><div class=\"aw1-name\">Innovation of the Year</div><div class=\"aw1-year\">2023</div><div class=\"aw1-org\">Forbes Technology</div></div>\n    <div class=\"aw1-card\"><div class=\"aw1-icon\">⭐</div><div class=\"aw1-name\">5-Star Excellence</div><div class=\"aw1-year\">2023</div><div class=\"aw1-org\">G2 Crowd</div></div>\n    <div class=\"aw1-card\"><div class=\"aw1-icon\">🎖️</div><div class=\"aw1-name\">Top 50 Startups</div><div class=\"aw1-year\">2022</div><div class=\"aw1-org\">Gartner Inc.</div></div>\n  </div>\n</section>"
    },
    {
      "id": "aw-2",
      "name": "Dark Gold Elegance",
      "html": "\n<style>\n.aw2{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;color:#fff}\n.aw2-header{text-align:center;max-width:600px;margin:0 auto 60px}\n.aw2-header h2{font-size:42px;font-weight:900;margin:0 0 15px;background:linear-gradient(to right, #fbbf24, #d97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.aw2-header p{color:#a1a1aa;font-size:16px}\n.aw2-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:25px}\n.aw2-card{background:#18181b;border:1px solid #27272a;padding:40px 30px;border-radius:16px;display:flex;align-items:center;gap:25px;transition:transform 0.3s,border-color 0.3s}\n.aw2-card:hover{transform:translateY(-5px);border-color:#fbbf24}\n.aw2-icon{width:60px;height:60px;background:rgba(251,191,36,0.1);color:#fbbf24;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}\n.aw2-content h3{margin:0 0 5px;font-size:20px;font-weight:700;color:#f8fafc}\n.aw2-content p{margin:0;font-size:14px;color:#a1a1aa}\n.aw2-year{display:inline-block;padding:4px 10px;background:#27272a;color:#fbbf24;border-radius:4px;font-size:12px;font-weight:700;margin-top:10px}\n</style>\n<section class=\"aw2\">\n  <div class=\"aw2-header\">\n    <h2>Global Recognition</h2>\n    <p>A testament to our relentless pursuit of excellence and innovation across the globe.</p>\n  </div>\n  <div class=\"aw2-grid\">\n    <div class=\"aw2-card\">\n      <div class=\"aw2-icon\">🏆</div>\n      <div class=\"aw2-content\">\n        <h3>Best AI Startup</h3>\n        <p>Tech Innovators Awards</p>\n        <div class=\"aw2-year\">2023</div>\n      </div>\n    </div>\n    <div class=\"aw2-card\">\n      <div class=\"aw2-icon\">🏅</div>\n      <div class=\"aw2-content\">\n        <h3>Product of the Year</h3>\n        <p>Design Excellence Council</p>\n        <div class=\"aw2-year\">2022</div>\n      </div>\n    </div>\n    <div class=\"aw2-card\">\n      <div class=\"aw2-icon\">⭐</div>\n      <div class=\"aw2-content\">\n        <h3>Top 10 Workplaces</h3>\n        <p>Global Culture Index</p>\n        <div class=\"aw2-year\">2022</div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "aw-3",
      "name": "Minimalist Outlines",
      "html": "\n<style>\n.aw3{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.aw3-wrap{max-width:1200px;margin:0 auto;text-align:center}\n.aw3-title{font-size:36px;font-weight:900;color:#000;text-transform:uppercase;letter-spacing:2px;margin:0 0 50px}\n.aw3-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:30px}\n.aw3-item{width:250px;padding:40px 20px;border:1px solid #e5e7eb;border-radius:0;background:#fff;transition:box-shadow 0.3s}\n.aw3-item:hover{box-shadow:8px 8px 0 #000;border-color:#000}\n.aw3-icon{font-size:40px;margin-bottom:20px;color:#000}\n.aw3-name{font-size:16px;font-weight:700;color:#000;margin:0 0 10px}\n.aw3-line{width:30px;height:2px;background:#000;margin:0 auto 15px}\n.aw3-desc{font-size:13px;color:#666;line-height:1.5;margin:0}\n</style>\n<section class=\"aw3\">\n  <div class=\"aw3-wrap\">\n    <h2 class=\"aw3-title\">Accolades</h2>\n    <div class=\"aw3-grid\">\n      <div class=\"aw3-item\">\n        <div class=\"aw3-icon\">🎖️</div>\n        <h3 class=\"aw3-name\">Red Dot Design</h3>\n        <div class=\"aw3-line\"></div>\n        <p class=\"aw3-desc\">Winner of the Product Design category for exceptional usability.</p>\n      </div>\n      <div class=\"aw3-item\">\n        <div class=\"aw3-icon\">🎗️</div>\n        <h3 class=\"aw3-name\">Awwwards SOTD</h3>\n        <div class=\"aw3-line\"></div>\n        <p class=\"aw3-desc\">Site of the Day for outstanding web experience.</p>\n      </div>\n      <div class=\"aw3-item\">\n        <div class=\"aw3-icon\">🏅</div>\n        <h3 class=\"aw3-name\">Fast Company</h3>\n        <div class=\"aw3-line\"></div>\n        <p class=\"aw3-desc\">Most Innovative Companies in Tech 2023.</p>\n      </div>\n      <div class=\"aw3-item\">\n        <div class=\"aw3-icon\">🏆</div>\n        <h3 class=\"aw3-name\">Webby Winner</h3>\n        <div class=\"aw3-line\"></div>\n        <p class=\"aw3-desc\">People's Voice Winner in Business Services.</p>\n      </div>\n    </div>\n  </div>\n</section>"
