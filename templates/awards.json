      "id": "aw-4",
      "name": "Colorful Badges",
      "html": "\n<style>\n.aw4{padding:100px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.aw4-head{text-align:center;margin-bottom:60px}\n.aw4-head h2{font-size:38px;font-weight:800;color:#0f172a;margin:0}\n.aw4-grid{max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:20px}\n.aw4-row{display:flex;align-items:center;background:#fff;border-radius:16px;padding:25px 30px;box-shadow:0 10px 25px rgba(0,0,0,0.03);position:relative;overflow:hidden}\n.aw4-row::before{content:'';position:absolute;left:0;top:0;bottom:0;width:8px}\n.aw4-row:nth-child(1)::before{background:#ef4444}\n.aw4-row:nth-child(2)::before{background:#3b82f6}\n.aw4-row:nth-child(3)::before{background:#10b981}\n.aw4-row:nth-child(4)::before{background:#f59e0b}\n.aw4-year{font-size:24px;font-weight:900;color:#cbd5e1;width:100px;flex-shrink:0}\n.aw4-content{flex:1;padding-left:20px;border-left:1px solid #f1f5f9}\n.aw4-title{font-size:20px;font-weight:700;color:#1e293b;margin:0 0 5px}\n.aw4-org{font-size:15px;color:#64748b;margin:0}\n.aw4-badge{padding:8px 16px;background:#f1f5f9;color:#334155;border-radius:50px;font-size:13px;font-weight:600}\n@media(max-width:600px){.aw4-row{flex-direction:column;align-items:flex-start;gap:15px}.aw4-content{border-left:none;padding-left:0;border-top:1px solid #f1f5f9;padding-top:15px;width:100%}}\n</style>\n<section class=\"aw4\">\n  <div class=\"aw4-head\">\n    <h2>Hall of Fame</h2>\n  </div>\n  <div class=\"aw4-grid\">\n    <div class=\"aw4-row\">\n      <div class=\"aw4-year\">2024</div>\n      <div class=\"aw4-content\">\n        <h3 class=\"aw4-title\">Customer Success Award</h3>\n        <p class=\"aw4-org\">Global Business Review</p>\n      </div>\n      <div class=\"aw4-badge\">Winner</div>\n    </div>\n    <div class=\"aw4-row\">\n      <div class=\"aw4-year\">2023</div>\n      <div class=\"aw4-content\">\n        <h3 class=\"aw4-title\">Agency of the Year</h3>\n        <p class=\"aw4-org\">Creative Design Awards</p>\n      </div>\n      <div class=\"aw4-badge\">Gold</div>\n    </div>\n    <div class=\"aw4-row\">\n      <div class=\"aw4-year\">2022</div>\n      <div class=\"aw4-content\">\n        <h3 class=\"aw4-title\">Green Tech Innovator</h3>\n        <p class=\"aw4-org\">EcoTech Summit</p>\n      </div>\n      <div class=\"aw4-badge\">Finalist</div>\n    </div>\n    <div class=\"aw4-row\">\n      <div class=\"aw4-year\">2021</div>\n      <div class=\"aw4-content\">\n        <h3 class=\"aw4-title\">Best UX/UI Design</h3>\n        <p class=\"aw4-org\">Digital Excellence Board</p>\n      </div>\n      <div class=\"aw4-badge\">Winner</div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "aw-5",
      "name": "Glassmorphism Glow",
      "html": "\n<style>\n.aw5{padding:100px 20px;background:#030014;font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.aw5-blob1{position:absolute;width:400px;height:400px;background:#4f46e5;border-radius:50%;filter:blur(100px);top:-100px;left:-100px;opacity:0.4;z-index:0}\n.aw5-blob2{position:absolute;width:400px;height:400px;background:#ec4899;border-radius:50%;filter:blur(100px);bottom:-100px;right:-100px;opacity:0.3;z-index:0}\n.aw5-wrap{position:relative;z-index:1;max-width:1000px;margin:0 auto;text-align:center}\n.aw5-wrap h2{font-size:48px;color:#fff;font-weight:900;margin:0 0 50px}\n.aw5-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:30px}\n.aw5-card{background:rgba(255,255,255,0.03);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:40px 30px;box-shadow:0 25px 50px rgba(0,0,0,0.3);color:#fff;transition:transform 0.3s,background 0.3s}\n.aw5-card:hover{transform:translateY(-10px);background:rgba(255,255,255,0.06)}\n.aw5-icon{font-size:50px;margin-bottom:20px;text-shadow:0 0 20px rgba(255,255,255,0.5)}\n.aw5-title{font-size:20px;font-weight:700;margin:0 0 10px}\n.aw5-desc{font-size:14px;color:rgba(255,255,255,0.7);line-height:1.6;margin:0}\n</style>\n<section class=\"aw5\">\n  <div class=\"aw5-blob1\"></div>\n  <div class=\"aw5-blob2\"></div>\n  <div class=\"aw5-wrap\">\n    <h2>Honors</h2>\n    <div class=\"aw5-grid\">\n      <div class=\"aw5-card\">\n        <div class=\"aw5-icon\">💎</div>\n        <h3 class=\"aw5-title\">Diamond Award</h3>\n        <p class=\"aw5-desc\">Top 1% of digital agencies delivering high-value solutions.</p>\n      </div>\n      <div class=\"aw5-card\">\n        <div class=\"aw5-icon\">🚀</div>\n        <h3 class=\"aw5-title\">Fastest Growing</h3>\n        <p class=\"aw5-desc\">Ranked #12 on the Inc. 5000 list for rapid expansion.</p>\n      </div>\n      <div class=\"aw5-card\">\n        <div class=\"aw5-icon\">🛡️</div>\n        <h3 class=\"aw5-title\">Security Excellence</h3>\n        <p class=\"aw5-desc\">Recognized for implementing enterprise-grade safety.</p>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "aw-6",
      "name": "Split Editorial List",
      "html": "\n<style>\n.aw6{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.aw6-wrap{max-width:1100px;margin:0 auto;display:flex;gap:60px;align-items:flex-start}\n.aw6-left{flex:1;position:sticky;top:40px}\n.aw6-left h2{font-size:48px;font-weight:900;color:#111;margin:0 0 20px;line-height:1.1;letter-spacing:-1px}\n.aw6-left p{font-size:16px;color:#555;line-height:1.6;margin:0}\n.aw6-right{flex:1.5;display:flex;flex-direction:column}\n.aw6-item{display:flex;align-items:center;justify-content:space-between;padding:30px 0;border-bottom:1px solid #eaeaea;transition:padding 0.3s}\n.aw6-item:hover{padding-left:20px;padding-right:20px;background:#fafafa}\n.aw6-year{font-size:16px;font-weight:700;color:#111;width:60px}\n.aw6-info{flex:1;padding:0 20px}\n.aw6-title{font-size:22px;font-weight:800;color:#111;margin:0 0 5px}\n.aw6-org{font-size:14px;color:#777;margin:0}\n.aw6-icon{font-size:24px;color:#111}\n@media(max-width:768px){.aw6-wrap{flex-direction:column;gap:40px}.aw6-left{position:static}.aw6-item{flex-direction:column;align-items:flex-start;gap:15px}.aw6-info{padding:0}.aw6-icon{display:none}}\n</style>\n<section class=\"aw6\">\n  <div class=\"aw6-wrap\">\n    <div class=\"aw6-left\">\n      <h2>Awards &<br>Trophies</h2>\n      <p>We don't work for awards, but we are humbled when our dedication to craft and performance is recognized by the industry.</p>\n    </div>\n    <div class=\"aw6-right\">\n      <div class=\"aw6-item\">\n        <div class=\"aw6-year\">2024</div>\n        <div class=\"aw6-info\">\n          <h3 class=\"aw6-title\">Site of the Year</h3>\n          <p class=\"aw6-org\">CSS Design Awards</p>\n        </div>\n        <div class=\"aw6-icon\">↗</div>\n      </div>\n      <div class=\"aw6-item\">\n        <div class=\"aw6-year\">2023</div>\n        <div class=\"aw6-info\">\n          <h3 class=\"aw6-title\">Best E-Commerce App</h3>\n          <p class=\"aw6-org\">Mobile Excellence</p>\n        </div>\n        <div class=\"aw6-icon\">↗</div>\n      </div>\n      <div class=\"aw6-item\">\n        <div class=\"aw6-year\">2022</div>\n        <div class=\"aw6-info\">\n          <h3 class=\"aw6-title\">Top B2B Service</h3>\n          <p class=\"aw6-org\">Clutch Leaders Matrix</p>\n        </div>\n        <div class=\"aw6-icon\">↗</div>\n      </div>\n      <div class=\"aw6-item\">\n        <div class=\"aw6-year\">2021</div>\n        <div class=\"aw6-info\">\n          <h3 class=\"aw6-title\">Design Vanguard</h3>\n          <p class=\"aw6-org\">Architectural Record</p>\n        </div>\n        <div class=\"aw6-icon\">↗</div>\n      </div>\n    </div>\n  </div>\n</section>"
    }
