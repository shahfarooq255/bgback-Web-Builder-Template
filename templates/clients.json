      "id": "clients-3",
      "name": "Dark Bordered Grid",
      "description": "A premium dark theme with logos enclosed in subtle bordered boxes",
      "html": "\n                        <style>\n                          .clt3-wrap{padding:80px 20px;background:#09090b;font-family:sans-serif;}\n                          .clt3-inner{max-width:1100px;margin:0 auto;}\n                          .clt3-head{text-align:center;margin-bottom:50px;}\n                          .clt3-head h2{font-size:14px;font-weight:800;color:#a1a1aa;margin:0;letter-spacing:3px;text-transform:uppercase;}\n                          .clt3-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:20px;}\n                          .clt3-box{border:1px solid #27272a;background:#18181b;height:120px;display:flex;justify-content:center;align-items:center;border-radius:12px;transition:background 0.3s, border-color 0.3s;}\n                          .clt3-box:hover{background:#27272a;border-color:#3f3f46;}\n                          .clt3-logo svg{height:35px;width:auto;opacity:0.6;transition:opacity 0.3s;}\n                          .clt3-box:hover .clt3-logo svg{opacity:1;}\n                          .clt3-logo text{fill:#fff;}\n                        </style>\n                        <section class=\"clt3-wrap\">\n                          <div class=\"clt3-inner\">\n                            <div class=\"clt3-head\">\n                              <h2>Powering World-Class Companies</h2>\n                            </div>\n                            <div class=\"clt3-grid\">\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">ACME</text></svg></div></div>\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">NEXUS</text></svg></div></div>\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">BLOCK</text></svg></div></div>\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">ASTRA</text></svg></div></div>\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">HEXA</text></svg></div></div>\n                              <div class=\"clt3-box\"><div class=\"clt3-logo\"><svg viewBox=\"0 0 120 40\"><path d=\"M6,20 Q13,10 20,20 T34,20\" fill=\"none\" stroke=\"#ec4899\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"42\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\">FLOW</text></svg></div></div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "clients-4",
      "name": "Split Content & Logos",
      "description": "A split layout with a prominent title on the left and a grid of logos on the right",
      "html": "\n                        <style>\n                          .clt4-wrap{padding:100px 20px;background:#fff;font-family:sans-serif;}\n                          .clt4-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:60px;}\n                          .clt4-text{flex:1;min-width:300px;}\n                          .clt4-text h2{font-size:clamp(32px,4vw,44px);font-weight:900;color:#111;margin:0 0 20px;line-height:1.2;}\n                          .clt4-text p{font-size:18px;color:#666;line-height:1.6;margin:0;}\n                          .clt4-grid{flex:1.5;min-width:300px;display:grid;grid-template-columns:repeat(3, 1fr);gap:40px;}\n                          .clt4-logo{display:flex;justify-content:flex-start;align-items:center;filter:grayscale(100%);opacity:0.6;transition:0.3s;}\n                          .clt4-logo:hover{filter:grayscale(0%);opacity:1;}\n                          .clt4-logo svg{height:35px;width:auto;}\n                          @media(max-width:900px){\n                            .clt4-inner{flex-direction:column;}\n                            .clt4-text{text-align:center;}\n                            .clt4-grid{grid-template-columns:repeat(2, 1fr);justify-items:center;}\n                            .clt4-logo{justify-content:center;}\n                          }\n                          @media(max-width:500px){.clt4-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"clt4-wrap\">\n                          <div class=\"clt4-inner\">\n                            <div class=\"clt4-text\">\n                              <h2>Join over 10,000+ forward-thinking teams.</h2>\n                              <p>From promising startups to Fortune 500 enterprises, the world's best teams rely on our platform.</p>\n                            </div>\n                            <div class=\"clt4-grid\">\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">ACME</text></svg></div>\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">NEXUS</text></svg></div>\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">BLOCK</text></svg></div>\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">ASTRA</text></svg></div>\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">HEXA</text></svg></div>\n                              <div class=\"clt4-logo\"><svg viewBox=\"0 0 120 40\"><path d=\"M6,20 Q13,10 20,20 T34,20\" fill=\"none\" stroke=\"#ec4899\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"42\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#111\">FLOW</text></svg></div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "clients-5",
      "name": "Centered Featured Cloud",
      "description": "A clustered cloud of logos with a large primary logo in the center",
      "html": "\n                        <style>\n                          .clt5-wrap{padding:100px 20px;background:#f8fafc;font-family:sans-serif;}\n                          .clt5-inner{max-width:1000px;margin:0 auto;text-align:center;}\n                          .clt5-head{margin-bottom:60px;}\n                          .clt5-head h2{font-size:clamp(28px,4vw,36px);font-weight:900;color:#0f172a;margin:0 0 15px;}\n                          .clt5-head p{font-size:18px;color:#64748b;margin:0;}\n                          .clt5-cloud{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:30px 50px;}\n                          .clt5-logo{opacity:0.7;transition:0.3s;}\n                          .clt5-logo:hover{opacity:1;transform:scale(1.05);}\n                          .clt5-logo svg{height:40px;width:auto;}\n                          .clt5-main svg{height:60px;} /* Main featured logo is larger */\n                          .clt5-main{opacity:1;}\n                        </style>\n                        <section class=\"clt5-wrap\">\n                          <div class=\"clt5-inner\">\n                            <div class=\"clt5-head\">\n                              <h2>You're in good company.</h2>\n                              <p>Our infrastructure powers the web's best products.</p>\n                            </div>\n                            <div class=\"clt5-cloud\">\n                              <div class=\"clt5-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ACME</text></svg></div>\n                              <div class=\"clt5-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">NEXUS</text></svg></div>\n                              <div class=\"clt5-logo clt5-main\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">BLOCK</text></svg></div>\n                              <div class=\"clt5-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ASTRA</text></svg></div>\n                              <div class=\"clt5-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">HEXA</text></svg></div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
