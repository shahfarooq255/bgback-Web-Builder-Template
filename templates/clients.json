    {
      "id": "clients-1",
      "name": "Infinite Marquee",
      "description": "A smooth, infinitely scrolling marquee of client logos",
      "html": "\n                        <style>\n                          .clt1-wrap{padding:60px 0;background:#fff;font-family:sans-serif;overflow:hidden;}\n                          .clt1-head{text-align:center;margin-bottom:40px;}\n                          .clt1-head h2{font-size:16px;text-transform:uppercase;letter-spacing:2px;color:#64748b;font-weight:700;margin:0;}\n                          .clt1-marquee{display:flex;width:calc(200px * 12);animation:clt1-scroll 20s linear infinite;}\n                          .clt1-marquee:hover{animation-play-state:paused;}\n                          .clt1-logo{width:200px;display:flex;justify-content:center;align-items:center;opacity:0.5;transition:opacity 0.3s, transform 0.3s;filter:grayscale(100%);}\n                          .clt1-logo:hover{opacity:1;filter:grayscale(0%);transform:scale(1.1);}\n                          .clt1-logo svg{height:40px;width:auto;}\n                          @keyframes clt1-scroll{\n                            0% { transform: translateX(0); }\n                            100% { transform: translateX(calc(-200px * 6)); }\n                          }\n                        </style>\n                        <section class=\"clt1-wrap\">\n                          <div class=\"clt1-head\">\n                            <h2>Trusted by innovative teams worldwide</h2>\n                          </div>\n                          <div class=\"clt1-marquee\">\n                            <!-- Original 6 -->\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ACME</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">NEXUS</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">BLOCK</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ASTRA</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">HEXA</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><path d=\"M6,20 Q13,10 20,20 T34,20\" fill=\"none\" stroke=\"#ec4899\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"42\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">FLOW</text></svg></div>\n                            <!-- Duplicated 6 for smooth loop -->\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ACME</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">NEXUS</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">BLOCK</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ASTRA</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">HEXA</text></svg></div>\n                            <div class=\"clt1-logo\"><svg viewBox=\"0 0 120 40\"><path d=\"M6,20 Q13,10 20,20 T34,20\" fill=\"none\" stroke=\"#ec4899\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"42\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">FLOW</text></svg></div>\n                          </div>\n                        </section>\n                    "
    },
