      "id": "clients-2",
      "name": "Clean Grayscale Grid",
      "description": "A static grid of logos that turn colorful on hover",
      "html": "\n                        <style>\n                          .clt2-wrap{padding:80px 20px;background:#f9fafb;font-family:sans-serif;}\n                          .clt2-inner{max-width:1000px;margin:0 auto;}\n                          .clt2-head{text-align:center;margin-bottom:40px;}\n                          .clt2-head h2{font-size:24px;font-weight:700;color:#111;margin:0;}\n                          .clt2-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));gap:30px;align-items:center;justify-items:center;}\n                          .clt2-logo{filter:grayscale(100%) opacity(0.5);transition:all 0.3s;cursor:pointer;}\n                          .clt2-logo:hover{filter:grayscale(0%) opacity(1);transform:scale(1.05);}\n                          .clt2-logo svg{height:40px;width:auto;}\n                        </style>\n                        <section class=\"clt2-wrap\">\n                          <div class=\"clt2-inner\">\n                            <div class=\"clt2-head\">\n                              <h2>Our Amazing Partners</h2>\n                            </div>\n                            <div class=\"clt2-grid\">\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 120 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#3b82f6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ACME</text></svg></div>\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,8 32,28 8,28\" fill=\"#ef4444\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">NEXUS</text></svg></div>\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 120 40\"><rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\" fill=\"#10b981\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">BLOCK</text></svg></div>\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 120 40\"><polygon points=\"20,6 34,20 20,34 6,20\" fill=\"#f59e0b\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">ASTRA</text></svg></div>\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 130 40\"><path d=\"M20,6 L32,13 L32,27 L20,34 L8,27 L8,13 Z\" fill=\"#8b5cf6\"/><text x=\"40\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">HEXA</text></svg></div>\n                              <div class=\"clt2-logo\"><svg viewBox=\"0 0 120 40\"><path d=\"M6,20 Q13,10 20,20 T34,20\" fill=\"none\" stroke=\"#ec4899\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"42\" y=\"26\" font-family=\"Arial\" font-weight=\"900\" font-size=\"20\" fill=\"#0f172a\">FLOW</text></svg></div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
