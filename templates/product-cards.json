    {
      "id": "product-cards-1",
      "name": "Floating Detail Card",
      "description": "Elegant product card with floating price chip and image zoom",
      "html": "\n                        <style>\n                          .prc1-wrap{padding:80px 20px;background:#f0f4f8;font-family:sans-serif;display:flex;justify-content:center;}\n                          .prc1-card{background:#fff;border-radius:24px;overflow:hidden;width:100%;max-width:360px;box-shadow:0 20px 60px rgba(0,0,0,0.08);}\n                          .prc1-img{height:300px;position:relative;overflow:hidden;}\n                          .prc1-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s;}\n                          .prc1-card:hover .prc1-img img{transform:scale(1.08);}\n                          .prc1-price-chip{position:absolute;bottom:15px;right:15px;background:#fff;padding:8px 16px;border-radius:20px;font-size:20px;font-weight:900;color:#111;box-shadow:0 4px 15px rgba(0,0,0,0.15);}\n                          .prc1-badge{position:absolute;top:15px;left:15px;background:#ef4444;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:700;}\n                          .prc1-body{padding:25px;}\n                          .prc1-cat{color:#6b7280;font-size:12px;text-transform:uppercase;letter-spacing:1px;margin:0 0 8px;}\n                          .prc1-name{color:#111;font-size:22px;font-weight:800;margin:0 0 10px;line-height:1.3;}\n                          .prc1-stars{color:#f59e0b;font-size:14px;margin-bottom:20px;}\n                          .prc1-btn{width:100%;padding:14px;background:#111;color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;transition:background 0.2s;}\n                          .prc1-btn:hover{background:#333;}\n                          @media(max-width:480px){.prc1-card{max-width:100%;} .prc1-img{height:240px;}}\n                        </style>\n                        <section class=\"prc1-wrap\">\n                          <div class=\"prc1-card\">\n                            <div class=\"prc1-img\">\n                              <img src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=600&auto=format&fit=crop\" alt=\"Watch\">\n                              <div class=\"prc1-badge\">SALE</div>\n                              <div class=\"prc1-price-chip\">$149</div>\n                            </div>\n                            <div class=\"prc1-body\">\n                              <p class=\"prc1-cat\">Accessories</p>\n                              <h3 class=\"prc1-name\">Apex Minimalist Watch</h3>\n                              <div class=\"prc1-stars\">★★★★★ <span style=\"color:#6b7280;font-size:13px;\">(128 reviews)</span></div>\n                              <button class=\"prc1-btn\">Add to Cart</button>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-cards-2",
      "name": "Side-by-Side Card",
      "description": "Horizontal product card with image left and details right",
      "html": "\n                        <style>\n                          .prc2-wrap{padding:80px 20px;background:#f9fafb;font-family:sans-serif;display:flex;justify-content:center;}\n                          .prc2-card{background:#fff;border-radius:20px;display:flex;overflow:hidden;width:100%;max-width:700px;box-shadow:0 10px 40px rgba(0,0,0,0.06);}\n                          .prc2-img{width:300px;flex-shrink:0;position:relative;overflow:hidden;}\n                          .prc2-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}\n                          .prc2-card:hover .prc2-img img{transform:scale(1.06);}\n                          .prc2-new{position:absolute;top:15px;left:15px;background:#10b981;color:#fff;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700;}\n                          .prc2-body{padding:35px;display:flex;flex-direction:column;justify-content:center;}\n                          .prc2-cat{color:#10b981;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}\n                          .prc2-name{font-size:26px;font-weight:800;color:#111;margin:10px 0 8px;line-height:1.2;}\n                          .prc2-desc{color:#6b7280;font-size:15px;line-height:1.6;margin-bottom:20px;}\n                          .prc2-price{font-size:32px;font-weight:900;color:#111;margin-bottom:20px;}\n                          .prc2-price s{font-size:18px;color:#9ca3af;margin-left:10px;font-weight:400;}\n                          .prc2-actions{display:flex;gap:12px;}\n                          .prc2-cart{flex:1;padding:13px;background:#111;color:#fff;border:none;border-radius:10px;font-weight:700;cursor:pointer;font-size:15px;}\n                          .prc2-wish{width:48px;height:48px;border:2px solid #e5e7eb;border-radius:10px;background:#fff;cursor:pointer;font-size:20px;}\n                          @media(max-width:650px){.prc2-card{flex-direction:column;} .prc2-img{width:100%;height:240px;} .prc2-body{padding:25px;}}\n                        </style>\n                        <section class=\"prc2-wrap\">\n                          <div class=\"prc2-card\">\n                            <div class=\"prc2-img\">\n                              <img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=600&auto=format&fit=crop\" alt=\"Sneaker\">\n                              <span class=\"prc2-new\">NEW</span>\n                            </div>\n                            <div class=\"prc2-body\">\n                              <span class=\"prc2-cat\">Footwear</span>\n                              <h3 class=\"prc2-name\">UltraRun Air Pro</h3>\n                              <p class=\"prc2-desc\">Engineered for performance. Lightweight foam midsole with breathable mesh upper for all-day comfort.</p>\n                              <div class=\"prc2-price\">$129 <s>$179</s></div>\n                              <div class=\"prc2-actions\">\n                                <button class=\"prc2-cart\">Add to Cart</button>\n                                <button class=\"prc2-wish\">♡</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-cards-3",
      "name": "Glassmorphism Product Card",
      "description": "Dark ambient background with glass-effect card overlay",
      "html": "\n                        <style>\n                          .prc3-wrap{padding:80px 20px;background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460);font-family:sans-serif;display:flex;justify-content:center;}\n                          .prc3-card{background:rgba(255,255,255,0.07);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.12);border-radius:24px;overflow:hidden;width:100%;max-width:340px;}\n                          .prc3-img{height:260px;position:relative;overflow:hidden;}\n                          .prc3-img img{width:100%;height:100%;object-fit:cover;}\n                          .prc3-color-dots{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);display:flex;gap:8px;}\n                          .prc3-dot{width:14px;height:14px;border-radius:50%;border:2px solid rgba(255,255,255,0.6);cursor:pointer;}\n                          .prc3-body{padding:25px;}\n                          .prc3-name{color:#fff;font-size:22px;font-weight:800;margin:0 0 6px;}\n                          .prc3-sub{color:rgba(255,255,255,0.5);font-size:14px;margin:0 0 20px;}\n                          .prc3-row{display:flex;justify-content:space-between;align-items:center;}\n                          .prc3-price{color:#fff;font-size:28px;font-weight:900;}\n                          .prc3-btn{background:linear-gradient(90deg,#a855f7,#6366f1);color:#fff;border:none;padding:12px 24px;border-radius:10px;font-weight:700;cursor:pointer;font-size:14px;}\n                          @media(max-width:400px){.prc3-card{max-width:100%;}}\n                        </style>\n                        <section class=\"prc3-wrap\">\n                          <div class=\"prc3-card\">\n                            <div class=\"prc3-img\">\n                              <img src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=600&auto=format&fit=crop\" alt=\"Perfume\">\n                              <div class=\"prc3-color-dots\">\n                                <div class=\"prc3-dot\" style=\"background:#d4af37;\"></div>\n                                <div class=\"prc3-dot\" style=\"background:#c0c0c0;\"></div>\n                                <div class=\"prc3-dot\" style=\"background:#b07d6a;\"></div>\n                              </div>\n                            </div>\n                            <div class=\"prc3-body\">\n                              <h3 class=\"prc3-name\">Midnight Elixir</h3>\n                              <p class=\"prc3-sub\">Luxury Fragrance &bull; 50ml EDP</p>\n                              <div class=\"prc3-row\">\n                                <span class=\"prc3-price\">$89</span>\n                                <button class=\"prc3-btn\">Buy Now</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-cards-4",
      "name": "Comparison Card",
      "description": "Product card with specs comparison and pro/lite variants",
      "html": "\n                        <style>\n                          .prc4-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prc4-container{max-width:700px;margin:0 auto;}\n                          .prc4-header{text-align:center;margin-bottom:30px;}\n                          .prc4-tabs{display:flex;gap:12px;justify-content:center;margin-bottom:30px;flex-wrap:wrap;}\n                          .prc4-tab{padding:10px 28px;border-radius:30px;border:2px solid #e5e7eb;background:#fff;font-weight:700;cursor:pointer;font-size:15px;color:#374151;}\n                          .prc4-tab.active{background:#111;color:#fff;border-color:#111;}\n                          .prc4-card{border:2px solid #111;border-radius:20px;overflow:hidden;}\n                          .prc4-img{height:280px;position:relative;overflow:hidden;background:#f9fafb;}\n                          .prc4-img img{width:100%;height:100%;object-fit:cover;}\n                          .prc4-body{padding:30px;}\n                          .prc4-name{font-size:26px;font-weight:800;color:#111;margin:0 0 5px;}\n                          .prc4-price{font-size:36px;font-weight:900;color:#111;margin:0 0 25px;}\n                          .prc4-specs{list-style:none;padding:0;margin:0 0 25px;display:grid;grid-template-columns:1fr 1fr;gap:10px;}\n                          .prc4-spec{font-size:14px;color:#374151;display:flex;align-items:center;gap:8px;}\n                          .prc4-spec span{font-size:16px;}\n                          .prc4-btn{width:100%;padding:15px;background:#111;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;}\n                          @media(max-width:500px){.prc4-specs{grid-template-columns:1fr;} .prc4-body{padding:20px;}}\n                        </style>\n                        <section class=\"prc4-wrap\">\n                          <div class=\"prc4-container\">\n                            <div class=\"prc4-header\">\n                              <h2 style=\"font-size:clamp(26px,4vw,36px);font-weight:800;color:#111;margin:0 0 5px;\">Choose Your Plan</h2>\n                              <p style=\"color:#6b7280;margin:0;\">Pick the model that fits your style.</p>\n                            </div>\n                            <div class=\"prc4-tabs\">\n                              <button class=\"prc4-tab active\">Pro ✦</button>\n                              <button class=\"prc4-tab\">Lite</button>\n                            </div>\n                            <div class=\"prc4-card\">\n                              <div class=\"prc4-img\"><img src=\"https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?q=80&w=700&auto=format&fit=crop\" alt=\"Camera\"></div>\n                              <div class=\"prc4-body\">\n                                <h3 class=\"prc4-name\">Retro Pro XL Camera</h3>\n                                <div class=\"prc4-price\">$1,299</div>\n                                <ul class=\"prc4-specs\">\n                                  <li class=\"prc4-spec\"><span>✅</span> 50MP Full-Frame</li>\n                                  <li class=\"prc4-spec\"><span>✅</span> 8K Video Recording</li>\n                                  <li class=\"prc4-spec\"><span>✅</span> Weather Sealed Body</li>\n                                  <li class=\"prc4-spec\"><span>✅</span> Dual SD Card Slots</li>\n                                  <li class=\"prc4-spec\"><span>✅</span> 5-Axis Stabilization</li>\n                                  <li class=\"prc4-spec\"><span>✅</span> Wi-Fi & Bluetooth</li>\n                                </ul>\n                                <button class=\"prc4-btn\">Add to Cart &mdash; $1,299</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-cards-5",
      "name": "Neon Hover Card",
      "description": "Dark card with neon glow on hover, great for tech products",
      "html": "\n                        <style>\n                          .prc5-wrap{padding:80px 20px;background:#050505;font-family:sans-serif;display:flex;justify-content:center;}\n                          .prc5-card{background:#111;border:1px solid #222;border-radius:20px;overflow:hidden;width:100%;max-width:360px;transition:border-color 0.3s, box-shadow 0.3s;}\n                          .prc5-card:hover{border-color:#6366f1;box-shadow:0 0 30px rgba(99,102,241,0.25);}\n                          .prc5-img{height:280px;position:relative;overflow:hidden;}\n                          .prc5-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s;filter:grayscale(30%);}\n                          .prc5-card:hover .prc5-img img{transform:scale(1.05);filter:grayscale(0%);}\n                          .prc5-label{position:absolute;top:15px;left:15px;padding:6px 14px;border-radius:20px;font-size:11px;font-weight:800;letter-spacing:2px;border:1px solid;}\n                          .prc5-body{padding:25px;}\n                          .prc5-name{color:#f9fafb;font-size:22px;font-weight:800;margin:0 0 8px;}\n                          .prc5-desc{color:#6b7280;font-size:14px;line-height:1.6;margin:0 0 20px;}\n                          .prc5-bottom{display:flex;justify-content:space-between;align-items:center;}\n                          .prc5-price{color:#fff;font-size:28px;font-weight:900;}\n                          .prc5-btn{padding:12px 22px;background:linear-gradient(90deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:10px;font-weight:700;cursor:pointer;font-size:14px;transition:opacity 0.2s;}\n                          .prc5-btn:hover{opacity:0.85;}\n                          @media(max-width:400px){.prc5-card{max-width:100%;} .prc5-img{height:220px;}}\n                        </style>\n                        <section class=\"prc5-wrap\">\n                          <div class=\"prc5-card\">\n                            <div class=\"prc5-img\">\n                              <img src=\"https://images.unsplash.com/photo-1593305841991-05c297ba4575?q=80&w=600&auto=format&fit=crop\" alt=\"Headset\">\n                              <span class=\"prc5-label\" style=\"background:rgba(99,102,241,0.15);color:#818cf8;border-color:rgba(99,102,241,0.3);\">GAMING</span>\n                            </div>\n                            <div class=\"prc5-body\">\n                              <h3 class=\"prc5-name\">ProSound X7 Headset</h3>\n                              <p class=\"prc5-desc\">Surround sound with deep bass, noise cancellation, and 40-hr battery for marathon sessions.</p>\n                              <div class=\"prc5-bottom\">\n                                <span class=\"prc5-price\">$299</span>\n                                <button class=\"prc5-btn\">Buy Now</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
