    {
      "id": "checkout-1",
      "name": "Split Screen Checkout",
      "description": "Modern split layout: form on the left, order summary locked on the right",
      "html": "\n                        <style>\n                          .chk1-wrap{background:#f9fafb;font-family:sans-serif;min-height:100vh;}\n                          .chk1-inner{max-width:1200px;margin:0 auto;display:flex;gap:40px;}\n                          .chk1-left{flex:1.5;padding:60px 20px;}\n                          .chk1-right{flex:1;background:#fff;padding:60px 40px;border-left:1px solid #e5e7eb;position:sticky;top:0;height:100vh;overflow-y:auto;}\n                          .chk1-logo{font-size:24px;font-weight:900;color:#111;margin-bottom:40px;display:inline-block;}\n                          .chk1-sec{margin-bottom:40px;}\n                          .chk1-sec-head{font-size:18px;font-weight:800;color:#111;margin:0 0 20px;}\n                          .chk1-row{display:flex;gap:15px;margin-bottom:15px;}\n                          .chk1-col{flex:1;}\n                          .chk1-input{width:100%;padding:14px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;box-sizing:border-box;}\n                          .chk1-input:focus{outline:none;border-color:#111;box-shadow:0 0 0 2px rgba(17,17,17,0.1);}\n                          .chk1-select{width:100%;padding:14px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;background:#fff;appearance:none;}\n                          .chk1-btn{width:100%;padding:18px;background:#111;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;margin-top:20px;}\n                          .chk1-item{display:flex;gap:15px;align-items:center;margin-bottom:20px;}\n                          .chk1-img{width:64px;height:64px;border-radius:8px;object-fit:cover;border:1px solid #e5e7eb;position:relative;}\n                          .chk1-badge{position:absolute;top:-8px;right:-8px;background:#6b7280;color:#fff;font-size:12px;width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:50%;}\n                          .chk1-item-info{flex:1;}\n                          .chk1-item-name{font-size:14px;font-weight:700;margin:0 0 4px;}\n                          .chk1-item-price{font-size:14px;font-weight:600;color:#111;}\n                          .chk1-totals{border-top:1px solid #e5e7eb;padding-top:20px;margin-top:20px;}\n                          .chk1-trow{display:flex;justify-content:space-between;font-size:14px;color:#4b5563;margin-bottom:15px;}\n                          .chk1-ttotal{display:flex;justify-content:space-between;font-size:22px;font-weight:800;color:#111;margin-top:20px;}\n                          @media(max-width:900px){\n                            .chk1-inner{flex-direction:column-reverse;gap:0;}\n                            .chk1-right{height:auto;position:static;padding:40px 20px;border-left:none;border-bottom:1px solid #e5e7eb;}\n                            .chk1-left{padding:40px 20px;}\n                          }\n                          @media(max-width:500px){.chk1-row{flex-direction:column;gap:15px;}}\n                        </style>\n                        <section class=\"chk1-wrap\">\n                          <div class=\"chk1-inner\">\n                            <div class=\"chk1-left\">\n                              <a href=\"#\" class=\"chk1-logo\">LUXE STORE</a>\n                              <div class=\"chk1-sec\">\n                                <h3 class=\"chk1-sec-head\">Contact</h3>\n                                <input type=\"email\" class=\"chk1-input\" placeholder=\"Email or mobile phone number\">\n                              </div>\n                              <div class=\"chk1-sec\">\n                                <h3 class=\"chk1-sec-head\">Delivery</h3>\n                                <div class=\"chk1-row\">\n                                  <div class=\"chk1-col\"><select class=\"chk1-select\"><option>United States</option><option>Canada</option></select></div>\n                                </div>\n                                <div class=\"chk1-row\">\n                                  <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"First name\"></div>\n                                  <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"Last name\"></div>\n                                </div>\n                                <div class=\"chk1-row\"><div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"Address\"></div></div>\n                                <div class=\"chk1-row\">\n                                  <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"City\"></div>\n                                  <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"State\"></div>\n                                  <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"ZIP code\"></div>\n                                </div>\n                              </div>\n                              <div class=\"chk1-sec\">\n                                <h3 class=\"chk1-sec-head\">Payment</h3>\n                                <div style=\"border:1px solid #d1d5db;border-radius:8px;padding:20px;background:#fff;\">\n                                  <div class=\"chk1-row\"><div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"Card number\"></div></div>\n                                  <div class=\"chk1-row\">\n                                    <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"Expiration date (MM/YY)\"></div>\n                                    <div class=\"chk1-col\"><input type=\"text\" class=\"chk1-input\" placeholder=\"Security code\"></div>\n                                  </div>\n                                </div>\n                              </div>\n                              <button class=\"chk1-btn\">Pay Now</button>\n                            </div>\n                            <div class=\"chk1-right\">\n                              <div class=\"chk1-item\">\n                                <div style=\"position:relative;\">\n                                  <img class=\"chk1-img\" src=\"https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=200&auto=format&fit=crop\" alt=\"Item\">\n                                  <span class=\"chk1-badge\">1</span>\n                                </div>\n                                <div class=\"chk1-item-info\">\n                                  <h4 class=\"chk1-item-name\">Smart Watch Series 7</h4>\n                                  <p style=\"margin:0;font-size:13px;color:#6b7280;\">Midnight Black</p>\n                                </div>\n                                <div class=\"chk1-item-price\">$399.00</div>\n                              </div>\n                              <div class=\"chk1-row\" style=\"margin-top:30px;\">\n                                <input type=\"text\" class=\"chk1-input\" placeholder=\"Discount code\">\n                                <button style=\"background:#e5e7eb;border:none;padding:0 20px;border-radius:8px;font-weight:600;cursor:pointer;\">Apply</button>\n                              </div>\n                              <div class=\"chk1-totals\">\n                                <div class=\"chk1-trow\"><span>Subtotal</span><span>$399.00</span></div>\n                                <div class=\"chk1-trow\"><span>Shipping</span><span>Calculated at next step</span></div>\n                                <div class=\"chk1-ttotal\"><span>Total</span><span>$399.00</span></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "checkout-2",
      "name": "Centered Minimal Checkout",
      "description": "A clean, single-column checkout form focused purely on conversion",
      "html": "\n                        <style>\n                          .chk2-wrap{padding:60px 20px;background:#f3f4f6;font-family:sans-serif;display:flex;justify-content:center;}\n                          .chk2-card{width:100%;max-width:600px;background:#fff;border-radius:20px;box-shadow:0 10px 40px rgba(0,0,0,0.08);overflow:hidden;}\n                          .chk2-head{background:#111;padding:30px;text-align:center;color:#fff;}\n                          .chk2-head h2{margin:0;font-size:24px;font-weight:800;}\n                          .chk2-head p{margin:10px 0 0;font-size:15px;color:#9ca3af;}\n                          .chk2-body{padding:40px;}\n                          .chk2-label{display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:8px;}\n                          .chk2-input{width:100%;padding:14px 16px;border:2px solid #e5e7eb;border-radius:10px;font-size:15px;margin-bottom:20px;box-sizing:border-box;transition:border-color 0.2s;}\n                          .chk2-input:focus{outline:none;border-color:#111;}\n                          .chk2-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;}\n                          .chk2-divider{display:flex;align-items:center;text-align:center;color:#9ca3af;font-size:14px;margin:30px 0;}\n                          .chk2-divider::before,.chk2-divider::after{content:'';flex:1;border-bottom:1px solid #e5e7eb;}\n                          .chk2-divider:not(:empty)::before{margin-right:.25em;}\n                          .chk2-divider:not(:empty)::after{margin-left:.25em;}\n                          .chk2-btn{width:100%;padding:16px;background:#10b981;color:#fff;border:none;border-radius:10px;font-size:18px;font-weight:800;cursor:pointer;}\n                          .chk2-secure{text-align:center;font-size:13px;color:#6b7280;margin-top:20px;display:flex;justify-content:center;align-items:center;gap:6px;}\n                          @media(max-width:500px){.chk2-grid{grid-template-columns:1fr;} .chk2-body{padding:25px;}}\n                        </style>\n                        <section class=\"chk2-wrap\">\n                          <div class=\"chk2-card\">\n                            <div class=\"chk2-head\">\n                              <h2>Complete Your Order</h2>\n                              <p>Total Due: <strong>$149.00</strong></p>\n                            </div>\n                            <div class=\"chk2-body\">\n                              <label class=\"chk2-label\">Email Address</label>\n                              <input type=\"email\" class=\"chk2-input\" placeholder=\"you@example.com\">\n                              \n                              <div class=\"chk2-divider\">Shipping Details</div>\n                              \n                              <div class=\"chk2-grid\">\n                                <div><label class=\"chk2-label\">First Name</label><input type=\"text\" class=\"chk2-input\"></div>\n                                <div><label class=\"chk2-label\">Last Name</label><input type=\"text\" class=\"chk2-input\"></div>\n                              </div>\n                              <label class=\"chk2-label\">Street Address</label>\n                              <input type=\"text\" class=\"chk2-input\" placeholder=\"123 Main St\">\n                              <div class=\"chk2-grid\">\n                                <div><label class=\"chk2-label\">City</label><input type=\"text\" class=\"chk2-input\"></div>\n                                <div><label class=\"chk2-label\">ZIP / Postal</label><input type=\"text\" class=\"chk2-input\"></div>\n                              </div>\n\n                              <div class=\"chk2-divider\">Payment Info</div>\n\n                              <label class=\"chk2-label\">Card Number</label>\n                              <input type=\"text\" class=\"chk2-input\" placeholder=\"0000 0000 0000 0000\">\n                              <div class=\"chk2-grid\">\n                                <div><label class=\"chk2-label\">Expiry (MM/YY)</label><input type=\"text\" class=\"chk2-input\" placeholder=\"12/25\"></div>\n                                <div><label class=\"chk2-label\">CVC</label><input type=\"text\" class=\"chk2-input\" placeholder=\"123\"></div>\n                              </div>\n                              \n                              <button class=\"chk2-btn\">Pay $149.00 securely</button>\n                              <div class=\"chk2-secure\">🔒 256-bit SSL encryption. Safe and secure.</div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "checkout-3",
      "name": "Accordion Steps Checkout",
      "description": "Expands sections progressively to keep the user focused without feeling overwhelmed",
      "html": "\n                        <style>\n                          .chk3-wrap{padding:60px 20px;background:#fff;font-family:sans-serif;}\n                          .chk3-inner{max-width:800px;margin:0 auto;}\n                          .chk3-head{font-size:32px;font-weight:800;text-align:center;margin-bottom:40px;}\n                          .chk3-step{border:2px solid #e5e7eb;border-radius:12px;margin-bottom:20px;overflow:hidden;}\n                          .chk3-step.active{border-color:#111;}\n                          .chk3-shead{background:#f9fafb;padding:20px 25px;display:flex;align-items:center;gap:15px;font-size:18px;font-weight:700;color:#6b7280;cursor:pointer;}\n                          .chk3-step.active .chk3-shead{background:#fff;color:#111;border-bottom:2px solid #f1f5f9;}\n                          .chk3-num{width:28px;height:28px;background:#e5e7eb;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;}\n                          .chk3-step.active .chk3-num{background:#111;}\n                          .chk3-step.completed .chk3-num{background:#10b981;}\n                          .chk3-sbody{padding:25px;display:none;}\n                          .chk3-step.active .chk3-sbody{display:block;}\n                          .chk3-input{width:100%;padding:14px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:15px;box-sizing:border-box;}\n                          .chk3-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;}\n                          .chk3-btn{padding:14px 28px;background:#111;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;font-size:16px;}\n                          @media(max-width:500px){.chk3-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"chk3-wrap\">\n                          <div class=\"chk3-inner\">\n                            <h2 class=\"chk3-head\">Checkout</h2>\n                            \n                            <div class=\"chk3-step completed\">\n                              <div class=\"chk3-shead\"><div class=\"chk3-num\">✓</div> 1. Customer Info</div>\n                            </div>\n                            \n                            <div class=\"chk3-step active\">\n                              <div class=\"chk3-shead\"><div class=\"chk3-num\">2</div> Shipping Address</div>\n                              <div class=\"chk3-sbody\">\n                                <div class=\"chk3-grid\">\n                                  <input type=\"text\" class=\"chk3-input\" placeholder=\"First Name\">\n                                  <input type=\"text\" class=\"chk3-input\" placeholder=\"Last Name\">\n                                </div>\n                                <input type=\"text\" class=\"chk3-input\" placeholder=\"Street Address\">\n                                <div class=\"chk3-grid\">\n                                  <input type=\"text\" class=\"chk3-input\" placeholder=\"City\">\n                                  <input type=\"text\" class=\"chk3-input\" placeholder=\"ZIP Code\">\n                                </div>\n                                <button class=\"chk3-btn\">Continue to Payment</button>\n                              </div>\n                            </div>\n                            \n                            <div class=\"chk3-step\">\n                              <div class=\"chk3-shead\"><div class=\"chk3-num\">3</div> Payment Method</div>\n                            </div>\n                            \n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "checkout-4",
      "name": "Dark Luxury Checkout",
      "description": "Premium dark mode checkout page for high-end stores",
      "html": "\n                        <style>\n                          .chk4-wrap{padding:80px 20px;background:#09090b;font-family:sans-serif;}\n                          .chk4-inner{max-width:900px;margin:0 auto;}\n                          .chk4-grid{display:grid;grid-template-columns:1fr 350px;gap:50px;}\n                          .chk4-head{font-size:32px;font-weight:800;color:#fff;margin:0 0 30px;}\n                          .chk4-label{display:block;font-size:13px;color:#a1a1aa;margin-bottom:8px;font-weight:600;}\n                          .chk4-input{width:100%;padding:14px;background:#18181b;border:1px solid #27272a;border-radius:8px;color:#fff;margin-bottom:20px;box-sizing:border-box;}\n                          .chk4-input:focus{outline:none;border-color:#d4af37;}\n                          .chk4-row{display:flex;gap:15px;}\n                          .chk4-summary{background:#18181b;padding:30px;border-radius:12px;border:1px solid #27272a;}\n                          .chk4-stitle{color:#fff;font-size:18px;font-weight:700;margin:0 0 20px;}\n                          .chk4-srow{display:flex;justify-content:space-between;color:#a1a1aa;font-size:14px;margin-bottom:12px;}\n                          .chk4-stotal{display:flex;justify-content:space-between;color:#d4af37;font-size:24px;font-weight:800;margin-top:20px;padding-top:20px;border-top:1px solid #27272a;}\n                          .chk4-btn{width:100%;padding:18px;background:#d4af37;color:#000;border:none;border-radius:8px;font-size:16px;font-weight:800;cursor:pointer;margin-top:30px;}\n                          @media(max-width:800px){.chk4-grid{grid-template-columns:1fr;} .chk4-row{flex-direction:column;gap:0;}}\n                        </style>\n                        <section class=\"chk4-wrap\">\n                          <div class=\"chk4-inner\">\n                            <h2 class=\"chk4-head\">Secure Checkout</h2>\n                            <div class=\"chk4-grid\">\n                              <div>\n                                <h3 style=\"color:#fff;font-size:18px;margin-bottom:20px;border-bottom:1px solid #27272a;padding-bottom:10px;\">Billing Details</h3>\n                                <div class=\"chk4-row\">\n                                  <div style=\"flex:1;\"><label class=\"chk4-label\">First Name</label><input type=\"text\" class=\"chk4-input\"></div>\n                                  <div style=\"flex:1;\"><label class=\"chk4-label\">Last Name</label><input type=\"text\" class=\"chk4-input\"></div>\n                                </div>\n                                <label class=\"chk4-label\">Email Address</label>\n                                <input type=\"email\" class=\"chk4-input\">\n                                <label class=\"chk4-label\">Card Number</label>\n                                <input type=\"text\" class=\"chk4-input\" placeholder=\"0000 0000 0000 0000\">\n                                <div class=\"chk4-row\">\n                                  <div style=\"flex:1;\"><label class=\"chk4-label\">Expiry (MM/YY)</label><input type=\"text\" class=\"chk4-input\"></div>\n                                  <div style=\"flex:1;\"><label class=\"chk4-label\">CVC</label><input type=\"text\" class=\"chk4-input\"></div>\n                                </div>\n                              </div>\n                              <div>\n                                <div class=\"chk4-summary\">\n                                  <h3 class=\"chk4-stitle\">Your Order</h3>\n                                  <div class=\"chk4-srow\"><span>Caviar Leather Bag</span><span>$849.00</span></div>\n                                  <div class=\"chk4-srow\"><span>Shipping</span><span>Complimentary</span></div>\n                                  <div class=\"chk4-stotal\"><span>Total</span><span>$849.00</span></div>\n                                  <button class=\"chk4-btn\">COMPLETE ORDER</button>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "checkout-5",
      "name": "Express Checkout Form",
      "description": "Features quick pay buttons (Apple Pay / GPay) at the top",
      "html": "\n                        <style>\n                          .chk5-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;display:flex;justify-content:center;}\n                          .chk5-card{width:100%;max-width:550px;border:1px solid #e5e7eb;border-radius:16px;padding:40px;}\n                          .chk5-head{text-align:center;margin-bottom:30px;}\n                          .chk5-head h2{margin:0 0 10px;font-size:26px;font-weight:800;color:#111;}\n                          .chk5-express{display:flex;gap:15px;margin-bottom:30px;}\n                          .chk5-exp-btn{flex:1;padding:14px;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;display:flex;justify-content:center;align-items:center;}\n                          .chk5-exp-ap{background:#000;color:#fff;}\n                          .chk5-exp-gp{background:#fff;color:#3c4043;border:1px solid #dadce0;}\n                          .chk5-div{display:flex;align-items:center;text-align:center;color:#9ca3af;font-size:14px;margin-bottom:30px;}\n                          .chk5-div::before,.chk5-div::after{content:'';flex:1;border-bottom:1px solid #e5e7eb;}\n                          .chk5-div:not(:empty)::before{margin-right:.5em;}\n                          .chk5-div:not(:empty)::after{margin-left:.5em;}\n                          .chk5-input{width:100%;padding:14px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:15px;font-size:15px;box-sizing:border-box;}\n                          .chk5-btn{width:100%;padding:16px;background:#4f46e5;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;margin-top:10px;}\n                          @media(max-width:500px){.chk5-card{padding:25px;} .chk5-express{flex-direction:column;}}\n                        </style>\n                        <section class=\"chk5-wrap\">\n                          <div class=\"chk5-card\">\n                            <div class=\"chk5-head\">\n                              <h2>Express Checkout</h2>\n                              <p style=\"color:#6b7280;margin:0;\">Pay instantly with your preferred method.</p>\n                            </div>\n                            <div class=\"chk5-express\">\n                              <button class=\"chk5-exp-btn chk5-exp-ap\"> Pay</button>\n                              <button class=\"chk5-exp-btn chk5-exp-gp\">G Pay</button>\n                            </div>\n                            <div class=\"chk5-div\">OR PAY WITH CARD</div>\n                            <input type=\"email\" class=\"chk5-input\" placeholder=\"Email address\">\n                            <input type=\"text\" class=\"chk5-input\" placeholder=\"Card information\">\n                            <input type=\"text\" class=\"chk5-input\" placeholder=\"Name on card\">\n                            <input type=\"text\" class=\"chk5-input\" placeholder=\"Billing Address\">\n                            <button class=\"chk5-btn\">Pay $120.00</button>\n                          </div>\n                        </section>\n                    "
    }
  ]
