    {
      "id": "portfolio-card-1",
      "name": "3D Lift Card",
      "description": "A beautiful portfolio card with a glowing shadow and 3D lift effect on hover",
      "html": "\n                        <style>\n                          .ptc1-wrap{padding:60px 20px;background:#f8fafc;font-family:sans-serif;display:flex;justify-content:center;}\n                          .ptc1-card{width:100%;max-width:400px;background:#fff;border-radius:24px;padding:20px;box-shadow:0 10px 40px rgba(0,0,0,0.04);transition:transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;}\n                          .ptc1-card:hover{transform:translateY(-12px);box-shadow:0 20px 50px rgba(99, 102, 241, 0.2);}\n                          .ptc1-img-wrap{position:relative;width:100%;aspect-ratio:4/3;border-radius:16px;overflow:hidden;margin-bottom:20px;}\n                          .ptc1-img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s;}\n                          .ptc1-card:hover .ptc1-img{transform:scale(1.05);}\n                          .ptc1-badge{position:absolute;top:15px;left:15px;background:rgba(255,255,255,0.9);backdrop-filter:blur(5px);color:#4f46e5;font-weight:700;font-size:12px;padding:6px 12px;border-radius:20px;letter-spacing:0.5px;}\n                          .ptc1-title{font-size:22px;font-weight:800;color:#1e293b;margin:0 0 10px;}\n                          .ptc1-desc{color:#64748b;font-size:15px;line-height:1.6;margin:0 0 20px;}\n                          .ptc1-btn{display:flex;align-items:center;justify-content:center;width:100%;padding:14px;background:#f1f5f9;color:#0f172a;border-radius:12px;text-decoration:none;font-weight:700;transition:background 0.3s;}\n                          .ptc1-card:hover .ptc1-btn{background:#4f46e5;color:#fff;}\n                        </style>\n                        <section class=\"ptc1-wrap\">\n                          <div class=\"ptc1-card\">\n                            <div class=\"ptc1-img-wrap\">\n                              <span class=\"ptc1-badge\">UX Research</span>\n                              <img class=\"ptc1-img\" src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=600&auto=format&fit=crop\" alt=\"Project\">\n                            </div>\n                            <h3 class=\"ptc1-title\">Fintech Dashboard App</h3>\n                            <p class=\"ptc1-desc\">A complete redesign of a banking app to simplify complex financial data for everyday users.</p>\n                            <a href=\"#\" class=\"ptc1-btn\">View Case Study →</a>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "portfolio-card-2",
      "name": "Split Wide Card",
      "description": "A horizontal card layout (image left, text right) perfect for detailed case studies",
      "html": "\n                        <style>\n                          .ptc2-wrap{padding:60px 20px;background:#fff;font-family:sans-serif;display:flex;justify-content:center;}\n                          .ptc2-card{width:100%;max-width:900px;background:#fff;border:1px solid #e2e8f0;border-radius:20px;display:flex;overflow:hidden;transition:box-shadow 0.3s;}\n                          .ptc2-card:hover{box-shadow:0 15px 40px rgba(0,0,0,0.06);}\n                          .ptc2-img-box{flex:1;min-height:300px;}\n                          .ptc2-img{width:100%;height:100%;object-fit:cover;}\n                          .ptc2-content{flex:1.2;padding:40px;display:flex;flex-direction:column;justify-content:center;}\n                          .ptc2-tag{color:#10b981;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;}\n                          .ptc2-title{font-size:28px;font-weight:800;color:#0f172a;margin:0 0 15px;}\n                          .ptc2-desc{color:#64748b;font-size:16px;line-height:1.6;margin:0 0 25px;}\n                          .ptc2-meta{display:flex;gap:20px;margin-bottom:25px;}\n                          .ptc2-mitem{font-size:14px;}\n                          .ptc2-mlabel{color:#94a3b8;display:block;margin-bottom:4px;}\n                          .ptc2-mval{color:#334155;font-weight:700;}\n                          .ptc2-btn{display:inline-block;padding:14px 28px;background:#0f172a;color:#fff;text-decoration:none;font-weight:600;border-radius:8px;align-self:flex-start;}\n                          @media(max-width:768px){\n                            .ptc2-card{flex-direction:column;}\n                            .ptc2-img-box{min-height:250px;}\n                            .ptc2-content{padding:30px 20px;}\n                          }\n                        </style>\n                        <section class=\"ptc2-wrap\">\n                          <div class=\"ptc2-card\">\n                            <div class=\"ptc2-img-box\">\n                              <img class=\"ptc2-img\" src=\"https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=800&auto=format&fit=crop\" alt=\"Case Study\">\n                            </div>\n                            <div class=\"ptc2-content\">\n                              <div class=\"ptc2-tag\">Case Study</div>\n                              <h3 class=\"ptc2-title\">Enterprise Cloud Migration</h3>\n                              <p class=\"ptc2-desc\">How we helped a Fortune 500 company securely migrate their legacy systems to a modern cloud infrastructure with zero downtime.</p>\n                              <div class=\"ptc2-meta\">\n                                <div class=\"ptc2-mitem\"><span class=\"ptc2-mlabel\">Client</span><span class=\"ptc2-mval\">TechCorp Inc.</span></div>\n                                <div class=\"ptc2-mitem\"><span class=\"ptc2-mlabel\">Timeline</span><span class=\"ptc2-mval\">6 Months</span></div>\n                              </div>\n                              <a href=\"#\" class=\"ptc2-btn\">Read Full Story</a>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "portfolio-card-3",
      "name": "Dark Neumorphic Card",
      "description": "A premium dark card with subtle lighting and an embedded tech aesthetic",
      "html": "\n                        <style>\n                          .ptc3-wrap{padding:60px 20px;background:#09090b;font-family:sans-serif;display:flex;justify-content:center;}\n                          .ptc3-card{width:100%;max-width:420px;background:#18181b;border:1px solid #27272a;border-radius:20px;padding:24px;transition:border-color 0.3s;}\n                          .ptc3-card:hover{border-color:#52525b;}\n                          .ptc3-img-box{width:100%;height:240px;border-radius:12px;overflow:hidden;position:relative;margin-bottom:24px;}\n                          .ptc3-img{width:100%;height:100%;object-fit:cover;opacity:0.8;transition:opacity 0.3s, transform 0.5s;}\n                          .ptc3-card:hover .ptc3-img{opacity:1;transform:scale(1.05);}\n                          .ptc3-stats{display:flex;justify-content:space-between;margin-bottom:15px;padding-bottom:15px;border-bottom:1px solid #27272a;}\n                          .ptc3-stat{text-align:center;flex:1;}\n                          .ptc3-sval{color:#fff;font-size:20px;font-weight:800;margin-bottom:4px;}\n                          .ptc3-slabel{color:#a1a1aa;font-size:12px;text-transform:uppercase;letter-spacing:1px;}\n                          .ptc3-title{font-size:22px;font-weight:700;color:#f4f4f5;margin:0 0 10px;}\n                          .ptc3-desc{color:#a1a1aa;font-size:14px;line-height:1.6;margin:0 0 20px;}\n                          .ptc3-foot{display:flex;justify-content:space-between;align-items:center;}\n                          .ptc3-tools{display:flex;gap:10px;}\n                          .ptc3-tool{width:32px;height:32px;border-radius:50%;background:#27272a;display:flex;justify-content:center;align-items:center;color:#fff;font-size:12px;font-weight:700;}\n                          .ptc3-link{color:#fff;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:5px;transition:color 0.2s;}\n                          .ptc3-link:hover{color:#38bdf8;}\n                        </style>\n                        <section class=\"ptc3-wrap\">\n                          <div class=\"ptc3-card\">\n                            <div class=\"ptc3-img-box\">\n                              <img class=\"ptc3-img\" src=\"https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=600&auto=format&fit=crop\" alt=\"Code\">\n                            </div>\n                            <div class=\"ptc3-stats\">\n                              <div class=\"ptc3-stat\"><div class=\"ptc3-sval\">2M+</div><div class=\"ptc3-slabel\">Users</div></div>\n                              <div class=\"ptc3-stat\" style=\"border-left:1px solid #27272a;border-right:1px solid #27272a;\"><div class=\"ptc3-sval\">99%</div><div class=\"ptc3-slabel\">Uptime</div></div>\n                              <div class=\"ptc3-stat\"><div class=\"ptc3-sval\">4x</div><div class=\"ptc3-slabel\">Speed</div></div>\n                            </div>\n                            <h3 class=\"ptc3-title\">Cyber Security Portal</h3>\n                            <p class=\"ptc3-desc\">Developed a high-performance, real-time threat detection dashboard for a leading cybersecurity firm.</p>\n                            <div class=\"ptc3-foot\">\n                              <div class=\"ptc3-tools\">\n                                <div class=\"ptc3-tool\" title=\"React\">Re</div>\n                                <div class=\"ptc3-tool\" title=\"Node.js\">No</div>\n                                <div class=\"ptc3-tool\" title=\"AWS\">AW</div>\n                              </div>\n                              <a href=\"#\" class=\"ptc3-link\">View Live ↗</a>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "portfolio-card-4",
      "name": "Interactive Profile Portfolio",
      "description": "A personal portfolio card showing a freelancer/creator profile along with their best shots",
      "html": "\n                        <style>\n                          .ptc4-wrap{padding:60px 20px;background:#f1f5f9;font-family:sans-serif;display:flex;justify-content:center;}\n                          .ptc4-card{width:100%;max-width:500px;background:#fff;border-radius:20px;padding:30px;box-shadow:0 10px 30px rgba(0,0,0,0.05);}\n                          .ptc4-head{display:flex;align-items:center;gap:20px;margin-bottom:25px;}\n                          .ptc4-av{width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid #fff;box-shadow:0 4px 10px rgba(0,0,0,0.1);}\n                          .ptc4-info h3{margin:0 0 5px;font-size:20px;font-weight:800;color:#1e293b;}\n                          .ptc4-info p{margin:0;color:#64748b;font-size:14px;}\n                          .ptc4-shots{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:25px;}\n                          .ptc4-shot{border-radius:12px;overflow:hidden;aspect-ratio:1/1;}\n                          .ptc4-shot img{width:100%;height:100%;object-fit:cover;transition:transform 0.3s;}\n                          .ptc4-shot:hover img{transform:scale(1.1);}\n                          .ptc4-foot{display:flex;gap:15px;}\n                          .ptc4-btn1{flex:1;padding:12px;background:#3b82f6;color:#fff;border:none;border-radius:10px;font-weight:700;cursor:pointer;}\n                          .ptc4-btn2{flex:1;padding:12px;background:#f1f5f9;color:#334155;border:none;border-radius:10px;font-weight:700;cursor:pointer;}\n                        </style>\n                        <section class=\"ptc4-wrap\">\n                          <div class=\"ptc4-card\">\n                            <div class=\"ptc4-head\">\n                              <img class=\"ptc4-av\" src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop\" alt=\"Creator\">\n                              <div class=\"ptc4-info\">\n                                <h3>Sarah Jenkins</h3>\n                                <p>Senior Product Designer 🎨</p>\n                              </div>\n                            </div>\n                            <div class=\"ptc4-shots\">\n                              <div class=\"ptc4-shot\"><img src=\"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=400&auto=format&fit=crop\" alt=\"Shot 1\"></div>\n                              <div class=\"ptc4-shot\"><img src=\"https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=400&auto=format&fit=crop\" alt=\"Shot 2\"></div>\n                            </div>\n                            <div class=\"ptc4-foot\">\n                              <button class=\"ptc4-btn1\">Hire Me</button>\n                              <button class=\"ptc4-btn2\">View Portfolio</button>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "portfolio-card-5",
      "name": "Minimal App Showcase",
      "description": "A tall card emphasizing vertical mobile/app screens with overlapping elements",
      "html": "\n                        <style>\n                          .ptc5-wrap{padding:60px 20px;background:#fff;font-family:sans-serif;display:flex;justify-content:center;}\n                          .ptc5-card{width:100%;max-width:380px;background:linear-gradient(145deg, #f0fdf4, #dcfce7);border-radius:30px;padding:40px 30px 0;overflow:hidden;position:relative;}\n                          .ptc5-tag{display:inline-block;padding:6px 14px;background:#fff;color:#166534;font-size:12px;font-weight:800;border-radius:20px;margin-bottom:20px;}\n                          .ptc5-title{font-size:26px;font-weight:900;color:#14532d;margin:0 0 15px;line-height:1.2;}\n                          .ptc5-desc{color:#166534;font-size:15px;margin:0 0 30px;}\n                          .ptc5-phone{width:80%;margin:0 auto;background:#111;border:8px solid #111;border-radius:24px 24px 0 0;border-bottom:none;aspect-ratio:9/16;overflow:hidden;transform:translateY(10px);transition:transform 0.5s;}\n                          .ptc5-card:hover .ptc5-phone{transform:translateY(0);}\n                          .ptc5-screen{width:100%;height:100%;object-fit:cover;border-radius:16px 16px 0 0;}\n                        </style>\n                        <section class=\"ptc5-wrap\">\n                          <div class=\"ptc5-card\">\n                            <span class=\"ptc5-tag\">iOS APP DESIGN</span>\n                            <h3 class=\"ptc5-title\">Plantify:<br>Your Green Companion</h3>\n                            <p class=\"ptc5-desc\">An intuitive app helping you care for your houseplants with smart reminders.</p>\n                            <div class=\"ptc5-phone\">\n                              <img class=\"ptc5-screen\" src=\"https://images.unsplash.com/photo-1533090161767-e6ffed986c88?q=80&w=400&auto=format&fit=crop\" alt=\"App Screen\">\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
