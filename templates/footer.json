    {
      "id": "footer-1",
      "name": "Centered Clean Footer",
      "description": "A classic, clean footer with centered logo, links, social icons, and copyright text",
      "html": "\n                        <style>\n                          .ft1-wrap{background:#fff;padding:60px 20px 30px;font-family:sans-serif;border-top:1px solid #e2e8f0;text-align:center;}\n                          .ft1-logo{font-size:24px;font-weight:900;color:#0f172a;margin-bottom:25px;display:flex;justify-content:center;align-items:center;gap:8px;}\n                          .ft1-nav{display:flex;justify-content:center;gap:30px;flex-wrap:wrap;margin-bottom:30px;}\n                          .ft1-nav a{color:#64748b;text-decoration:none;font-weight:600;font-size:15px;transition:color 0.3s;}\n                          .ft1-nav a:hover{color:#3b82f6;}\n                          .ft1-social{display:flex;justify-content:center;gap:15px;margin-bottom:40px;}\n                          .ft1-sicon{width:40px;height:40px;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#475569;text-decoration:none;font-size:18px;transition:all 0.3s;}\n                          .ft1-sicon:hover{background:#3b82f6;color:#fff;transform:translateY(-3px);}\n                          .ft1-copy{font-size:14px;color:#94a3b8;border-top:1px solid #e2e8f0;padding-top:30px;}\n                        </style>\n                        <footer class=\"ft1-wrap\">\n                          <div class=\"ft1-logo\"><span>⚡</span> AppName</div>\n                          <nav class=\"ft1-nav\">\n                            <a href=\"#\">About</a>\n                            <a href=\"#\">Features</a>\n                            <a href=\"#\">Pricing</a>\n                            <a href=\"#\">Careers</a>\n                            <a href=\"#\">Help</a>\n                            <a href=\"#\">Privacy</a>\n                          </nav>\n                          <div class=\"ft1-social\">\n                            <a href=\"#\" class=\"ft1-sicon\">𝕏</a>\n                            <a href=\"#\" class=\"ft1-sicon\">in</a>\n                            <a href=\"#\" class=\"ft1-sicon\">gh</a>\n                            <a href=\"#\" class=\"ft1-sicon\">fb</a>\n                          </div>\n                          <div class=\"ft1-copy\">\n                            &copy; 2026 AppName Inc. All rights reserved.\n                          </div>\n                        </footer>\n                    "
