      "html": "\n                        <style>\n                          .ft5-wrap{padding:20px;background:#f8fafc;font-family:sans-serif;}\n                          .ft5-inner{max-width:800px;margin:0 auto;background:#fff;border-radius:100px;padding:15px 30px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 10px 25px rgba(0,0,0,0.05);border:1px solid #f1f5f9;}\n                          .ft5-left{font-size:14px;color:#64748b;font-weight:500;}\n                          .ft5-right{display:flex;gap:20px;}\n                          .ft5-right a{color:#3b82f6;text-decoration:none;font-size:14px;font-weight:600;transition:opacity 0.3s;}\n                          .ft5-right a:hover{opacity:0.7;}\n                          @media(max-width:600px){\n                            .ft5-inner{flex-direction:column;border-radius:20px;text-align:center;gap:15px;}\n                          }\n                        </style>\n                        <footer class=\"ft5-wrap\">\n                          <div class=\"ft5-inner\">\n                            <div class=\"ft5-left\">&copy; 2026 Minimalist. All rights reserved.</div>\n                            <div class=\"ft5-right\">\n                              <a href=\"#\">Twitter</a>\n                              <a href=\"#\">GitHub</a>\n                              <a href=\"#\">Dribbble</a>\n                            </div>\n                          </div>\n                        </footer>\n                    "
