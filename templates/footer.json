      "html": "\n                        <style>\n                          .ft3-wrap{background:#f9fafb;padding:80px 20px 40px;font-family:sans-serif;border-top:1px solid #e5e7eb;}\n                          .ft3-inner{max-width:1200px;margin:0 auto;display:flex;gap:60px;margin-bottom:50px;}\n                          .ft3-left{flex:1;max-width:400px;}\n                          .ft3-right{flex:2;display:grid;grid-template-columns:repeat(3, 1fr);gap:30px;}\n                          .ft3-brand{font-size:24px;font-weight:800;color:#111;margin-bottom:20px;display:flex;align-items:center;gap:10px;}\n                          .ft3-text{color:#6b7280;font-size:15px;line-height:1.6;margin-bottom:25px;}\n                          .ft3-form{display:flex;gap:10px;}\n                          .ft3-input{flex:1;padding:12px 15px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;outline:none;font-family:inherit;}\n                          .ft3-input:focus{border-color:#10b981;}\n                          .ft3-btn{padding:12px 20px;background:#10b981;color:#fff;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-family:inherit;}\n                          .ft3-title{font-size:16px;font-weight:700;color:#111;margin:0 0 20px;}\n                          .ft3-list{list-style:none;padding:0;margin:0;}\n                          .ft3-list li{margin-bottom:12px;}\n                          .ft3-list a{color:#6b7280;text-decoration:none;font-size:15px;transition:color 0.3s;}\n                          .ft3-list a:hover{color:#10b981;}\n                          .ft3-bottom{max-width:1200px;margin:0 auto;padding-top:30px;border-top:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;}\n                          .ft3-copy{color:#9ca3af;font-size:14px;}\n                          .ft3-payments{display:flex;gap:10px;font-size:20px;color:#d1d5db;}\n                          @media(max-width:900px){.ft3-inner{flex-direction:column;}}\n                          @media(max-width:600px){.ft3-right{grid-template-columns:1fr;} .ft3-form{flex-direction:column;} .ft3-bottom{flex-direction:column;gap:15px;text-align:center;}}\n                        </style>\n                        <footer class=\"ft3-wrap\">\n                          <div class=\"ft3-inner\">\n                            <div class=\"ft3-left\">\n                              <div class=\"ft3-brand\"><span style=\"color:#10b981;\">🛒</span> ShopHub</div>\n                              <p class=\"ft3-text\">Subscribe to our newsletter and get 10% off your first purchase.</p>\n                              <form class=\"ft3-form\" onsubmit=\"event.preventDefault();\">\n                                <input type=\"email\" class=\"ft3-input\" placeholder=\"Your email address\" required>\n                                <button type=\"submit\" class=\"ft3-btn\">Subscribe</button>\n                              </form>\n                            </div>\n                            <div class=\"ft3-right\">\n                              <div>\n                                <h4 class=\"ft3-title\">Shop</h4>\n                                <ul class=\"ft3-list\">\n                                  <li><a href=\"#\">All Products</a></li>\n                                  <li><a href=\"#\">New Arrivals</a></li>\n                                  <li><a href=\"#\">Discounts</a></li>\n                                  <li><a href=\"#\">Gift Cards</a></li>\n                                </ul>\n                              </div>\n                              <div>\n                                <h4 class=\"ft3-title\">Support</h4>\n                                <ul class=\"ft3-list\">\n                                  <li><a href=\"#\">Track Order</a></li>\n                                  <li><a href=\"#\">Returns</a></li>\n                                  <li><a href=\"#\">Shipping Info</a></li>\n                                  <li><a href=\"#\">Contact Us</a></li>\n                                </ul>\n                              </div>\n                              <div>\n                                <h4 class=\"ft3-title\">Company</h4>\n                                <ul class=\"ft3-list\">\n                                  <li><a href=\"#\">About Us</a></li>\n                                  <li><a href=\"#\">Careers</a></li>\n                                  <li><a href=\"#\">Store Locator</a></li>\n                                  <li><a href=\"#\">Blog</a></li>\n                                </ul>\n                              </div>\n                            </div>\n                          </div>\n                          <div class=\"ft3-bottom\">\n                            <div class=\"ft3-copy\">&copy; 2026 ShopHub. All rights reserved.</div>\n                            <div class=\"ft3-payments\">\n                              <span>💳</span>\n                              <span>🏦</span>\n                              <span>📱</span>\n                            </div>\n                          </div>\n                        </footer>\n                    "
    },
    {
      "id": "footer-4",
      "name": "Large CTA Footer",
      "description": "A footer that starts with a massive Call to Action, excellent for SaaS or agencies",
      "html": "\n                        <style>\n                          .ft4-wrap{background:#111;color:#fff;font-family:sans-serif;padding:100px 20px 40px;text-align:center;}\n                          .ft4-cta-title{font-size:48px;font-weight:900;margin:0 0 20px;letter-spacing:-1px;}\n                          .ft4-cta-desc{font-size:18px;color:#a1a1aa;margin:0 auto 40px;max-width:600px;line-height:1.6;}\n                          .ft4-btn{display:inline-block;padding:18px 40px;background:#fff;color:#111;text-decoration:none;font-size:18px;font-weight:800;border-radius:50px;transition:transform 0.3s;}\n                          .ft4-btn:hover{transform:translateY(-3px);}\n                          .ft4-divider{height:1px;background:#333;margin:80px auto 40px;max-width:1000px;}\n                          .ft4-links{display:flex;justify-content:center;gap:30px;flex-wrap:wrap;margin-bottom:30px;}\n                          .ft4-links a{color:#a1a1aa;text-decoration:none;font-weight:600;transition:color 0.3s;}\n                          .ft4-links a:hover{color:#fff;}\n                          .ft4-copy{color:#71717a;font-size:14px;}\n                          @media(max-width:600px){.ft4-cta-title{font-size:36px;}}\n                        </style>\n                        <footer class=\"ft4-wrap\">\n                          <h2 class=\"ft4-cta-title\">Ready to get started?</h2>\n                          <p class=\"ft4-cta-desc\">Join thousands of creators building their future with us. Start your 14-day free trial today.</p>\n                          <a href=\"#\" class=\"ft4-btn\">Start Free Trial</a>\n                          <div class=\"ft4-divider\"></div>\n                          <div class=\"ft4-links\">\n                            <a href=\"#\">Home</a>\n                            <a href=\"#\">Pricing</a>\n                            <a href=\"#\">Use Cases</a>\n                            <a href=\"#\">Documentation</a>\n                            <a href=\"#\">Contact</a>\n                          </div>\n                          <div class=\"ft4-copy\">&copy; 2026 BrandName. Built with ❤️.</div>\n                        </footer>\n                    "
