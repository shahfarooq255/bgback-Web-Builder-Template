  "templates": [
    {
      "id": "contact-1",
      "name": "Split Layout Contact",
      "description": "A modern two-column contact form with details on the left",
      "html": "\n                        <style>\n                          .cf1-wrap{padding:80px 20px;background:#f8fafc;font-family:sans-serif;}\n                          .cf1-inner{max-width:1100px;margin:0 auto;display:flex;gap:60px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 15px 40px rgba(0,0,0,0.06);}\n                          .cf1-left{background:linear-gradient(160deg,#1e3a8a,#3b82f6);padding:60px 40px;flex:1;color:#fff;display:flex;flex-direction:column;gap:30px;}\n                          .cf1-left h2{font-size:28px;font-weight:800;margin:0;}\n                          .cf1-left p{font-size:15px;opacity:0.85;line-height:1.6;margin:0;}\n                          .cf1-detail{display:flex;align-items:flex-start;gap:15px;}\n                          .cf1-icon{width:40px;height:40px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px;}\n                          .cf1-detail-text strong{display:block;font-weight:600;font-size:14px;}\n                          .cf1-detail-text span{font-size:14px;opacity:0.8;}\n                          .cf1-right{padding:60px 40px;flex:1.2;}\n                          .cf1-right h3{font-size:24px;font-weight:800;color:#0f172a;margin:0 0 30px;}\n                          .cf1-row{display:grid;grid-template-columns:1fr 1fr;gap:15px;}\n                          .cf1-group{display:flex;flex-direction:column;gap:6px;margin-bottom:15px;}\n                          .cf1-group label{font-size:13px;font-weight:600;color:#374151;}\n                          .cf1-input,.cf1-textarea{padding:12px 15px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;width:100%;box-sizing:border-box;}\n                          .cf1-input:focus,.cf1-textarea:focus{border-color:#3b82f6;}\n                          .cf1-textarea{resize:vertical;height:120px;}\n                          .cf1-btn{width:100%;padding:14px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;transition:background 0.3s;font-family:inherit;}\n                          .cf1-btn:hover{background:#2563eb;}\n                          @media(max-width:900px){\n                            .cf1-inner{flex-direction:column;}\n                            .cf1-left,.cf1-right{padding:40px 25px;}\n                          }\n                          @media(max-width:500px){.cf1-row{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"cf1-wrap\">\n                          <div class=\"cf1-inner\">\n                            <div class=\"cf1-left\">\n                              <h2>Let's Talk</h2>\n                              <p>Have a project in mind? We'd love to hear about it. Fill out the form and we'll get back to you within 24 hours.</p>\n                              <div class=\"cf1-detail\">\n                                <div class=\"cf1-icon\">📍</div>\n                                <div class=\"cf1-detail-text\"><strong>Address</strong><span>123 Main Street, NY, USA</span></div>\n                              </div>\n                              <div class=\"cf1-detail\">\n                                <div class=\"cf1-icon\">📧</div>\n                                <div class=\"cf1-detail-text\"><strong>Email</strong><span>hello@company.com</span></div>\n                              </div>\n                              <div class=\"cf1-detail\">\n                                <div class=\"cf1-icon\">📞</div>\n                                <div class=\"cf1-detail-text\"><strong>Phone</strong><span>+1 (555) 000-0000</span></div>\n                              </div>\n                            </div>\n                            <div class=\"cf1-right\">\n                              <h3>Send us a message</h3>\n                              <form onsubmit=\"event.preventDefault();\">\n                                <div class=\"cf1-row\">\n                                  <div class=\"cf1-group\"><label>First Name</label><input class=\"cf1-input\" type=\"text\" placeholder=\"John\"></div>\n                                  <div class=\"cf1-group\"><label>Last Name</label><input class=\"cf1-input\" type=\"text\" placeholder=\"Doe\"></div>\n                                </div>\n                                <div class=\"cf1-group\"><label>Email</label><input class=\"cf1-input\" type=\"email\" placeholder=\"john@example.com\"></div>\n                                <div class=\"cf1-group\"><label>Subject</label><input class=\"cf1-input\" type=\"text\" placeholder=\"How can we help?\"></div>\n                                <div class=\"cf1-group\"><label>Message</label><textarea class=\"cf1-textarea\" placeholder=\"Write your message here...\"></textarea></div>\n                                <button type=\"submit\" class=\"cf1-btn\">Send Message</button>\n                              </form>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "contact-2",
      "name": "Minimal Centered",
      "description": "A clean, minimal contact form centered on the page",
      "html": "\n                        <style>\n                          .cf2-wrap{padding:100px 20px;background:#fff;font-family:sans-serif;}\n                          .cf2-inner{max-width:600px;margin:0 auto;}\n                          .cf2-head{text-align:center;margin-bottom:40px;}\n                          .cf2-head h2{font-size:36px;font-weight:900;color:#111;margin:0 0 10px;}\n                          .cf2-head p{font-size:16px;color:#666;margin:0;}\n                          .cf2-group{margin-bottom:20px;}\n                          .cf2-group label{display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;}\n                          .cf2-input,.cf2-textarea{width:100%;padding:14px 18px;border:2px solid #f1f5f9;border-radius:10px;font-size:15px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;background:#f8fafc;box-sizing:border-box;}\n                          .cf2-input:focus,.cf2-textarea:focus{border-color:#6366f1;background:#fff;}\n                          .cf2-textarea{height:130px;resize:vertical;}\n                          .cf2-btn{width:100%;padding:15px;background:#6366f1;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;transition:all 0.3s;font-family:inherit;}\n                          .cf2-btn:hover{background:#4f46e5;transform:translateY(-2px);}\n                        </style>\n                        <section class=\"cf2-wrap\">\n                          <div class=\"cf2-inner\">\n                            <div class=\"cf2-head\">\n                              <h2>Get in Touch</h2>\n                              <p>We'll get back to you as soon as possible.</p>\n                            </div>\n                            <form onsubmit=\"event.preventDefault();\">\n                              <div class=\"cf2-group\"><label>Your Name</label><input class=\"cf2-input\" type=\"text\" placeholder=\"Full name\"></div>\n                              <div class=\"cf2-group\"><label>Email Address</label><input class=\"cf2-input\" type=\"email\" placeholder=\"you@example.com\"></div>\n                              <div class=\"cf2-group\"><label>Message</label><textarea class=\"cf2-textarea\" placeholder=\"Tell us about your project...\"></textarea></div>\n                              <button type=\"submit\" class=\"cf2-btn\">Send Message →</button>\n                            </form>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "contact-3",
      "name": "Dark Glassmorphism",
      "description": "A premium dark contact form with a glassmorphism effect",
      "html": "\n                        <style>\n                          .cf3-wrap{padding:80px 20px;background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);font-family:sans-serif;}\n                          .cf3-inner{max-width:700px;margin:0 auto;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:50px 40px;backdrop-filter:blur(20px);}\n                          .cf3-head{text-align:center;margin-bottom:40px;}\n                          .cf3-head h2{font-size:32px;font-weight:800;color:#fff;margin:0 0 10px;}\n                          .cf3-head p{font-size:15px;color:rgba(255,255,255,0.6);margin:0;}\n                          .cf3-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;}\n                          .cf3-group{margin-bottom:20px;}\n                          .cf3-group label{display:block;font-size:12px;font-weight:600;color:rgba(255,255,255,0.6);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;}\n                          .cf3-input,.cf3-textarea{width:100%;padding:14px 18px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;font-size:15px;font-family:inherit;outline:none;color:#fff;transition:border-color 0.3s;box-sizing:border-box;}\n                          .cf3-input::placeholder,.cf3-textarea::placeholder{color:rgba(255,255,255,0.35);}\n                          .cf3-input:focus,.cf3-textarea:focus{border-color:rgba(168,85,247,0.7);background:rgba(255,255,255,0.1);}\n                          .cf3-textarea{height:130px;resize:vertical;}\n                          .cf3-btn{width:100%;padding:15px;background:linear-gradient(90deg,#a855f7,#6366f1);color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity 0.3s;}\n                          .cf3-btn:hover{opacity:0.85;}\n                          @media(max-width:600px){\n                            .cf3-row{grid-template-columns:1fr;}\n                            .cf3-inner{padding:40px 20px;}\n                          }\n                        </style>\n                        <section class=\"cf3-wrap\">\n                          <div class=\"cf3-inner\">\n                            <div class=\"cf3-head\">\n                              <h2>Contact Us</h2>\n                              <p>Drop us a line and we will be in touch shortly.</p>\n                            </div>\n                            <form onsubmit=\"event.preventDefault();\">\n                              <div class=\"cf3-row\">\n                                <div class=\"cf3-group\"><label>First Name</label><input class=\"cf3-input\" type=\"text\" placeholder=\"John\"></div>\n                                <div class=\"cf3-group\"><label>Last Name</label><input class=\"cf3-input\" type=\"text\" placeholder=\"Doe\"></div>\n                              </div>\n                              <div class=\"cf3-group\"><label>Email</label><input class=\"cf3-input\" type=\"email\" placeholder=\"john@example.com\"></div>\n                              <div class=\"cf3-group\"><label>Message</label><textarea class=\"cf3-textarea\" placeholder=\"Your message...\"></textarea></div>\n                              <button type=\"submit\" class=\"cf3-btn\">Send Message</button>\n                            </form>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "contact-4",
      "name": "Map & Form Layout",
      "description": "A practical layout with an embedded map placeholder on one side",
      "html": "\n                        <style>\n                          .cf4-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .cf4-inner{max-width:1100px;margin:0 auto;}\n                          .cf4-head{text-align:center;margin-bottom:50px;}\n                          .cf4-head h2{font-size:36px;font-weight:900;color:#111;margin:0 0 10px;}\n                          .cf4-grid{display:flex;gap:40px;}\n                          .cf4-map{flex:1;min-width:280px;background:#e2e8f0;border-radius:16px;min-height:400px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;}\n                          .cf4-map-label{text-align:center;color:#64748b;}\n                          .cf4-map-label div{font-size:40px;}\n                          .cf4-map-label p{font-weight:600;color:#475569;}\n                          .cf4-form-box{flex:1.2;min-width:280px;}\n                          .cf4-group{margin-bottom:18px;}\n                          .cf4-group label{display:block;font-size:14px;font-weight:600;color:#374151;margin-bottom:7px;}\n                          .cf4-input,.cf4-textarea,.cf4-select{width:100%;padding:12px 15px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;box-sizing:border-box;}\n                          .cf4-input:focus,.cf4-textarea:focus,.cf4-select:focus{border-color:#2563eb;}\n                          .cf4-textarea{height:110px;resize:vertical;}\n                          .cf4-btn{width:100%;padding:14px;background:#0f172a;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;font-family:inherit;transition:background 0.3s;}\n                          .cf4-btn:hover{background:#1e293b;}\n                          @media(max-width:800px){\n                            .cf4-grid{flex-direction:column;}\n                            .cf4-map{min-height:250px;}\n                          }\n                        </style>\n                        <section class=\"cf4-wrap\">\n                          <div class=\"cf4-inner\">\n                            <div class=\"cf4-head\">\n                              <h2>Find Us & Reach Out</h2>\n                            </div>\n                            <div class=\"cf4-grid\">\n                              <div class=\"cf4-map\">\n                                <div class=\"cf4-map-label\"><div>📍</div><p>123 Business Ave,<br>New York, NY 10001</p></div>\n                              </div>\n                              <div class=\"cf4-form-box\">\n                                <form onsubmit=\"event.preventDefault();\">\n                                  <div class=\"cf4-group\"><label>Full Name</label><input class=\"cf4-input\" type=\"text\" placeholder=\"Your full name\"></div>\n                                  <div class=\"cf4-group\"><label>Email</label><input class=\"cf4-input\" type=\"email\" placeholder=\"your@email.com\"></div>\n                                  <div class=\"cf4-group\"><label>Department</label><select class=\"cf4-select\"><option>General Inquiry</option><option>Sales</option><option>Support</option><option>Partnership</option></select></div>\n                                  <div class=\"cf4-group\"><label>Message</label><textarea class=\"cf4-textarea\" placeholder=\"Your message...\"></textarea></div>\n                                  <button type=\"submit\" class=\"cf4-btn\">Submit</button>\n                                </form>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "contact-5",
      "name": "Card Grid with Info",
      "description": "Info cards on top with a full-width form below for a complete contact section",
      "html": "\n                        <style>\n                          .cf5-wrap{padding:80px 20px;background:#f0fdf4;font-family:sans-serif;}\n                          .cf5-inner{max-width:1000px;margin:0 auto;}\n                          .cf5-head{text-align:center;margin-bottom:50px;}\n                          .cf5-head h2{font-size:36px;font-weight:900;color:#052e16;margin:0 0 10px;}\n                          .cf5-head p{font-size:16px;color:#166534;margin:0;}\n                          .cf5-info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:50px;}\n                          .cf5-info-card{background:#fff;border-radius:16px;padding:25px;text-align:center;box-shadow:0 4px 10px rgba(0,0,0,0.04);}\n                          .cf5-info-icon{font-size:28px;margin-bottom:10px;}\n                          .cf5-info-card h4{font-size:16px;font-weight:700;color:#052e16;margin:0 0 5px;}\n                          .cf5-info-card p{font-size:14px;color:#4b5563;margin:0;}\n                          .cf5-form-box{background:#fff;border-radius:20px;padding:40px;box-shadow:0 4px 15px rgba(0,0,0,0.04);}\n                          .cf5-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px;}\n                          .cf5-group{display:flex;flex-direction:column;gap:6px;}\n                          .cf5-group label{font-size:13px;font-weight:600;color:#374151;}\n                          .cf5-input,.cf5-textarea{padding:12px 15px;border:1px solid #d1fae5;border-radius:8px;font-size:14px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;width:100%;box-sizing:border-box;background:#f0fdf4;}\n                          .cf5-input:focus,.cf5-textarea:focus{border-color:#10b981;background:#fff;}\n                          .cf5-textarea{height:120px;resize:vertical;}\n                          .cf5-btn{padding:14px 40px;background:#10b981;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;font-family:inherit;transition:background 0.3s;}\n                          .cf5-btn:hover{background:#059669;}\n                          @media(max-width:768px){\n                            .cf5-row{grid-template-columns:1fr;}\n                            .cf5-form-box{padding:25px 15px;}\n                          }\n                        </style>\n                        <section class=\"cf5-wrap\">\n                          <div class=\"cf5-inner\">\n                            <div class=\"cf5-head\">\n                              <h2>We'd Love to Hear From You</h2>\n                              <p>Reach out through any channel below or fill out the form.</p>\n                            </div>\n                            <div class=\"cf5-info-grid\">\n                              <div class=\"cf5-info-card\"><div class=\"cf5-info-icon\">📧</div><h4>Email</h4><p>hello@yourcompany.com</p></div>\n                              <div class=\"cf5-info-card\"><div class=\"cf5-info-icon\">📞</div><h4>Phone</h4><p>+1 (800) 123-4567</p></div>\n                              <div class=\"cf5-info-card\"><div class=\"cf5-info-icon\">💬</div><h4>Live Chat</h4><p>Available Mon–Fri, 9am–5pm</p></div>\n                            </div>\n                            <div class=\"cf5-form-box\">\n                              <form onsubmit=\"event.preventDefault();\">\n                                <div class=\"cf5-row\">\n                                  <div class=\"cf5-group\"><label>Name</label><input class=\"cf5-input\" type=\"text\" placeholder=\"Your name\"></div>\n                                  <div class=\"cf5-group\"><label>Email</label><input class=\"cf5-input\" type=\"email\" placeholder=\"your@email.com\"></div>\n                                  <div class=\"cf5-group\"><label>Phone</label><input class=\"cf5-input\" type=\"tel\" placeholder=\"+1 000 000 0000\"></div>\n                                </div>\n                                <div class=\"cf5-group\" style=\"margin-bottom:20px;\"><label>Message</label><textarea class=\"cf5-textarea\" placeholder=\"How can we help you?\"></textarea></div>\n                                <button type=\"submit\" class=\"cf5-btn\">Send Message</button>\n                              </form>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
}