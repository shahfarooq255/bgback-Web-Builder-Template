  "templates": [
    {
      "id": "ab-1",
      "name": "Elegant Author Card",
      "html": "\n<style>\n.ab1{padding:60px 20px;background:#f9fafb;font-family:'Inter',sans-serif}\n.ab1-card{max-width:700px;margin:0 auto;background:#fff;border-radius:20px;padding:40px;display:flex;gap:30px;align-items:flex-start;box-shadow:0 4px 20px rgba(0,0,0,.06);border:1px solid #e5e7eb}\n.ab1-avatar{width:100px;height:100px;border-radius:50%;object-fit:cover;flex-shrink:0;border:3px solid #e5e7eb}\n.ab1-info{flex:1}\n.ab1-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#6366f1;margin-bottom:8px}\n.ab1-name{font-size:22px;font-weight:800;color:#111;margin:0 0 5px}\n.ab1-role{font-size:14px;color:#888;margin:0 0 15px}\n.ab1-bio{font-size:15px;color:#555;line-height:1.7;margin:0 0 20px}\n.ab1-social{display:flex;gap:10px}\n.ab1-social a{width:36px;height:36px;background:#f3f4f6;border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:16px;transition:background .3s;color:#333}\n.ab1-social a:hover{background:#6366f1;color:#fff}\n@media(max-width:600px){.ab1-card{flex-direction:column}.ab1-avatar{width:80px;height:80px}}\n</style>\n<section class=\"ab1\">\n  <div class=\"ab1-card\">\n    <img class=\"ab1-avatar\" src=\"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=200&auto=format&fit=crop\" alt=\"Author\">\n    <div class=\"ab1-info\">\n      <div class=\"ab1-label\">About the Author</div>\n      <h3 class=\"ab1-name\">James Harrison</h3>\n      <p class=\"ab1-role\">Senior Product Designer & UX Strategist</p>\n      <p class=\"ab1-bio\">James is a seasoned designer with over 12 years of experience helping startups and enterprises craft intuitive digital experiences. He writes about design systems, product thinking, and the future of human-computer interaction.</p>\n      <div class=\"ab1-social\">\n        <a href=\"#\" title=\"Twitter\">🐦</a>\n        <a href=\"#\" title=\"LinkedIn\">💼</a>\n        <a href=\"#\" title=\"Website\">🌐</a>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ab-2",
      "name": "Dark Split View",
      "html": "\n<style>\n.ab2{padding:80px 20px;background:#0f172a;font-family:'Inter',sans-serif;color:#f8fafc}\n.ab2-card{max-width:900px;margin:0 auto;display:flex;background:#1e293b;border-radius:24px;overflow:hidden;box-shadow:0 25px 50px rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.05)}\n.ab2-img{width:40%;object-fit:cover}\n.ab2-content{width:60%;padding:50px 40px}\n.ab2-tag{display:inline-block;padding:6px 12px;background:rgba(56,189,248,0.1);color:#38bdf8;border-radius:50px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:15px}\n.ab2-name{font-size:32px;font-weight:900;margin:0 0 10px;color:#fff}\n.ab2-bio{font-size:16px;line-height:1.8;color:#94a3b8;margin:0 0 30px}\n.ab2-footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.1);padding-top:20px}\n.ab2-stats{display:flex;gap:20px}\n.ab2-stat-item strong{display:block;color:#f8fafc;font-size:18px}.ab2-stat-item span{color:#64748b;font-size:12px}\n.ab2-social{display:flex;gap:12px}\n.ab2-social a{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;transition:background 0.3s}\n.ab2-social a:hover{background:#38bdf8}\n@media(max-width:768px){.ab2-card{flex-direction:column}.ab2-img{width:100%;height:300px}.ab2-content{width:100%;padding:30px 20px}}\n</style>\n<section class=\"ab2\">\n  <div class=\"ab2-card\">\n    <img class=\"ab2-img\" src=\"https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=600&q=80\" alt=\"Author\">\n    <div class=\"ab2-content\">\n      <span class=\"ab2-tag\">Tech Writer</span>\n      <h3 class=\"ab2-name\">Elena Rodriguez</h3>\n      <p class=\"ab2-bio\">Elena covers the intersection of AI, design, and culture. With a background in cognitive science, she brings a unique perspective to how technology shapes human behavior and society.</p>\n      <div class=\"ab2-footer\">\n        <div class=\"ab2-stats\">\n          <div class=\"ab2-stat-item\"><strong>142</strong><span>Articles</span></div>\n          <div class=\"ab2-stat-item\"><strong>50k</strong><span>Readers</span></div>\n        </div>\n        <div class=\"ab2-social\">\n          <a href=\"#\">in</a><a href=\"#\">tw</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ab-3",
      "name": "Floating Center Badge",
      "html": "\n<style>\n.ab3{padding:120px 20px 80px;background:#f3f4f6;font-family:'Inter',sans-serif}\n.ab3-card{max-width:600px;margin:0 auto;background:#fff;border-radius:24px;padding:60px 40px 40px;text-align:center;box-shadow:0 20px 40px rgba(0,0,0,0.05);position:relative}\n.ab3-avatar{width:120px;height:120px;border-radius:50%;object-fit:cover;border:6px solid #f3f4f6;position:absolute;top:-60px;left:50%;transform:translateX(-50%);box-shadow:0 10px 20px rgba(0,0,0,0.1)}\n.ab3-name{font-size:28px;font-weight:800;color:#111;margin:0 0 5px}\n.ab3-role{font-size:15px;color:#f59e0b;font-weight:600;margin:0 0 20px}\n.ab3-bio{font-size:16px;color:#555;line-height:1.7;margin:0 0 30px}\n.ab3-btn{display:inline-block;padding:12px 30px;background:#111;color:#fff;border-radius:50px;text-decoration:none;font-weight:600;transition:background 0.3s}\n.ab3-btn:hover{background:#f59e0b}\n</style>\n<section class=\"ab3\">\n  <div class=\"ab3-card\">\n    <img class=\"ab3-avatar\" src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=300&q=80\" alt=\"Author\">\n    <h3 class=\"ab3-name\">Marcus Chen</h3>\n    <p class=\"ab3-role\">Lead Photographer</p>\n    <p class=\"ab3-bio\">Capturing moments that tell stories. Marcus has spent the last decade traveling the globe, documenting human resilience and natural wonders through his award-winning lens.</p>\n    <a href=\"#\" class=\"ab3-btn\">View Portfolio</a>\n  </div>\n</section>"
    },
    {
      "id": "ab-4",
      "name": "Glassmorphism Bio",
      "html": "\n<style>\n.ab4{padding:80px 20px;background:linear-gradient(135deg,#c084fc,#6366f1);font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.ab4::before{content:'';position:absolute;width:400px;height:400px;background:#f472b6;border-radius:50%;filter:blur(100px);top:-100px;right:-100px;opacity:0.6}\n.ab4-card{position:relative;max-width:800px;margin:0 auto;background:rgba(255,255,255,0.1);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.2);border-radius:24px;padding:40px;display:flex;align-items:center;gap:40px;box-shadow:0 25px 50px rgba(0,0,0,0.1);z-index:2}\n.ab4-img-wrap{position:relative}\n.ab4-avatar{width:160px;height:160px;border-radius:20px;object-fit:cover;box-shadow:0 15px 30px rgba(0,0,0,0.2)}\n.ab4-content{color:#fff}\n.ab4-name{font-size:32px;font-weight:800;margin:0 0 5px}\n.ab4-role{font-size:15px;color:rgba(255,255,255,0.8);margin:0 0 20px;text-transform:uppercase;letter-spacing:1px}\n.ab4-bio{font-size:16px;line-height:1.6;color:rgba(255,255,255,0.9);margin:0 0 25px}\n.ab4-links{display:flex;gap:15px}\n.ab4-links a{color:#fff;text-decoration:none;font-weight:600;padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.15);transition:background 0.3s}\n.ab4-links a:hover{background:rgba(255,255,255,0.3)}\n@media(max-width:768px){.ab4-card{flex-direction:column;text-align:center}.ab4-links{justify-content:center}}\n</style>\n<section class=\"ab4\">\n  <div class=\"ab4-card\">\n    <div class=\"ab4-img-wrap\">\n      <img class=\"ab4-avatar\" src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80\" alt=\"Author\">\n    </div>\n    <div class=\"ab4-content\">\n      <h3 class=\"ab4-name\">Sophia Laurent</h3>\n      <p class=\"ab4-role\">Creative Director</p>\n      <p class=\"ab4-bio\">Blending code with art. Sophia leads the design team with a focus on immersive experiences, glassmorphism UI, and spatial computing.</p>\n      <div class=\"ab4-links\">\n        <a href=\"#\">Dribbble</a>\n        <a href=\"#\">Behance</a>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ab-5",
      "name": "Editorial Quote Bio",
      "html": "\n<style>\n.ab5{padding:80px 20px;background:#fff;font-family:'Playfair Display',serif}\n.ab5-wrap{max-width:900px;margin:0 auto;display:flex;align-items:center;gap:60px}\n.ab5-avatar{width:300px;height:400px;object-fit:cover;filter:grayscale(100%);transition:filter 0.5s}\n.ab5-avatar:hover{filter:grayscale(0%)}\n.ab5-content{flex:1}\n.ab5-name{font-size:48px;font-weight:700;color:#000;margin:0 0 10px;line-height:1.1}\n.ab5-quote{font-size:20px;font-style:italic;color:#555;margin:0 0 30px;line-height:1.6;border-left:2px solid #000;padding-left:20px}\n.ab5-bio{font-family:'Inter',sans-serif;font-size:15px;color:#666;line-height:1.8;margin:0 0 30px}\n.ab5-sign{font-size:24px;font-style:italic;color:#000}\n@media(max-width:768px){.ab5-wrap{flex-direction:column;text-align:center}.ab5-quote{border-left:none;border-top:2px solid #000;padding-left:0;padding-top:20px;margin-top:20px}.ab5-avatar{width:100%;height:300px}}\n</style>\n<section class=\"ab5\">\n  <div class=\"ab5-wrap\">\n    <img class=\"ab5-avatar\" src=\"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=500&q=80\" alt=\"Author\">\n    <div class=\"ab5-content\">\n      <h3 class=\"ab5-name\">Isabella Swan</h3>\n      <div class=\"ab5-quote\">\"Design is not just what it looks like and feels like. Design is how it works.\"</div>\n      <p class=\"ab5-bio\">Isabella is a renowned critic and author who has dedicated her life to analyzing modern architecture and digital design trends. Her weekly column reaches millions of readers worldwide.</p>\n      <div class=\"ab5-sign\">I. Swan</div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ab-6",
      "name": "Neo-Brutalism Bio",
      "html": "\n<style>\n.ab6{padding:80px 20px;background:#fefce8;font-family:'Inter',sans-serif}\n.ab6-card{max-width:800px;margin:0 auto;background:#fff;border:4px solid #000;box-shadow:12px 12px 0 #000;padding:40px;display:flex;gap:40px;align-items:center;transition:transform 0.2s}\n.ab6-card:hover{transform:translate(-5px,-5px);box-shadow:17px 17px 0 #000}\n.ab6-img-wrap{border:4px solid #000;box-shadow:6px 6px 0 #000;border-radius:12px;overflow:hidden;width:150px;height:150px;flex-shrink:0}\n.ab6-avatar{width:100%;height:100%;object-fit:cover;display:block}\n.ab6-content{flex:1}\n.ab6-name{font-size:36px;font-weight:900;color:#000;margin:0 0 10px;text-transform:uppercase;letter-spacing:-1px}\n.ab6-tags{display:flex;gap:10px;margin-bottom:20px}\n.ab6-tag{padding:6px 12px;background:#a7f3d0;border:2px solid #000;font-size:12px;font-weight:800;text-transform:uppercase}\n.ab6-tag:nth-child(2){background:#fbcfe8}\n.ab6-bio{font-size:16px;color:#000;line-height:1.6;font-weight:500;margin:0}\n@media(max-width:768px){.ab6-card{flex-direction:column;text-align:center}.ab6-tags{justify-content:center}}\n</style>\n<section class=\"ab6\">\n  <div class=\"ab6-card\">\n    <div class=\"ab6-img-wrap\">\n      <img class=\"ab6-avatar\" src=\"https://images.unsplash.com/photo-1527980965255-d3b416303d12?auto=format&fit=crop&w=400&q=80\" alt=\"Author\">\n    </div>\n    <div class=\"ab6-content\">\n      <h3 class=\"ab6-name\">David Kim</h3>\n      <div class=\"ab6-tags\">\n        <span class=\"ab6-tag\">Founder</span>\n        <span class=\"ab6-tag\">Developer</span>\n      </div>\n      <p class=\"ab6-bio\">Building tools for creators. David loves pushing the web to its limits, writing bold code, and creating unapologetic user interfaces that stand out from the crowd.</p>\n    </div>\n  </div>\n</section>"
    }
  ]
}
