    {
      "id": "carousel-1",
      "name": "Modern Full-Width Slider",
      "description": "Sleek full-width carousel with animated text and indicators",
      "html": "\n                        <style>\n                          .cr1-wrap{position:relative;width:100%;height:500px;background:#111;overflow:hidden;font-family:sans-serif;}\n                          .cr1-bg{width:100%;height:100%;position:absolute;top:0;left:0;background:url('https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=2000&auto=format&fit=crop') center/cover;}\n                          .cr1-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;padding:0 10%;}\n                          .cr1-content{color:#fff;max-width:600px;}\n                          .cr1-title{font-size:clamp(32px,5vw,48px);font-weight:900;margin:0 0 20px 0;line-height:1.1;}\n                          .cr1-desc{font-size:clamp(15px,2.5vw,18px);color:#ccc;margin:0 0 30px 0;line-height:1.6;}\n                          @media(max-width:768px){.cr1-overlay{padding:0 5%;text-align:center;} .cr1-content{margin:0 auto;}}\n                        </style>\n                        <div class=\"cr1-wrap\">\n                            <div class=\"cr1-bg\">\n                                <div class=\"cr1-overlay\">\n                                    <div class=\"cr1-content\">\n                                        <span style=\"display:inline-block;padding:5px 15px;background:#e67e22;border-radius:20px;font-size:12px;font-weight:bold;margin-bottom:15px;text-transform:uppercase;letter-spacing:2px;\">Tech Innovations</span>\n                                        <h2 class=\"cr1-title\">Next Generation<br>Computing</h2>\n                                        <p class=\"cr1-desc\">Discover the power of our latest hardware solutions designed for ultimate performance and reliability.</p>\n                                        <button style=\"padding:15px 40px;background:#fff;border:none;border-radius:5px;color:#111;font-weight:bold;font-size:16px;cursor:pointer;\">Learn More</button>\n                                    </div>\n                                </div>\n                            </div>\n                            <div style=\"position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px;\">\n                                <div style=\"width: 40px; height: 4px; background: #e67e22; border-radius: 2px; cursor: pointer;\"></div>\n                                <div style=\"width: 40px; height: 4px; background: rgba(255,255,255,0.3); border-radius: 2px; cursor: pointer;\"></div>\n                                <div style=\"width: 40px; height: 4px; background: rgba(255,255,255,0.3); border-radius: 2px; cursor: pointer;\"></div>\n                            </div>\n                            <button style=\"position: absolute; left: 20px; top: 50%; transform: translateY(-50%); width: 50px; height: 50px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; color: #fff; font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;\">&#10094;</button>\n                            <button style=\"position: absolute; right: 20px; top: 50%; transform: translateY(-50%); width: 50px; height: 50px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; color: #fff; font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;\">&#10095;</button>\n                        </div>\n                    "
    },
    {
      "id": "carousel-2",
      "name": "Product Card Carousel",
      "description": "Multi-item slider for e-commerce products",
      "html": "\n                        <style>\n                          .cr2-wrap{padding:60px 40px;background:#f8f9fa;font-family:sans-serif;position:relative;}\n                          .cr2-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px;flex-wrap:wrap;gap:20px;}\n                          .cr2-cards{display:flex;gap:25px;overflow-x:auto;padding-bottom:10px;}\n                          .cr2-cards::-webkit-scrollbar{height:8px;}\n                          .cr2-cards::-webkit-scrollbar-thumb{background:#ccc;border-radius:4px;}\n                          .cr2-title{font-size:clamp(24px,4vw,32px);font-weight:800;color:#111;margin:0 0 10px 0;}\n                          @media(max-width:768px){.cr2-wrap{padding:40px 20px;}}\n                        </style>\n                        <div class=\"cr2-wrap\">\n                            <div class=\"cr2-header\">\n                                <div>\n                                    <h2 class=\"cr2-title\">Trending Products</h2>\n                                    <p style=\"font-size: 16px; color: #666; margin: 0;\">Explore our most popular items of the week.</p>\n                                </div>\n                                <div style=\"display: flex; gap: 10px;\">\n                                    <button style=\"width: 45px; height: 45px; background: #fff; border: 1px solid #ddd; border-radius: 50%; color: #333; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05);\">&#10094;</button>\n                                    <button style=\"width: 45px; height: 45px; background: #111; border: none; border-radius: 50%; color: #fff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1);\">&#10095;</button>\n                                </div>\n                            </div>\n                            <div class=\"cr2-cards\">\n                                <div style=\"flex: 1; min-width: 280px; background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border: 1px solid #eee;\">\n                                    <div style=\"height: 200px; background: #f0f0f0; border-radius: 8px; margin-bottom: 20px;\"></div>\n                                    <h3 style=\"font-size: 18px; font-weight: 700; margin: 0 0 10px 0; color: #111;\">Wireless Headphones</h3>\n                                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                                        <span style=\"font-size: 20px; font-weight: 800; color: #e67e22;\">$199.99</span>\n                                        <button style=\"padding: 8px 15px; background: #111; color: #fff; border: none; border-radius: 5px; font-size: 14px; font-weight: bold; cursor: pointer;\">Add to Cart</button>\n                                    </div>\n                                </div>\n                                <div style=\"flex: 1; min-width: 280px; background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border: 1px solid #eee;\">\n                                    <div style=\"height: 200px; background: #f0f0f0; border-radius: 8px; margin-bottom: 20px;\"></div>\n                                    <h3 style=\"font-size: 18px; font-weight: 700; margin: 0 0 10px 0; color: #111;\">Smart Watch V2</h3>\n                                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                                        <span style=\"font-size: 20px; font-weight: 800; color: #e67e22;\">$249.50</span>\n                                        <button style=\"padding: 8px 15px; background: #111; color: #fff; border: none; border-radius: 5px; font-size: 14px; font-weight: bold; cursor: pointer;\">Add to Cart</button>\n                                    </div>\n                                </div>\n                                <div style=\"flex: 1; min-width: 280px; background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border: 1px solid #eee;\">\n                                    <div style=\"height: 200px; background: #f0f0f0; border-radius: 8px; margin-bottom: 20px;\"></div>\n                                    <h3 style=\"font-size: 18px; font-weight: 700; margin: 0 0 10px 0; color: #111;\">Minimalist Backpack</h3>\n                                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                                        <span style=\"font-size: 20px; font-weight: 800; color: #e67e22;\">$89.00</span>\n                                        <button style=\"padding: 8px 15px; background: #111; color: #fff; border: none; border-radius: 5px; font-size: 14px; font-weight: bold; cursor: pointer;\">Add to Cart</button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    "
    },
    {
      "id": "carousel-3",
      "name": "Testimonial Slider",
      "description": "Elegant review carousel for client feedback",
      "html": "\n                        <style>\n                          .cr3-wrap{padding:80px 40px;background:#111;font-family:sans-serif;text-align:center;color:#fff;}\n                          .cr3-title{font-size:clamp(28px,4vw,36px);font-weight:800;margin:0 0 50px 0;}\n                          .cr3-quote{font-size:clamp(18px,3vw,24px);line-height:1.6;margin:0 0 30px 0;position:relative;z-index:1;font-weight:300;}\n                          @media(max-width:768px){.cr3-wrap{padding:50px 20px;}}\n                        </style>\n                        <div class=\"cr3-wrap\">\n                            <h2 class=\"cr3-title\">What Our Clients Say</h2>\n                            <div style=\"max-width: 800px; margin: 0 auto; position: relative;\">\n                                <div style=\"font-size: 80px; color: #333; position: absolute; top: -30px; left: -20px; font-family: serif; line-height: 1;\">&ldquo;</div>\n                                <p class=\"cr3-quote\">\"The platform completely revolutionized how we build digital products. It's incredibly intuitive, fast, and the support team is second to none. Highly recommended for any serious agency.\"</p>\n                                <div style=\"display: flex; align-items: center; justify-content: center; gap: 15px;\">\n                                    <div style=\"width: 60px; height: 60px; border-radius: 50%; background: #444;\"></div>\n                                    <div style=\"text-align: left;\">\n                                        <h4 style=\"margin: 0 0 5px 0; font-size: 18px; font-weight: 700;\">Sarah Jenkins</h4>\n                                        <span style=\"color: #888; font-size: 14px;\">CTO, TechFlow Inc.</span>\n                                    </div>\n                                </div>\n                            </div>\n                            <div style=\"display: flex; justify-content: center; gap: 8px; margin-top: 40px;\">\n                                <div style=\"width: 12px; height: 12px; background: #00ff88; border-radius: 50%; cursor: pointer;\"></div>\n                                <div style=\"width: 12px; height: 12px; background: #333; border-radius: 50%; cursor: pointer;\"></div>\n                                <div style=\"width: 12px; height: 12px; background: #333; border-radius: 50%; cursor: pointer;\"></div>\n                                <div style=\"width: 12px; height: 12px; background: #333; border-radius: 50%; cursor: pointer;\"></div>\n                            </div>\n                        </div>\n                    "
    },
    {
      "id": "carousel-4",
      "name": "Split Screen Carousel",
      "description": "Creative layout with image and text sliding separately",
      "html": "\n                        <style>\n                          .cr4-wrap{display:flex;width:100%;min-height:500px;font-family:sans-serif;flex-wrap:wrap;}\n                          .cr4-left{flex:1;background:#f093fb;position:relative;overflow:hidden;min-width:300px;min-height:300px;}\n                          .cr4-right{flex:1;background:#fff;padding:60px;display:flex;flex-direction:column;justify-content:center;position:relative;min-width:300px;}\n                          .cr4-title{font-size:clamp(32px,5vw,42px);font-weight:900;color:#111;margin:0 0 20px 0;line-height:1.2;}\n                          .cr4-desc{font-size:clamp(15px,2.5vw,16px);color:#666;margin:0 0 40px 0;line-height:1.6;max-width:400px;}\n                          .cr4-controls{position:absolute;bottom:40px;right:60px;display:flex;gap:10px;}\n                          @media(max-width:768px){.cr4-right{padding:40px 20px;} .cr4-controls{position:relative;bottom:0;right:0;margin-top:30px;justify-content:center;}}\n                        </style>\n                        <div class=\"cr4-wrap\">\n                            <div class=\"cr4-left\">\n                                <div style=\"position: absolute; inset: 0; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); display: flex; align-items: center; justify-content: center;\">\n                                    <div style=\"width: 60%; height: 60%; background: rgba(255,255,255,0.3); border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.1);\"></div>\n                                </div>\n                            </div>\n                            <div class=\"cr4-right\">\n                                <div style=\"color: #f5576c; font-size: 14px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;\">Collection 2026</div>\n                                <h2 class=\"cr4-title\">Vibrant & Bold<br>Design System</h2>\n                                <p class=\"cr4-desc\">Elevate your brand with our new collection of stunning components crafted for modern web experiences.</p>\n                                <button style=\"padding: 15px 30px; background: #111; border: none; color: #fff; font-weight: 700; width: fit-content; cursor: pointer;\">Discover More</button>\n                                <div class=\"cr4-controls\">\n                                    <button style=\"width: 50px; height: 50px; background: transparent; border: 2px solid #eee; border-radius: 50%; color: #333; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s;\">&#10094;</button>\n                                    <button style=\"width: 50px; height: 50px; background: #111; border: none; border-radius: 50%; color: #fff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s;\">&#10095;</button>\n                                </div>\n                            </div>\n                        </div>\n                    "
    },
    {
      "id": "carousel-5",
      "name": "3D Coverflow Slider",
      "description": "Interactive visual carousel for portfolios or galleries",
      "html": "\n                        <style>\n                          .cr5-wrap{padding:80px 20px;background:#0a0a0a;font-family:sans-serif;overflow:hidden;position:relative;text-align:center;}\n                          .cr5-title{font-size:clamp(28px,4vw,36px);font-weight:800;color:#fff;margin:0 0 10px 0;}\n                          .cr5-cards{display:flex;align-items:center;justify-content:center;gap:-20px;height:400px;position:relative;}\n                          .cr5-main{width:300px;height:400px;background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%), url('https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=1000&auto=format&fit=crop') center/cover;border-radius:20px;box-shadow:0 20px 50px rgba(0,0,0,0.9);display:flex;align-items:flex-end;padding:30px;position:relative;z-index:3;}\n                          .cr5-side{width:250px;height:350px;background:#222;border-radius:15px;opacity:0.6;z-index:1;}\n                          @media(max-width:768px){.cr5-cards{gap:10px;height:auto;} .cr5-side{display:none;} .cr5-main{width:100%;max-width:350px;height:350px;} .cr5-wrap{padding:50px 20px;}}\n                        </style>\n                        <div class=\"cr5-wrap\">\n                            <h2 class=\"cr5-title\">Our Recent Works</h2>\n                            <p style=\"font-size: 16px; color: #888; margin: 0 0 60px 0;\">Swipe to explore our award-winning portfolio.</p>\n                            \n                            <div class=\"cr5-cards\">\n                                <div class=\"cr5-side\" style=\"transform: scale(0.8) translateX(60px); box-shadow: -5px 0 20px rgba(0,0,0,0.8);\"></div>\n                                <div class=\"cr5-main\">\n                                    <div style=\"color: #fff; text-align: left;\">\n                                        <h3 style=\"font-size: 24px; font-weight: 800; margin: 0 0 5px 0;\">Digital Art</h3>\n                                        <p style=\"font-size: 14px; color: #ccc; margin: 0;\">UI/UX Design Concept</p>\n                                    </div>\n                                </div>\n                                <div class=\"cr5-side\" style=\"transform: scale(0.8) translateX(-60px); box-shadow: 5px 0 20px rgba(0,0,0,0.8);\"></div>\n                            </div>\n                            \n                            <div style=\"display: flex; justify-content: center; gap: 30px; margin-top: 40px;\">\n                                <button style=\"background: transparent; border: none; color: #fff; font-size: 24px; cursor: pointer; opacity: 0.7;\">&larr; Prev</button>\n                                <button style=\"background: transparent; border: none; color: #fff; font-size: 24px; cursor: pointer;\">Next &rarr;</button>\n                            </div>\n                        </div>\n                    "
    }
  ]
