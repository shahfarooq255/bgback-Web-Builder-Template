    {
      "id": "gallery-1",
      "name": "Masonry Gallery",
      "description": "A beautiful Pinterest-style masonry layout that perfectly fits images of different heights",
      "html": "\n                        <style>\n                          .gal1-wrap{padding:60px 20px;background:#fff;font-family:sans-serif;}\n                          .gal1-inner{max-width:1200px;margin:0 auto;}\n                          .gal1-head{text-align:center;margin-bottom:40px;}\n                          .gal1-head h2{font-size:clamp(30px,5vw,40px);font-weight:900;color:#111;margin:0 0 10px;}\n                          .gal1-grid{column-count:3;column-gap:20px;}\n                          .gal1-item{break-inside:avoid;margin-bottom:20px;position:relative;border-radius:12px;overflow:hidden;cursor:pointer;}\n                          .gal1-img{width:100%;display:block;transition:transform 0.4s ease;}\n                          .gal1-item:hover .gal1-img{transform:scale(1.03);}\n                          .gal1-overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);opacity:0;transition:opacity 0.3s;display:flex;align-items:flex-end;padding:20px;}\n                          .gal1-item:hover .gal1-overlay{opacity:1;}\n                          .gal1-title{color:#fff;font-size:18px;font-weight:700;margin:0;transform:translateY(10px);transition:transform 0.3s;}\n                          .gal1-item:hover .gal1-title{transform:translateY(0);}\n                          @media(max-width:900px){.gal1-grid{column-count:2;}}\n                          @media(max-width:500px){.gal1-grid{column-count:1;}}\n                        </style>\n                        <section class=\"gal1-wrap\">\n                          <div class=\"gal1-inner\">\n                            <div class=\"gal1-head\">\n                              <h2>Moments Captured</h2>\n                            </div>\n                            <div class=\"gal1-grid\">\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1469474968028-56623f02e42e?q=80&w=600&auto=format&fit=crop\" alt=\"Nature\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Into the Wild</h3></div>\n                              </div>\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1506744626753-dba7d41543fc?q=80&w=600&auto=format&fit=crop\" alt=\"Mountain\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Mountain Peaks</h3></div>\n                              </div>\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1472214103451-9374bd1c798e?q=80&w=600&auto=format&fit=crop\" alt=\"Forest\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Misty Forest</h3></div>\n                              </div>\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=600&auto=format&fit=crop\" alt=\"Fog\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Morning Fog</h3></div>\n                              </div>\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1433086966358-54859d0ed716?q=80&w=600&auto=format&fit=crop\" alt=\"Waterfall\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Hidden Waterfall</h3></div>\n                              </div>\n                              <div class=\"gal1-item\">\n                                <img class=\"gal1-img\" src=\"https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?q=80&w=600&auto=format&fit=crop\" alt=\"Trees\">\n                                <div class=\"gal1-overlay\"><h3 class=\"gal1-title\">Autumn Colors</h3></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "gallery-2",
      "name": "Bento Box Grid",
      "description": "Modern asymmetric grid (Bento style) with varying image sizes seamlessly locked together",
      "html": "\n                        <style>\n                          .gal2-wrap{padding:60px 20px;background:#f9fafb;font-family:sans-serif;}\n                          .gal2-inner{max-width:1100px;margin:0 auto;}\n                          .gal2-head{text-align:center;margin-bottom:40px;}\n                          .gal2-head h2{font-size:clamp(28px,5vw,36px);font-weight:800;color:#1f2937;margin:0;}\n                          .gal2-grid{display:grid;grid-template-columns:repeat(4, 1fr);grid-auto-rows:250px;gap:15px;}\n                          .gal2-item{border-radius:16px;overflow:hidden;position:relative;}\n                          .gal2-img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s ease;}\n                          .gal2-item:hover .gal2-img{transform:scale(1.08);}\n                          .gal2-tall{grid-row:span 2;}\n                          .gal2-wide{grid-column:span 2;}\n                          .gal2-large{grid-column:span 2;grid-row:span 2;}\n                          @media(max-width:800px){\n                            .gal2-grid{grid-template-columns:repeat(2, 1fr);grid-auto-rows:200px;}\n                            .gal2-wide{grid-column:span 2;}\n                            .gal2-large{grid-column:span 2;}\n                          }\n                          @media(max-width:500px){\n                            .gal2-grid{grid-template-columns:1fr;grid-auto-rows:250px;}\n                            .gal2-tall,.gal2-wide,.gal2-large{grid-column:span 1;grid-row:span 1;}\n                          }\n                        </style>\n                        <section class=\"gal2-wrap\">\n                          <div class=\"gal2-inner\">\n                            <div class=\"gal2-head\">\n                              <h2>Visual Stories</h2>\n                            </div>\n                            <div class=\"gal2-grid\">\n                              <div class=\"gal2-item gal2-large\">\n                                <img class=\"gal2-img\" src=\"https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=800&auto=format&fit=crop\" alt=\"Photography\">\n                              </div>\n                              <div class=\"gal2-item\">\n                                <img class=\"gal2-img\" src=\"https://images.unsplash.com/photo-1518599904199-0ca897819ddb?q=80&w=400&auto=format&fit=crop\" alt=\"Photography\">\n                              </div>\n                              <div class=\"gal2-item gal2-tall\">\n                                <img class=\"gal2-img\" src=\"https://images.unsplash.com/photo-1520013817300-1f4c1cb245ef?q=80&w=400&auto=format&fit=crop\" alt=\"Photography\">\n                              </div>\n                              <div class=\"gal2-item\">\n                                <img class=\"gal2-img\" src=\"https://images.unsplash.com/photo-1493246507139-91e8fad9978e?q=80&w=400&auto=format&fit=crop\" alt=\"Photography\">\n                              </div>\n                              <div class=\"gal2-item gal2-wide\">\n                                <img class=\"gal2-img\" src=\"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=800&auto=format&fit=crop\" alt=\"Photography\">\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "gallery-3",
      "name": "Horizontal Scroll Gallery",
      "description": "A modern, touch-friendly side-scrolling gallery. Perfect for mobile users to swipe through images",
      "html": "\n                        <style>\n                          .gal3-wrap{padding:60px 0 60px 20px;background:#0f172a;font-family:sans-serif;}\n                          .gal3-head{margin-bottom:30px;padding-right:20px;}\n                          .gal3-head h2{font-size:clamp(28px,5vw,38px);font-weight:800;color:#fff;margin:0;}\n                          .gal3-scroll{display:flex;gap:20px;overflow-x:auto;padding-bottom:20px;scroll-snap-type:x mandatory;}\n                          .gal3-scroll::-webkit-scrollbar{height:8px;}\n                          .gal3-scroll::-webkit-scrollbar-track{background:rgba(255,255,255,0.05);border-radius:10px;}\n                          .gal3-scroll::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.2);border-radius:10px;}\n                          .gal3-item{flex:0 0 300px;scroll-snap-align:start;border-radius:16px;overflow:hidden;position:relative;}\n                          .gal3-img{width:100%;height:400px;object-fit:cover;transition:opacity 0.3s;}\n                          .gal3-item:hover .gal3-img{opacity:0.8;}\n                          @media(max-width:600px){.gal3-item{flex:0 0 260px;} .gal3-img{height:350px;}}\n                        </style>\n                        <section class=\"gal3-wrap\">\n                          <div class=\"gal3-head\">\n                            <h2>The Architecture Album</h2>\n                          </div>\n                          <div class=\"gal3-scroll\">\n                            <div class=\"gal3-item\"><img class=\"gal3-img\" src=\"https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=400&auto=format&fit=crop\" alt=\"Arch\"></div>\n                            <div class=\"gal3-item\"><img class=\"gal3-img\" src=\"https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=400&auto=format&fit=crop\" alt=\"Arch\"></div>\n                            <div class=\"gal3-item\"><img class=\"gal3-img\" src=\"https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=400&auto=format&fit=crop\" alt=\"Arch\"></div>\n                            <div class=\"gal3-item\"><img class=\"gal3-img\" src=\"https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=400&auto=format&fit=crop\" alt=\"Arch\"></div>\n                            <div class=\"gal3-item\"><img class=\"gal3-img\" src=\"https://images.unsplash.com/photo-1428366890462-dd4baecf492b?q=80&w=400&auto=format&fit=crop\" alt=\"Arch\"></div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "gallery-4",
      "name": "Polaroid Stack Gallery",
      "description": "A playful scattered polaroid layout that straightens out when the user hovers over an image",
      "html": "\n                        <style>\n                          .gal4-wrap{padding:100px 20px;background:#f4f4f5;font-family:sans-serif;overflow:hidden;}\n                          .gal4-head{text-align:center;margin-bottom:60px;}\n                          .gal4-head h2{font-size:32px;font-weight:900;color:#18181b;margin:0;}\n                          .gal4-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:30px;max-width:1000px;margin:0 auto;}\n                          .gal4-item{background:#fff;padding:15px 15px 50px 15px;box-shadow:0 10px 30px rgba(0,0,0,0.1);transition:transform 0.4s, box-shadow 0.4s, z-index 0s;position:relative;}\n                          .gal4-item:nth-child(odd){transform:rotate(-4deg);}\n                          .gal4-item:nth-child(even){transform:rotate(5deg);}\n                          .gal4-item:nth-child(3n){transform:rotate(-2deg);}\n                          .gal4-item:hover{transform:rotate(0deg) scale(1.1);box-shadow:0 20px 40px rgba(0,0,0,0.15);z-index:10;}\n                          .gal4-img{width:250px;height:250px;object-fit:cover;background:#e4e4e7;}\n                          .gal4-caption{position:absolute;bottom:15px;left:0;width:100%;text-align:center;font-family:'Courier New', monospace;font-weight:700;color:#3f3f46;font-size:16px;}\n                          @media(max-width:768px){\n                            .gal4-item{transform:rotate(0) !important;}\n                            .gal4-item:hover{transform:scale(1.05) !important;}\n                          }\n                        </style>\n                        <section class=\"gal4-wrap\">\n                          <div class=\"gal4-head\">\n                            <h2>Vintage Memories</h2>\n                          </div>\n                          <div class=\"gal4-grid\">\n                            <div class=\"gal4-item\">\n                              <img class=\"gal4-img\" src=\"https://images.unsplash.com/photo-1528605248644-14dd04022da1?q=80&w=400&auto=format&fit=crop\" alt=\"Party\">\n                              <div class=\"gal4-caption\">Summer '98</div>\n                            </div>\n                            <div class=\"gal4-item\">\n                              <img class=\"gal4-img\" src=\"https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?q=80&w=400&auto=format&fit=crop\" alt=\"Camera\">\n                              <div class=\"gal4-caption\">Road Trip</div>\n                            </div>\n                            <div class=\"gal4-item\">\n                              <img class=\"gal4-img\" src=\"https://images.unsplash.com/photo-1516574187841-cb9cc2ca948b?q=80&w=400&auto=format&fit=crop\" alt=\"Friends\">\n                              <div class=\"gal4-caption\">Beach Day</div>\n                            </div>\n                            <div class=\"gal4-item\">\n                              <img class=\"gal4-img\" src=\"https://images.unsplash.com/photo-1473496169904-658ba37448eb?q=80&w=400&auto=format&fit=crop\" alt=\"City\">\n                              <div class=\"gal4-caption\">Downtown</div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "gallery-5",
      "name": "Cinematic Focus Grid",
      "description": "A dark fullscreen-style grid where hovering over an image dims the others, bringing focus to the hovered image",
      "html": "\n                        <style>\n                          .gal5-wrap{padding:20px;background:#000;font-family:sans-serif;}\n                          .gal5-head{text-align:center;padding:40px 0;}\n                          .gal5-head h2{font-size:clamp(30px,4vw,40px);font-weight:300;color:#fff;margin:0;letter-spacing:4px;text-transform:uppercase;}\n                          .gal5-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:10px;}\n                          .gal5-item{position:relative;overflow:hidden;aspect-ratio:1/1;}\n                          .gal5-img{width:100%;height:100%;object-fit:cover;transition:opacity 0.4s ease, transform 0.8s ease;}\n                          .gal5-grid:hover .gal5-img{opacity:0.3;}\n                          .gal5-item:hover .gal5-img{opacity:1 !important;transform:scale(1.05);}\n                        </style>\n                        <section class=\"gal5-wrap\">\n                          <div class=\"gal5-head\">\n                            <h2>Cinematography</h2>\n                          </div>\n                          <div class=\"gal5-grid\">\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1478720568477-152d9b164e26?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1505686994434-e3fca4438341?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1542204165-65bf26472b9b?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1522869635100-9f4c5e86afbd?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                            <div class=\"gal5-item\"><img class=\"gal5-img\" src=\"https://images.unsplash.com/photo-1440404653325-ab127d49abc1?q=80&w=500&auto=format&fit=crop\" alt=\"Cinema\"></div>\n                          </div>\n                        </section>\n                    "
    }
  ]
