    {
      "id": "dn-1",
      "name": "Warm Donation Block",
      "html": "\n<style>\n.dn1{padding:100px 20px;background:linear-gradient(135deg,#fff7ed,#fef3c7);font-family:'Inter',sans-serif}\n.dn1-wrap{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.dn1-text h2{font-size:clamp(28px,4vw,40px);font-weight:800;color:#78350f;margin:0 0 20px;line-height:1.2}\n.dn1-text p{color:#92400e;font-size:16px;line-height:1.8;margin:0 0 30px}\n.dn1-progress{margin-bottom:30px}\n.dn1-progress-label{display:flex;justify-content:space-between;margin-bottom:8px}\n.dn1-progress-label span{font-size:14px;font-weight:700;color:#78350f}\n.dn1-bar{height:12px;background:#fed7aa;border-radius:50px;overflow:hidden}\n.dn1-fill{height:100%;background:linear-gradient(90deg,#f97316,#ef4444);border-radius:50px;width:68%}\n.dn1-form{background:#fff;border-radius:24px;padding:40px;box-shadow:0 10px 40px rgba(0,0,0,.08)}\n.dn1-form h3{font-size:20px;font-weight:700;color:#111;margin:0 0 25px}\n.dn1-amounts{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:25px}\n.dn1-amount{padding:10px 20px;border:2px solid #e5e7eb;border-radius:10px;font-size:15px;font-weight:700;color:#333;cursor:pointer;transition:all .3s;background:#fff}\n.dn1-amount:hover,.dn1-amount.active{border-color:#f97316;background:#fff7ed;color:#f97316}\n.dn1-input{width:100%;padding:14px 16px;border:2px solid #e5e7eb;border-radius:12px;font-size:15px;color:#111;outline:none;box-sizing:border-box;font-family:'Inter',sans-serif;margin-bottom:20px;transition:border-color .3s}\n.dn1-input:focus{border-color:#f97316}\n.dn1-btn{width:100%;padding:16px;background:linear-gradient(135deg,#f97316,#ef4444);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif}\n@media(max-width:768px){.dn1-wrap{grid-template-columns:1fr}}\n</style>\n<section class=\"dn1\">\n  <div class=\"dn1-wrap\">\n    <div class=\"dn1-text\">\n      <h2>Help Us Make a Real Difference</h2>\n      <p>Every contribution helps us provide clean water, education, and healthcare to underserved communities around the world.</p>\n      <div class=\"dn1-progress\">\n        <div class=\"dn1-progress-label\"><span>$68,400 raised</span><span>Goal: $100,000</span></div>\n        <div class=\"dn1-bar\"><div class=\"dn1-fill\"></div></div>\n        <p style=\"color:#92400e;font-size:13px;margin:8px 0 0\">1,240 supporters · 12 days left</p>\n      </div>\n    </div>\n    <div class=\"dn1-form\">\n      <h3>Make a Donation</h3>\n      <div class=\"dn1-amounts\">\n        <div class=\"dn1-amount active\">$10</div>\n        <div class=\"dn1-amount\">$25</div>\n        <div class=\"dn1-amount\">$50</div>\n        <div class=\"dn1-amount\">$100</div>\n      </div>\n      <input class=\"dn1-input\" type=\"number\" placeholder=\"Or enter custom amount ($)\">\n      <input class=\"dn1-input\" type=\"email\" placeholder=\"Your email address\">\n      <button class=\"dn1-btn\">❤️ Donate Now</button>\n    </div>\n  </div>\n</section>"
    }
  ]
}