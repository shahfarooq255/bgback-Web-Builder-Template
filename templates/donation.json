  "templates": [
    {
      "id": "dn-1",
      "name": "Warm Donation Block",
      "html": "\n<style>\n.dn1{padding:100px 20px;background:linear-gradient(135deg,#fff7ed,#fef3c7);font-family:'Inter',sans-serif}\n.dn1-wrap{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.dn1-text h2{font-size:clamp(28px,4vw,40px);font-weight:800;color:#78350f;margin:0 0 20px;line-height:1.2}\n.dn1-text p{color:#92400e;font-size:16px;line-height:1.8;margin:0 0 30px}\n.dn1-progress{margin-bottom:30px}\n.dn1-progress-label{display:flex;justify-content:space-between;margin-bottom:8px}\n.dn1-progress-label span{font-size:14px;font-weight:700;color:#78350f}\n.dn1-bar{height:12px;background:#fed7aa;border-radius:50px;overflow:hidden}\n.dn1-fill{height:100%;background:linear-gradient(90deg,#f97316,#ef4444);border-radius:50px;width:68%}\n.dn1-form{background:#fff;border-radius:24px;padding:40px;box-shadow:0 10px 40px rgba(0,0,0,.08)}\n.dn1-form h3{font-size:20px;font-weight:700;color:#111;margin:0 0 25px}\n.dn1-amounts{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:25px}\n.dn1-amount{padding:10px 20px;border:2px solid #e5e7eb;border-radius:10px;font-size:15px;font-weight:700;color:#333;cursor:pointer;transition:all .3s;background:#fff}\n.dn1-amount:hover,.dn1-amount.active{border-color:#f97316;background:#fff7ed;color:#f97316}\n.dn1-input{width:100%;padding:14px 16px;border:2px solid #e5e7eb;border-radius:12px;font-size:15px;color:#111;outline:none;box-sizing:border-box;font-family:'Inter',sans-serif;margin-bottom:20px;transition:border-color .3s}\n.dn1-input:focus{border-color:#f97316}\n.dn1-btn{width:100%;padding:16px;background:linear-gradient(135deg,#f97316,#ef4444);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif}\n@media(max-width:768px){.dn1-wrap{grid-template-columns:1fr}}\n</style>\n<section class=\"dn1\">\n  <div class=\"dn1-wrap\">\n    <div class=\"dn1-text\">\n      <h2>Help Us Make a Real Difference</h2>\n      <p>Every contribution helps us provide clean water, education, and healthcare to underserved communities around the world.</p>\n      <div class=\"dn1-progress\">\n        <div class=\"dn1-progress-label\"><span>$68,400 raised</span><span>Goal: $100,000</span></div>\n        <div class=\"dn1-bar\"><div class=\"dn1-fill\"></div></div>\n        <p style=\"color:#92400e;font-size:13px;margin:8px 0 0\">1,240 supporters · 12 days left</p>\n      </div>\n    </div>\n    <div class=\"dn1-form\">\n      <h3>Make a Donation</h3>\n      <div class=\"dn1-amounts\">\n        <div class=\"dn1-amount active\">$10</div>\n        <div class=\"dn1-amount\">$25</div>\n        <div class=\"dn1-amount\">$50</div>\n        <div class=\"dn1-amount\">$100</div>\n      </div>\n      <input class=\"dn1-input\" type=\"number\" placeholder=\"Or enter custom amount ($)\">\n      <input class=\"dn1-input\" type=\"email\" placeholder=\"Your email address\">\n      <button class=\"dn1-btn\">❤️ Donate Now</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "dn-2",
      "name": "Dark Impact Donation",
      "html": "\n<style>\n.dn2{padding:100px 20px;background:#0a0a0a;font-family:'Inter',sans-serif;color:#fff}\n.dn2-wrap{max-width:1100px;margin:0 auto}\n.dn2-top{display:flex;gap:60px;align-items:center;margin-bottom:60px;flex-wrap:wrap}\n.dn2-text{flex:1;min-width:280px}\n.dn2-label{font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#ef4444;margin-bottom:15px}\n.dn2-text h2{font-size:clamp(36px,5vw,60px);font-weight:900;margin:0 0 20px;line-height:1.1;letter-spacing:-1px}\n.dn2-text p{color:#a1a1aa;font-size:16px;line-height:1.7;margin:0}\n.dn2-stats{flex:1;min-width:280px;display:flex;flex-direction:column;gap:15px}\n.dn2-stat{background:#18181b;border:1px solid #27272a;border-radius:16px;padding:25px 30px;display:flex;align-items:center;gap:20px}\n.dn2-stat-num{font-size:36px;font-weight:900;color:#ef4444}\n.dn2-stat-lbl{font-size:14px;color:#71717a;line-height:1.5}\n.dn2-progress{margin-bottom:50px}\n.dn2-bar-label{display:flex;justify-content:space-between;margin-bottom:10px}\n.dn2-bar-label span{font-size:14px;font-weight:600;color:#fff}\n.dn2-bar-label span:last-child{color:#71717a}\n.dn2-bar{height:8px;background:#27272a;border-radius:4px;overflow:hidden}\n.dn2-bar-fill{height:100%;width:72%;background:linear-gradient(90deg,#ef4444,#f97316);border-radius:4px}\n.dn2-amounts{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}\n.dn2-btn-amt{padding:12px 24px;background:#18181b;border:1px solid #3f3f46;color:#fff;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;transition:all 0.3s}\n.dn2-btn-amt:hover{border-color:#ef4444;color:#ef4444}\n.dn2-donate-btn{padding:18px 50px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;border:none;border-radius:12px;font-size:17px;font-weight:800;cursor:pointer;transition:transform 0.2s}\n.dn2-donate-btn:hover{transform:translateY(-3px)}\n</style>\n<section class=\"dn2\">\n  <div class=\"dn2-wrap\">\n    <div class=\"dn2-top\">\n      <div class=\"dn2-text\">\n        <div class=\"dn2-label\">Help Us Now</div>\n        <h2>Your Gift Saves Lives</h2>\n        <p>We are on a mission to bring food, clean water, and shelter to families displaced by conflict. Every dollar directly reaches those in need.</p>\n      </div>\n      <div class=\"dn2-stats\">\n        <div class=\"dn2-stat\"><div class=\"dn2-stat-num\">95%</div><div class=\"dn2-stat-lbl\">of all donations go directly<br>to aid programs</div></div>\n        <div class=\"dn2-stat\"><div class=\"dn2-stat-num\">2.4M</div><div class=\"dn2-stat-lbl\">people helped in<br>the last 5 years</div></div>\n      </div>\n    </div>\n    <div class=\"dn2-progress\">\n      <div class=\"dn2-bar-label\"><span>$72,000 raised of $100,000 goal</span><span>72% funded</span></div>\n      <div class=\"dn2-bar\"><div class=\"dn2-bar-fill\"></div></div>\n    </div>\n    <div class=\"dn2-amounts\">\n      <button class=\"dn2-btn-amt\">$10</button>\n      <button class=\"dn2-btn-amt\">$25</button>\n      <button class=\"dn2-btn-amt\">$50</button>\n      <button class=\"dn2-btn-amt\">$100</button>\n      <button class=\"dn2-btn-amt\">Custom</button>\n    </div>\n    <button class=\"dn2-donate-btn\">Donate Now &rarr;</button>\n  </div>\n</section>"
    },
    {
      "id": "dn-3",
      "name": "Cause Cards Grid",
      "html": "\n<style>\n.dn3{padding:100px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.dn3-head{text-align:center;max-width:600px;margin:0 auto 60px}\n.dn3-head h2{font-size:40px;font-weight:800;color:#0f172a;margin:0 0 15px}\n.dn3-head p{color:#64748b;font-size:16px;line-height:1.7}\n.dn3-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:25px}\n.dn3-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.05);transition:transform 0.3s}\n.dn3-card:hover{transform:translateY(-8px)}\n.dn3-img{height:200px;background-size:cover;background-position:center}\n.dn3-body{padding:28px}\n.dn3-tag{display:inline-block;padding:4px 12px;border-radius:50px;font-size:11px;font-weight:700;text-transform:uppercase;margin-bottom:15px}\n.dn3-tag-green{background:#d1fae5;color:#065f46}\n.dn3-tag-blue{background:#dbeafe;color:#1e40af}\n.dn3-tag-red{background:#fee2e2;color:#991b1b}\n.dn3-card-title{font-size:20px;font-weight:700;color:#0f172a;margin:0 0 10px}\n.dn3-card-desc{font-size:14px;color:#64748b;line-height:1.6;margin:0 0 20px}\n.dn3-progress-label{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:8px}\n.dn3-progress-label .raised{color:#0f172a}\n.dn3-progress-label .goal{color:#94a3b8}\n.dn3-bar{height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;margin-bottom:20px}\n.dn3-bar-fill{height:100%;border-radius:3px}\n.dn3-donate-btn{display:block;text-align:center;padding:12px;border-radius:10px;font-weight:700;font-size:14px;cursor:pointer;border:none;width:100%}\n</style>\n<section class=\"dn3\">\n  <div class=\"dn3-head\">\n    <h2>Choose a Cause to Support</h2>\n    <p>Every campaign is verified. 100% of your donation reaches those who need it most.</p>\n  </div>\n  <div class=\"dn3-grid\">\n    <div class=\"dn3-card\">\n      <div class=\"dn3-img\" style=\"background-image:url('https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80')\"></div>\n      <div class=\"dn3-body\">\n        <span class=\"dn3-tag dn3-tag-green\">Education</span>\n        <h3 class=\"dn3-card-title\">Books for Every Child</h3>\n        <p class=\"dn3-card-desc\">Help us provide school supplies and quality education materials to 5,000 kids.</p>\n        <div class=\"dn3-progress-label\"><span class=\"raised\">$34,200 raised</span><span class=\"goal\">Goal: $50K</span></div>\n        <div class=\"dn3-bar\"><div class=\"dn3-bar-fill\" style=\"width:68%;background:#10b981\"></div></div>\n        <button class=\"dn3-donate-btn\" style=\"background:#10b981;color:#fff\">Donate Now</button>\n      </div>\n    </div>\n    <div class=\"dn3-card\">\n      <div class=\"dn3-img\" style=\"background-image:url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=80')\"></div>\n      <div class=\"dn3-body\">\n        <span class=\"dn3-tag dn3-tag-blue\">Healthcare</span>\n        <h3 class=\"dn3-card-title\">Mobile Medical Clinics</h3>\n        <p class=\"dn3-card-desc\">Bring doctors to remote villages with no access to hospitals or medicine.</p>\n        <div class=\"dn3-progress-label\"><span class=\"raised\">$88,000 raised</span><span class=\"goal\">Goal: $120K</span></div>\n        <div class=\"dn3-bar\"><div class=\"dn3-bar-fill\" style=\"width:73%;background:#3b82f6\"></div></div>\n        <button class=\"dn3-donate-btn\" style=\"background:#3b82f6;color:#fff\">Donate Now</button>\n      </div>\n    </div>\n    <div class=\"dn3-card\">\n      <div class=\"dn3-img\" style=\"background-image:url('https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&w=600&q=80')\"></div>\n      <div class=\"dn3-body\">\n        <span class=\"dn3-tag dn3-tag-red\">Emergency</span>\n        <h3 class=\"dn3-card-title\">Disaster Relief Fund</h3>\n        <p class=\"dn3-card-desc\">Rapid response to floods and earthquakes providing food and temporary shelter.</p>\n        <div class=\"dn3-progress-label\"><span class=\"raised\">$195,000 raised</span><span class=\"goal\">Goal: $200K</span></div>\n        <div class=\"dn3-bar\"><div class=\"dn3-bar-fill\" style=\"width:97%;background:#ef4444\"></div></div>\n        <button class=\"dn3-donate-btn\" style=\"background:#ef4444;color:#fff\">Donate Now</button>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "dn-4",
      "name": "Fullscreen Hero Donation",
      "html": "\n<style>\n.dn4{min-height:80vh;background:url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1920&q=80') center/cover;position:relative;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:60px 20px}\n.dn4::before{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.85),rgba(0,0,0,0.4))}\n.dn4-content{position:relative;z-index:2;color:#fff;max-width:700px}\n.dn4-quote{font-size:20px;font-style:italic;color:rgba(255,255,255,0.8);margin-bottom:20px;line-height:1.6}\n.dn4 h2{font-size:clamp(40px,6vw,72px);font-weight:900;margin:0 0 20px;letter-spacing:-1px;line-height:1}\n.dn4 p{color:rgba(255,255,255,0.75);font-size:17px;margin:0 0 40px;line-height:1.7}\n.dn4-bar-wrap{background:rgba(255,255,255,0.15);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2);border-radius:16px;padding:25px 30px;margin-bottom:30px;text-align:left}\n.dn4-bar-meta{display:flex;justify-content:space-between;margin-bottom:10px}\n.dn4-bar-meta span{font-size:14px;font-weight:600;color:#fff}\n.dn4-bar-track{height:8px;background:rgba(255,255,255,0.2);border-radius:4px;overflow:hidden}\n.dn4-bar-fill{height:100%;width:84%;background:linear-gradient(90deg,#10b981,#34d399);border-radius:4px}\n.dn4-actions{display:flex;gap:15px;justify-content:center;flex-wrap:wrap}\n.dn4-btn{padding:18px 40px;border-radius:50px;font-size:16px;font-weight:700;cursor:pointer;border:none}\n.dn4-btn-primary{background:#10b981;color:#fff}\n.dn4-btn-secondary{background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.4);backdrop-filter:blur(10px)}\n</style>\n<section class=\"dn4\">\n  <div class=\"dn4-content\">\n    <div class=\"dn4-quote\">\"The best time to plant a tree was 20 years ago. The second best time is now.\"</div>\n    <h2>Restore Our Forests</h2>\n    <p>Join 50,000 donors who are helping us plant 1 million trees across 3 continents before 2026.</p>\n    <div class=\"dn4-bar-wrap\">\n      <div class=\"dn4-bar-meta\"><span>842,000 trees planted</span><span>Goal: 1,000,000</span></div>\n      <div class=\"dn4-bar-track\"><div class=\"dn4-bar-fill\"></div></div>\n    </div>\n    <div class=\"dn4-actions\">\n      <button class=\"dn4-btn dn4-btn-primary\">Plant a Tree — $5</button>\n      <button class=\"dn4-btn dn4-btn-secondary\">Learn More</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "dn-5",
      "name": "Minimal Clean Donation",
      "html": "\n<style>\n.dn5{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.dn5-wrap{max-width:700px;margin:0 auto;text-align:center}\n.dn5-icon{font-size:56px;display:block;margin-bottom:20px}\n.dn5-wrap h2{font-size:42px;font-weight:800;color:#0f172a;margin:0 0 15px;letter-spacing:-1px}\n.dn5-wrap p{color:#64748b;font-size:17px;line-height:1.7;margin:0 0 40px}\n.dn5-progress{background:#f1f5f9;border-radius:12px;padding:25px 30px;margin-bottom:40px;text-align:left}\n.dn5-prog-labels{display:flex;justify-content:space-between;margin-bottom:12px}\n.dn5-prog-labels span{font-size:15px;font-weight:700;color:#0f172a}\n.dn5-prog-labels span:last-child{color:#64748b;font-weight:500}\n.dn5-bar{height:10px;background:#e2e8f0;border-radius:5px;overflow:hidden}\n.dn5-bar-fill{height:100%;width:63%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:5px}\n.dn5-prog-sub{font-size:13px;color:#94a3b8;margin-top:10px}\n.dn5-amounts{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:25px}\n.dn5-amt{padding:12px 28px;background:#f8fafc;border:2px solid #e2e8f0;border-radius:50px;font-size:16px;font-weight:700;color:#0f172a;cursor:pointer;transition:all 0.3s}\n.dn5-amt:hover{border-color:#6366f1;color:#6366f1;background:#eef2ff}\n.dn5-btn{padding:18px 60px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:50px;font-size:17px;font-weight:700;cursor:pointer;transition:opacity 0.3s}\n.dn5-btn:hover{opacity:0.9}\n.dn5-note{font-size:13px;color:#94a3b8;margin-top:20px}\n</style>\n<section class=\"dn5\">\n  <div class=\"dn5-wrap\">\n    <span class=\"dn5-icon\">💜</span>\n    <h2>Support Our Mission</h2>\n    <p>Your generosity funds research, community programs, and life-saving initiatives worldwide. Every amount makes a difference.</p>\n    <div class=\"dn5-progress\">\n      <div class=\"dn5-prog-labels\"><span>$63,400 raised</span><span>Goal: $100,000</span></div>\n      <div class=\"dn5-bar\"><div class=\"dn5-bar-fill\"></div></div>\n      <div class=\"dn5-prog-sub\">1,840 supporters • 21 days remaining</div>\n    </div>\n    <div class=\"dn5-amounts\">\n      <div class=\"dn5-amt\">$5</div>\n      <div class=\"dn5-amt\">$15</div>\n      <div class=\"dn5-amt\">$30</div>\n      <div class=\"dn5-amt\">$50</div>\n    </div>\n    <button class=\"dn5-btn\">Donate with Love</button>\n    <p class=\"dn5-note\">Secure payment powered by Stripe. 100% of donations go to the cause.</p>\n  </div>\n</section>"
    },
    {
      "id": "dn-6",
      "name": "Neo-Brutalism Donation",
      "html": "\n<style>\n.dn6{padding:100px 20px;background:#e0f2fe;font-family:'Inter',sans-serif}\n.dn6-wrap{max-width:1000px;margin:0 auto;display:flex;gap:30px;flex-wrap:wrap}\n.dn6-left{flex:1;min-width:280px}\n.dn6-left h2{font-size:clamp(40px,5vw,64px);font-weight:900;color:#000;line-height:1;margin:0 0 20px;text-transform:uppercase;letter-spacing:-2px}\n.dn6-left p{font-size:16px;color:#0f172a;line-height:1.7;margin:0 0 30px;font-weight:500}\n.dn6-impact{display:flex;gap:20px;flex-wrap:wrap}\n.dn6-impact-item{background:#fff;border:3px solid #000;box-shadow:5px 5px 0 #000;padding:16px 20px}\n.dn6-impact-num{font-size:28px;font-weight:900;color:#0284c7;display:block}\n.dn6-impact-lbl{font-size:12px;font-weight:700;text-transform:uppercase;color:#000}\n.dn6-right{flex:1;min-width:280px;background:#fff;border:4px solid #000;box-shadow:10px 10px 0 #000;padding:40px}\n.dn6-right h3{font-size:24px;font-weight:900;color:#000;margin:0 0 25px;text-transform:uppercase}\n.dn6-amounts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}\n.dn6-amt{padding:14px;background:#e0f2fe;border:3px solid #000;font-size:18px;font-weight:900;color:#000;cursor:pointer;text-align:center;transition:all 0.2s}\n.dn6-amt:hover{background:#0284c7;color:#fff}\n.dn6-input{width:100%;padding:14px 16px;border:3px solid #000;background:#f8fafc;font-size:16px;color:#000;outline:none;box-sizing:border-box;margin-bottom:16px;font-weight:600}\n.dn6-btn{width:100%;padding:18px;background:#000;color:#fff;border:3px solid #000;font-size:18px;font-weight:900;text-transform:uppercase;cursor:pointer;transition:all 0.2s;letter-spacing:1px}\n.dn6-btn:hover{background:#0284c7;border-color:#0284c7}\n</style>\n<section class=\"dn6\">\n  <div class=\"dn6-wrap\">\n    <div class=\"dn6-left\">\n      <h2>Give.<br>Change.<br>Lives.</h2>\n      <p>Bold action starts with a single donation. We use every cent to create maximum impact for those who need it most.</p>\n      <div class=\"dn6-impact\">\n        <div class=\"dn6-impact-item\"><span class=\"dn6-impact-num\">$10</span><span class=\"dn6-impact-lbl\">Feeds a family</span></div>\n        <div class=\"dn6-impact-item\"><span class=\"dn6-impact-num\">$50</span><span class=\"dn6-impact-lbl\">Buys school books</span></div>\n        <div class=\"dn6-impact-item\"><span class=\"dn6-impact-num\">$100</span><span class=\"dn6-impact-lbl\">Funds a clinic day</span></div>\n      </div>\n    </div>\n    <div class=\"dn6-right\">\n      <h3>Your Donation</h3>\n      <div class=\"dn6-amounts\">\n        <div class=\"dn6-amt\">$10</div>\n        <div class=\"dn6-amt\">$25</div>\n        <div class=\"dn6-amt\">$50</div>\n        <div class=\"dn6-amt\">$100</div>\n      </div>\n      <input class=\"dn6-input\" type=\"number\" placeholder=\"Custom amount ($)\">\n      <button class=\"dn6-btn\">Donate Now &rarr;</button>\n    </div>\n  </div>\n</section>"
    }
  ]
}
