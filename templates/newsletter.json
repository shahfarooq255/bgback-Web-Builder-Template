      "id": "newsletter-1",
      "name": "Centered Clean Card",
      "description": "A clean, centered newsletter subscription card",
      "html": "\n                        <style>\n                          .nl1-wrap{padding:80px 20px;background:#f8fafc;font-family:sans-serif;display:flex;justify-content:center;}\n                          .nl1-card{background:#fff;border-radius:24px;padding:60px 40px;width:100%;max-width:700px;text-align:center;box-shadow:0 20px 40px rgba(0,0,0,0.04);}\n                          .nl1-icon{font-size:40px;margin-bottom:20px;display:inline-block;background:#eff6ff;width:80px;height:80px;line-height:80px;border-radius:50%;color:#3b82f6;}\n                          .nl1-title{font-size:32px;font-weight:800;color:#0f172a;margin:0 0 15px;}\n                          .nl1-desc{font-size:16px;color:#64748b;margin:0 auto 40px;max-width:450px;line-height:1.6;}\n                          .nl1-form{display:flex;gap:10px;max-width:500px;margin:0 auto;}\n                          .nl1-input{flex:1;padding:15px 20px;border:2px solid #e2e8f0;border-radius:12px;font-size:16px;outline:none;transition:border-color 0.3s;font-family:inherit;}\n                          .nl1-input:focus{border-color:#3b82f6;}\n                          .nl1-btn{padding:15px 30px;background:#3b82f6;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;transition:background 0.3s;font-family:inherit;white-space:nowrap;}\n                          .nl1-btn:hover{background:#2563eb;}\n                          .nl1-note{font-size:13px;color:#94a3b8;margin-top:20px;display:block;}\n                          @media(max-width:500px){\n                            .nl1-form{flex-direction:column;}\n                            .nl1-btn{width:100%;}\n                            .nl1-card{padding:40px 20px;}\n                          }\n                        </style>\n                        <section class=\"nl1-wrap\">\n                          <div class=\"nl1-card\">\n                            <div class=\"nl1-icon\">📩</div>\n                            <h2 class=\"nl1-title\">Subscribe to our Newsletter</h2>\n                            <p class=\"nl1-desc\">Get the latest news, articles, and resources, sent to your inbox weekly.</p>\n                            <form class=\"nl1-form\" onsubmit=\"event.preventDefault();\">\n                              <input type=\"email\" class=\"nl1-input\" placeholder=\"Enter your email address\" required>\n                              <button type=\"submit\" class=\"nl1-btn\">Subscribe</button>\n                            </form>\n                            <span class=\"nl1-note\">We care about your data. Read our Privacy Policy.</span>\n                          </div>\n                        </section>\n                    "
