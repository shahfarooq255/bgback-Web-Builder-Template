      "html": "\n                        <style>\n                          .nl3-wrap{padding:60px 20px;background:#09090b;font-family:sans-serif;}\n                          .nl3-inner{max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:40px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);padding:40px 50px;border-radius:20px;}\n                          .nl3-text{flex:1;}\n                          .nl3-title{font-size:24px;font-weight:700;color:#fff;margin:0 0 10px;}\n                          .nl3-desc{font-size:15px;color:#a1a1aa;margin:0;}\n                          .nl3-form{flex:1;display:flex;gap:10px;background:#18181b;padding:8px;border-radius:50px;border:1px solid rgba(255,255,255,0.1);box-shadow:inset 0 2px 4px rgba(0,0,0,0.2);}\n                          .nl3-input{flex:1;background:transparent;border:none;padding:10px 20px;color:#fff;font-size:15px;outline:none;font-family:inherit;}\n                          .nl3-input::placeholder{color:#71717a;}\n                          .nl3-btn{padding:12px 28px;background:linear-gradient(90deg,#a855f7,#6366f1);color:#fff;border:none;border-radius:40px;font-size:15px;font-weight:600;cursor:pointer;transition:opacity 0.3s;font-family:inherit;white-space:nowrap;}\n                          .nl3-btn:hover{opacity:0.9;}\n                          @media(max-width:800px){\n                            .nl3-inner{flex-direction:column;text-align:center;padding:40px 25px;}\n                            .nl3-form{width:100%;flex-direction:column;border-radius:15px;background:transparent;border:none;padding:0;box-shadow:none;}\n                            .nl3-input{background:#18181b;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:15px;}\n                            .nl3-btn{border-radius:10px;width:100%;}\n                          }\n                        </style>\n                        <section class=\"nl3-wrap\">\n                          <div class=\"nl3-inner\">\n                            <div class=\"nl3-text\">\n                              <h2 class=\"nl3-title\">Never miss an update.</h2>\n                              <p class=\"nl3-desc\">We respect your inbox. Only quality content, no spam.</p>\n                            </div>\n                            <form class=\"nl3-form\" onsubmit=\"event.preventDefault();\">\n                              <input type=\"email\" class=\"nl3-input\" placeholder=\"your@email.com\" required>\n                              <button type=\"submit\" class=\"nl3-btn\">Subscribe</button>\n                            </form>\n                          </div>\n                        </section>\n                    "
