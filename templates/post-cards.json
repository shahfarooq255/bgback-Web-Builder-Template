      "id": "post-cards-1",
      "name": "Glassmorphism Card",
      "description": "Modern glass effect post card with floating tags",
      "html": "\n                        <style>\n                          .pc1-wrap{padding:80px 20px;background:#0f172a url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1600&auto=format&fit=crop') center/cover;font-family:sans-serif;}\n                          .pc1-card{background:rgba(255,255,255,0.05);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:30px;max-width:400px;margin:0 auto;box-shadow:0 10px 40px rgba(0,0,0,0.3);}\n                          .pc1-img{height:220px;background:url('https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=600&auto=format&fit=crop') center/cover;border-radius:16px;margin-bottom:20px;position:relative;}\n                          .pc1-tag{position:absolute;top:15px;left:15px;background:rgba(255,255,255,0.9);color:#0f172a;font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;letter-spacing:1px;}\n                          .pc1-title{color:#fff;font-size:24px;font-weight:800;margin:0 0 10px 0;line-height:1.3;}\n                          .pc1-desc{color:#94a3b8;font-size:15px;line-height:1.6;margin:0 0 25px 0;}\n                          .pc1-footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,0.1);padding-top:20px;}\n                          .pc1-author{display:flex;align-items:center;gap:10px;}\n                          .pc1-avatar{width:36px;height:36px;border-radius:50%;background:#ddd;}\n                          @media(max-width:480px){.pc1-card{padding:20px;} .pc1-img{height:180px;}}\n                        </style>\n                        <section class=\"pc1-wrap\">\n                            <div class=\"pc1-card\">\n                                <div class=\"pc1-img\">\n                                    <span class=\"pc1-tag\">TECHNOLOGY</span>\n                                </div>\n                                <h3 class=\"pc1-title\">The Future of Retro Computing</h3>\n                                <p class=\"pc1-desc\">Exploring why vintage tech is making a massive comeback among modern developers and hobbyists.</p>\n                                <div class=\"pc1-footer\">\n                                    <div class=\"pc1-author\">\n                                        <div class=\"pc1-avatar\" style=\"background:url('https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=100&auto=format&fit=crop') center/cover;\"></div>\n                                        <div style=\"color:#e2e8f0;font-size:13px;font-weight:600;\">Alex Mason</div>\n                                    </div>\n                                    <span style=\"color:#64748b;font-size:13px;\">Oct 24</span>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
