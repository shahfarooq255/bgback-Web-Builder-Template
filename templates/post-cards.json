    },
    {
      "id": "post-cards-3",
      "name": "Overlap Header Card",
      "description": "Image overlaps the card body for a creative aesthetic",
      "html": "\n                        <style>\n                          .pc3-wrap{padding:100px 20px;background:#e2e8f0;font-family:sans-serif;}\n                          .pc3-container{max-width:420px;margin:0 auto;position:relative;padding-top:100px;}\n                          .pc3-img{position:absolute;top:0;left:20px;right:20px;height:220px;background:url('https://images.unsplash.com/photo-1600132806370-bf17e65e942f?q=80&w=600&auto=format&fit=crop') center/cover;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.15);z-index:2;}\n                          .pc3-card{background:#fff;border-radius:20px;padding:140px 30px 40px 30px;box-shadow:0 10px 30px rgba(0,0,0,0.05);position:relative;z-index:1;}\n                          .pc3-title{color:#1e293b;font-size:26px;font-weight:800;margin:0 0 15px 0;line-height:1.2;text-align:center;}\n                          .pc3-desc{color:#64748b;font-size:16px;line-height:1.6;margin:0 0 25px 0;text-align:center;}\n                          .pc3-meta{display:flex;justify-content:center;gap:15px;color:#94a3b8;font-size:14px;font-weight:500;}\n                          @media(max-width:480px){.pc3-card{padding:120px 20px 30px 20px;} .pc3-img{height:180px;}}\n                        </style>\n                        <section class=\"pc3-wrap\">\n                            <div class=\"pc3-container\">\n                                <div class=\"pc3-img\"></div>\n                                <div class=\"pc3-card\">\n                                    <h3 class=\"pc3-title\">The Art of Storytelling</h3>\n                                    <p class=\"pc3-desc\">Why compelling narratives are the secret weapon for modern brands and marketing agencies.</p>\n                                    <div class=\"pc3-meta\">\n                                        <span>By Elena Roe</span>\n                                        <span>•</span>\n                                        <span>5 min read</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "post-cards-4",
      "name": "Cyberpunk Neon Card",
      "description": "Dark mode card with neon borders and striking typography",
      "html": "\n                        <style>\n                          .pc4-wrap{padding:80px 20px;background:#050505;font-family:monospace;}\n                          .pc4-card{background:#111;border:1px solid #333;border-radius:0;padding:25px;max-width:400px;margin:0 auto;position:relative;overflow:hidden;}\n                          .pc4-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg, #f12711, #f5af19);}\n                          .pc4-img{height:200px;background:url('https://images.unsplash.com/photo-1605810230434-7631ac76ec81?q=80&w=600&auto=format&fit=crop') center/cover;filter:grayscale(100%) contrast(1.2);transition:filter 0.4s;margin-bottom:20px;}\n                          .pc4-card:hover .pc4-img{filter:grayscale(0%);}\n                          .pc4-tag{color:#f5af19;font-size:12px;text-transform:uppercase;letter-spacing:2px;margin-bottom:10px;display:block;}\n                          .pc4-title{color:#fff;font-size:22px;font-weight:700;margin:0 0 15px 0;line-height:1.4;}\n                          .pc4-btn{display:inline-block;padding:10px 20px;background:transparent;color:#fff;border:1px solid #f12711;font-size:14px;text-decoration:none;text-transform:uppercase;letter-spacing:1px;transition:0.3s;}\n                          .pc4-btn:hover{background:#f12711;color:#000;}\n                        </style>\n                        <section class=\"pc4-wrap\">\n                            <div class=\"pc4-card\">\n                                <div class=\"pc4-img\"></div>\n                                <span class=\"pc4-tag\">// SYSTEM UPDATE</span>\n                                <h3 class=\"pc4-title\">Embracing the AI Revolution in Cyber Security</h3>\n                                <br>\n                                <a href=\"#\" class=\"pc4-btn\">Execute Read</a>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "post-cards-5",
      "name": "Interactive Hover Card",
      "description": "Content slides up on hover, revealing the description",
      "html": "\n                        <style>\n                          .pc5-wrap{padding:80px 20px;background:#f3f4f6;font-family:sans-serif;}\n                          .pc5-card{max-width:380px;height:450px;margin:0 auto;border-radius:20px;overflow:hidden;position:relative;background:url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop') center/cover;box-shadow:0 15px 35px rgba(0,0,0,0.15);}\n                          .pc5-overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);}\n                          .pc5-content{position:absolute;bottom:0;left:0;width:100%;padding:30px;box-sizing:border-box;transform:translateY(70px);transition:transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);}\n                          .pc5-card:hover .pc5-content{transform:translateY(0);}\n                          .pc5-title{color:#fff;font-size:24px;font-weight:800;margin:0 0 10px 0;line-height:1.2;}\n                          .pc5-desc{color:#d1d5db;font-size:15px;line-height:1.6;margin:0 0 20px 0;opacity:0;transition:opacity 0.4s;transition-delay:0.1s;}\n                          .pc5-card:hover .pc5-desc{opacity:1;}\n                          .pc5-tag{display:inline-block;padding:5px 12px;background:#10b981;color:#fff;font-size:11px;font-weight:700;border-radius:12px;text-transform:uppercase;letter-spacing:1px;margin-bottom:15px;}\n                          @media(max-width:480px){.pc5-content{transform:translateY(0);} .pc5-desc{opacity:1;} .pc5-card{height:400px;}}\n                        </style>\n                        <section class=\"pc5-wrap\">\n                            <div class=\"pc5-card\">\n                                <div class=\"pc5-overlay\"></div>\n                                <div class=\"pc5-content\">\n                                    <span class=\"pc5-tag\">Travel</span>\n                                    <h3 class=\"pc5-title\">10 Hidden Beaches You Must Visit</h3>\n                                    <p class=\"pc5-desc\">Escape the crowds and discover pristine coastlines that remain untouched by commercial tourism.</p>\n                                </div>\n                            </div>\n                        </section>\n                    "
    }
