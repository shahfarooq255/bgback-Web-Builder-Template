    {
      "id": "features-1",
      "name": "Modern Grid Features",
      "description": "Clean 3-column grid with glowing icons",
      "html": "\n                        <style>\n                          .ft1-wrap{padding:80px 20px;font-family:sans-serif;background:#fff;}\n                          .ft1-inner{max-width:1200px;margin:0 auto;text-align:center;}\n                          .ft1-title{font-size:clamp(28px,4vw,36px);font-weight:800;color:#111;margin:0 0 15px 0;}\n                          .ft1-desc{font-size:clamp(15px,2.5vw,16px);color:#666;margin:0 auto 60px auto;max-width:600px;}\n                          .ft1-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:30px;text-align:left;}\n                          .ft1-card{padding:30px;background:#f8f9fa;border-radius:16px;transition:transform 0.3s;border:1px solid #eee;}\n                          @media(max-width:768px){.ft1-wrap{padding:50px 20px;} .ft1-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"ft1-wrap\">\n                            <div class=\"ft1-inner\">\n                                <h2 class=\"ft1-title\">Why Choose Us?</h2>\n                                <p class=\"ft1-desc\">Discover the powerful features that make our platform the perfect choice for your business.</p>\n                                \n                                <div class=\"ft1-grid\">\n                                    <!-- Feature 1 -->\n                                    <div class=\"ft1-card\">\n                                        <div style=\"width: 50px; height: 50px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;\">🚀</div>\n                                        <h3 style=\"font-size: 20px; font-weight: 700; color: #111; margin: 0 0 10px 0;\">Lightning Fast</h3>\n                                        <p style=\"color: #666; font-size: 15px; line-height: 1.6; margin: 0;\">Optimized for speed. Our globally distributed CDN ensures your content loads instantly everywhere.</p>\n                                    </div>\n                                    <!-- Feature 2 -->\n                                    <div class=\"ft1-card\">\n                                        <div style=\"width: 50px; height: 50px; background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;\">🛡️</div>\n                                        <h3 style=\"font-size: 20px; font-weight: 700; color: #111; margin: 0 0 10px 0;\">Secure by Default</h3>\n                                        <p style=\"color: #666; font-size: 15px; line-height: 1.6; margin: 0;\">Enterprise-grade security with end-to-end encryption to keep your data safe and compliant.</p>\n                                    </div>\n                                    <!-- Feature 3 -->\n                                    <div class=\"ft1-card\">\n                                        <div style=\"width: 50px; height: 50px; background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%); border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;\">🔄</div>\n                                        <h3 style=\"font-size: 20px; font-weight: 700; color: #111; margin: 0 0 10px 0;\">Auto Sync</h3>\n                                        <p style=\"color: #666; font-size: 15px; line-height: 1.6; margin: 0;\">Seamlessly sync your data across all devices in real-time without manual intervention.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "features-2",
      "name": "Split Layout Benefits",
      "description": "Left side sticky text, right side scrolling cards",
      "html": "\n                        <style>\n                          .ft2-wrap{padding:100px 20px;background:#0f172a;font-family:sans-serif;}\n                          .ft2-inner{max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:60px;}\n                          .ft2-left{flex:1;min-width:300px;}\n                          .ft2-sticky{position:sticky;top:40px;}\n                          .ft2-right{flex:1;min-width:300px;display:flex;flex-direction:column;gap:20px;}\n                          .ft2-title{color:#f8fafc;font-size:clamp(32px,5vw,42px);font-weight:800;margin:15px 0 20px 0;line-height:1.2;}\n                          .ft2-desc{color:#94a3b8;font-size:clamp(15px,2.5vw,18px);line-height:1.6;margin:0 0 30px 0;}\n                          .ft2-card{padding:40px;background:#1e293b;border-radius:20px;border:1px solid #334155;}\n                          @media(max-width:768px){.ft2-wrap{padding:60px 20px;} .ft2-inner{gap:40px;} .ft2-sticky{position:static;text-align:center;} .ft2-card{padding:30px;}}\n                        </style>\n                        <section class=\"ft2-wrap\">\n                            <div class=\"ft2-inner\">\n                                <div class=\"ft2-left\">\n                                    <div class=\"ft2-sticky\">\n                                        <span style=\"color: #38bdf8; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 2px;\">Powerful Tools</span>\n                                        <h2 class=\"ft2-title\">Everything you need to scale</h2>\n                                        <p class=\"ft2-desc\">Stop switching between multiple apps. We bring all the core functionalities into one unified ecosystem.</p>\n                                        <a href=\"#\" style=\"display: inline-block; padding: 12px 28px; background: #38bdf8; color: #0f172a; font-weight: 700; border-radius: 30px; text-decoration: none;\">Explore Features</a>\n                                    </div>\n                                </div>\n                                <div class=\"ft2-right\">\n                                    <div class=\"ft2-card\">\n                                        <h3 style=\"color: #f8fafc; font-size: 22px; font-weight: 700; margin: 0 0 10px 0;\">Intelligent Automation</h3>\n                                        <p style=\"color: #94a3b8; font-size: 16px; line-height: 1.6; margin: 0;\">Automate repetitive tasks and workflows with our AI-powered engine.</p>\n                                    </div>\n                                    <div class=\"ft2-card\">\n                                        <h3 style=\"color: #f8fafc; font-size: 22px; font-weight: 700; margin: 0 0 10px 0;\">Advanced Analytics</h3>\n                                        <p style=\"color: #94a3b8; font-size: 16px; line-height: 1.6; margin: 0;\">Gain deep insights into user behavior and business metrics in real-time.</p>\n                                    </div>\n                                    <div class=\"ft2-card\">\n                                        <h3 style=\"color: #f8fafc; font-size: 22px; font-weight: 700; margin: 0 0 10px 0;\">Team Collaboration</h3>\n                                        <p style=\"color: #94a3b8; font-size: 16px; line-height: 1.6; margin: 0;\">Work seamlessly with your team with live editing and instant messaging.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "features-3",
      "name": "Dark Glowing Features",
      "description": "Modern dark theme with neon glowing borders",
      "html": "\n                        <style>\n                          .ft3-wrap{padding:90px 20px;background:#000;font-family:sans-serif;}\n                          .ft3-title{color:#fff;font-size:clamp(36px,5vw,48px);font-weight:900;margin:0;}\n                          .ft3-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:25px;}\n                          @media(max-width:768px){.ft3-wrap{padding:50px 20px;} .ft3-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"ft3-wrap\">\n                            <div style=\"max-width: 1200px; margin: 0 auto;\">\n                                <div style=\"text-align: center; margin-bottom: 60px;\">\n                                    <h2 class=\"ft3-title\">Built for <span style=\"background: linear-gradient(to right, #00f2fe, #4facfe); -webkit-background-clip: text; color: transparent;\">Performance</span></h2>\n                                </div>\n                                <div class=\"ft3-grid\">\n                                    <div style=\"padding: 30px; background: #111; border-radius: 15px; border: 1px solid #222; box-shadow: 0 0 30px rgba(0, 242, 254, 0.05);\">\n                                        <h3 style=\"color: #fff; font-size: 20px; font-weight: 700; margin: 0 0 10px 0;\">Global CDN</h3>\n                                        <p style=\"color: #888; font-size: 15px; line-height: 1.5; margin: 0;\">Deliver content instantly across 200+ edge locations worldwide.</p>\n                                    </div>\n                                    <div style=\"padding: 30px; background: #111; border-radius: 15px; border: 1px solid #222; box-shadow: 0 0 30px rgba(79, 172, 254, 0.05);\">\n                                        <h3 style=\"color: #fff; font-size: 20px; font-weight: 700; margin: 0 0 10px 0;\">DDoS Protection</h3>\n                                        <p style=\"color: #888; font-size: 15px; line-height: 1.5; margin: 0;\">Always-on mitigation to keep your applications running smoothly.</p>\n                                    </div>\n                                    <div style=\"padding: 30px; background: #111; border-radius: 15px; border: 1px solid #222; box-shadow: 0 0 30px rgba(0, 242, 254, 0.05);\">\n                                        <h3 style=\"color: #fff; font-size: 20px; font-weight: 700; margin: 0 0 10px 0;\">Edge Computing</h3>\n                                        <p style=\"color: #888; font-size: 15px; line-height: 1.5; margin: 0;\">Run your backend logic closest to your users for zero latency.</p>\n                                    </div>\n                                    <div style=\"padding: 30px; background: #111; border-radius: 15px; border: 1px solid #222; box-shadow: 0 0 30px rgba(79, 172, 254, 0.05);\">\n                                        <h3 style=\"color: #fff; font-size: 20px; font-weight: 700; margin: 0 0 10px 0;\">Real-time Logs</h3>\n                                        <p style=\"color: #888; font-size: 15px; line-height: 1.5; margin: 0;\">Monitor traffic and performance metrics as they happen.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "features-4",
      "name": "Bento Box Features",
      "description": "Modern asymmetric grid layout for multiple features",
      "html": "\n                        <style>\n                          .ft4-wrap{padding:80px 20px;background:#f5f5f7;font-family:sans-serif;}\n                          .ft4-title{font-size:clamp(32px,5vw,40px);font-weight:700;color:#1d1d1f;margin:0;}\n                          .ft4-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;grid-auto-rows:250px;}\n                          .ft4-box1{grid-column:span 2;background:#fff;border-radius:24px;padding:40px;box-shadow:0 10px 30px rgba(0,0,0,0.02);display:flex;flex-direction:column;justify-content:center;}\n                          .ft4-box2{background:#1d1d1f;border-radius:24px;padding:30px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;}\n                          .ft4-box3{background:#fff;border-radius:24px;padding:30px;box-shadow:0 10px 30px rgba(0,0,0,0.02);display:flex;flex-direction:column;justify-content:space-between;}\n                          .ft4-box4{grid-column:span 2;background:linear-gradient(120deg, #fdfbfb 0%, #ebedee 100%);border-radius:24px;padding:40px;box-shadow:0 10px 30px rgba(0,0,0,0.02);display:flex;flex-direction:column;justify-content:center;}\n                          @media(max-width:900px){.ft4-grid{grid-template-columns:repeat(2,1fr);}}\n                          @media(max-width:600px){.ft4-wrap{padding:50px 20px;} .ft4-grid{grid-template-columns:1fr;grid-auto-rows:auto;gap:15px;} .ft4-box1, .ft4-box4{grid-column:span 1;padding:30px;}}\n                        </style>\n                        <section class=\"ft4-wrap\">\n                            <div style=\"max-width: 1000px; margin: 0 auto;\">\n                                <div style=\"text-align: center; margin-bottom: 50px;\">\n                                    <h2 class=\"ft4-title\">Packed with everything.</h2>\n                                </div>\n                                <div class=\"ft4-grid\">\n                                    <div class=\"ft4-box1\">\n                                        <h3 style=\"font-size: 28px; font-weight: 700; color: #1d1d1f; margin: 0 0 10px 0;\">Pro Camera System</h3>\n                                        <p style=\"font-size: 16px; color: #86868b; margin: 0;\">Capture incredible detail with our advanced computational photography algorithms.</p>\n                                    </div>\n                                    <div class=\"ft4-box2\">\n                                        <div style=\"font-size: 32px;\">🔋</div>\n                                        <div>\n                                            <h3 style=\"font-size: 20px; font-weight: 700; margin: 0 0 5px 0;\">All-day Battery</h3>\n                                            <p style=\"font-size: 14px; color: #a1a1a6; margin: 0;\">Up to 24 hours.</p>\n                                        </div>\n                                    </div>\n                                    <div class=\"ft4-box3\">\n                                        <div style=\"font-size: 32px;\">⚡</div>\n                                        <div>\n                                            <h3 style=\"font-size: 20px; font-weight: 700; margin: 0 0 5px 0; color: #1d1d1f;\">Ultra Fast</h3>\n                                            <p style=\"font-size: 14px; color: #86868b; margin: 0;\">A16 Bionic Chip.</p>\n                                        </div>\n                                    </div>\n                                    <div class=\"ft4-box4\">\n                                        <h3 style=\"font-size: 28px; font-weight: 700; color: #1d1d1f; margin: 0 0 10px 0;\">Ceramic Shield</h3>\n                                        <p style=\"font-size: 16px; color: #86868b; margin: 0;\">Tougher than any smartphone glass. Splash, water, and dust resistant.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n                    "
    },
    {
      "id": "features-5",
      "name": "Alternating Features (Zig-Zag)",
      "description": "Classic zig-zag layout with images and text",
      "html": "\n                        <style>\n                          .ft5-wrap{background:#ffffff;font-family:sans-serif;overflow:hidden;}\n                          .ft5-row{display:flex;flex-wrap:wrap;align-items:center;max-width:1200px;margin:0 auto;padding:80px 20px;gap:40px;}\n                          .ft5-rev{flex-wrap:wrap-reverse;}\n                          .ft5-col{flex:1;min-width:300px;}\n                          .ft5-title{font-size:clamp(28px,4vw,36px);font-weight:800;color:#222;margin:15px 0 20px 0;line-height:1.2;}\n                          .ft5-desc{font-size:clamp(15px,2.5vw,18px);color:#666;line-height:1.6;margin:0 0 30px 0;}\n                          .ft5-img{width:100%;height:400px;border-radius:20px;box-shadow:0 20px 40px rgba(0,0,0,0.1);background-position:center;background-size:cover;}\n                          @media(max-width:768px){.ft5-row{padding:50px 20px;gap:30px;} .ft5-img{height:300px;}}\n                        </style>\n                        <section class=\"ft5-wrap\">\n                            <div class=\"ft5-row\">\n                                <div class=\"ft5-col\">\n                                    <span style=\"color: #e67e22; font-weight: 700; font-size: 14px; text-transform: uppercase;\">Cloud Storage</span>\n                                    <h2 class=\"ft5-title\">Store everything securely</h2>\n                                    <p class=\"ft5-desc\">Keep all your important files, photos, and documents safely backed up in the cloud. Access them from any device, anywhere in the world.</p>\n                                    <ul style=\"list-style: none; padding: 0; margin: 0; color: #444; font-size: 16px;\">\n                                        <li style=\"margin-bottom: 10px;\">✓ 256-bit AES encryption</li>\n                                        <li style=\"margin-bottom: 10px;\">✓ Automatic daily backups</li>\n                                        <li>✓ Unlimited bandwidth</li>\n                                    </ul>\n                                </div>\n                                <div class=\"ft5-col\">\n                                    <div class=\"ft5-img\" style=\"background-image: url('https://images.unsplash.com/photo-1544197150-b99a580bb7a8?q=80&w=1000&auto=format&fit=crop');\"></div>\n                                </div>\n                            </div>\n                            <div class=\"ft5-row ft5-rev\">\n                                <div class=\"ft5-col\">\n                                    <div class=\"ft5-img\" style=\"background-image: url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1000&auto=format&fit=crop');\"></div>\n                                </div>\n                                <div class=\"ft5-col\">\n                                    <span style=\"color: #9b59b6; font-weight: 700; font-size: 14px; text-transform: uppercase;\">Collaboration</span>\n                                    <h2 class=\"ft5-title\">Work together, faster</h2>\n                                    <p class=\"ft5-desc\">Invite your team members, share folders, and collaborate on documents in real-time. Leave comments and track changes effortlessly.</p>\n                                    <button style=\"padding: 12px 25px; background: #9b59b6; color: #fff; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px;\">Try it for free</button>\n                                </div>\n                            </div>\n                        </section>\n                    "
    }
