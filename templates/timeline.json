      "id": "tl-1",
      "name": "Vertical Center Timeline",
      "html": "\n<style>\n.tl1{padding:100px 20px;background:#fafafa;font-family:'Inter',sans-serif}\n.tl1 h2{text-align:center;font-size:clamp(32px,5vw,48px);font-weight:800;color:#111;margin:0 0 70px;letter-spacing:-1px}\n.tl1-list{max-width:800px;margin:0 auto;position:relative}\n.tl1-list::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,#6366f1,#a78bfa);transform:translateX(-50%)}\n.tl1-item{display:flex;justify-content:flex-end;padding-right:calc(50% + 40px);margin-bottom:60px;position:relative}\n.tl1-item:nth-child(even){justify-content:flex-start;padding-right:0;padding-left:calc(50% + 40px)}\n.tl1-dot{position:absolute;left:50%;top:24px;width:18px;height:18px;background:#6366f1;border-radius:50%;border:4px solid #fafafa;transform:translateX(-50%);z-index:2}\n.tl1-card{background:#fff;border-radius:16px;padding:25px 30px;box-shadow:0 4px 20px rgba(0,0,0,.06);max-width:320px;border:1px solid #eee}\n.tl1-year{font-size:12px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:10px}\n.tl1-title{font-size:18px;font-weight:700;color:#111;margin:0 0 8px}\n.tl1-desc{font-size:14px;color:#666;line-height:1.6;margin:0}\n@media(max-width:768px){.tl1-list::before{left:20px}.tl1-item,.tl1-item:nth-child(even){justify-content:flex-start;padding:0 0 0 55px}.tl1-dot{left:20px}}\n</style>\n<section class=\"tl1\">\n  <h2>Our Journey</h2>\n  <div class=\"tl1-list\">\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2010</div><h3 class=\"tl1-title\">Company Founded</h3><p class=\"tl1-desc\">Started in a small garage with a big dream and three passionate co-founders.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2013</div><h3 class=\"tl1-title\">First Major Client</h3><p class=\"tl1-desc\">Secured a Fortune 500 client — a turning point that validated our vision.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2017</div><h3 class=\"tl1-title\">Global Expansion</h3><p class=\"tl1-desc\">Opened offices in 10 countries and crossed 1 million users worldwide.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2024</div><h3 class=\"tl1-title\">AI Integration</h3><p class=\"tl1-desc\">Launched our AI-powered platform, redefining how teams build products.</p></div></div>\n  </div>\n</section>"
    },
    {
      "id": "tl-2",
      "name": "Horizontal Scroll Timeline",
      "html": "\n<style>\n.tl2{padding:80px 0;background:#0a0a0a;font-family:'Inter',sans-serif;overflow:hidden}\n.tl2 h2{text-align:center;color:#fff;font-size:clamp(28px,4vw,42px);font-weight:800;margin:0 0 60px;padding:0 20px}\n.tl2-track{display:flex;gap:0;padding:0 40px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:40px}\n.tl2-track::-webkit-scrollbar{display:none}\n.tl2-item{flex-shrink:0;width:280px;scroll-snap-align:start;position:relative;padding:0 30px 0 0}\n.tl2-item::after{content:'';position:absolute;top:28px;right:0;left:60px;height:2px;background:#27272a}\n.tl2-item:last-child::after{display:none}\n.tl2-circle{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;margin-bottom:25px;flex-shrink:0;position:relative;z-index:2}\n.tl2-year{font-size:12px;color:#6366f1;font-weight:700;letter-spacing:2px;margin-bottom:10px}\n.tl2-title{color:#fff;font-size:17px;font-weight:700;margin:0 0 10px}\n.tl2-desc{color:#888;font-size:13px;line-height:1.6;margin:0}\n</style>\n<section class=\"tl2\">\n  <h2>Milestones & History</h2>\n  <div class=\"tl2-track\">\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">1</div><div class=\"tl2-year\">2008</div><h3 class=\"tl2-title\">The Idea Born</h3><p class=\"tl2-desc\">A simple problem sparked an innovative idea that would change an industry.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">2</div><div class=\"tl2-year\">2011</div><h3 class=\"tl2-title\">Seed Funding</h3><p class=\"tl2-desc\">Raised $2M in seed funding to build our initial product and team.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">3</div><div class=\"tl2-year\">2015</div><h3 class=\"tl2-title\">Product Launch</h3><p class=\"tl2-desc\">Shipped v1.0 to 50,000 beta users, receiving overwhelmingly positive feedback.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">4</div><div class=\"tl2-year\">2019</div><h3 class=\"tl2-title\">Series B: $40M</h3><p class=\"tl2-desc\">Secured major funding to accelerate global growth and product development.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">5</div><div class=\"tl2-year\">2024</div><h3 class=\"tl2-title\">100M Users</h3><p class=\"tl2-desc\">Celebrating 100 million users across 180 countries — a global phenomenon.</p></div>\n  </div>\n</section>"
    }
