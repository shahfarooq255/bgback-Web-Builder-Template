  "templates": [
    {
      "id": "tl-1",
      "name": "Vertical Center Timeline",
      "html": "\n<style>\n.tl1{padding:100px 20px;background:#fafafa;font-family:'Inter',sans-serif}\n.tl1 h2{text-align:center;font-size:clamp(32px,5vw,48px);font-weight:800;color:#111;margin:0 0 70px;letter-spacing:-1px}\n.tl1-list{max-width:800px;margin:0 auto;position:relative}\n.tl1-list::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,#6366f1,#a78bfa);transform:translateX(-50%)}\n.tl1-item{display:flex;justify-content:flex-end;padding-right:calc(50% + 40px);margin-bottom:60px;position:relative}\n.tl1-item:nth-child(even){justify-content:flex-start;padding-right:0;padding-left:calc(50% + 40px)}\n.tl1-dot{position:absolute;left:50%;top:24px;width:18px;height:18px;background:#6366f1;border-radius:50%;border:4px solid #fafafa;transform:translateX(-50%);z-index:2}\n.tl1-card{background:#fff;border-radius:16px;padding:25px 30px;box-shadow:0 4px 20px rgba(0,0,0,.06);max-width:320px;border:1px solid #eee}\n.tl1-year{font-size:12px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:10px}\n.tl1-title{font-size:18px;font-weight:700;color:#111;margin:0 0 8px}\n.tl1-desc{font-size:14px;color:#666;line-height:1.6;margin:0}\n@media(max-width:768px){.tl1-list::before{left:20px}.tl1-item,.tl1-item:nth-child(even){justify-content:flex-start;padding:0 0 0 55px}.tl1-dot{left:20px}}\n</style>\n<section class=\"tl1\">\n  <h2>Our Journey</h2>\n  <div class=\"tl1-list\">\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2010</div><h3 class=\"tl1-title\">Company Founded</h3><p class=\"tl1-desc\">Started in a small garage with a big dream and three passionate co-founders.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2013</div><h3 class=\"tl1-title\">First Major Client</h3><p class=\"tl1-desc\">Secured a Fortune 500 client — a turning point that validated our vision.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2017</div><h3 class=\"tl1-title\">Global Expansion</h3><p class=\"tl1-desc\">Opened offices in 10 countries and crossed 1 million users worldwide.</p></div></div>\n    <div class=\"tl1-item\"><div class=\"tl1-dot\"></div><div class=\"tl1-card\"><div class=\"tl1-year\">2024</div><h3 class=\"tl1-title\">AI Integration</h3><p class=\"tl1-desc\">Launched our AI-powered platform, redefining how teams build products.</p></div></div>\n  </div>\n</section>"
    },
    {
      "id": "tl-2",
      "name": "Horizontal Scroll Timeline",
      "html": "\n<style>\n.tl2{padding:80px 0;background:#0a0a0a;font-family:'Inter',sans-serif;overflow:hidden}\n.tl2 h2{text-align:center;color:#fff;font-size:clamp(28px,4vw,42px);font-weight:800;margin:0 0 60px;padding:0 20px}\n.tl2-track{display:flex;gap:0;padding:0 40px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:40px}\n.tl2-track::-webkit-scrollbar{display:none}\n.tl2-item{flex-shrink:0;width:280px;scroll-snap-align:start;position:relative;padding:0 30px 0 0}\n.tl2-item::after{content:'';position:absolute;top:28px;right:0;left:60px;height:2px;background:#27272a}\n.tl2-item:last-child::after{display:none}\n.tl2-circle{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;margin-bottom:25px;flex-shrink:0;position:relative;z-index:2}\n.tl2-year{font-size:12px;color:#6366f1;font-weight:700;letter-spacing:2px;margin-bottom:10px}\n.tl2-title{color:#fff;font-size:17px;font-weight:700;margin:0 0 10px}\n.tl2-desc{color:#888;font-size:13px;line-height:1.6;margin:0}\n</style>\n<section class=\"tl2\">\n  <h2>Milestones & History</h2>\n  <div class=\"tl2-track\">\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">1</div><div class=\"tl2-year\">2008</div><h3 class=\"tl2-title\">The Idea Born</h3><p class=\"tl2-desc\">A simple problem sparked an innovative idea that would change an industry.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">2</div><div class=\"tl2-year\">2011</div><h3 class=\"tl2-title\">Seed Funding</h3><p class=\"tl2-desc\">Raised $2M in seed funding to build our initial product and team.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">3</div><div class=\"tl2-year\">2015</div><h3 class=\"tl2-title\">Product Launch</h3><p class=\"tl2-desc\">Shipped v1.0 to 50,000 beta users, receiving overwhelmingly positive feedback.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">4</div><div class=\"tl2-year\">2019</div><h3 class=\"tl2-title\">Series B: $40M</h3><p class=\"tl2-desc\">Secured major funding to accelerate global growth and product development.</p></div>\n    <div class=\"tl2-item\"><div class=\"tl2-circle\">5</div><div class=\"tl2-year\">2024</div><h3 class=\"tl2-title\">100M Users</h3><p class=\"tl2-desc\">Celebrating 100 million users across 180 countries — a global phenomenon.</p></div>\n  </div>\n</section>"
    },
    {
      "id": "tl-3",
      "name": "Left-Aligned Minimalist",
      "html": "\n<style>\n.tl3{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.tl3-wrap{max-width:800px;margin:0 auto}\n.tl3-head{margin-bottom:60px}\n.tl3-head h2{font-size:36px;font-weight:800;color:#0f172a;margin:0 0 10px;letter-spacing:-1px}\n.tl3-head p{color:#64748b;font-size:16px;margin:0}\n.tl3-list{position:relative;padding-left:140px}\n.tl3-list::before{content:'';position:absolute;left:110px;top:0;bottom:0;width:2px;background:#e2e8f0}\n.tl3-item{position:relative;margin-bottom:50px}\n.tl3-item:last-child{margin-bottom:0}\n.tl3-year{position:absolute;left:-140px;top:2px;width:90px;text-align:right;font-size:18px;font-weight:900;color:#6366f1}\n.tl3-dot{position:absolute;left:-35px;top:8px;width:12px;height:12px;background:#fff;border:3px solid #6366f1;border-radius:50%;box-shadow:0 0 0 4px #fff}\n.tl3-title{font-size:20px;font-weight:800;color:#0f172a;margin:0 0 10px;line-height:1.3}\n.tl3-desc{font-size:15px;color:#475569;line-height:1.7;margin:0}\n@media(max-width:600px){\n  .tl3-list{padding-left:30px}\n  .tl3-list::before{left:0}\n  .tl3-year{position:static;text-align:left;margin-bottom:10px;width:auto;font-size:16px}\n  .tl3-dot{left:-35px;top:30px}\n}\n</style>\n<section class=\"tl3\">\n  <div class=\"tl3-wrap\">\n    <div class=\"tl3-head\">\n      <h2>Company History</h2>\n      <p>How we went from a simple idea to a global enterprise.</p>\n    </div>\n    <div class=\"tl3-list\">\n      <div class=\"tl3-item\">\n        <div class=\"tl3-year\">2015</div><div class=\"tl3-dot\"></div>\n        <h3 class=\"tl3-title\">The Beginning</h3>\n        <p class=\"tl3-desc\">Founded in a small dorm room with the goal of making design tools accessible to everyone.</p>\n      </div>\n      <div class=\"tl3-item\">\n        <div class=\"tl3-year\">2018</div><div class=\"tl3-dot\"></div>\n        <h3 class=\"tl3-title\">Series A Funding</h3>\n        <p class=\"tl3-desc\">Secured $10 million to scale our engineering team and launch our second flagship product.</p>\n      </div>\n      <div class=\"tl3-item\">\n        <div class=\"tl3-year\">2021</div><div class=\"tl3-dot\"></div>\n        <h3 class=\"tl3-title\">Going Global</h3>\n        <p class=\"tl3-desc\">Opened offices in London, Tokyo, and Sydney, crossing the 1 million active users milestone.</p>\n      </div>\n      <div class=\"tl3-item\">\n        <div class=\"tl3-year\">2025</div><div class=\"tl3-dot\"></div>\n        <h3 class=\"tl3-title\">Market Leaders</h3>\n        <p class=\"tl3-desc\">Recognized as the #1 design tool globally, with a thriving community of over 10M creatives.</p>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "tl-4",
      "name": "Image & Text Alternating",
      "html": "\n<style>\n.tl4{padding:100px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.tl4-head{text-align:center;margin-bottom:80px}\n.tl4-head h2{font-size:clamp(32px,5vw,48px);font-weight:800;color:#0f172a;margin:0 0 15px}\n.tl4-head p{color:#64748b;font-size:16px}\n.tl4-list{max-width:1000px;margin:0 auto;position:relative}\n.tl4-list::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:#cbd5e1;transform:translateX(-50%);z-index:0}\n.tl4-item{display:flex;align-items:center;justify-content:space-between;margin-bottom:80px;position:relative;z-index:1}\n.tl4-item:last-child{margin-bottom:0}\n.tl4-item:nth-child(even){flex-direction:row-reverse}\n.tl4-content{width:45%;background:#fff;padding:40px;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,0.05)}\n.tl4-img{width:45%;height:300px;border-radius:20px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.1)}\n.tl4-img img{width:100%;height:100%;object-fit:cover}\n.tl4-dot{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:20px;height:20px;background:#fff;border:5px solid #10b981;border-radius:50%}\n.tl4-year{display:inline-block;padding:6px 16px;background:#d1fae5;color:#059669;border-radius:50px;font-size:13px;font-weight:800;margin-bottom:15px}\n.tl4-title{font-size:22px;font-weight:800;color:#0f172a;margin:0 0 15px}\n.tl4-desc{font-size:15px;color:#475569;line-height:1.7;margin:0}\n@media(max-width:768px){\n  .tl4-list::before{left:20px}\n  .tl4-item,.tl4-item:nth-child(even){flex-direction:column;align-items:flex-start;padding-left:50px;margin-bottom:50px}\n  .tl4-content,.tl4-img{width:100%}\n  .tl4-content{margin-bottom:20px;padding:25px}\n  .tl4-dot{left:20px;top:30px}\n}\n</style>\n<section class=\"tl4\">\n  <div class=\"tl4-head\">\n    <h2>Our Evolution</h2>\n    <p>The key moments that shaped who we are today.</p>\n  </div>\n  <div class=\"tl4-list\">\n    <div class=\"tl4-item\">\n      <div class=\"tl4-dot\"></div>\n      <div class=\"tl4-content\">\n        <div class=\"tl4-year\">August 2018</div>\n        <h3 class=\"tl4-title\">The Concept</h3>\n        <p class=\"tl4-desc\">We sketched the very first prototype on a napkin. It was rough, but the vision was crystal clear.</p>\n      </div>\n      <div class=\"tl4-img\"><img src=\"https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80\" alt=\"Team\"></div>\n    </div>\n    <div class=\"tl4-item\">\n      <div class=\"tl4-dot\"></div>\n      <div class=\"tl4-content\">\n        <div class=\"tl4-year\">March 2020</div>\n        <h3 class=\"tl4-title\">First Office</h3>\n        <p class=\"tl4-desc\">Moved out of the garage and into our first official HQ in downtown Austin. The team grew to 15 people.</p>\n      </div>\n      <div class=\"tl4-img\"><img src=\"https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=800&q=80\" alt=\"Office\"></div>\n    </div>\n    <div class=\"tl4-item\">\n      <div class=\"tl4-dot\"></div>\n      <div class=\"tl4-content\">\n        <div class=\"tl4-year\">November 2024</div>\n        <h3 class=\"tl4-title\">Product V3 Launch</h3>\n        <p class=\"tl4-desc\">A complete rewrite of our core platform, introducing AI capabilities and a brand new design system.</p>\n      </div>\n      <div class=\"tl4-img\"><img src=\"https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=80\" alt=\"Product\"></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "tl-5",
      "name": "Glassmorphism Timeline",
      "html": "\n<style>\n.tl5{padding:100px 20px;background:linear-gradient(135deg,#0f172a,#1e1b4b);font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.tl5-blob{position:absolute;width:400px;height:400px;background:#6366f1;border-radius:50%;filter:blur(100px);opacity:0.3;top:10%;left:-100px}\n.tl5-blob2{background:#a78bfa;top:auto;bottom:10%;left:auto;right:-100px}\n.tl5-wrap{position:relative;z-index:2;max-width:800px;margin:0 auto}\n.tl5-head{text-align:center;margin-bottom:70px;color:#fff}\n.tl5-head h2{font-size:40px;font-weight:900;margin:0 0 15px}\n.tl5-list{position:relative;padding-left:40px}\n.tl5-list::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:rgba(255,255,255,0.1)}\n.tl5-item{position:relative;margin-bottom:40px;background:rgba(255,255,255,0.03);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:30px;transition:background 0.3s}\n.tl5-item:hover{background:rgba(255,255,255,0.06)}\n.tl5-item::before{content:'';position:absolute;left:-45px;top:35px;width:12px;height:12px;background:#8b5cf6;border-radius:50%;box-shadow:0 0 15px #8b5cf6}\n.tl5-date{font-size:14px;color:#a78bfa;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:10px}\n.tl5-title{font-size:22px;font-weight:800;color:#f8fafc;margin:0 0 10px}\n.tl5-desc{font-size:15px;color:rgba(255,255,255,0.6);line-height:1.7;margin:0}\n</style>\n<section class=\"tl5\">\n  <div class=\"tl5-blob\"></div>\n  <div class=\"tl5-blob tl5-blob2\"></div>\n  <div class=\"tl5-wrap\">\n    <div class=\"tl5-head\">\n      <h2>Roadmap 2026</h2>\n    </div>\n    <div class=\"tl5-list\">\n      <div class=\"tl5-item\">\n        <div class=\"tl5-date\">Q1 2026</div>\n        <h3 class=\"tl5-title\">Advanced AI Features</h3>\n        <p class=\"tl5-desc\">Rollout of predictive analytics and automated report generation for all enterprise tier customers.</p>\n      </div>\n      <div class=\"tl5-item\">\n        <div class=\"tl5-date\">Q2 2026</div>\n        <h3 class=\"tl5-title\">Mobile App Overhaul</h3>\n        <p class=\"tl5-desc\">A complete redesign of the iOS and Android apps, introducing a dark mode and faster sync capabilities.</p>\n      </div>\n      <div class=\"tl5-item\">\n        <div class=\"tl5-date\">Q3 2026</div>\n        <h3 class=\"tl5-title\">Global Data Centers</h3>\n        <p class=\"tl5-desc\">Opening new server locations in Frankfurt and Tokyo to improve latency for our international users.</p>\n      </div>\n      <div class=\"tl5-item\">\n        <div class=\"tl5-date\">Q4 2026</div>\n        <h3 class=\"tl5-title\">Open API Launch</h3>\n        <p class=\"tl5-desc\">Public release of our comprehensive REST API, allowing developers to build custom integrations seamlessly.</p>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "tl-6",
      "name": "Neo-Brutalism Timeline",
      "html": "\n<style>\n.tl6{padding:100px 20px;background:#fef9c3;font-family:'Inter',sans-serif}\n.tl6-wrap{max-width:900px;margin:0 auto}\n.tl6-title{font-size:clamp(40px,6vw,64px);font-weight:900;color:#000;text-transform:uppercase;margin:0 0 60px;letter-spacing:-2px;border-bottom:5px solid #000;padding-bottom:20px}\n.tl6-list{display:flex;flex-direction:column;gap:40px;position:relative}\n.tl6-list::before{content:'';position:absolute;left:30px;top:0;bottom:0;width:6px;background:#000}\n.tl6-item{display:flex;gap:30px;position:relative}\n.tl6-year-box{width:66px;height:66px;background:#fff;border:4px solid #000;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;z-index:2;flex-shrink:0;box-shadow:4px 4px 0 #000}\n.tl6-content{background:#fff;border:4px solid #000;box-shadow:8px 8px 0 #000;padding:25px 30px;flex:1;transition:transform 0.2s}\n.tl6-item:hover .tl6-content{transform:translate(-4px,-4px);box-shadow:12px 12px 0 #000}\n.tl6-content h3{font-size:24px;font-weight:900;text-transform:uppercase;margin:0 0 10px;color:#000}\n.tl6-content p{font-size:15px;color:#333;font-weight:600;line-height:1.6;margin:0}\n.tl6-c1 .tl6-content{background:#bbf7d0}\n.tl6-c2 .tl6-content{background:#bfdbfe}\n.tl6-c3 .tl6-content{background:#fbcfe8}\n@media(max-width:600px){\n  .tl6-list::before{left:20px}\n  .tl6-item{gap:15px}\n  .tl6-year-box{width:46px;height:46px;font-size:12px;margin-left:-3px}\n}\n</style>\n<section class=\"tl6\">\n  <div class=\"tl6-wrap\">\n    <h2 class=\"tl6-title\">Our Story</h2>\n    <div class=\"tl6-list\">\n      <div class=\"tl6-item tl6-c1\">\n        <div class=\"tl6-year-box\">'18</div>\n        <div class=\"tl6-content\">\n          <h3>The Launch</h3>\n          <p>We pushed the first version live at 3 AM. By noon, we had our first 100 paying customers.</p>\n        </div>\n      </div>\n      <div class=\"tl6-item tl6-c2\">\n        <div class=\"tl6-year-box\">'21</div>\n        <div class=\"tl6-content\">\n          <h3>Team of 50</h3>\n          <p>Outgrew our coworking space and moved into a real office. Reached $5M in annual recurring revenue.</p>\n        </div>\n      </div>\n      <div class=\"tl6-item tl6-c3\">\n        <div class=\"tl6-year-box\">'24</div>\n        <div class=\"tl6-content\">\n          <h3>Going Public</h3>\n          <p>Rang the bell on Wall Street. A huge milestone, but we still feel like we're just getting started.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "tl-7",
      "name": "Horizontal Alternating Cards",
      "html": "\n<style>\n.tl7{padding:120px 20px;background:#f8fafc;font-family:'Inter',sans-serif;overflow:hidden}\n.tl7 h2{text-align:center;font-size:36px;font-weight:800;color:#0f172a;margin:0 0 80px}\n.tl7-track{position:relative;max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px}\n.tl7-line{position:absolute;top:50%;left:0;right:0;height:4px;background:#e2e8f0;transform:translateY(-50%);z-index:0}\n.tl7-item{position:relative;z-index:1;width:250px;flex-shrink:0}\n.tl7-dot{width:20px;height:20px;background:#3b82f6;border:4px solid #fff;border-radius:50%;margin:0 auto;box-shadow:0 0 0 4px #e2e8f0}\n.tl7-card{background:#fff;padding:25px;border-radius:16px;box-shadow:0 10px 25px rgba(0,0,0,0.05);position:absolute;width:100%;left:0;opacity:0.9;transition:opacity 0.3s;border:1px solid #f1f5f9}\n.tl7-item:hover .tl7-card{opacity:1;border-color:#3b82f6}\n.tl7-item-up .tl7-card{bottom:40px}\n.tl7-item-down .tl7-card{top:40px}\n.tl7-item-up .tl7-card::after{content:'';position:absolute;bottom:-8px;left:50%;transform:translateX(-50%) rotate(45deg);width:16px;height:16px;background:#fff;border-right:1px solid #f1f5f9;border-bottom:1px solid #f1f5f9}\n.tl7-item-down .tl7-card::after{content:'';position:absolute;top:-8px;left:50%;transform:translateX(-50%) rotate(45deg);width:16px;height:16px;background:#fff;border-left:1px solid #f1f5f9;border-top:1px solid #f1f5f9}\n.tl7-date{font-size:14px;font-weight:700;color:#3b82f6;margin-bottom:8px}\n.tl7-title{font-size:18px;font-weight:800;color:#0f172a;margin:0 0 10px}\n.tl7-desc{font-size:14px;color:#64748b;line-height:1.6;margin:0}\n@media(max-width:992px){\n  .tl7-track{flex-direction:column;padding-left:20px;align-items:flex-start}\n  .tl7-line{top:0;bottom:0;left:29px;width:4px;height:auto;transform:none}\n  .tl7-item{width:100%;display:flex;align-items:center;margin-bottom:40px}\n  .tl7-dot{margin:0 20px 0 0}\n  .tl7-card{position:static;width:calc(100% - 60px)}\n  .tl7-item-up .tl7-card::after, .tl7-item-down .tl7-card::after{display:none}\n}\n</style>\n<section class=\"tl7\">\n  <h2>Project Roadmap</h2>\n  <div class=\"tl7-track\">\n    <div class=\"tl7-line\"></div>\n    <div class=\"tl7-item tl7-item-up\">\n      <div class=\"tl7-card\">\n        <div class=\"tl7-date\">Phase 1</div>\n        <h3 class=\"tl7-title\">Ideation</h3>\n        <p class=\"tl7-desc\">Brainstorming sessions, market research, and defining the core problem statement.</p>\n      </div>\n      <div class=\"tl7-dot\"></div>\n    </div>\n    <div class=\"tl7-item tl7-item-down\">\n      <div class=\"tl7-dot\"></div>\n      <div class=\"tl7-card\">\n        <div class=\"tl7-date\">Phase 2</div>\n        <h3 class=\"tl7-title\">Prototyping</h3>\n        <p class=\"tl7-desc\">Creating low-fidelity wireframes and interactive prototypes for user testing.</p>\n      </div>\n    </div>\n    <div class=\"tl7-item tl7-item-up\">\n      <div class=\"tl7-card\">\n        <div class=\"tl7-date\">Phase 3</div>\n        <h3 class=\"tl7-title\">Development</h3>\n        <p class=\"tl7-desc\">Writing the code, setting up databases, and integrating third-party APIs.</p>\n      </div>\n      <div class=\"tl7-dot\"></div>\n    </div>\n    <div class=\"tl7-item tl7-item-down\">\n      <div class=\"tl7-dot\"></div>\n      <div class=\"tl7-card\">\n        <div class=\"tl7-date\">Phase 4</div>\n        <h3 class=\"tl7-title\">Launch</h3>\n        <p class=\"tl7-desc\">Final QA testing, deployment to production, and official marketing push.</p>\n      </div>\n    </div>\n  </div>\n</section>"
    }
  ]
}
