  "templates": [
    {
      "id": "login-1",
      "name": "Clean Split Login",
      "description": "A modern two-panel login with image on the left and form on the right",
      "html": "\n                        <style>\n                          .lg1-wrap{min-height:500px;display:flex;font-family:sans-serif;}\n                          .lg1-left{flex:1;background:linear-gradient(145deg,#1e3a8a,#3b82f6);display:flex;flex-direction:column;justify-content:center;align-items:center;padding:60px 40px;color:#fff;text-align:center;}\n                          .lg1-left h2{font-size:clamp(28px,4vw,40px);font-weight:900;margin:0 0 15px;}\n                          .lg1-left p{font-size:16px;opacity:0.85;max-width:320px;line-height:1.6;margin:0;}\n                          .lg1-right{flex:1;background:#fff;display:flex;align-items:center;justify-content:center;padding:60px 40px;}\n                          .lg1-form{width:100%;max-width:380px;}\n                          .lg1-form h3{font-size:28px;font-weight:800;color:#0f172a;margin:0 0 8px;}\n                          .lg1-form p{font-size:14px;color:#64748b;margin:0 0 30px;}\n                          .lg1-group{margin-bottom:18px;}\n                          .lg1-group label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;}\n                          .lg1-input{width:100%;padding:13px 16px;border:1.5px solid #e5e7eb;border-radius:10px;font-size:15px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;box-sizing:border-box;}\n                          .lg1-input:focus{border-color:#3b82f6;}\n                          .lg1-forgot{text-align:right;margin-bottom:20px;}\n                          .lg1-forgot a{font-size:13px;color:#3b82f6;text-decoration:none;}\n                          .lg1-btn{width:100%;padding:14px;background:#3b82f6;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;transition:background 0.3s;}\n                          .lg1-btn:hover{background:#2563eb;}\n                          .lg1-divider{text-align:center;font-size:13px;color:#94a3b8;margin:20px 0;position:relative;}\n                          .lg1-divider::before{content:'';position:absolute;left:0;top:50%;width:45%;height:1px;background:#e5e7eb;}\n                          .lg1-divider::after{content:'';position:absolute;right:0;top:50%;width:45%;height:1px;background:#e5e7eb;}\n                          .lg1-signup{text-align:center;font-size:14px;color:#64748b;margin-top:20px;}\n                          .lg1-signup a{color:#3b82f6;font-weight:600;text-decoration:none;}\n                          @media(max-width:768px){\n                            .lg1-wrap{flex-direction:column;}\n                            .lg1-left{padding:40px 20px;}\n                            .lg1-right{padding:40px 20px;}\n                          }\n                        </style>\n                        <div class=\"lg1-wrap\">\n                          <div class=\"lg1-left\">\n                            <h2>Welcome Back!</h2>\n                            <p>Sign in to access your dashboard, manage projects, and connect with your team.</p>\n                          </div>\n                          <div class=\"lg1-right\">\n                            <div class=\"lg1-form\">\n                              <h3>Sign In</h3>\n                              <p>Don't have an account? <a href=\"#\">Sign up</a></p>\n                              <form onsubmit=\"event.preventDefault();\">\n                                <div class=\"lg1-group\"><label>Email Address</label><input class=\"lg1-input\" type=\"email\" placeholder=\"you@example.com\"></div>\n                                <div class=\"lg1-group\"><label>Password</label><input class=\"lg1-input\" type=\"password\" placeholder=\"••••••••\"></div>\n                                <div class=\"lg1-forgot\"><a href=\"#\">Forgot password?</a></div>\n                                <button type=\"submit\" class=\"lg1-btn\">Sign In</button>\n                                <div class=\"lg1-divider\">or</div>\n                                <div class=\"lg1-signup\">New here? <a href=\"#\">Create an account</a></div>\n                              </form>\n                            </div>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "login-2",
      "name": "Centered Card Login",
      "description": "A clean centered login card on a soft background",
      "html": "\n                        <style>\n                          .lg2-wrap{padding:80px 20px;background:#f1f5f9;font-family:sans-serif;display:flex;align-items:center;justify-content:center;min-height:500px;}\n                          .lg2-card{background:#fff;border-radius:20px;padding:50px 40px;width:100%;max-width:420px;box-shadow:0 20px 50px rgba(0,0,0,0.07);}\n                          .lg2-logo{font-size:28px;font-weight:900;color:#6366f1;text-align:center;margin-bottom:30px;letter-spacing:-1px;}\n                          .lg2-title{font-size:24px;font-weight:800;color:#111;text-align:center;margin:0 0 8px;}\n                          .lg2-sub{font-size:14px;color:#64748b;text-align:center;margin:0 0 30px;}\n                          .lg2-group{margin-bottom:18px;}\n                          .lg2-group label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;}\n                          .lg2-input{width:100%;padding:13px 16px;border:1.5px solid #e5e7eb;border-radius:10px;font-size:15px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;box-sizing:border-box;background:#f8fafc;}\n                          .lg2-input:focus{border-color:#6366f1;background:#fff;}\n                          .lg2-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}\n                          .lg2-check{font-size:13px;color:#64748b;display:flex;align-items:center;gap:6px;}\n                          .lg2-link{font-size:13px;color:#6366f1;text-decoration:none;font-weight:600;}\n                          .lg2-btn{width:100%;padding:14px;background:#6366f1;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.3s;}\n                          .lg2-btn:hover{background:#4f46e5;transform:translateY(-2px);}\n                          .lg2-footer{text-align:center;font-size:13px;color:#64748b;margin-top:20px;}\n                          .lg2-footer a{color:#6366f1;font-weight:600;text-decoration:none;}\n                          @media(max-width:480px){.lg2-card{padding:40px 25px;}}\n                        </style>\n                        <div class=\"lg2-wrap\">\n                          <div class=\"lg2-card\">\n                            <div class=\"lg2-logo\">&#9670; Nexus</div>\n                            <h2 class=\"lg2-title\">Welcome Back</h2>\n                            <p class=\"lg2-sub\">Enter your credentials to access your account.</p>\n                            <form onsubmit=\"event.preventDefault();\">\n                              <div class=\"lg2-group\"><label>Email</label><input class=\"lg2-input\" type=\"email\" placeholder=\"email@example.com\"></div>\n                              <div class=\"lg2-group\"><label>Password</label><input class=\"lg2-input\" type=\"password\" placeholder=\"••••••••\"></div>\n                              <div class=\"lg2-row\">\n                                <label class=\"lg2-check\"><input type=\"checkbox\"> Remember me</label>\n                                <a href=\"#\" class=\"lg2-link\">Forgot password?</a>\n                              </div>\n                              <button type=\"submit\" class=\"lg2-btn\">Sign In</button>\n                            </form>\n                            <p class=\"lg2-footer\">Don't have an account? <a href=\"#\">Sign up free</a></p>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "login-3",
      "name": "Dark Signup Form",
      "description": "A premium dark themed signup/registration form",
      "html": "\n                        <style>\n                          .lg3-wrap{padding:80px 20px;background:#09090b;font-family:sans-serif;display:flex;justify-content:center;min-height:500px;align-items:center;}\n                          .lg3-card{width:100%;max-width:480px;}\n                          .lg3-head{margin-bottom:40px;}\n                          .lg3-head h2{font-size:32px;font-weight:800;color:#fff;margin:0 0 10px;}\n                          .lg3-head p{font-size:15px;color:#a1a1aa;margin:0;}\n                          .lg3-row{display:grid;grid-template-columns:1fr 1fr;gap:15px;}\n                          .lg3-group{margin-bottom:18px;}\n                          .lg3-group label{display:block;font-size:12px;font-weight:600;color:#a1a1aa;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.8px;}\n                          .lg3-input{width:100%;padding:13px 16px;background:#18181b;border:1px solid #27272a;border-radius:8px;font-size:15px;font-family:inherit;outline:none;color:#fff;transition:border-color 0.3s;box-sizing:border-box;}\n                          .lg3-input::placeholder{color:#52525b;}\n                          .lg3-input:focus{border-color:#a855f7;}\n                          .lg3-terms{font-size:13px;color:#71717a;margin-bottom:20px;}\n                          .lg3-terms a{color:#a855f7;text-decoration:none;}\n                          .lg3-btn{width:100%;padding:14px;background:linear-gradient(90deg,#a855f7,#6366f1);color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity 0.3s;}\n                          .lg3-btn:hover{opacity:0.85;}\n                          .lg3-footer{text-align:center;font-size:14px;color:#71717a;margin-top:20px;}\n                          .lg3-footer a{color:#a855f7;text-decoration:none;font-weight:600;}\n                          @media(max-width:500px){.lg3-row{grid-template-columns:1fr;}}\n                        </style>\n                        <div class=\"lg3-wrap\">\n                          <div class=\"lg3-card\">\n                            <div class=\"lg3-head\">\n                              <h2>Create your account</h2>\n                              <p>Start your 30-day free trial. No credit card required.</p>\n                            </div>\n                            <form onsubmit=\"event.preventDefault();\">\n                              <div class=\"lg3-row\">\n                                <div class=\"lg3-group\"><label>First Name</label><input class=\"lg3-input\" type=\"text\" placeholder=\"John\"></div>\n                                <div class=\"lg3-group\"><label>Last Name</label><input class=\"lg3-input\" type=\"text\" placeholder=\"Doe\"></div>\n                              </div>\n                              <div class=\"lg3-group\"><label>Email</label><input class=\"lg3-input\" type=\"email\" placeholder=\"john@example.com\"></div>\n                              <div class=\"lg3-group\"><label>Password</label><input class=\"lg3-input\" type=\"password\" placeholder=\"Min. 8 characters\"></div>\n                              <div class=\"lg3-group\"><label>Confirm Password</label><input class=\"lg3-input\" type=\"password\" placeholder=\"Repeat password\"></div>\n                              <p class=\"lg3-terms\">By signing up, you agree to our <a href=\"#\">Terms of Service</a> and <a href=\"#\">Privacy Policy</a>.</p>\n                              <button type=\"submit\" class=\"lg3-btn\">Create Account</button>\n                            </form>\n                            <p class=\"lg3-footer\">Already have an account? <a href=\"#\">Sign in</a></p>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "login-4",
      "name": "Tab Toggle Login/Signup",
      "description": "A single card with interactive tabs to switch between Login and Signup",
      "html": "\n                        <style>\n                          .lg4-wrap{padding:80px 20px;background:#f0f9ff;font-family:sans-serif;display:flex;justify-content:center;min-height:500px;align-items:center;}\n                          .lg4-card{background:#fff;border-radius:20px;padding:40px;width:100%;max-width:420px;box-shadow:0 10px 30px rgba(0,0,0,0.06);}\n                          .lg4-tabs{display:flex;background:#f1f5f9;border-radius:10px;padding:5px;margin-bottom:30px;gap:5px;}\n                          .lg4-tab{flex:1;padding:10px;border:none;background:transparent;border-radius:8px;font-size:15px;font-weight:600;color:#64748b;cursor:pointer;transition:all 0.3s;font-family:inherit;}\n                          .lg4-tab.active{background:#fff;color:#0ea5e9;box-shadow:0 2px 8px rgba(0,0,0,0.08);}\n                          .lg4-panel{display:none;}\n                          .lg4-panel.active{display:block;}\n                          .lg4-group{margin-bottom:16px;}\n                          .lg4-group label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;}\n                          .lg4-input{width:100%;padding:12px 15px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;box-sizing:border-box;}\n                          .lg4-input:focus{border-color:#0ea5e9;}\n                          .lg4-btn{width:100%;padding:13px;background:#0ea5e9;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;margin-top:5px;}\n                          .lg4-btn:hover{background:#0284c7;}\n                          .lg4-forgot{text-align:right;margin-bottom:15px;}\n                          .lg4-forgot a{font-size:12px;color:#0ea5e9;text-decoration:none;}\n                        </style>\n                        <script>\n                          function lg4Switch(tab){\n                            var tabs = document.querySelectorAll('.lg4-tab');\n                            var panels = document.querySelectorAll('.lg4-panel');\n                            for(var i=0;i<tabs.length;i++) tabs[i].classList.remove('active');\n                            for(var i=0;i<panels.length;i++) panels[i].classList.remove('active');\n                            document.getElementById('lg4-tab-'+tab).classList.add('active');\n                            document.getElementById('lg4-panel-'+tab).classList.add('active');\n                          }\n                        </script>\n                        <div class=\"lg4-wrap\">\n                          <div class=\"lg4-card\">\n                            <div class=\"lg4-tabs\">\n                              <button class=\"lg4-tab active\" id=\"lg4-tab-login\" onclick=\"lg4Switch('login')\">Sign In</button>\n                              <button class=\"lg4-tab\" id=\"lg4-tab-signup\" onclick=\"lg4Switch('signup')\">Sign Up</button>\n                            </div>\n                            <div class=\"lg4-panel active\" id=\"lg4-panel-login\">\n                              <form onsubmit=\"event.preventDefault();\">\n                                <div class=\"lg4-group\"><label>Email</label><input class=\"lg4-input\" type=\"email\" placeholder=\"you@example.com\"></div>\n                                <div class=\"lg4-group\"><label>Password</label><input class=\"lg4-input\" type=\"password\" placeholder=\"••••••••\"></div>\n                                <div class=\"lg4-forgot\"><a href=\"#\">Forgot password?</a></div>\n                                <button type=\"submit\" class=\"lg4-btn\">Sign In</button>\n                              </form>\n                            </div>\n                            <div class=\"lg4-panel\" id=\"lg4-panel-signup\">\n                              <form onsubmit=\"event.preventDefault();\">\n                                <div class=\"lg4-group\"><label>Full Name</label><input class=\"lg4-input\" type=\"text\" placeholder=\"Your full name\"></div>\n                                <div class=\"lg4-group\"><label>Email</label><input class=\"lg4-input\" type=\"email\" placeholder=\"you@example.com\"></div>\n                                <div class=\"lg4-group\"><label>Password</label><input class=\"lg4-input\" type=\"password\" placeholder=\"Min. 8 characters\"></div>\n                                <button type=\"submit\" class=\"lg4-btn\">Create Account</button>\n                              </form>\n                            </div>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "login-5",
      "name": "Minimal OTP / Magic Link",
      "description": "A passwordless sign-in form for email OTP or magic link authentication",
      "html": "\n                        <style>\n                          .lg5-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;display:flex;justify-content:center;align-items:center;min-height:500px;}\n                          .lg5-card{width:100%;max-width:420px;text-align:center;}\n                          .lg5-icon{font-size:48px;margin-bottom:20px;}\n                          .lg5-card h2{font-size:30px;font-weight:900;color:#111;margin:0 0 10px;}\n                          .lg5-card p{font-size:16px;color:#64748b;margin:0 0 35px;line-height:1.5;}\n                          .lg5-input-wrap{display:flex;gap:10px;margin-bottom:15px;}\n                          .lg5-input{flex:1;padding:14px 18px;border:2px solid #e5e7eb;border-radius:12px;font-size:15px;font-family:inherit;outline:none;color:#111;transition:border-color 0.3s;}\n                          .lg5-input:focus{border-color:#f59e0b;}\n                          .lg5-btn{padding:14px 24px;background:#f59e0b;color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;transition:background 0.3s;}\n                          .lg5-btn:hover{background:#d97706;}\n                          .lg5-note{font-size:13px;color:#94a3b8;margin-bottom:30px;}\n                          .lg5-divider{display:flex;align-items:center;gap:15px;margin-bottom:25px;}\n                          .lg5-divider::before,.lg5-divider::after{content:'';flex:1;height:1px;background:#e5e7eb;}\n                          .lg5-divider span{font-size:13px;color:#94a3b8;white-space:nowrap;}\n                          .lg5-alt-btn{width:100%;padding:13px;border:2px solid #e5e7eb;border-radius:12px;background:#fff;font-size:15px;font-weight:600;color:#111;cursor:pointer;font-family:inherit;transition:border-color 0.3s;}\n                          .lg5-alt-btn:hover{border-color:#111;}\n                          @media(max-width:480px){.lg5-input-wrap{flex-direction:column;}.lg5-btn{width:100%;}}\n                        </style>\n                        <div class=\"lg5-wrap\">\n                          <div class=\"lg5-card\">\n                            <div class=\"lg5-icon\">✨</div>\n                            <h2>Sign in instantly</h2>\n                            <p>Enter your email and we'll send you a magic link - no password needed.</p>\n                            <form onsubmit=\"event.preventDefault();\">\n                              <div class=\"lg5-input-wrap\">\n                                <input type=\"email\" class=\"lg5-input\" placeholder=\"your@email.com\" required>\n                                <button type=\"submit\" class=\"lg5-btn\">Send Link</button>\n                              </div>\n                              <p class=\"lg5-note\">Check your inbox. Link expires in 10 minutes.</p>\n                              <div class=\"lg5-divider\"><span>or continue with</span></div>\n                              <button type=\"button\" class=\"lg5-alt-btn\">&#128100; Sign in with Google</button>\n                            </form>\n                          </div>\n                        </div>\n                    "
    }
  ]
}