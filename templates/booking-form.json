  "templates": [
    {
      "id": "bf-1",
      "name": "Elegant Booking Card",
      "html": "\n<style>\n.bf1{padding:100px 20px;background:linear-gradient(135deg,#f0f4ff,#faf5ff);font-family:'Inter',sans-serif}\n.bf1-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.bf1-info h2{font-size:clamp(30px,4vw,44px);font-weight:800;color:#111;margin:0 0 20px;line-height:1.2}\n.bf1-info p{color:#555;font-size:16px;line-height:1.8;margin:0 0 30px}\n.bf1-feature{display:flex;align-items:center;gap:12px;margin-bottom:15px}\n.bf1-feature-icon{width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}\n.bf1-feature span{font-size:15px;color:#333;font-weight:500}\n.bf1-form{background:#fff;border-radius:24px;padding:40px;box-shadow:0 20px 60px rgba(99,102,241,.1)}\n.bf1-form h3{font-size:22px;font-weight:700;color:#111;margin:0 0 30px}\n.bf1-field{margin-bottom:20px}\n.bf1-field label{display:block;font-size:13px;font-weight:600;color:#555;margin-bottom:8px}\n.bf1-field input,.bf1-field select{width:100%;padding:12px 16px;border:2px solid #e5e7eb;border-radius:10px;font-size:14px;color:#111;outline:none;box-sizing:border-box;transition:border-color .3s;font-family:'Inter',sans-serif}\n.bf1-field input:focus,.bf1-field select:focus{border-color:#6366f1}\n.bf1-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.bf1-btn{width:100%;padding:15px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;margin-top:10px;transition:opacity .3s;font-family:'Inter',sans-serif}\n.bf1-btn:hover{opacity:.9}\n@media(max-width:768px){.bf1-wrap{grid-template-columns:1fr}.bf1-row{grid-template-columns:1fr}}\n</style>\n<section class=\"bf1\">\n  <div class=\"bf1-wrap\">\n    <div class=\"bf1-info\">\n      <h2>Book Your Free Consultation</h2>\n      <p>Schedule a session with our experts and take the first step toward transforming your business.</p>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">🕐</div><span>Flexible scheduling — mornings & evenings</span></div>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">💻</div><span>Online or in-person meetings available</span></div>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">✅</div><span>No commitment required — completely free</span></div>\n    </div>\n    <div class=\"bf1-form\">\n      <h3>Schedule Appointment</h3>\n      <div class=\"bf1-row\">\n        <div class=\"bf1-field\"><label>First Name</label><input type=\"text\" placeholder=\"John\"></div>\n        <div class=\"bf1-field\"><label>Last Name</label><input type=\"text\" placeholder=\"Doe\"></div>\n      </div>\n      <div class=\"bf1-field\"><label>Email Address</label><input type=\"email\" placeholder=\"john@example.com\"></div>\n      <div class=\"bf1-field\"><label>Phone Number</label><input type=\"tel\" placeholder=\"+1 (555) 000-0000\"></div>\n      <div class=\"bf1-row\">\n        <div class=\"bf1-field\"><label>Preferred Date</label><input type=\"date\"></div>\n        <div class=\"bf1-field\"><label>Preferred Time</label><select><option>9:00 AM</option><option>11:00 AM</option><option>2:00 PM</option><option>4:00 PM</option></select></div>\n      </div>\n      <div class=\"bf1-field\"><label>Service Needed</label><select><option>Consulting</option><option>Design</option><option>Development</option><option>Marketing</option></select></div>\n      <button class=\"bf1-btn\">Confirm Booking →</button>\n    </div>\n  </div>\n</section>"
    }
  ]
}