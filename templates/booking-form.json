  "templates": [
    {
      "id": "bf-1",
      "name": "Elegant Booking Card",
      "html": "\n<style>\n.bf1{padding:100px 20px;background:linear-gradient(135deg,#f0f4ff,#faf5ff);font-family:'Inter',sans-serif}\n.bf1-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.bf1-info h2{font-size:clamp(30px,4vw,44px);font-weight:800;color:#111;margin:0 0 20px;line-height:1.2}\n.bf1-info p{color:#555;font-size:16px;line-height:1.8;margin:0 0 30px}\n.bf1-feature{display:flex;align-items:center;gap:12px;margin-bottom:15px}\n.bf1-feature-icon{width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}\n.bf1-feature span{font-size:15px;color:#333;font-weight:500}\n.bf1-form{background:#fff;border-radius:24px;padding:40px;box-shadow:0 20px 60px rgba(99,102,241,.1)}\n.bf1-form h3{font-size:22px;font-weight:700;color:#111;margin:0 0 30px}\n.bf1-field{margin-bottom:20px}\n.bf1-field label{display:block;font-size:13px;font-weight:600;color:#555;margin-bottom:8px}\n.bf1-field input,.bf1-field select{width:100%;padding:12px 16px;border:2px solid #e5e7eb;border-radius:10px;font-size:14px;color:#111;outline:none;box-sizing:border-box;transition:border-color .3s;font-family:'Inter',sans-serif}\n.bf1-field input:focus,.bf1-field select:focus{border-color:#6366f1}\n.bf1-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.bf1-btn{width:100%;padding:15px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;margin-top:10px;transition:opacity .3s;font-family:'Inter',sans-serif}\n.bf1-btn:hover{opacity:.9}\n@media(max-width:768px){.bf1-wrap{grid-template-columns:1fr}.bf1-row{grid-template-columns:1fr}}\n</style>\n<section class=\"bf1\">\n  <div class=\"bf1-wrap\">\n    <div class=\"bf1-info\">\n      <h2>Book Your Free Consultation</h2>\n      <p>Schedule a session with our experts and take the first step toward transforming your business.</p>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">🕐</div><span>Flexible scheduling — mornings & evenings</span></div>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">💻</div><span>Online or in-person meetings available</span></div>\n      <div class=\"bf1-feature\"><div class=\"bf1-feature-icon\">✅</div><span>No commitment required — completely free</span></div>\n    </div>\n    <div class=\"bf1-form\">\n      <h3>Schedule Appointment</h3>\n      <div class=\"bf1-row\">\n        <div class=\"bf1-field\"><label>First Name</label><input type=\"text\" placeholder=\"John\"></div>\n        <div class=\"bf1-field\"><label>Last Name</label><input type=\"text\" placeholder=\"Doe\"></div>\n      </div>\n      <div class=\"bf1-field\"><label>Email Address</label><input type=\"email\" placeholder=\"john@example.com\"></div>\n      <div class=\"bf1-field\"><label>Phone Number</label><input type=\"tel\" placeholder=\"+1 (555) 000-0000\"></div>\n      <div class=\"bf1-row\">\n        <div class=\"bf1-field\"><label>Preferred Date</label><input type=\"date\"></div>\n        <div class=\"bf1-field\"><label>Preferred Time</label><select><option>9:00 AM</option><option>11:00 AM</option><option>2:00 PM</option><option>4:00 PM</option></select></div>\n      </div>\n      <div class=\"bf1-field\"><label>Service Needed</label><select><option>Consulting</option><option>Design</option><option>Development</option><option>Marketing</option></select></div>\n      <button class=\"bf1-btn\">Confirm Booking →</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "bf-2",
      "name": "Dark Neon Booking",
      "html": "\n<style>\n.bf2{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;color:#fff}\n.bf2-wrap{max-width:1100px;margin:0 auto;display:flex;gap:60px;flex-direction:row-reverse;align-items:center}\n.bf2-info{flex:1}\n.bf2-info h2{font-size:42px;font-weight:900;margin:0 0 15px;color:#fff}\n.bf2-info h2 span{color:#10b981}\n.bf2-info p{color:#a1a1aa;font-size:16px;line-height:1.7;margin:0 0 30px}\n.bf2-form{flex:1;background:#18181b;border:1px solid #27272a;border-radius:16px;padding:40px;box-shadow:0 25px 50px rgba(0,0,0,0.5)}\n.bf2-field{margin-bottom:20px}\n.bf2-field label{display:block;font-size:12px;font-weight:600;color:#a1a1aa;margin-bottom:8px;text-transform:uppercase;letter-spacing:1px}\n.bf2-field input, .bf2-field select{width:100%;padding:14px 16px;background:#27272a;border:1px solid #3f3f46;border-radius:8px;color:#fff;font-size:15px;outline:none;transition:border-color 0.3s,box-shadow 0.3s;box-sizing:border-box}\n.bf2-field input:focus, .bf2-field select:focus{border-color:#10b981;box-shadow:0 0 0 3px rgba(16,185,129,0.1)}\n.bf2-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.bf2-btn{width:100%;padding:16px;background:#10b981;color:#000;border:none;border-radius:8px;font-size:16px;font-weight:800;cursor:pointer;transition:transform 0.2s}\n.bf2-btn:hover{transform:translateY(-2px)}\n@media(max-width:768px){.bf2-wrap{flex-direction:column}.bf2-row{grid-template-columns:1fr}}\n</style>\n<section class=\"bf2\">\n  <div class=\"bf2-wrap\">\n    <div class=\"bf2-info\">\n      <h2>Secure Your <span>Spot</span></h2>\n      <p>Join the revolution. Book your demo today and see how our platform can supercharge your workflow with next-gen tools.</p>\n      <ul style=\"list-style:none;padding:0;color:#e4e4e7;line-height:2\">\n        <li>✅ 14-day free trial included</li>\n        <li>✅ No credit card required</li>\n        <li>✅ 1-on-1 expert onboarding</li>\n      </ul>\n    </div>\n    <div class=\"bf2-form\">\n      <div class=\"bf2-field\">\n        <label>Full Name</label>\n        <input type=\"text\" placeholder=\"Jane Doe\">\n      </div>\n      <div class=\"bf2-field\">\n        <label>Work Email</label>\n        <input type=\"email\" placeholder=\"jane@company.com\">\n      </div>\n      <div class=\"bf2-row\">\n        <div class=\"bf2-field\">\n          <label>Company Size</label>\n          <select><option>1-10</option><option>11-50</option><option>50+</option></select>\n        </div>\n        <div class=\"bf2-field\">\n          <label>Date</label>\n          <input type=\"date\">\n        </div>\n      </div>\n      <button class=\"bf2-btn\">Book Demo</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "bf-3",
      "name": "Minimalist Line Form",
      "html": "\n<style>\n.bf3{padding:120px 20px;background:#fff;font-family:'Inter',sans-serif}\n.bf3-wrap{max-width:600px;margin:0 auto;text-align:center}\n.bf3-wrap h2{font-size:36px;font-weight:900;color:#111;margin:0 0 15px}\n.bf3-wrap p{color:#666;font-size:16px;margin:0 0 40px}\n.bf3-form{text-align:left}\n.bf3-field{margin-bottom:30px}\n.bf3-field input, .bf3-field select{width:100%;padding:10px 0;background:transparent;border:none;border-bottom:2px solid #e5e7eb;font-size:16px;color:#111;outline:none;transition:border-color 0.3s;box-sizing:border-box}\n.bf3-field input:focus, .bf3-field select:focus{border-bottom-color:#f43f5e}\n.bf3-field input::placeholder{color:#a1a1aa}\n.bf3-row{display:grid;grid-template-columns:1fr 1fr;gap:30px}\n.bf3-btn{width:100%;padding:18px;background:#111;color:#fff;border:none;border-radius:50px;font-size:16px;font-weight:700;cursor:pointer;transition:background 0.3s;margin-top:10px}\n.bf3-btn:hover{background:#f43f5e}\n@media(max-width:600px){.bf3-row{grid-template-columns:1fr;gap:10px}}\n</style>\n<section class=\"bf3\">\n  <div class=\"bf3-wrap\">\n    <h2>Reserve a Table</h2>\n    <p>Experience culinary excellence. Book now.</p>\n    <div class=\"bf3-form\">\n      <div class=\"bf3-row\">\n        <div class=\"bf3-field\">\n          <input type=\"text\" placeholder=\"Your Name\">\n        </div>\n        <div class=\"bf3-field\">\n          <input type=\"tel\" placeholder=\"Phone Number\">\n        </div>\n      </div>\n      <div class=\"bf3-row\">\n        <div class=\"bf3-field\">\n          <input type=\"date\">\n        </div>\n        <div class=\"bf3-field\">\n          <select><option disabled selected>Guests</option><option>1 Person</option><option>2 People</option><option>3-4 People</option><option>5+ People</option></select>\n        </div>\n      </div>\n      <button class=\"bf3-btn\">Confirm Reservation</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "bf-4",
      "name": "Horizontal Search Bar",
      "html": "\n<style>\n.bf4{padding:140px 20px;background:url('https://images.unsplash.com/photo-1542314831-c6a4d27ce6a2?auto=format&fit=crop&w=1920&q=80') center/cover;position:relative;font-family:'Inter',sans-serif}\n.bf4::before{content:'';position:absolute;inset:0;background:rgba(0,0,0,0.5)}\n.bf4-wrap{position:relative;z-index:2;max-width:1200px;margin:0 auto;text-align:center}\n.bf4-wrap h2{font-size:48px;font-weight:800;color:#fff;margin:0 0 40px}\n.bf4-form{background:#fff;padding:10px;border-radius:100px;display:flex;align-items:center;box-shadow:0 25px 50px rgba(0,0,0,0.2)}\n.bf4-field{flex:1;padding:10px 25px;border-right:1px solid #e5e7eb;text-align:left}\n.bf4-field:nth-last-child(2){border-right:none}\n.bf4-field label{display:block;font-size:12px;font-weight:700;color:#666;text-transform:uppercase;margin-bottom:4px}\n.bf4-field input, .bf4-field select{width:100%;border:none;background:transparent;font-size:15px;color:#111;font-weight:600;outline:none;padding:0}\n.bf4-btn{padding:18px 40px;background:#3b82f6;color:#fff;border:none;border-radius:100px;font-size:16px;font-weight:700;cursor:pointer;transition:background 0.3s}\n.bf4-btn:hover{background:#2563eb}\n@media(max-width:991px){.bf4-form{flex-direction:column;border-radius:24px;padding:20px;gap:15px}.bf4-field{width:100%;border-right:none;border-bottom:1px solid #e5e7eb;padding:10px 0}.bf4-field:nth-last-child(2){border-bottom:none}.bf4-btn{width:100%}}\n</style>\n<section class=\"bf4\">\n  <div class=\"bf4-wrap\">\n    <h2>Find Your Perfect Stay</h2>\n    <div class=\"bf4-form\">\n      <div class=\"bf4-field\">\n        <label>Destination</label>\n        <input type=\"text\" placeholder=\"Where are you going?\">\n      </div>\n      <div class=\"bf4-field\">\n        <label>Check In</label>\n        <input type=\"date\">\n      </div>\n      <div class=\"bf4-field\">\n        <label>Check Out</label>\n        <input type=\"date\">\n      </div>\n      <div class=\"bf4-field\">\n        <label>Guests</label>\n        <select><option>1 Room, 2 Adults</option><option>2 Rooms, 4 Adults</option></select>\n      </div>\n      <button class=\"bf4-btn\">Search</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "bf-5",
      "name": "Glassmorphism Appointment",
      "html": "\n<style>\n.bf5{padding:100px 20px;background:linear-gradient(135deg,#c4b5fd,#fbcfe8);font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.bf5-blob{position:absolute;width:500px;height:500px;background:#a78bfa;border-radius:50%;filter:blur(100px);top:-100px;left:-100px;opacity:0.5}\n.bf5-wrap{position:relative;z-index:2;max-width:800px;margin:0 auto}\n.bf5-card{background:rgba(255,255,255,0.2);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.4);border-radius:30px;padding:50px;box-shadow:0 25px 50px rgba(0,0,0,0.1)}\n.bf5-card h2{text-align:center;font-size:36px;font-weight:800;color:#111;margin:0 0 10px}\n.bf5-card p{text-align:center;color:#444;margin:0 0 40px}\n.bf5-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.bf5-field{margin-bottom:20px}\n.bf5-field input, .bf5-field select{width:100%;padding:15px 20px;background:rgba(255,255,255,0.4);border:1px solid rgba(255,255,255,0.5);border-radius:12px;font-size:15px;color:#111;outline:none;transition:background 0.3s;box-sizing:border-box}\n.bf5-field input::placeholder{color:#666}\n.bf5-field input:focus, .bf5-field select:focus{background:rgba(255,255,255,0.7)}\n.bf5-btn{width:100%;padding:16px;background:#111;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;margin-top:10px}\n@media(max-width:600px){.bf5-row{grid-template-columns:1fr}.bf5-card{padding:30px}}\n</style>\n<section class=\"bf5\">\n  <div class=\"bf5-blob\"></div>\n  <div class=\"bf5-wrap\">\n    <div class=\"bf5-card\">\n      <h2>Let's Talk</h2>\n      <p>Schedule a creative consultation with our team.</p>\n      <div class=\"bf5-row\">\n        <div class=\"bf5-field\"><input type=\"text\" placeholder=\"First Name\"></div>\n        <div class=\"bf5-field\"><input type=\"text\" placeholder=\"Last Name\"></div>\n      </div>\n      <div class=\"bf5-field\"><input type=\"email\" placeholder=\"Email Address\"></div>\n      <div class=\"bf5-field\">\n        <select><option disabled selected>Select Service</option><option>Web Design</option><option>Branding</option><option>Marketing</option></select>\n      </div>\n      <button class=\"bf5-btn\">Send Request</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "bf-6",
      "name": "Corporate Blue Form",
      "html": "\n<style>\n.bf6{padding:80px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.bf6-wrap{max-width:1100px;margin:0 auto;display:flex;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.05);border:1px solid #e2e8f0}\n.bf6-left{width:40%;background:#1e40af;color:#fff;padding:50px 40px;display:flex;flex-direction:column;justify-content:center}\n.bf6-left h2{font-size:36px;font-weight:800;margin:0 0 15px}\n.bf6-left p{font-size:15px;line-height:1.7;color:#bfdbfe;margin:0 0 30px}\n.bf6-contact{margin-top:auto}\n.bf6-contact-item{display:flex;align-items:center;gap:12px;margin-bottom:15px;font-size:14px;color:#eff6ff}\n.bf6-right{width:60%;padding:50px 40px}\n.bf6-right h3{font-size:24px;font-weight:700;color:#0f172a;margin:0 0 30px}\n.bf6-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}\n.bf6-field label{display:block;font-size:13px;font-weight:600;color:#475569;margin-bottom:6px}\n.bf6-field input, .bf6-field select, .bf6-field textarea{width:100%;padding:12px 16px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;font-size:14px;color:#0f172a;outline:none;box-sizing:border-box}\n.bf6-field textarea{height:100px;resize:none}\n.bf6-btn{padding:14px 30px;background:#1e40af;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;transition:background 0.3s}\n.bf6-btn:hover{background:#1e3a8a}\n@media(max-width:768px){.bf6-wrap{flex-direction:column}.bf6-left,.bf6-right{width:100%}.bf6-grid{grid-template-columns:1fr}}\n</style>\n<section class=\"bf6\">\n  <div class=\"bf6-wrap\">\n    <div class=\"bf6-left\">\n      <h2>Get in Touch</h2>\n      <p>Whether you have a question about our services, pricing, or anything else, our team is ready to answer all your questions.</p>\n      <div class=\"bf6-contact\">\n        <div class=\"bf6-contact-item\">📞 +1 (800) 123-4567</div>\n        <div class=\"bf6-contact-item\">✉️ hello@company.com</div>\n        <div class=\"bf6-contact-item\">📍 123 Business Ave, Suite 100</div>\n      </div>\n    </div>\n    <div class=\"bf6-right\">\n      <h3>Send a Message</h3>\n      <div class=\"bf6-grid\">\n        <div class=\"bf6-field\"><label>First Name</label><input type=\"text\"></div>\n        <div class=\"bf6-field\"><label>Last Name</label><input type=\"text\"></div>\n        <div class=\"bf6-field\"><label>Email</label><input type=\"email\"></div>\n        <div class=\"bf6-field\"><label>Phone</label><input type=\"tel\"></div>\n      </div>\n      <div class=\"bf6-field\" style=\"margin-bottom:30px\">\n        <label>How can we help?</label>\n        <textarea></textarea>\n      </div>\n      <button class=\"bf6-btn\">Submit Request</button>\n    </div>\n  </div>\n</section>"
    }
  ]
}
