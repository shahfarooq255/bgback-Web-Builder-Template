    {
      "id": "team-1",
      "name": "Modern Hover Cards",
      "description": "Clean profile cards where social media links elegantly slide up on hover",
      "html": "\n                        <style>\n                          .tm1-wrap{padding:80px 20px;background:#f8fafc;font-family:sans-serif;}\n                          .tm1-head{text-align:center;margin-bottom:50px;}\n                          .tm1-head h2{font-size:clamp(30px,5vw,40px);font-weight:900;color:#0f172a;margin:0 0 10px;}\n                          .tm1-head p{color:#64748b;font-size:18px;}\n                          .tm1-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:30px;max-width:1200px;margin:0 auto;}\n                          .tm1-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.05);position:relative;}\n                          .tm1-img-box{position:relative;overflow:hidden;aspect-ratio:4/5;}\n                          .tm1-img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s ease;}\n                          .tm1-card:hover .tm1-img{transform:scale(1.05);}\n                          .tm1-socials{position:absolute;bottom:0;left:0;width:100%;background:rgba(255,255,255,0.95);display:flex;justify-content:center;gap:15px;padding:15px;transform:translateY(100%);transition:transform 0.3s ease;}\n                          .tm1-card:hover .tm1-socials{transform:translateY(0);}\n                          .tm1-icon{width:35px;height:35px;background:#0f172a;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:14px;transition:background 0.3s;}\n                          .tm1-icon:hover{background:#3b82f6;}\n                          .tm1-info{padding:25px;text-align:center;}\n                          .tm1-name{font-size:20px;font-weight:800;color:#0f172a;margin:0 0 5px;}\n                          .tm1-role{font-size:14px;color:#3b82f6;font-weight:600;margin:0;}\n                        </style>\n                        <section class=\"tm1-wrap\">\n                          <div class=\"tm1-head\">\n                            <h2>Meet The Experts</h2>\n                            <p>The brilliant minds behind our success.</p>\n                          </div>\n                          <div class=\"tm1-grid\">\n                            <div class=\"tm1-card\">\n                              <div class=\"tm1-img-box\">\n                                <img class=\"tm1-img\" src=\"https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=400&auto=format&fit=crop\" alt=\"Team Member\">\n                                <div class=\"tm1-socials\">\n                                  <a href=\"#\" class=\"tm1-icon\">in</a>\n                                  <a href=\"#\" class=\"tm1-icon\">tw</a>\n                                </div>\n                              </div>\n                              <div class=\"tm1-info\">\n                                <h3 class=\"tm1-name\">Marcus Reed</h3>\n                                <p class=\"tm1-role\">Chief Executive Officer</p>\n                              </div>\n                            </div>\n                            <div class=\"tm1-card\">\n                              <div class=\"tm1-img-box\">\n                                <img class=\"tm1-img\" src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=400&auto=format&fit=crop\" alt=\"Team Member\">\n                                <div class=\"tm1-socials\">\n                                  <a href=\"#\" class=\"tm1-icon\">in</a>\n                                  <a href=\"#\" class=\"tm1-icon\">tw</a>\n                                </div>\n                              </div>\n                              <div class=\"tm1-info\">\n                                <h3 class=\"tm1-name\">Elena Gomez</h3>\n                                <p class=\"tm1-role\">Head of Design</p>\n                              </div>\n                            </div>\n                            <div class=\"tm1-card\">\n                              <div class=\"tm1-img-box\">\n                                <img class=\"tm1-img\" src=\"https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=400&auto=format&fit=crop\" alt=\"Team Member\">\n                                <div class=\"tm1-socials\">\n                                  <a href=\"#\" class=\"tm1-icon\">in</a>\n                                  <a href=\"#\" class=\"tm1-icon\">tw</a>\n                                </div>\n                              </div>\n                              <div class=\"tm1-info\">\n                                <h3 class=\"tm1-name\">David Chen</h3>\n                                <p class=\"tm1-role\">Lead Developer</p>\n                              </div>\n                            </div>\n                            <div class=\"tm1-card\">\n                              <div class=\"tm1-img-box\">\n                                <img class=\"tm1-img\" src=\"https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=400&auto=format&fit=crop\" alt=\"Team Member\">\n                                <div class=\"tm1-socials\">\n                                  <a href=\"#\" class=\"tm1-icon\">in</a>\n                                  <a href=\"#\" class=\"tm1-icon\">tw</a>\n                                </div>\n                              </div>\n                              <div class=\"tm1-info\">\n                                <h3 class=\"tm1-name\">Sarah Jenkins</h3>\n                                <p class=\"tm1-role\">Marketing Director</p>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
