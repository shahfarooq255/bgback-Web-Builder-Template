    {
      "id": "team-5",
      "name": "Horizontal Scroll Roster",
      "description": "A touch-friendly horizontal scrolling carousel, perfect for showcasing larger teams on mobile",
      "html": "\n                        <style>\n                          .tm5-wrap{padding:80px 0 80px 20px;background:#f0f9ff;font-family:sans-serif;}\n                          .tm5-head{margin-bottom:40px;padding-right:20px;}\n                          .tm5-head h2{font-size:36px;font-weight:900;color:#0369a1;margin:0;}\n                          .tm5-scroll{display:flex;gap:20px;overflow-x:auto;padding-bottom:20px;scroll-snap-type:x mandatory;}\n                          .tm5-scroll::-webkit-scrollbar{height:6px;}\n                          .tm5-scroll::-webkit-scrollbar-track{background:rgba(0,0,0,0.05);border-radius:10px;}\n                          .tm5-scroll::-webkit-scrollbar-thumb{background:rgba(3,105,161,0.3);border-radius:10px;}\n                          .tm5-card{flex:0 0 280px;scroll-snap-align:start;background:#fff;border-radius:16px;padding:25px;text-align:center;box-shadow:0 4px 15px rgba(0,0,0,0.03);}\n                          .tm5-img{width:100px;height:100px;border-radius:50%;object-fit:cover;margin:0 auto 15px;}\n                          .tm5-name{font-size:20px;font-weight:800;color:#111;margin:0 0 5px;}\n                          .tm5-role{font-size:14px;color:#0ea5e9;font-weight:600;margin:0 0 15px;}\n                          .tm5-desc{font-size:14px;color:#64748b;line-height:1.5;margin:0;}\n                          @media(max-width:600px){.tm5-card{flex:0 0 240px;}}\n                        </style>\n                        <section class=\"tm5-wrap\">\n                          <div class=\"tm5-head\">\n                            <h2>The Roster</h2>\n                          </div>\n                          <div class=\"tm5-scroll\">\n                            <div class=\"tm5-card\">\n                              <img class=\"tm5-img\" src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop\">\n                              <h3 class=\"tm5-name\">Olivia</h3>\n                              <p class=\"tm5-role\">Designer</p>\n                              <p class=\"tm5-desc\">Creates stunning UI/UX experiences.</p>\n                            </div>\n                            <div class=\"tm5-card\">\n                              <img class=\"tm5-img\" src=\"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=200&auto=format&fit=crop\">\n                              <h3 class=\"tm5-name\">Lucas</h3>\n                              <p class=\"tm5-role\">Frontend Dev</p>\n                              <p class=\"tm5-desc\">Brings designs to life with code.</p>\n                            </div>\n                            <div class=\"tm5-card\">\n                              <img class=\"tm5-img\" src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop\">\n                              <h3 class=\"tm5-name\">Emma</h3>\n                              <p class=\"tm5-role\">Backend Dev</p>\n                              <p class=\"tm5-desc\">Architects robust server solutions.</p>\n                            </div>\n                            <div class=\"tm5-card\">\n                              <img class=\"tm5-img\" src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop\">\n                              <h3 class=\"tm5-name\">Noah</h3>\n                              <p class=\"tm5-role\">DevOps</p>\n                              <p class=\"tm5-desc\">Keeps the infrastructure running smooth.</p>\n                            </div>\n                            <div class=\"tm5-card\">\n                              <img class=\"tm5-img\" src=\"https://images.unsplash.com/photo-1531427186611-ecfd6d936c79?q=80&w=200&auto=format&fit=crop\">\n                              <h3 class=\"tm5-name\">Liam</h3>\n                              <p class=\"tm5-role\">QA Tester</p>\n                              <p class=\"tm5-desc\">Ensures everything