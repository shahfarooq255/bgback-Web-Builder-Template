  "templates": [
    {
      "id": "ps-1",
      "name": "Numbered Steps Light",
      "html": "\n<style>\n.ps1{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.ps1-header{text-align:center;max-width:600px;margin:0 auto 70px}\n.ps1-header span{color:#6366f1;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:2px}\n.ps1-header h2{font-size:clamp(32px,4vw,46px);font-weight:800;color:#111;margin:10px 0 0;letter-spacing:-1px}\n.ps1-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px;position:relative}\n.ps1-grid::before{content:'';position:absolute;top:40px;left:60px;right:60px;height:2px;background:linear-gradient(90deg,#6366f1,#a78bfa);z-index:0}\n.ps1-step{text-align:center;position:relative;z-index:1}\n.ps1-num{width:80px;height:80px;background:#fff;border:3px solid #6366f1;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#6366f1;margin:0 auto 25px;box-shadow:0 0 0 8px #fff}\n.ps1-title{font-size:18px;font-weight:700;color:#111;margin:0 0 12px}\n.ps1-desc{font-size:14px;color:#666;line-height:1.6;margin:0}\n@media(max-width:768px){.ps1-grid::before{display:none}}\n</style>\n<section class=\"ps1\">\n  <div class=\"ps1-header\"><span>How It Works</span><h2>Our Simple 4-Step Process</h2></div>\n  <div class=\"ps1-grid\">\n    <div class=\"ps1-step\"><div class=\"ps1-num\">1</div><h3 class=\"ps1-title\">Discovery Call</h3><p class=\"ps1-desc\">We start with understanding your vision, goals, and unique challenges in depth.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">2</div><h3 class=\"ps1-title\">Strategy & Plan</h3><p class=\"ps1-desc\">Our team crafts a custom roadmap with clear milestones and deliverables.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">3</div><h3 class=\"ps1-title\">Build & Iterate</h3><p class=\"ps1-desc\">We develop, test, and refine continuously with your feedback at every stage.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">4</div><h3 class=\"ps1-title\">Launch & Support</h3><p class=\"ps1-desc\">Go live with confidence and continuous support from our dedicated team.</p></div>\n  </div>\n</section>"
    },
    {
      "id": "ps-2",
      "name": "Dark Zig-Zag Process",
      "html": "\n<style>\n.ps2{padding:100px 20px;background:#0d0d14;font-family:'Inter',sans-serif}\n.ps2 h2{text-align:center;color:#fff;font-size:clamp(30px,4vw,44px);font-weight:800;margin:0 0 70px;letter-spacing:-1px}\n.ps2-list{max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:50px}\n.ps2-item{display:flex;gap:40px;align-items:center}\n.ps2-item:nth-child(even){flex-direction:row-reverse}\n.ps2-icon-wrap{width:120px;height:120px;border-radius:24px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:48px}\n.ps2-content{flex:1}\n.ps2-num{font-size:12px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px}\n.ps2-title{font-size:24px;font-weight:700;color:#fff;margin:0 0 15px;line-height:1.2}\n.ps2-desc{color:#888;font-size:15px;line-height:1.7;margin:0}\n@media(max-width:700px){.ps2-item,.ps2-item:nth-child(even){flex-direction:column}.ps2-icon-wrap{width:80px;height:80px;font-size:32px}}\n</style>\n<section class=\"ps2\">\n  <h2>How We Work</h2>\n  <div class=\"ps2-list\">\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🎯</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 01</div><h3 class=\"ps2-title\">Define the Challenge</h3><p class=\"ps2-desc\">We deep-dive into your business to uncover the root problems and craft the right questions before we touch a single line of code.</p></div></div>\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🛠️</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 02</div><h3 class=\"ps2-title\">Design the Solution</h3><p class=\"ps2-desc\">Our architects and designers collaborate on wireframes, prototypes, and technical blueprints — all reviewed and approved by you.</p></div></div>\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🚀</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 03</div><h3 class=\"ps2-title\">Build & Deploy</h3><p class=\"ps2-desc\">Agile sprints, continuous integration, and rigorous testing ensure a polished product lands in your hands on time, every time.</p></div></div>\n  </div>\n</section>"
    },
    {
      "id": "ps-3",
      "name": "Gradient Cards Process",
      "html": "\n<style>\n.ps3{padding:100px 20px;background:linear-gradient(135deg,#f0f4ff,#faf5ff);font-family:'Inter',sans-serif}\n.ps3-header{text-align:center;max-width:600px;margin:0 auto 60px}\n.ps3-header h2{font-size:clamp(32px,4vw,48px);font-weight:800;color:#0f172a;margin:0 0 15px;letter-spacing:-1px}\n.ps3-header p{color:#64748b;font-size:16px}\n.ps3-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:25px}\n.ps3-card{border-radius:24px;padding:40px 30px;position:relative;overflow:hidden;color:#fff;transition:transform 0.3s}\n.ps3-card:hover{transform:translateY(-8px)}\n.ps3-c1{background:linear-gradient(135deg,#6366f1,#8b5cf6)}\n.ps3-c2{background:linear-gradient(135deg,#10b981,#059669)}\n.ps3-c3{background:linear-gradient(135deg,#f59e0b,#ef4444)}\n.ps3-c4{background:linear-gradient(135deg,#3b82f6,#06b6d4)}\n.ps3-card::before{content:'';position:absolute;bottom:-30px;right:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,0.1)}\n.ps3-num{font-size:52px;font-weight:900;opacity:0.2;line-height:1;margin-bottom:20px}\n.ps3-icon{font-size:36px;margin-bottom:15px;display:block}\n.ps3-title{font-size:20px;font-weight:700;margin:0 0 12px}\n.ps3-desc{font-size:14px;opacity:0.85;line-height:1.6;margin:0}\n</style>\n<section class=\"ps3\">\n  <div class=\"ps3-header\">\n    <h2>How We Deliver Results</h2>\n    <p>A clear, proven process that takes you from idea to launch with zero guesswork.</p>\n  </div>\n  <div class=\"ps3-grid\">\n    <div class=\"ps3-card ps3-c1\"><div class=\"ps3-num\">01</div><span class=\"ps3-icon\">🔍</span><h3 class=\"ps3-title\">Research & Discover</h3><p class=\"ps3-desc\">We analyze your market, competitors, and user needs to build a solid foundation.</p></div>\n    <div class=\"ps3-card ps3-c2\"><div class=\"ps3-num\">02</div><span class=\"ps3-icon\">✏️</span><h3 class=\"ps3-title\">Design & Prototype</h3><p class=\"ps3-desc\">From wireframes to high-fidelity mockups, we visualize every part of the experience.</p></div>\n    <div class=\"ps3-card ps3-c3\"><div class=\"ps3-num\">03</div><span class=\"ps3-icon\">⚙️</span><h3 class=\"ps3-title\">Build & Test</h3><p class=\"ps3-desc\">Our engineers write clean, scalable code with continuous QA at every sprint.</p></div>\n    <div class=\"ps3-card ps3-c4\"><div class=\"ps3-num\">04</div><span class=\"ps3-icon\">🚀</span><h3 class=\"ps3-title\">Launch & Grow</h3><p class=\"ps3-desc\">We deploy, monitor, and iterate continuously so your product keeps improving.</p></div>\n  </div>\n</section>"
    },
    {
      "id": "ps-4",
      "name": "Vertical Timeline Steps",
      "html": "\n<style>\n.ps4{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.ps4-wrap{max-width:800px;margin:0 auto}\n.ps4-head{text-align:center;margin-bottom:70px}\n.ps4-head h2{font-size:clamp(32px,5vw,52px);font-weight:800;color:#0f172a;margin:0;letter-spacing:-1px}\n.ps4-list{position:relative;padding-left:60px}\n.ps4-list::before{content:'';position:absolute;left:22px;top:0;bottom:0;width:3px;background:linear-gradient(to bottom,#6366f1,#e2e8f0)}\n.ps4-item{position:relative;margin-bottom:50px}\n.ps4-item:last-child{margin-bottom:0}\n.ps4-dot{position:absolute;left:-47px;top:6px;width:50px;height:50px;border-radius:50%;background:#6366f1;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;box-shadow:0 0 0 6px #fff,0 0 0 8px #e0e7ff}\n.ps4-content{background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;padding:28px 30px;transition:all 0.3s}\n.ps4-item:hover .ps4-content{border-color:#6366f1;box-shadow:0 8px 25px rgba(99,102,241,0.1)}\n.ps4-tag{font-size:11px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:10px}\n.ps4-title{font-size:22px;font-weight:700;color:#0f172a;margin:0 0 10px}\n.ps4-desc{font-size:15px;color:#64748b;line-height:1.7;margin:0}\n</style>\n<section class=\"ps4\">\n  <div class=\"ps4-wrap\">\n    <div class=\"ps4-head\"><h2>Our Process</h2></div>\n    <div class=\"ps4-list\">\n      <div class=\"ps4-item\"><div class=\"ps4-dot\">1</div><div class=\"ps4-content\"><div class=\"ps4-tag\">Week 1</div><h3 class=\"ps4-title\">Onboarding & Discovery</h3><p class=\"ps4-desc\">We get to know you, your business goals, target audience, and existing systems through structured workshops.</p></div></div>\n      <div class=\"ps4-item\"><div class=\"ps4-dot\">2</div><div class=\"ps4-content\"><div class=\"ps4-tag\">Week 2-3</div><h3 class=\"ps4-title\">Strategy & Architecture</h3><p class=\"ps4-desc\">We define the technical roadmap, design system, and content architecture before any development begins.</p></div></div>\n      <div class=\"ps4-item\"><div class=\"ps4-dot\">3</div><div class=\"ps4-content\"><div class=\"ps4-tag\">Week 4-8</div><h3 class=\"ps4-title\">Design & Development</h3><p class=\"ps4-desc\">Iterative sprints deliver working features every week, with stakeholder reviews to keep alignment strong.</p></div></div>\n      <div class=\"ps4-item\"><div class=\"ps4-dot\">4</div><div class=\"ps4-content\"><div class=\"ps4-tag\">Week 9-10</div><h3 class=\"ps4-title\">QA, Launch & Handoff</h3><p class=\"ps4-desc\">Thorough testing, performance optimization, and a smooth launch followed by a 30-day support window.</p></div></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ps-5",
      "name": "Neo-Brutalism Steps",
      "html": "\n<style>\n.ps5{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.ps5-wrap{max-width:1000px;margin:0 auto}\n.ps5-top{margin-bottom:60px;border-bottom:5px solid #000;padding-bottom:25px}\n.ps5-top h2{font-size:clamp(44px,6vw,80px);font-weight:900;color:#000;text-transform:uppercase;margin:0;letter-spacing:-2px;line-height:1}\n.ps5-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0;border:4px solid #000}\n.ps5-step{padding:35px 30px;border-right:4px solid #000;position:relative;background:#fff;transition:background 0.2s}\n.ps5-step:last-child{border-right:none}\n.ps5-step:hover{background:#fef9c3}\n.ps5-step-num{font-size:80px;font-weight:900;color:#000;line-height:1;opacity:0.08;position:absolute;top:10px;right:15px}\n.ps5-icon{font-size:36px;margin-bottom:20px;display:block}\n.ps5-title{font-size:20px;font-weight:900;color:#000;text-transform:uppercase;margin:0 0 12px;letter-spacing:-0.5px}\n.ps5-desc{font-size:14px;color:#555;line-height:1.6;margin:0;font-weight:500}\n@media(max-width:768px){.ps5-grid{grid-template-columns:1fr}.ps5-step{border-right:none;border-bottom:4px solid #000}.ps5-step:last-child{border-bottom:none}}\n</style>\n<section class=\"ps5\">\n  <div class=\"ps5-wrap\">\n    <div class=\"ps5-top\">\n      <h2>The Way<br>We Work</h2>\n    </div>\n    <div class=\"ps5-grid\">\n      <div class=\"ps5-step\"><div class=\"ps5-step-num\">1</div><span class=\"ps5-icon\">🎯</span><h3 class=\"ps5-title\">Scope</h3><p class=\"ps5-desc\">Define goals, audience and success metrics clearly upfront.</p></div>\n      <div class=\"ps5-step\"><div class=\"ps5-step-num\">2</div><span class=\"ps5-icon\">🗺️</span><h3 class=\"ps5-title\">Plan</h3><p class=\"ps5-desc\">Build a detailed roadmap with timelines and deliverables.</p></div>\n      <div class=\"ps5-step\"><div class=\"ps5-step-num\">3</div><span class=\"ps5-icon\">🔨</span><h3 class=\"ps5-title\">Execute</h3><p class=\"ps5-desc\">Ship fast in weekly sprints with continuous feedback loops.</p></div>\n      <div class=\"ps5-step\"><div class=\"ps5-step-num\">4</div><span class=\"ps5-icon\">📊</span><h3 class=\"ps5-title\">Measure</h3><p class=\"ps5-desc\">Track KPIs and optimize performance post-launch relentlessly.</p></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ps-6",
      "name": "Split Side Steps",
      "html": "\n<style>\n.ps6{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;color:#fff}\n.ps6-wrap{max-width:1100px;margin:0 auto;display:flex;gap:80px;align-items:flex-start;flex-wrap:wrap}\n.ps6-left{flex:1;min-width:280px;position:sticky;top:40px}\n.ps6-left h2{font-size:clamp(36px,5vw,56px);font-weight:900;margin:0 0 20px;line-height:1.1;letter-spacing:-1px}\n.ps6-left p{color:#71717a;font-size:16px;line-height:1.7;margin:0 0 35px}\n.ps6-left-btn{display:inline-block;padding:16px 35px;background:#6366f1;color:#fff;border-radius:12px;font-weight:700;font-size:15px;text-decoration:none;transition:background 0.3s}\n.ps6-left-btn:hover{background:#4f46e5}\n.ps6-right{flex:1.5;min-width:280px;display:flex;flex-direction:column;gap:0}\n.ps6-item{display:flex;gap:25px;padding:35px 0;border-bottom:1px solid #27272a;transition:padding 0.3s}\n.ps6-item:first-child{padding-top:0}\n.ps6-item:last-child{border-bottom:none}\n.ps6-item:hover{padding-left:15px}\n.ps6-icon-wrap{width:52px;height:52px;border-radius:14px;background:#18181b;border:1px solid #27272a;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;transition:background 0.3s}\n.ps6-item:hover .ps6-icon-wrap{background:#6366f1;border-color:#6366f1}\n.ps6-content{}\n.ps6-step-label{font-size:11px;font-weight:700;color:#52525b;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px}\n.ps6-title{font-size:20px;font-weight:700;color:#f8fafc;margin:0 0 10px}\n.ps6-desc{font-size:14px;color:#71717a;line-height:1.7;margin:0}\n</style>\n<section class=\"ps6\">\n  <div class=\"ps6-wrap\">\n    <div class=\"ps6-left\">\n      <h2>Simple.<br>Powerful.<br>Process.</h2>\n      <p>We follow a refined methodology that eliminates guesswork and delivers predictable, outstanding results every time.</p>\n      <a href=\"#\" class=\"ps6-left-btn\">Work With Us &rarr;</a>\n    </div>\n    <div class=\"ps6-right\">\n      <div class=\"ps6-item\"><div class=\"ps6-icon-wrap\">💬</div><div class=\"ps6-content\"><div class=\"ps6-step-label\">Step 01</div><h3 class=\"ps6-title\">Discovery Call</h3><p class=\"ps6-desc\">A 60-minute deep dive into your goals, challenges, and vision for the project.</p></div></div>\n      <div class=\"ps6-item\"><div class=\"ps6-icon-wrap\">📐</div><div class=\"ps6-content\"><div class=\"ps6-step-label\">Step 02</div><h3 class=\"ps6-title\">Proposal & Scope</h3><p class=\"ps6-desc\">Receive a detailed proposal with timeline, pricing, and tech stack recommendations.</p></div></div>\n      <div class=\"ps6-item\"><div class=\"ps6-icon-wrap\">⚙️</div><div class=\"ps6-content\"><div class=\"ps6-step-label\">Step 03</div><h3 class=\"ps6-title\">Design & Build</h3><p class=\"ps6-desc\">Agile development with weekly demos and full transparency into progress.</p></div></div>\n      <div class=\"ps6-item\"><div class=\"ps6-icon-wrap\">🏁</div><div class=\"ps6-content\"><div class=\"ps6-step-label\">Step 04</div><h3 class=\"ps6-title\">Launch & Support</h3><p class=\"ps6-desc\">Go-live with confidence backed by our dedicated post-launch support team.</p></div></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ps-7",
      "name": "Glassmorphism Steps",
      "html": "\n<style>\n.ps7{padding:100px 20px;background:linear-gradient(135deg,#1e1b4b,#0f172a);font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.ps7-blob{position:absolute;width:500px;height:500px;border-radius:50%;filter:blur(100px);opacity:0.3}\n.ps7-blob1{background:#7c3aed;top:-150px;left:-100px}\n.ps7-blob2{background:#3b82f6;bottom:-150px;right:-100px}\n.ps7-wrap{position:relative;z-index:2;max-width:1100px;margin:0 auto}\n.ps7-head{text-align:center;color:#fff;margin-bottom:70px}\n.ps7-head h2{font-size:clamp(32px,5vw,52px);font-weight:900;margin:0 0 15px;letter-spacing:-1px}\n.ps7-head p{color:#94a3b8;font-size:16px}\n.ps7-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}\n.ps7-step{background:rgba(255,255,255,0.04);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:35px 28px;color:#fff;position:relative;transition:transform 0.3s,background 0.3s}\n.ps7-step:hover{transform:translateY(-8px);background:rgba(255,255,255,0.08)}\n.ps7-conn{position:absolute;top:50%;right:-12px;width:24px;height:24px;background:#6366f1;border-radius:50%;z-index:3;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:900}\n.ps7-steps .ps7-step:last-child .ps7-conn{display:none}\n.ps7-num{font-size:13px;font-weight:700;color:#a78bfa;text-transform:uppercase;letter-spacing:2px;margin-bottom:20px}\n.ps7-icon{font-size:36px;display:block;margin-bottom:18px}\n.ps7-title{font-size:19px;font-weight:700;margin:0 0 12px;color:#f8fafc}\n.ps7-desc{font-size:14px;color:rgba(255,255,255,0.6);line-height:1.6;margin:0}\n@media(max-width:768px){.ps7-conn{display:none!important}}\n</style>\n<section class=\"ps7\">\n  <div class=\"ps7-blob ps7-blob1\"></div>\n  <div class=\"ps7-blob ps7-blob2\"></div>\n  <div class=\"ps7-wrap\">\n    <div class=\"ps7-head\">\n      <h2>Built for Speed & Quality</h2>\n      <p>Every project follows our battle-tested process designed to minimize risk and maximize results.</p>\n    </div>\n    <div class=\"ps7-steps\">\n      <div class=\"ps7-step\"><div class=\"ps7-conn\">&rarr;</div><div class=\"ps7-num\">Step 01</div><span class=\"ps7-icon\">🔭</span><h3 class=\"ps7-title\">Explore</h3><p class=\"ps7-desc\">Understand the problem space and define a clear direction.</p></div>\n      <div class=\"ps7-step\"><div class=\"ps7-conn\">&rarr;</div><div class=\"ps7-num\">Step 02</div><span class=\"ps7-icon\">🎨</span><h3 class=\"ps7-title\">Design</h3><p class=\"ps7-desc\">Create wireframes and prototypes with user-first thinking.</p></div>\n      <div class=\"ps7-step\"><div class=\"ps7-conn\">&rarr;</div><div class=\"ps7-num\">Step 03</div><span class=\"ps7-icon\">💻</span><h3 class=\"ps7-title\">Develop</h3><p class=\"ps7-desc\">Build with clean, maintainable code and modern best practices.</p></div>\n      <div class=\"ps7-step\"><div class=\"ps7-num\">Step 04</div><span class=\"ps7-icon\">🚀</span><h3 class=\"ps7-title\">Deploy</h3><p class=\"ps7-desc\">Launch with automated testing, monitoring and zero-downtime deployment.</p></div>\n    </div>\n  </div>\n</section>"
    }
  ]
}
