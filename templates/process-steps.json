  "templates": [
    {
      "id": "ps-1",
      "name": "Numbered Steps Light",
      "html": "\n<style>\n.ps1{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.ps1-header{text-align:center;max-width:600px;margin:0 auto 70px}\n.ps1-header span{color:#6366f1;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:2px}\n.ps1-header h2{font-size:clamp(32px,4vw,46px);font-weight:800;color:#111;margin:10px 0 0;letter-spacing:-1px}\n.ps1-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px;position:relative}\n.ps1-grid::before{content:'';position:absolute;top:40px;left:60px;right:60px;height:2px;background:linear-gradient(90deg,#6366f1,#a78bfa);z-index:0}\n.ps1-step{text-align:center;position:relative;z-index:1}\n.ps1-num{width:80px;height:80px;background:#fff;border:3px solid #6366f1;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#6366f1;margin:0 auto 25px;box-shadow:0 0 0 8px #fff}\n.ps1-title{font-size:18px;font-weight:700;color:#111;margin:0 0 12px}\n.ps1-desc{font-size:14px;color:#666;line-height:1.6;margin:0}\n@media(max-width:768px){.ps1-grid::before{display:none}}\n</style>\n<section class=\"ps1\">\n  <div class=\"ps1-header\"><span>How It Works</span><h2>Our Simple 4-Step Process</h2></div>\n  <div class=\"ps1-grid\">\n    <div class=\"ps1-step\"><div class=\"ps1-num\">1</div><h3 class=\"ps1-title\">Discovery Call</h3><p class=\"ps1-desc\">We start with understanding your vision, goals, and unique challenges in depth.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">2</div><h3 class=\"ps1-title\">Strategy & Plan</h3><p class=\"ps1-desc\">Our team crafts a custom roadmap with clear milestones and deliverables.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">3</div><h3 class=\"ps1-title\">Build & Iterate</h3><p class=\"ps1-desc\">We develop, test, and refine continuously with your feedback at every stage.</p></div>\n    <div class=\"ps1-step\"><div class=\"ps1-num\">4</div><h3 class=\"ps1-title\">Launch & Support</h3><p class=\"ps1-desc\">Go live with confidence and continuous support from our dedicated team.</p></div>\n  </div>\n</section>"
    },
    {
      "id": "ps-2",
      "name": "Dark Zig-Zag Process",
      "html": "\n<style>\n.ps2{padding:100px 20px;background:#0d0d14;font-family:'Inter',sans-serif}\n.ps2 h2{text-align:center;color:#fff;font-size:clamp(30px,4vw,44px);font-weight:800;margin:0 0 70px;letter-spacing:-1px}\n.ps2-list{max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:50px}\n.ps2-item{display:flex;gap:40px;align-items:center}\n.ps2-item:nth-child(even){flex-direction:row-reverse}\n.ps2-icon-wrap{width:120px;height:120px;border-radius:24px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:48px}\n.ps2-content{flex:1}\n.ps2-num{font-size:12px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px}\n.ps2-title{font-size:24px;font-weight:700;color:#fff;margin:0 0 15px;line-height:1.2}\n.ps2-desc{color:#888;font-size:15px;line-height:1.7;margin:0}\n@media(max-width:700px){.ps2-item,.ps2-item:nth-child(even){flex-direction:column}.ps2-icon-wrap{width:80px;height:80px;font-size:32px}}\n</style>\n<section class=\"ps2\">\n  <h2>How We Work</h2>\n  <div class=\"ps2-list\">\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🎯</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 01</div><h3 class=\"ps2-title\">Define the Challenge</h3><p class=\"ps2-desc\">We deep-dive into your business to uncover the root problems and craft the right questions before we touch a single line of code.</p></div></div>\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🛠️</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 02</div><h3 class=\"ps2-title\">Design the Solution</h3><p class=\"ps2-desc\">Our architects and designers collaborate on wireframes, prototypes, and technical blueprints — all reviewed and approved by you.</p></div></div>\n    <div class=\"ps2-item\"><div class=\"ps2-icon-wrap\">🚀</div><div class=\"ps2-content\"><div class=\"ps2-num\">Step 03</div><h3 class=\"ps2-title\">Build & Deploy</h3><p class=\"ps2-desc\">Agile sprints, continuous integration, and rigorous testing ensure a polished product lands in your hands on time, every time.</p></div></div>\n  </div>\n</section>"
    }
  ]
}