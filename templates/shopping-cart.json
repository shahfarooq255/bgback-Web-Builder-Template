    {
      "id": "shopping-cart-1",
      "name": "Clean Split Cart",
      "description": "Modern split layout: items on left, order summary on right",
      "html": "\n                        <style>\n                          .crt1-wrap{padding:80px 20px;background:#f9fafb;font-family:sans-serif;}\n                          .crt1-inner{max-width:1100px;margin:0 auto;}\n                          .crt1-head{font-size:clamp(28px,4vw,36px);font-weight:800;color:#111;margin:0 0 30px;}\n                          .crt1-grid{display:flex;gap:40px;align-items:flex-start;}\n                          .crt1-items{flex:1;background:#fff;border-radius:16px;padding:30px;box-shadow:0 4px 20px rgba(0,0,0,0.03);}\n                          .crt1-item{display:flex;gap:20px;padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid #f1f5f9;align-items:center;}\n                          .crt1-item:last-child{border-bottom:none;padding-bottom:0;margin-bottom:0;}\n                          .crt1-img{width:100px;height:100px;border-radius:10px;object-fit:cover;background:#f1f5f9;flex-shrink:0;}\n                          .crt1-info{flex:1;}\n                          .crt1-name{font-size:18px;font-weight:700;color:#111;margin:0 0 5px;}\n                          .crt1-meta{color:#6b7280;font-size:14px;margin:0 0 10px;}\n                          .crt1-qty{display:flex;align-items:center;border:1px solid #e5e7eb;border-radius:8px;width:fit-content;}\n                          .crt1-qty button{background:transparent;border:none;padding:5px 12px;font-size:16px;cursor:pointer;color:#374151;}\n                          .crt1-qty span{font-size:14px;font-weight:600;padding:0 10px;}\n                          .crt1-price-wrap{text-align:right;}\n                          .crt1-price{font-size:18px;font-weight:800;color:#111;margin-bottom:10px;}\n                          .crt1-remove{color:#ef4444;font-size:13px;font-weight:600;background:none;border:none;cursor:pointer;}\n                          .crt1-summary{width:360px;background:#fff;border-radius:16px;padding:30px;box-shadow:0 4px 20px rgba(0,0,0,0.03);}\n                          .crt1-sum-head{font-size:20px;font-weight:800;color:#111;margin:0 0 20px;}\n                          .crt1-row{display:flex;justify-content:space-between;margin-bottom:15px;color:#374151;font-size:15px;}\n                          .crt1-total{display:flex;justify-content:space-between;margin:20px 0;padding-top:20px;border-top:1px solid #e5e7eb;font-size:22px;font-weight:900;color:#111;}\n                          .crt1-btn{width:100%;padding:16px;background:#111;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;transition:background 0.2s;}\n                          .crt1-btn:hover{background:#333;}\n                          @media(max-width:850px){.crt1-grid{flex-direction:column;gap:30px;} .crt1-summary{width:100%;}}\n                          @media(max-width:500px){.crt1-item{flex-direction:column;align-items:flex-start;} .crt1-img{width:100%;height:200px;} .crt1-price-wrap{text-align:left;width:100%;display:flex;justify-content:space-between;align-items:center;margin-top:10px;} .crt1-price{margin:0;}}\n                        </style>\n                        <section class=\"crt1-wrap\">\n                          <div class=\"crt1-inner\">\n                            <h2 class=\"crt1-head\">Shopping Cart (2)</h2>\n                            <div class=\"crt1-grid\">\n                              <div class=\"crt1-items\">\n                                <div class=\"crt1-item\">\n                                  <img class=\"crt1-img\" src=\"https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=200&auto=format&fit=crop\" alt=\"Watch\">\n                                  <div class=\"crt1-info\">\n                                    <h3 class=\"crt1-name\">Smart Watch Series 7</h3>\n                                    <p class=\"crt1-meta\">Color: Midnight Black</p>\n                                    <div class=\"crt1-qty\"><button>−</button><span>1</span><button>+</button></div>\n                                  </div>\n                                  <div class=\"crt1-price-wrap\">\n                                    <div class=\"crt1-price\">$399.00</div>\n                                    <button class=\"crt1-remove\">Remove</button>\n                                  </div>\n                                </div>\n                                <div class=\"crt1-item\">\n                                  <img class=\"crt1-img\" src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=200&auto=format&fit=crop\" alt=\"Perfume\">\n                                  <div class=\"crt1-info\">\n                                    <h3 class=\"crt1-name\">Luxury Elixir Perfume</h3>\n                                    <p class=\"crt1-meta\">Size: 100ml</p>\n                                    <div class=\"crt1-qty\"><button>−</button><span>2</span><button>+</button></div>\n                                  </div>\n                                  <div class=\"crt1-price-wrap\">\n                                    <div class=\"crt1-price\">$178.00</div>\n                                    <button class=\"crt1-remove\">Remove</button>\n                                  </div>\n                                </div>\n                              </div>\n                              <div class=\"crt1-summary\">\n                                <h3 class=\"crt1-sum-head\">Order Summary</h3>\n                                <div class=\"crt1-row\"><span>Subtotal</span><span>$577.00</span></div>\n                                <div class=\"crt1-row\"><span>Shipping</span><span>Free</span></div>\n                                <div class=\"crt1-row\"><span>Tax</span><span>$45.50</span></div>\n                                <div class=\"crt1-total\"><span>Total</span><span>$622.50</span></div>\n                                <button class=\"crt1-btn\">Proceed to Checkout</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "shopping-cart-2",
      "name": "Dark Mode Cart",
      "description": "Sleek dark theme shopping cart with neon accents",
      "html": "\n                        <style>\n                          .crt2-wrap{padding:80px 20px;background:#050505;font-family:sans-serif;}\n                          .crt2-inner{max-width:900px;margin:0 auto;}\n                          .crt2-head{font-size:clamp(26px,4vw,34px);font-weight:900;color:#fff;margin:0 0 30px;}\n                          .crt2-list{background:#111;border:1px solid #222;border-radius:16px;padding:30px;margin-bottom:30px;}\n                          .crt2-item{display:grid;grid-template-columns:80px 1fr auto auto;gap:20px;align-items:center;padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid #222;}\n                          .crt2-item:last-child{border-bottom:none;padding-bottom:0;margin-bottom:0;}\n                          .crt2-img{width:80px;height:80px;border-radius:10px;object-fit:cover;background:#222;}\n                          .crt2-name{font-size:16px;font-weight:700;color:#f9fafb;margin:0 0 4px;}\n                          .crt2-cat{color:#6b7280;font-size:13px;}\n                          .crt2-qty{display:flex;align-items:center;background:#000;border:1px solid #333;border-radius:8px;padding:4px;}\n                          .crt2-qty button{background:none;border:none;color:#fff;width:28px;height:28px;font-size:16px;cursor:pointer;border-radius:4px;}\n                          .crt2-qty button:hover{background:#222;}\n                          .crt2-qty span{color:#fff;font-size:14px;font-weight:700;width:30px;text-align:center;}\n                          .crt2-price{font-size:18px;font-weight:800;color:#fff;text-align:right;}\n                          .crt2-close{color:#6b7280;background:none;border:none;cursor:pointer;font-size:20px;margin-left:15px;}\n                          .crt2-close:hover{color:#ef4444;}\n                          .crt2-bottom{display:flex;justify-content:space-between;align-items:center;background:#111;border:1px solid #222;border-radius:16px;padding:25px 30px;}\n                          .crt2-total-lbl{color:#9ca3af;font-size:15px;margin-bottom:5px;}\n                          .crt2-total-val{color:#fff;font-size:28px;font-weight:900;}\n                          .crt2-btn{padding:16px 36px;background:linear-gradient(90deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:800;cursor:pointer;}\n                          @media(max-width:650px){\n                            .crt2-item{grid-template-columns:1fr;gap:15px;position:relative;}\n                            .crt2-img{width:100%;height:180px;}\n                            .crt2-close{position:absolute;top:10px;right:10px;background:rgba(0,0,0,0.5);width:32px;height:32px;border-radius:50%;color:#fff;}\n                            .crt2-qty{justify-content:space-between;width:100%;}\n                            .crt2-price{text-align:left;}\n                            .crt2-bottom{flex-direction:column;gap:20px;align-items:stretch;}\n                            .crt2-btn{width:100%;}\n                          }\n                        </style>\n                        <section class=\"crt2-wrap\">\n                          <div class=\"crt2-inner\">\n                            <h2 class=\"crt2-head\">Your Cart</h2>\n                            <div class=\"crt2-list\">\n                              <div class=\"crt2-item\">\n                                <img class=\"crt2-img\" src=\"https://images.unsplash.com/photo-1593305841991-05c297ba4575?q=80&w=200&auto=format&fit=crop\" alt=\"Headset\">\n                                <div>\n                                  <h3 class=\"crt2-name\">ProSound X7 Headset</h3>\n                                  <p class=\"crt2-cat\">Gaming Accessories</p>\n                                </div>\n                                <div class=\"crt2-qty\"><button>−</button><span>1</span><button>+</button></div>\n                                <div style=\"display:flex;align-items:center;\">\n                                  <div class=\"crt2-price\">$299</div>\n                                  <button class=\"crt2-close\">×</button>\n                                </div>\n                              </div>\n                              <div class=\"crt2-item\">\n                                <img class=\"crt2-img\" src=\"https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?q=80&w=200&auto=format&fit=crop\" alt=\"Camera\">\n                                <div>\n                                  <h3 class=\"crt2-name\">Retro Pro XL Camera</h3>\n                                  <p class=\"crt2-cat\">Electronics</p>\n                                </div>\n                                <div class=\"crt2-qty\"><button>−</button><span>1</span><button>+</button></div>\n                                <div style=\"display:flex;align-items:center;\">\n                                  <div class=\"crt2-price\">$1,299</div>\n                                  <button class=\"crt2-close\">×</button>\n                                </div>\n                              </div>\n                            </div>\n                            <div class=\"crt2-bottom\">\n                              <div>\n                                <div class=\"crt2-total-lbl\">Estimated Total</div>\n                                <div class=\"crt2-total-val\">$1,598.00</div>\n                              </div>\n                              <button class=\"crt2-btn\">Secure Checkout →</button>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "shopping-cart-3",
      "name": "Minimal Drawer Style",
      "description": "Cart presented as a floating card, similar to a side drawer layout",
      "html": "\n                        <style>\n                          .crt3-wrap{padding:80px 20px;background:#e5e7eb;font-family:sans-serif;display:flex;justify-content:center;}\n                          .crt3-card{width:100%;max-width:480px;background:#fff;border-radius:24px;box-shadow:0 20px 40px rgba(0,0,0,0.1);display:flex;flex-direction:column;}\n                          .crt3-head{padding:25px 30px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;}\n                          .crt3-head h2{margin:0;font-size:22px;font-weight:800;color:#111;}\n                          .crt3-count{background:#111;color:#fff;font-size:12px;font-weight:700;padding:4px 10px;border-radius:20px;}\n                          .crt3-body{padding:20px 30px;max-height:400px;overflow-y:auto;display:flex;flex-direction:column;gap:20px;}\n                          .crt3-item{display:flex;gap:15px;align-items:center;}\n                          .crt3-img{width:70px;height:70px;border-radius:10px;object-fit:cover;background:#f9fafb;}\n                          .crt3-info{flex:1;}\n                          .crt3-name{font-size:15px;font-weight:700;color:#111;margin:0 0 4px;}\n                          .crt3-price{font-size:14px;color:#6b7280;margin:0 0 8px;}\n                          .crt3-qty-wrap{display:flex;align-items:center;justify-content:space-between;}\n                          .crt3-qty{display:flex;align-items:center;gap:12px;background:#f1f5f9;padding:4px 12px;border-radius:20px;font-size:14px;font-weight:600;}\n                          .crt3-qty button{background:none;border:none;cursor:pointer;font-weight:700;}\n                          .crt3-remove{color:#9ca3af;font-size:13px;text-decoration:underline;background:none;border:none;cursor:pointer;}\n                          .crt3-foot{padding:25px 30px;border-top:1px solid #f1f5f9;background:#fafafa;border-radius:0 0 24px 24px;}\n                          .crt3-row{display:flex;justify-content:space-between;margin-bottom:10px;font-size:15px;color:#374151;}\n                          .crt3-total{display:flex;justify-content:space-between;margin:15px 0 20px;font-size:20px;font-weight:800;color:#111;}\n                          .crt3-btn{width:100%;padding:15px;background:#111;color:#fff;border:none;border-radius:14px;font-size:16px;font-weight:700;cursor:pointer;}\n                          @media(max-width:400px){.crt3-head,.crt3-body,.crt3-foot{padding:20px;}}\n                        </style>\n                        <section class=\"crt3-wrap\">\n                          <div class=\"crt3-card\">\n                            <div class=\"crt3-head\">\n                              <h2>Cart</h2>\n                              <span class=\"crt3-count\">3 Items</span>\n                            </div>\n                            <div class=\"crt3-body\">\n                              <div class=\"crt3-item\">\n                                <img class=\"crt3-img\" src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=200&auto=format&fit=crop\" alt=\"Shoe\">\n                                <div class=\"crt3-info\">\n                                  <h4 class=\"crt3-name\">UltraRun Air Pro</h4>\n                                  <p class=\"crt3-price\">$129.00</p>\n                                  <div class=\"crt3-qty-wrap\">\n                                    <div class=\"crt3-qty\"><button>−</button><span>1</span><button>+</button></div>\n                                    <button class=\"crt3-remove\">Remove</button>\n                                  </div>\n                                </div>\n                              </div>\n                              <div class=\"crt3-item\">\n                                <img class=\"crt3-img\" src=\"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=200&auto=format&fit=crop\" alt=\"Bag\">\n                                <div class=\"crt3-info\">\n                                  <h4 class=\"crt3-name\">Quilted Leather Bag</h4>\n                                  <p class=\"crt3-price\">$849.00</p>\n                                  <div class=\"crt3-qty-wrap\">\n                                    <div class=\"crt3-qty\"><button>−</button><span>1</span><button>+</button></div>\n                                    <button class=\"crt3-remove\">Remove</button>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div class=\"crt3-foot\">\n                              <div class=\"crt3-row\"><span>Subtotal</span><span>$978.00</span></div>\n                              <div class=\"crt3-row\"><span>Taxes</span><span>Calculated at checkout</span></div>\n                              <div class=\"crt3-total\"><span>Total</span><span>$978.00</span></div>\n                              <button class=\"crt3-btn\">Checkout</button>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "shopping-cart-4",
      "name": "Table Layout Cart",
      "description": "Classic horizontal row table layout, fully responsive",
      "html": "\n                        <style>\n                          .crt4-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .crt4-inner{max-width:1100px;margin:0 auto;}\n                          .crt4-head{font-size:clamp(26px,4vw,34px);font-weight:800;color:#111;margin:0 0 30px;border-bottom:2px solid #111;padding-bottom:15px;}\n                          .crt4-table{width:100%;border-collapse:collapse;margin-bottom:40px;}\n                          .crt4-table th{text-align:left;padding:15px;color:#6b7280;font-size:13px;text-transform:uppercase;border-bottom:1px solid #e5e7eb;}\n                          .crt4-table td{padding:20px 15px;border-bottom:1px solid #e5e7eb;vertical-align:middle;}\n                          .crt4-product{display:flex;align-items:center;gap:20px;}\n                          .crt4-img{width:80px;height:80px;border-radius:8px;object-fit:cover;background:#f9fafb;}\n                          .crt4-name{font-size:16px;font-weight:700;color:#111;margin:0 0 5px;}\n                          .crt4-var{font-size:13px;color:#6b7280;margin:0;}\n                          .crt4-val{font-size:16px;font-weight:700;color:#111;}\n                          .crt4-qty{display:inline-flex;border:1px solid #d1d5db;border-radius:6px;overflow:hidden;}\n                          .crt4-qty button{background:#fff;border:none;padding:6px 12px;cursor:pointer;}\n                          .crt4-qty input{width:40px;text-align:center;border:none;border-left:1px solid #d1d5db;border-right:1px solid #d1d5db;font-weight:600;}\n                          .crt4-close{color:#9ca3af;background:none;border:none;font-size:22px;cursor:pointer;}\n                          .crt4-bottom{display:flex;justify-content:flex-end;}\n                          .crt4-box{width:100%;max-width:400px;background:#f9fafb;padding:30px;border-radius:12px;}\n                          .crt4-row{display:flex;justify-content:space-between;margin-bottom:15px;font-size:15px;color:#374151;}\n                          .crt4-total{display:flex;justify-content:space-between;margin:20px 0;padding-top:20px;border-top:1px solid #d1d5db;font-size:20px;font-weight:800;color:#111;}\n                          .crt4-btn{width:100%;padding:15px;background:#10b981;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;}\n                          @media(max-width:768px){\n                            .crt4-table thead{display:none;}\n                            .crt4-table,.crt4-table tbody,.crt4-table tr,.crt4-table td{display:block;width:100%;}\n                            .crt4-table tr{margin-bottom:20px;border:1px solid #e5e7eb;border-radius:12px;position:relative;}\n                            .crt4-table td{border-bottom:none;padding:15px;}\n                            .crt4-td-price,.crt4-td-qty,.crt4-td-total{display:flex;justify-content:space-between;align-items:center;}\n                            .crt4-td-price::before{content:'Price:';color:#6b7280;font-size:13px;}\n                            .crt4-td-qty::before{content:'Quantity:';color:#6b7280;font-size:13px;}\n                            .crt4-td-total::before{content:'Subtotal:';color:#6b7280;font-size:13px;}\n                            .crt4-td-close{position:absolute;top:10px;right:10px;padding:0;}\n                          }\n                        </style>\n                        <section class=\"crt4-wrap\">\n                          <div class=\"crt4-inner\">\n                            <h2 class=\"crt4-head\">Shopping Bag</h2>\n                            <table class=\"crt4-table\">\n                              <thead>\n                                <tr>\n                                  <th>Product</th>\n                                  <th>Price</th>\n                                  <th>Quantity</th>\n                                  <th>Total</th>\n                                  <th></th>\n                                </tr>\n                              </thead>\n                              <tbody>\n                                <tr>\n                                  <td>\n                                    <div class=\"crt4-product\">\n                                      <img class=\"crt4-img\" src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=200&auto=format&fit=crop\" alt=\"Watch\">\n                                      <div>\n                                        <p class=\"crt4-name\">Apex Watch</p>\n                                        <p class=\"crt4-var\">Size: M</p>\n                                      </div>\n                                    </div>\n                                  </td>\n                                  <td class=\"crt4-td-price\"><span class=\"crt4-val\">$249.00</span></td>\n                                  <td class=\"crt4-td-qty\">\n                                    <div class=\"crt4-qty\"><button>−</button><input type=\"text\" value=\"1\" readonly><button>+</button></div>\n                                  </td>\n                                  <td class=\"crt4-td-total\"><span class=\"crt4-val\">$249.00</span></td>\n                                  <td class=\"crt4-td-close\"><button class=\"crt4-close\">×</button></td>\n                                </tr>\n                              </tbody>\n                            </table>\n                            <div class=\"crt4-bottom\">\n                              <div class=\"crt4-box\">\n                                <div class=\"crt4-row\"><span>Subtotal</span><span>$249.00</span></div>\n                                <div class=\"crt4-row\"><span>Shipping</span><span>$10.00</span></div>\n                                <div class=\"crt4-total\"><span>Total</span><span>$259.00</span></div>\n                                <button class=\"crt4-btn\">Checkout</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "shopping-cart-5",
      "name": "Step-based Cart",
      "description": "Cart page with a checkout progress bar at the top",
      "html": "\n                        <style>\n                          .crt5-wrap{padding:60px 20px;background:#f3f4f6;font-family:sans-serif;}\n                          .crt5-inner{max-width:900px;margin:0 auto;}\n                          .crt5-steps{display:flex;justify-content:space-between;margin-bottom:40px;position:relative;}\n                          .crt5-steps::before{content:'';position:absolute;top:15px;left:0;right:0;height:2px;background:#d1d5db;z-index:1;}\n                          .crt5-step{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:10px;background:#f3f4f6;padding:0 10px;}\n                          .crt5-step-num{width:32px;height:32px;border-radius:50%;background:#fff;border:2px solid #d1d5db;display:flex;align-items:center;justify-content:center;font-weight:700;color:#9ca3af;}\n                          .crt5-step.active .crt5-step-num{border-color:#111;background:#111;color:#fff;}\n                          .crt5-step-text{font-size:13px;font-weight:700;color:#9ca3af;text-transform:uppercase;}\n                          .crt5-step.active .crt5-step-text{color:#111;}\n                          .crt5-card{background:#fff;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,0.05);overflow:hidden;}\n                          .crt5-head{padding:25px 30px;border-bottom:1px solid #f1f5f9;}\n                          .crt5-head h2{margin:0;font-size:24px;font-weight:800;color:#111;}\n                          .crt5-body{padding:30px;}\n                          .crt5-item{display:flex;gap:20px;margin-bottom:20px;padding-bottom:20px;border-bottom:1px dashed #e5e7eb;}\n                          .crt5-item:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none;}\n                          .crt5-img{width:90px;height:90px;border-radius:10px;object-fit:cover;}\n                          .crt5-info{flex:1;display:flex;flex-direction:column;justify-content:center;}\n                          .crt5-name{font-size:18px;font-weight:700;color:#111;margin:0 0 5px;}\n                          .crt5-price{font-size:16px;font-weight:700;color:#4f46e5;margin:0;}\n                          .crt5-foot{padding:25px 30px;background:#f9fafb;display:flex;justify-content:space-between;align-items:center;}\n                          .crt5-total{font-size:20px;font-weight:800;color:#111;}\n                          .crt5-btn{padding:14px 30px;background:#111;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;}\n                          @media(max-width:600px){.crt5-item{flex-direction:column;} .crt5-img{width:100%;height:150px;} .crt5-foot{flex-direction:column;gap:20px;align-items:stretch;text-align:center;} .crt5-btn{width:100%;}}\n                        </style>\n                        <section class=\"crt5-wrap\">\n                          <div class=\"crt5-inner\">\n                            <div class=\"crt5-steps\">\n                              <div class=\"crt5-step active\"><div class=\"crt5-step-num\">1</div><div class=\"crt5-step-text\">Cart</div></div>\n                              <div class=\"crt5-step\"><div class=\"crt5-step-num\">2</div><div class=\"crt5-step-text\">Details</div></div>\n                              <div class=\"crt5-step\"><div class=\"crt5-step-num\">3</div><div class=\"crt5-step-text\">Payment</div></div>\n                            </div>\n                            <div class=\"crt5-card\">\n                              <div class=\"crt5-head\">\n                                <h2>Review Cart</h2>\n                              </div>\n                              <div class=\"crt5-body\">\n                                <div class=\"crt5-item\">\n                                  <img class=\"crt5-img\" src=\"https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=200&auto=format&fit=crop\" alt=\"Watch\">\n                                  <div class=\"crt5-info\">\n                                    <h3 class=\"crt5-name\">Smart Watch Series 7</h3>\n                                    <p class=\"crt5-price\">$399.00 x 1</p>\n                                  </div>\n                                </div>\n                                <div class=\"crt5-item\">\n                                  <img class=\"crt5-img\" src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=200&auto=format&fit=crop\" alt=\"Perfume\">\n                                  <div class=\"crt5-info\">\n                                    <h3 class=\"crt5-name\">Luxury Elixir Perfume</h3>\n                                    <p class=\"crt5-price\">$89.00 x 2</p>\n                                  </div>\n                                </div>\n                              </div>\n                              <div class=\"crt5-foot\">\n                                <div class=\"crt5-total\">Total: $577.00</div>\n                                <button class=\"crt5-btn\">Continue to Details →</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
}