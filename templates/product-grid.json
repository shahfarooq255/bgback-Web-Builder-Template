    {
      "id": "product-grid-2",
      "name": "Dark Premium Grid",
      "description": "Luxury dark-themed product grid for high-end brands",
      "html": "\n                        <style>\n                          .prgd2-wrap{padding:80px 20px;background:#0a0a0a;font-family:sans-serif;}\n                          .prgd2-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;max-width:1200px;margin:0 auto;}\n                          .prgd2-item{position:relative;overflow:hidden;aspect-ratio:3/4;background:#111;}\n                          .prgd2-item img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s ease, filter 0.5s;}\n                          .prgd2-item:hover img{transform:scale(1.08);filter:brightness(0.7);}\n                          .prgd2-info{position:absolute;bottom:0;left:0;width:100%;padding:25px;background:linear-gradient(to top, rgba(0,0,0,0.9), transparent);transform:translateY(20px);opacity:0;transition:all 0.4s;box-sizing:border-box;}\n                          .prgd2-item:hover .prgd2-info{transform:translateY(0);opacity:1;}\n                          .prgd2-pname{color:#fff;font-size:18px;font-weight:700;margin:0 0 5px 0;}\n                          .prgd2-pprice{color:#d4af37;font-size:22px;font-weight:900;margin:0 0 15px 0;}\n                          .prgd2-pbtn{display:block;width:100%;padding:12px;background:#d4af37;color:#000;border:none;font-weight:700;font-size:14px;cursor:pointer;letter-spacing:1px;border-radius:4px;}\n                          @media(max-width:700px){.prgd2-grid{grid-template-columns:repeat(2,1fr);} .prgd2-info{transform:translateY(0);opacity:1;}}\n                          @media(max-width:450px){.prgd2-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"prgd2-wrap\">\n                          <div style=\"max-width:1200px;margin:0 auto;\">\n                            <div style=\"text-align:center;margin-bottom:50px;\">\n                              <span style=\"color:#d4af37;font-size:12px;font-weight:700;letter-spacing:3px;\">LUXURY COLLECTION</span>\n                              <h2 style=\"color:#fff;font-size:clamp(32px,5vw,48px);font-weight:900;margin:10px 0 0 0;\">Curated for Excellence</h2>\n                            </div>\n                            <div class=\"prgd2-grid\">\n                              <div class=\"prgd2-item\">\n                                <img src=\"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=600&auto=format&fit=crop\" alt=\"Bag\">\n                                <div class=\"prgd2-info\"><h3 class=\"prgd2-pname\">Caviar Leather Bag</h3><p class=\"prgd2-pprice\">$849</p><button class=\"prgd2-pbtn\">VIEW PRODUCT</button></div>\n                              </div>\n                              <div class=\"prgd2-item\">\n                                <img src=\"https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?q=80&w=600&auto=format&fit=crop\" alt=\"Camera\">\n                                <div class=\"prgd2-info\"><h3 class=\"prgd2-pname\">Vintage Analog Camera</h3><p class=\"prgd2-pprice\">$1,299</p><button class=\"prgd2-pbtn\">VIEW PRODUCT</button></div>\n                              </div>\n                              <div class=\"prgd2-item\">\n                                <img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=600&auto=format&fit=crop\" alt=\"Shoe\">\n                                <div class=\"prgd2-info\"><h3 class=\"prgd2-pname\">Artisan Leather Shoe</h3><p class=\"prgd2-pprice\">$349</p><button class=\"prgd2-pbtn\">VIEW PRODUCT</button></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-grid-3",
      "name": "Bento Product Layout",
      "description": "Modern bento-style asymmetric grid with featured product",
      "html": "\n                        <style>\n                          .prgd3-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prgd3-bento{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto;gap:16px;max-width:1200px;margin:0 auto;}\n                          .prgd3-featured{grid-column:span 2;grid-row:span 2;background:#f3e8ff;border-radius:20px;padding:40px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;min-height:450px;}\n                          .prgd3-featured img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:20px;}\n                          .prgd3-featured-overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.75) 40%, transparent);border-radius:20px;}\n                          .prgd3-featured-content{position:relative;z-index:1;}\n                          .prgd3-small{background:#f9fafb;border-radius:16px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;}\n                          .prgd3-small img{width:100%;height:120px;object-fit:cover;border-radius:10px;margin-bottom:10px;}\n                          @media(max-width:800px){.prgd3-bento{grid-template-columns:1fr 1fr;} .prgd3-featured{grid-column:span 2;min-height:300px;}}\n                          @media(max-width:500px){.prgd3-bento{grid-template-columns:1fr;} .prgd3-featured{grid-column:span 1;grid-row:span 1;}}\n                        </style>\n                        <section class=\"prgd3-wrap\">\n                          <div style=\"max-width:1200px;margin:0 auto;\">\n                            <div style=\"margin-bottom:40px;\"><h2 style=\"font-size:clamp(28px,4vw,40px);font-weight:800;color:#111;margin:0;\">Shop by Collection</h2></div>\n                            <div class=\"prgd3-bento\">\n                              <div class=\"prgd3-featured\">\n                                <img src=\"https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=800&auto=format&fit=crop\" alt=\"Featured\">\n                                <div class=\"prgd3-featured-overlay\"></div>\n                                <div class=\"prgd3-featured-content\">\n                                  <span style=\"color:#fde68a;font-size:12px;font-weight:700;letter-spacing:2px;\">FEATURED</span>\n                                  <h3 style=\"color:#fff;font-size:28px;font-weight:800;margin:8px 0 10px;\">The Iconic Collection</h3>\n                                  <p style=\"color:#e5e7eb;font-size:15px;margin:0 0 20px;\">Timeless pieces crafted for modern life.</p>\n                                  <button style=\"background:#fff;color:#111;padding:12px 24px;border:none;border-radius:8px;font-weight:700;cursor:pointer;\">Shop Now</button>\n                                </div>\n                              </div>\n                              <div class=\"prgd3-small\">\n                                <img src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=400&auto=format&fit=crop\" alt=\"Watch\">\n                                <div><h4 style=\"margin:0 0 4px;font-size:15px;color:#111;\">Apex Sport Watch</h4><div style=\"display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-weight:800;font-size:18px;\">$199</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">+</button></div></div>\n                              </div>\n                              <div class=\"prgd3-small\">\n                                <img src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=400&auto=format&fit=crop\" alt=\"Perfume\">\n                                <div><h4 style=\"margin:0 0 4px;font-size:15px;color:#111;\">Midnight Elixir</h4><div style=\"display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-weight:800;font-size:18px;\">$89</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">+</button></div></div>\n                              </div>\n                              <div class=\"prgd3-small\" style=\"grid-column:span 2;background:#111;color:#fff;\">\n                                <div style=\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;\"><h4 style=\"margin:0;font-size:18px;\">🔥 Flash Deal - 40% Off Headphones</h4><button style=\"background:#facc15;color:#111;border:none;padding:10px 20px;border-radius:8px;font-weight:700;cursor:pointer;\">Grab Deal</button></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-grid-4",
      "name": "Filter Tag Grid",
      "description": "Product grid with category filter tags above the grid",
      "html": "\n                        <style>\n                          .prgd4-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prgd4-filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:40px;}\n                          .prgd4-tag{padding:8px 20px;background:#f3f4f6;color:#374151;border:none;border-radius:30px;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;}\n                          .prgd4-tag.active,.prgd4-tag:hover{background:#111;color:#fff;}\n                          .prgd4-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}\n                          .prgd4-card{border-radius:12px;overflow:hidden;border:1px solid #f1f1f1;background:#fff;}\n                          .prgd4-img{height:200px;background:#f9fafb;position:relative;overflow:hidden;}\n                          .prgd4-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}\n                          .prgd4-card:hover .prgd4-img img{transform:scale(1.05);}\n                          .prgd4-wish{position:absolute;top:12px;right:12px;width:32px;height:32px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.1);}\n                          .prgd4-body{padding:15px;}\n                          .prgd4-stars{color:#f59e0b;font-size:12px;}\n                          .prgd4-name{font-size:15px;font-weight:700;color:#111;margin:5px 0 3px;}\n                          .prgd4-row{display:flex;justify-content:space-between;align-items:center;}\n                          .prgd4-price{font-size:18px;font-weight:900;color:#111;}\n                          @media(max-width:1000px){.prgd4-grid{grid-template-columns:repeat(3,1fr);}}\n                          @media(max-width:700px){.prgd4-grid{grid-template-columns:repeat(2,1fr);}}\n                          @media(max-width:440px){.prgd4-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"prgd4-wrap\">\n                          <div style=\"max-width:1200px;margin:0 auto;\">\n                            <div style=\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;margin-bottom:30px;\">\n                              <h2 style=\"font-size:clamp(26px,4vw,38px);font-weight:800;color:#111;margin:0;\">All Products</h2>\n                              <span style=\"color:#6b7280;font-size:14px;\">Showing 4 of 48 results</span>\n                            </div>\n                            <div class=\"prgd4-filters\">\n                              <button class=\"prgd4-tag active\">All</button>\n                              <button class=\"prgd4-tag\">Accessories</button>\n                              <button class=\"prgd4-tag\">Electronics</button>\n                              <button class=\"prgd4-tag\">Footwear</button>\n                              <button class=\"prgd4-tag\">Apparel</button>\n                            </div>\n                            <div class=\"prgd4-grid\">\n                              <div class=\"prgd4-card\">\n                                <div class=\"prgd4-img\"><img src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=500&auto=format&fit=crop\" alt=\"watch\"><div class=\"prgd4-wish\">♡</div></div>\n                                <div class=\"prgd4-body\"><div class=\"prgd4-stars\">★★★★★</div><h4 class=\"prgd4-name\">Precision Watch</h4><div class=\"prgd4-row\"><span class=\"prgd4-price\">$199</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">Add</button></div></div>\n                              </div>\n                              <div class=\"prgd4-card\">\n                                <div class=\"prgd4-img\"><img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=500&auto=format&fit=crop\" alt=\"shoe\"><div class=\"prgd4-wish\">♡</div></div>\n                                <div class=\"prgd4-body\"><div class=\"prgd4-stars\">★★★★☆</div><h4 class=\"prgd4-name\">Runner Pro X</h4><div class=\"prgd4-row\"><span class=\"prgd4-price\">$129</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">Add</button></div></div>\n                              </div>\n                              <div class=\"prgd4-card\">\n                                <div class=\"prgd4-img\"><img src=\"https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?q=80&w=500&auto=format&fit=crop\" alt=\"cam\"><div class=\"prgd4-wish\">♡</div></div>\n                                <div class=\"prgd4-body\"><div class=\"prgd4-stars\">★★★★★</div><h4 class=\"prgd4-name\">Retro Film Camera</h4><div class=\"prgd4-row\"><span class=\"prgd4-price\">$399</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">Add</button></div></div>\n                              </div>\n                              <div class=\"prgd4-card\">\n                                <div class=\"prgd4-img\"><img src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=500&auto=format&fit=crop\" alt=\"perfume\"><div class=\"prgd4-wish\">♡</div></div>\n                                <div class=\"prgd4-body\"><div class=\"prgd4-stars\">★★★☆☆</div><h4 class=\"prgd4-name\">Aura Noir Perfume</h4><div class=\"prgd4-row\"><span class=\"prgd4-price\">$89</span><button style=\"background:#111;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">Add</button></div></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-grid-5",
      "name": "Gradient Category Grid",
      "description": "Vibrant gradient category cards leading to product collections",
      "html": "\n                        <style>\n                          .prgd5-wrap{padding:80px 20px;background:#fafafa;font-family:sans-serif;}\n                          .prgd5-cats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:40px;}\n                          .prgd5-cat{border-radius:16px;padding:30px 20px;text-align:center;cursor:pointer;transition:transform 0.2s;}\n                          .prgd5-cat:hover{transform:scale(1.04);}\n                          .prgd5-cat-icon{font-size:42px;margin-bottom:10px;}\n                          .prgd5-cat-name{font-weight:700;font-size:16px;}\n                          .prgd5-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}\n                          .prgd5-card{background:#fff;border-radius:16px;overflow:hidden;border:1px solid #f0f0f0;}\n                          .prgd5-img{height:220px;overflow:hidden;}\n                          .prgd5-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}\n                          .prgd5-card:hover .prgd5-img img{transform:scale(1.07);}\n                          .prgd5-info{padding:20px;display:flex;justify-content:space-between;align-items:center;}\n                          @media(max-width:900px){.prgd5-cats{grid-template-columns:repeat(2,1fr);} .prgd5-grid{grid-template-columns:repeat(2,1fr);}}\n                          @media(max-width:520px){.prgd5-cats{grid-template-columns:repeat(2,1fr);} .prgd5-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"prgd5-wrap\">\n                          <div style=\"max-width:1200px;margin:0 auto;\">\n                            <div style=\"text-align:center;margin-bottom:40px;\">\n                              <h2 style=\"font-size:clamp(28px,4vw,42px);font-weight:800;color:#111;margin:0 0 10px;\">Shop by Category</h2>\n                              <p style=\"color:#6b7280;margin:0;\">Find exactly what you're looking for.</p>\n                            </div>\n                            <div class=\"prgd5-cats\">\n                              <div class=\"prgd5-cat\" style=\"background:linear-gradient(135deg,#fde68a,#fb923c);\"><div class=\"prgd5-cat-icon\">⌚</div><div class=\"prgd5-cat-name\" style=\"color:#7c2d12;\">Watches</div></div>\n                              <div class=\"prgd5-cat\" style=\"background:linear-gradient(135deg,#bfdbfe,#6366f1);\"><div class=\"prgd5-cat-icon\">🎧</div><div class=\"prgd5-cat-name\" style=\"color:#fff;\">Audio</div></div>\n                              <div class=\"prgd5-cat\" style=\"background:linear-gradient(135deg,#bbf7d0,#10b981);\"><div class=\"prgd5-cat-icon\">👟</div><div class=\"prgd5-cat-name\" style=\"color:#fff;\">Footwear</div></div>\n                              <div class=\"prgd5-cat\" style=\"background:linear-gradient(135deg,#fce7f3,#ec4899);\"><div class=\"prgd5-cat-icon\">👜</div><div class=\"prgd5-cat-name\" style=\"color:#fff;\">Bags</div></div>\n                            </div>\n                            <div class=\"prgd5-grid\">\n                              <div class=\"prgd5-card\">\n                                <div class=\"prgd5-img\"><img src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=600&auto=format&fit=crop\" alt=\"Watch\"></div>\n                                <div class=\"prgd5-info\"><div><div style=\"font-size:16px;font-weight:700;color:#111;\">Apex Chrono</div><div style=\"color:#6b7280;font-size:13px;\">Accessories</div></div><div><div style=\"font-size:22px;font-weight:900;color:#111;\">$229</div><button style=\"margin-top:5px;background:#111;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:block;width:100%;\">Buy</button></div></div>\n                              </div>\n                              <div class=\"prgd5-card\">\n                                <div class=\"prgd5-img\"><img src=\"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=600&auto=format&fit=crop\" alt=\"Bag\"></div>\n                                <div class=\"prgd5-info\"><div><div style=\"font-size:16px;font-weight:700;color:#111;\">Caviar Clutch</div><div style=\"color:#6b7280;font-size:13px;\">Bags</div></div><div><div style=\"font-size:22px;font-weight:900;color:#111;\">$349</div><button style=\"margin-top:5px;background:#111;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:block;width:100%;\">Buy</button></div></div>\n                              </div>\n                              <div class=\"prgd5-card\">\n                                <div class=\"prgd5-img\"><img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=600&auto=format&fit=crop\" alt=\"Shoe\"></div>\n                                <div class=\"prgd5-info\"><div><div style=\"font-size:16px;font-weight:700;color:#111;\">Runner V2 Pro</div><div style=\"color:#6b7280;font-size:13px;\">Footwear</div></div><div><div style=\"font-size:22px;font-weight:900;color:#111;\">$159</div><button style=\"margin-top:5px;background:#111;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:block;width:100%;\">Buy</button></div></div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
