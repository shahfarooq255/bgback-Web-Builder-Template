    {
      "id": "product-grid-1",
      "name": "Classic Shop Grid",
      "description": "Clean 3-column product grid with hover effects and badges",
      "html": "\n                        <style>\n                          .prgd1-wrap{padding:80px 20px;background:#f9fafb;font-family:sans-serif;}\n                          .prgd1-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;max-width:1200px;margin:0 auto;}\n                          .prgd1-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.05);transition:transform 0.3s, box-shadow 0.3s;}\n                          .prgd1-card:hover{transform:translateY(-6px);box-shadow:0 12px 40px rgba(0,0,0,0.12);}\n                          .prgd1-img{height:260px;position:relative;overflow:hidden;background:#f1f5f9;}\n                          .prgd1-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}\n                          .prgd1-card:hover .prgd1-img img{transform:scale(1.06);}\n                          .prgd1-badge{position:absolute;top:15px;left:15px;background:#ef4444;color:#fff;font-size:11px;font-weight:800;padding:5px 10px;border-radius:6px;letter-spacing:1px;}\n                          .prgd1-body{padding:20px;}\n                          .prgd1-name{font-size:17px;font-weight:700;color:#111;margin:0 0 6px 0;}\n                          .prgd1-cat{font-size:12px;color:#6b7280;margin:0 0 15px 0;text-transform:uppercase;letter-spacing:1px;}\n                          .prgd1-footer{display:flex;align-items:center;justify-content:space-between;}\n                          .prgd1-price{font-size:22px;font-weight:900;color:#111;}\n                          .prgd1-price s{font-size:14px;color:#9ca3af;font-weight:400;margin-left:5px;}\n                          .prgd1-btn{background:#111;color:#fff;border:none;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:background 0.2s;}\n                          .prgd1-btn:hover{background:#333;}\n                          @media(max-width:900px){.prgd1-grid{grid-template-columns:repeat(2,1fr);}}\n                          @media(max-width:560px){.prgd1-grid{grid-template-columns:1fr;}}\n                        </style>\n                        <section class=\"prgd1-wrap\">\n                          <div style=\"max-width:1200px;margin:0 auto;\">\n                            <div style=\"text-align:center;margin-bottom:50px;\">\n                              <h2 style=\"font-size:clamp(28px,5vw,42px);font-weight:800;color:#111;margin:0 0 10px 0;\">New Arrivals</h2>\n                              <p style=\"color:#6b7280;font-size:16px;margin:0;\">Discover our latest collection</p>\n                            </div>\n                            <div class=\"prgd1-grid\">\n                              <div class=\"prgd1-card\">\n                                <div class=\"prgd1-img\">\n                                  <img src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=600&auto=format&fit=crop\" alt=\"Watch\">\n                                  <span class=\"prgd1-badge\">-20%</span>\n                                </div>\n                                <div class=\"prgd1-body\">\n                                  <p class=\"prgd1-cat\">Accessories</p>\n                                  <h3 class=\"prgd1-name\">Minimalist Pro Watch</h3>\n                                  <div class=\"prgd1-footer\">\n                                    <div class=\"prgd1-price\">$149 <s>$189</s></div>\n                                    <button class=\"prgd1-btn\">Add to Cart</button>\n                                  </div>\n                                </div>\n                              </div>\n                              <div class=\"prgd1-card\">\n                                <div class=\"prgd1-img\">\n                                  <img src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=600&auto=format&fit=crop\" alt=\"Headphones\">\n                                </div>\n                                <div class=\"prgd1-body\">\n                                  <p class=\"prgd1-cat\">Electronics</p>\n                                  <h3 class=\"prgd1-name\">Studio Wireless Headphones</h3>\n                                  <div class=\"prgd1-footer\">\n                                    <div class=\"prgd1-price\">$249</div>\n                                    <button class=\"prgd1-btn\">Add to Cart</button>\n                                  </div>\n                                </div>\n                              </div>\n                              <div class=\"prgd1-card\">\n                                <div class=\"prgd1-img\">\n                                  <img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=600&auto=format&fit=crop\" alt=\"Sneakers\">\n                                  <span class=\"prgd1-badge\">NEW</span>\n                                </div>\n                                <div class=\"prgd1-body\">\n                                  <p class=\"prgd1-cat\">Footwear</p>\n                                  <h3 class=\"prgd1-name\">UltraRun Air Sneakers</h3>\n                                  <div class=\"prgd1-footer\">\n                                    <div class=\"prgd1-price\">$129</div>\n                                    <button class=\"prgd1-btn\">Add to Cart</button>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
