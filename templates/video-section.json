    {
      "id": "vs-1",
      "name": "Dark Video Hero",
      "html": "\n<style>\n.vs1{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;text-align:center}\n.vs1 h2{color:#fff;font-size:clamp(32px,5vw,52px);font-weight:800;margin:0 0 20px;letter-spacing:-1px}\n.vs1 p{color:#888;font-size:17px;margin:0 0 50px;max-width:500px;margin-left:auto;margin-right:auto}\n.vs1-player{max-width:800px;margin:0 auto;position:relative;border-radius:20px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.5)}\n.vs1-thumb{width:100%;height:450px;object-fit:cover;display:block}\n.vs1-overlay{position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .3s}\n.vs1-overlay:hover{background:rgba(0,0,0,.2)}\n.vs1-play{width:80px;height:80px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform .3s,box-shadow .3s}\n.vs1-play:hover{transform:scale(1.1);box-shadow:0 0 0 15px rgba(255,255,255,.2)}\n.vs1-play svg{width:30px;height:30px;fill:#111;margin-left:5px}\n</style>\n<section class=\"vs1\">\n  <h2>See Us In Action</h2>\n  <p>Watch how our platform transforms the way teams work.</p>\n  <div class=\"vs1-player\">\n    <img class=\"vs1-thumb\" src=\"https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop\" alt=\"Video Thumbnail\">\n    <div class=\"vs1-overlay\">\n      <div class=\"vs1-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "vs-2",
      "name": "Split Video + Text",
      "html": "\n<style>\n.vs2{padding:80px 20px;background:#fff;font-family:'Inter',sans-serif}\n.vs2-wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.vs2-text span{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#6366f1}\n.vs2-text h2{font-size:clamp(28px,4vw,40px);font-weight:800;color:#111;margin:15px 0 20px;line-height:1.2}\n.vs2-text p{color:#666;font-size:15px;line-height:1.8;margin:0 0 30px}\n.vs2-feature{display:flex;gap:15px;margin-bottom:20px;align-items:flex-start}\n.vs2-feature-icon{width:40px;height:40px;background:#ede9fe;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px}\n.vs2-feature h4{margin:0 0 5px;font-size:15px;font-weight:700;color:#111}\n.vs2-feature p{margin:0;font-size:13px;color:#666}\n.vs2-video{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:16/9;box-shadow:0 20px 50px rgba(0,0,0,.12)}\n.vs2-video img{width:100%;height:100%;object-fit:cover}\n.vs2-play-btn{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.25);cursor:pointer}\n.vs2-play-btn div{width:70px;height:70px;background:#6366f1;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform .3s}\n.vs2-play-btn div:hover{transform:scale(1.1)}\n.vs2-play-btn svg{width:26px;height:26px;fill:#fff;margin-left:5px}\n@media(max-width:768px){.vs2-wrap{grid-template-columns:1fr}}\n</style>\n<section class=\"vs2\">\n  <div class=\"vs2-wrap\">\n    <div class=\"vs2-text\">\n      <span>Watch & Learn</span>\n      <h2>Built for Speed, Designed for Results</h2>\n      <p>Discover how our platform makes complex workflows incredibly simple — in just minutes.</p>\n      <div class=\"vs2-feature\"><div class=\"vs2-feature-icon\">⚡</div><div><h4>Blazing Fast Setup</h4><p>Get up and running in under 5 minutes with zero technical knowledge.</p></div></div>\n      <div class=\"vs2-feature\"><div class=\"vs2-feature-icon\">🎯</div><div><h4>Goal-Oriented Workflow</h4><p>Every feature is designed around real outcomes, not just tasks.</p></div></div>\n    </div>\n    <div class=\"vs2-video\">\n      <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop\" alt=\"Video\">\n      <div class=\"vs2-play-btn\"><div><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "vs-3",
      "name": "Video Background Hero",
      "html": "\n<style>\n.vs3{position:relative;height:70vh;min-height:500px;display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Inter',sans-serif;color:#fff;overflow:hidden}\n.vs3-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1536240478700-b869070f9279?auto=format&fit=crop&w=1920&q=80') center/cover;z-index:1}\n.vs3-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.6);z-index:2}\n.vs3-content{position:relative;z-index:3;max-width:800px;padding:20px}\n.vs3-play{width:90px;height:90px;background:rgba(255,255,255,0.2);backdrop-filter:blur(10px);border:2px solid rgba(255,255,255,0.4);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 30px;cursor:pointer;transition:transform 0.3s,background 0.3s}\n.vs3-play:hover{transform:scale(1.1);background:rgba(255,255,255,0.3)}\n.vs3-play svg{width:36px;height:36px;fill:#fff;margin-left:6px}\n.vs3 h2{font-size:clamp(36px,6vw,60px);font-weight:900;margin:0 0 15px;letter-spacing:-1px}\n.vs3 p{font-size:18px;color:rgba(255,255,255,0.8);margin:0 0 30px;font-weight:300}\n</style>\n<section class=\"vs3\">\n  <div class=\"vs3-bg\"></div>\n  <div class=\"vs3-overlay\"></div>\n  <div class=\"vs3-content\">\n    <div class=\"vs3-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n    <h2>Discover the Future</h2>\n    <p>Take a 2-minute tour to see how our platform can revolutionize your daily operations and boost team productivity.</p>\n  </div>\n</section>"
    },
    {
      "id": "vs-4",
      "name": "Glassmorphism Video",
      "html": "\n<style>\n.vs4{padding:120px 20px;background:linear-gradient(135deg,#c4b5fd,#93c5fd);font-family:'Inter',sans-serif;position:relative}\n.vs4-wrap{max-width:1000px;margin:0 auto;text-align:center}\n.vs4-card{background:rgba(255,255,255,0.2);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.4);border-radius:30px;padding:40px;box-shadow:0 20px 40px rgba(0,0,0,0.1)}\n.vs4-text{margin-bottom:40px}\n.vs4-text h2{font-size:44px;font-weight:900;color:#1e1b4b;margin:0 0 10px;letter-spacing:-1px}\n.vs4-text p{color:#4338ca;font-size:17px;margin:0}\n.vs4-video{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:16/9;border:1px solid rgba(255,255,255,0.5)}\n.vs4-video img{width:100%;height:100%;object-fit:cover}\n.vs4-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:70px;height:70px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 10px 20px rgba(99,102,241,0.4);transition:transform 0.3s}\n.vs4-play:hover{transform:translate(-50%,-50%) scale(1.15)}\n.vs4-play svg{width:28px;height:28px;fill:#fff;margin-left:4px}\n@media(max-width:768px){.vs4-card{padding:20px}}\n</style>\n<section class=\"vs4\">\n  <div class=\"vs4-wrap\">\n    <div class=\"vs4-card\">\n      <div class=\"vs4-text\">\n        <h2>Watch the Demo</h2>\n        <p>See exactly how to set up your first project in record time.</p>\n      </div>\n      <div class=\"vs4-video\">\n        <img src=\"https://images.unsplash.com/photo-1542744094-3a31f272c490?auto=format&fit=crop&w=1200&q=80\" alt=\"Demo\">\n        <div class=\"vs4-play\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "vs-5",
      "name": "Neo-Brutalism Video",
      "html": "\n<style>\n.vs5{padding:100px 20px;background:#fef9c3;font-family:'Inter',sans-serif}\n.vs5-wrap{max-width:1000px;margin:0 auto}\n.vs5-top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px;flex-wrap:wrap;gap:20px}\n.vs5-top h2{font-size:clamp(40px,6vw,70px);font-weight:900;color:#000;margin:0;line-height:1;text-transform:uppercase;letter-spacing:-2px}\n.vs5-badge{padding:8px 16px;background:#000;color:#fff;font-size:14px;font-weight:900;text-transform:uppercase;letter-spacing:1px;border:3px solid #000}\n.vs5-video-box{position:relative;background:#fff;border:5px solid #000;box-shadow:12px 12px 0 #000;border-radius:0;overflow:visible;aspect-ratio:16/9}\n.vs5-video-box img{width:100%;height:100%;object-fit:cover;display:block}\n.vs5-play-btn{position:absolute;bottom:-30px;right:-30px;width:100px;height:100px;background:#f43f5e;border:4px solid #000;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:6px 6px 0 #000;transition:transform 0.2s}\n.vs5-play-btn:hover{transform:translate(-4px,-4px);box-shadow:10px 10px 0 #000}\n.vs5-play-btn svg{width:40px;height:40px;fill:#000;margin-left:6px}\n@media(max-width:768px){.vs5-play-btn{bottom:10px;right:10px;width:70px;height:70px}.vs5-play-btn svg{width:28px;height:28px}}\n</style>\n<section class=\"vs5\">\n  <div class=\"vs5-wrap\">\n    <div class=\"vs5-top\">\n      <h2>Meet the<br>Product</h2>\n      <div class=\"vs5-badge\">2 Min Watch</div>\n    </div>\n    <div class=\"vs5-video-box\">\n      <img src=\"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80\" alt=\"Video\">\n      <div class=\"vs5-play-btn\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "vs-6",
      "name": "Minimalist Video Row",
      "html": "\n<style>\n.vs6{padding:120px 20px;background:#fff;font-family:'Inter',sans-serif}\n.vs6-wrap{max-width:1100px;margin:0 auto;display:flex;gap:50px;align-items:center;flex-wrap:wrap}\n.vs6-video-wrap{flex:1.5;min-width:300px;position:relative}\n.vs6-video{aspect-ratio:4/3;border-radius:24px;overflow:hidden;position:relative}\n.vs6-video img{width:100%;height:100%;object-fit:cover}\n.vs6-play{position:absolute;inset:0;background:rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background 0.3s}\n.vs6-play:hover{background:rgba(0,0,0,0.2)}\n.vs6-play-circle{width:64px;height:64px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 20px rgba(0,0,0,0.1)}\n.vs6-play-circle svg{width:24px;height:24px;fill:#0f172a;margin-left:4px}\n.vs6-text{flex:1;min-width:280px}\n.vs6-tag{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:2px;margin-bottom:15px;display:block}\n.vs6-text h2{font-size:36px;font-weight:800;color:#0f172a;margin:0 0 20px;line-height:1.2}\n.vs6-text p{font-size:16px;color:#64748b;line-height:1.7;margin:0 0 30px}\n.vs6-list{display:flex;flex-direction:column;gap:12px}\n.vs6-list-item{display:flex;align-items:center;gap:12px;font-size:15px;font-weight:600;color:#0f172a}\n.vs6-check{color:#10b981;font-size:18px}\n</style>\n<section class=\"vs6\">\n  <div class=\"vs6-wrap\">\n    <div class=\"vs6-video-wrap\">\n      <div class=\"vs6-video\">\n        <img src=\"https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=1000&q=80\" alt=\"Presentation\">\n        <div class=\"vs6-play\"><div class=\"vs6-play-circle\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div></div>\n      </div>\n    </div>\n    <div class=\"vs6-text\">\n      <span class=\"vs6-tag\">Video Overview</span>\n      <h2>Everything you need, in one place</h2>\n      <p>Stop juggling multiple tools. Watch how our integrated platform brings your entire workflow together seamlessly.</p>\n      <div class=\"vs6-list\">\n        <div class=\"vs6-list-item\"><span class=\"vs6-check\">✓</span> Automated task tracking</div>\n        <div class=\"vs6-list-item\"><span class=\"vs6-check\">✓</span> Real-time team collaboration</div>\n        <div class=\"vs6-list-item\"><span class=\"vs6-check\">✓</span> One-click deployment</div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "vs-7",
      "name": "Dark Cinematic Grid",
      "html": "\n<style>\n.vs7{padding:100px 20px;background:#030014;font-family:'Inter',sans-serif;color:#fff}\n.vs7-wrap{max-width:1200px;margin:0 auto}\n.vs7-head{text-align:center;margin-bottom:50px}\n.vs7-head h2{font-size:42px;font-weight:900;margin:0 0 15px;letter-spacing:-1px}\n.vs7-head p{color:#94a3b8;font-size:16px;max-width:600px;margin:0 auto}\n.vs7-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px}\n.vs7-main-video{border-radius:16px;overflow:hidden;position:relative;aspect-ratio:16/9;cursor:pointer}\n.vs7-side{display:flex;flex-direction:column;gap:20px}\n.vs7-sub-video{border-radius:16px;overflow:hidden;position:relative;flex:1;cursor:pointer}\n.vs7-img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s;display:block}\n.vs7-main-video:hover .vs7-img,.vs7-sub-video:hover .vs7-img{transform:scale(1.05)}\n.vs7-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.8),transparent);display:flex;align-items:flex-end;padding:30px}\n.vs7-sub-video .vs7-overlay{padding:20px}\n.vs7-play-sm{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:50px;height:50px;background:rgba(255,255,255,0.2);backdrop-filter:blur(5px);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background 0.3s}\n.vs7-main-video .vs7-play-sm{width:70px;height:70px}\n.vs7-main-video:hover .vs7-play-sm,.vs7-sub-video:hover .vs7-play-sm{background:#6366f1}\n.vs7-play-sm svg{fill:#fff;width:20px;height:20px;margin-left:4px}\n.vs7-main-video .vs7-play-sm svg{width:28px;height:28px}\n.vs7-info h3{font-size:22px;font-weight:700;margin:0 0 5px;color:#fff}\n.vs7-sub-video .vs7-info h3{font-size:16px}\n.vs7-info p{font-size:13px;color:#cbd5e1;margin:0}\n@media(max-width:900px){.vs7-grid{grid-template-columns:1fr}.vs7-sub-video{aspect-ratio:16/9}}\n</style>\n<section class=\"vs7\">\n  <div class=\"vs7-wrap\">\n    <div class=\"vs7-head\">\n      <h2>Video Resources</h2>\n      <p>Explore our library of tutorials, behind-the-scenes, and product deep-dives.</p>\n    </div>\n    <div class=\"vs7-grid\">\n      <div class=\"vs7-main-video\">\n        <img class=\"vs7-img\" src=\"https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=1200&q=80\" alt=\"Main Video\">\n        <div class=\"vs7-play-sm\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n        <div class=\"vs7-overlay\">\n          <div class=\"vs7-info\">\n            <h3>Product Keynote 2026</h3>\n            <p>Watch the full 45-minute announcement of our new features.</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"vs7-side\">\n        <div class=\"vs7-sub-video\">\n          <img class=\"vs7-img\" src=\"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80\" alt=\"Sub Video 1\">\n          <div class=\"vs7-play-sm\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n          <div class=\"vs7-overlay\">\n            <div class=\"vs7-info\">\n              <h3>Getting Started</h3>\n              <p>5 min tutorial</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"vs7-sub-video\">\n          <img class=\"vs7-img\" src=\"https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=600&q=80\" alt=\"Sub Video 2\">\n          <div class=\"vs7-play-sm\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></div>\n          <div class=\"vs7-overlay\">\n            <div class=\"vs7-info\">\n              <h3>Advanced Tips</h3>\n              <p>12 min tutorial</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
    }
  ]
}
