      "name": "Fullscreen Image Coming Soon",
      "html": "\n<style>\n.cs4{min-height:100vh;background:url('https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?auto=format&fit=crop&w=1920&q=80') center/cover;position:relative;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px}\n.cs4::before{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.4),rgba(0,0,0,0.7))}\n.cs4-content{position:relative;z-index:2;max-width:700px;color:#fff}\n.cs4-logo{font-size:28px;font-weight:900;letter-spacing:3px;text-transform:uppercase;margin-bottom:60px;display:block;opacity:0.9}\n.cs4 h1{font-size:clamp(40px,6vw,80px);font-weight:300;margin:0 0 20px;letter-spacing:-1px}\n.cs4 h1 strong{font-weight:900;display:block}\n.cs4 p{color:rgba(255,255,255,0.8);font-size:18px;margin:0 0 50px}\n.cs4-countdown{display:flex;justify-content:center;gap:40px;margin-bottom:50px;flex-wrap:wrap}\n.cs4-block{text-align:center}\n.cs4-num{font-size:64px;font-weight:900;line-height:1;color:#fff}\n.cs4-lbl{font-size:12px;text-transform:uppercase;letter-spacing:3px;color:rgba(255,255,255,0.6);margin-top:8px}\n.cs4-divider{font-size:50px;font-weight:100;color:rgba(255,255,255,0.3);line-height:1;margin-top:5px}\n.cs4-email{display:flex;gap:0;max-width:420px;margin:0 auto;background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);border-radius:50px;overflow:hidden;padding:6px}\n.cs4-input{flex:1;padding:12px 20px;background:transparent;border:none;color:#fff;font-size:14px;outline:none}\n.cs4-input::placeholder{color:rgba(255,255,255,0.5)}\n.cs4-btn{padding:12px 25px;background:#fff;color:#000;border:none;border-radius:50px;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap}\n</style>\n<section class=\"cs4\">\n  <div class=\"cs4-content\">\n    <span class=\"cs4-logo\">⬡ Brand</span>\n    <h1>We Are<strong>Almost There</strong></h1>\n    <p>An experience unlike any other is on its way.</p>\n    <div class=\"cs4-countdown\">\n      <div class=\"cs4-block\"><div class=\"cs4-num\" id=\"cs4-d\">30</div><div class=\"cs4-lbl\">Days</div></div>\n      <div class=\"cs4-divider\">:</div>\n      <div class=\"cs4-block\"><div class=\"cs4-num\" id=\"cs4-h\">12</div><div class=\"cs4-lbl\">Hours</div></div>\n      <div class=\"cs4-divider\">:</div>\n      <div class=\"cs4-block\"><div class=\"cs4-num\" id=\"cs4-m\">45</div><div class=\"cs4-lbl\">Minutes</div></div>\n      <div class=\"cs4-divider\">:</div>\n      <div class=\"cs4-block\"><div class=\"cs4-num\" id=\"cs4-s\">00</div><div class=\"cs4-lbl\">Seconds</div></div>\n    </div>\n    <div class=\"cs4-email\">\n      <input class=\"cs4-input\" type=\"email\" placeholder=\"your@email.com\">\n      <button class=\"cs4-btn\">Notify Me</button>\n    </div>\n  </div>\n</section>\n<script>(function(){var t=new Date();t.setDate(t.getDate()+30);function u(){var n=new Date(),d=t-n;if(d<=0)return;document.getElementById('cs4-d').textContent=String(Math.floor(d/864e5)).padStart(2,'0');document.getElementById('cs4-h').textContent=String(Math.floor((d%864e5)/36e5)).padStart(2,'0');document.getElementById('cs4-m').textContent=String(Math.floor((d%36e5)/6e4)).padStart(2,'0');document.getElementById('cs4-s').textContent=String(Math.floor((d%6e4)/1e3)).padStart(2,'0');}u();setInterval(u,1000);})();</script>"
