-block\"><div class=\"cs3-num\" id=\"cs3-m\">45</div><div class=\"cs3-lbl\">Minutes</div></div>\n      <div class=\"cs3-block\"><div class=\"cs3-num\" id=\"cs3-s\">00</div><div class=\"cs3-lbl\">Seconds</div></div>\n    </div>\n    <div class=\"cs3-form\">\n      <input class=\"cs3-input\" type=\"email\" placeholder=\"Enter your email...\">\n      <button class=\"cs3-btn\">Notify Me 🎉</button>\n    </div>\n  </div>\n</section>\n<script>(function(){var t=new Date();t.setDate(t.getDate()+30);function u(){var n=new Date(),d=t-n;if(d<=0)return;document.getElementById('cs3-d').textContent=String(Math.floor(d/864e5)).padStart(2,'0');document.getElementById('cs3-h').textContent=String(Math.floor((d%864e5)/36e5)).padStart(2,'0');document.getElementById('cs3-m').textContent=String(Math.floor((d%36e5)/6e4)).padStart(2,'0');document.getElementById('cs3-s').textContent=String(Math.floor((d%6e4)/1e3)).padStart(2,'0');}u();setInterval(u,1000);})();</script>"
