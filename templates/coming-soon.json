      "id": "cs-6",
      "name": "Aurora Gradient Coming Soon",
      "html": "\n<style>\n.cs6{min-height:100vh;background:#030014;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px;position:relative;overflow:hidden}\n.cs6-aurora1{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,#7c3aed,transparent 70%);top:-200px;left:-100px;opacity:0.5;filter:blur(60px)}\n.cs6-aurora2{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,#0ea5e9,transparent 70%);bottom:-200px;right:-100px;opacity:0.4;filter:blur(60px)}\n.cs6-aurora3{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,#ec4899,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);opacity:0.2;filter:blur(80px)}\n.cs6-content{position:relative;z-index:2;max-width:700px;color:#fff}\n.cs6 h1{font-size:clamp(44px,7vw,88px);font-weight:900;margin:0 0 20px;letter-spacing:-2px;background:linear-gradient(135deg,#fff,#c4b5fd);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.05}\n.cs6 p{color:rgba(255,255,255,0.6);font-size:18px;margin:0 0 50px;line-height:1.6}\n.cs6-countdown{display:flex;justify-content:center;gap:20px;margin-bottom:50px;flex-wrap:wrap}\n.cs6-block{background:rgba(255,255,255,0.05);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:30px 25px;min-width:110px}\n.cs6-num{font-size:52px;font-weight:900;color:#fff;line-height:1;background:linear-gradient(135deg,#fff,#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.cs6-lbl{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,0.4);margin-top:10px}\n.cs6-form{display:flex;gap:10px;max-width:460px;margin:0 auto;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.15);border-radius:50px;padding:8px;flex-wrap:wrap}\n.cs6-input{flex:1;min-width:200px;padding:12px 20px;background:transparent;border:none;color:#fff;font-size:14px;outline:none}\n.cs6-input::placeholder{color:rgba(255,255,255,0.4)}\n.cs6-btn{padding:12px 28px;background:linear-gradient(135deg,#7c3aed,#0ea5e9);color:#fff;border:none;border-radius:50px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap}\n</style>\n<section class=\"cs6\">\n  <div class=\"cs6-aurora1\"></div>\n  <div class=\"cs6-aurora2\"></div>\n  <div class=\"cs6-aurora3\"></div>\n  <div class=\"cs6-content\">\n    <h1>Launching<br>Into the Future</h1>\n    <p>We're building something remarkable at the intersection of technology and human experience.</p>\n    <div class=\"cs6-countdown\">\n      <div class=\"cs6-block\"><div class=\"cs6-num\" id=\"cs6-d\">30</div><div class=\"cs6-lbl\">Days</div></div>\n      <div class=\"cs6-block\"><div class=\"cs6-num\" id=\"cs6-h\">12</div><div class=\"cs6-lbl\">Hours</div></div>\n      <div class=\"cs6-block\"><div class=\"cs6-num\" id=\"cs6-m\">45</div><div class=\"cs6-lbl\">Minutes</div></div>\n      <div class=\"cs6-block\"><div class=\"cs6-num\" id=\"cs6-s\">00</div><div class=\"cs6-lbl\">Seconds</div></div>\n    </div>\n    <div class=\"cs6-form\">\n      <input class=\"cs6-input\" type=\"email\" placeholder=\"Enter your email...\">\n      <button class=\"cs6-btn\">Get Early Access</button>\n    </div>\n  </div>\n</section>\n<script>(function(){var t=new Date();t.setDate(t.getDate()+30);function u(){var n=new Date(),d=t-n;if(d<=0)return;document.getElementById('cs6-d').textContent=String(Math.floor(d/864e5)).padStart(2,'0');document.getElementById('cs6-h').textContent=String(Math.floor((d%864e5)/36e5)).padStart(2,'0');document.getElementById('cs6-m').textContent=String(Math.floor((d%36e5)/6e4)).padStart(2,'0');document.getElementById('cs6-s').textContent=String(Math.floor((d%6e4)/1e3)).padStart(2,'0');}u();setInterval(u,1000);})();</script>"
    }
  ]
}
