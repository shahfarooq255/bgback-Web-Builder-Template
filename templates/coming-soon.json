      "name": "Neon Cyberpunk Coming Soon",
      "html": "\n<style>\n.cs2{min-height:100vh;background:#000;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px;position:relative;overflow:hidden}\n.cs2-line{position:absolute;width:100%;height:1px;background:linear-gradient(to right,transparent,#00ffcc,transparent);top:50%;left:0;opacity:0.3}\n.cs2-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,255,204,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,204,0.05) 1px,transparent 1px);background-size:60px 60px}\n.cs2-content{position:relative;z-index:2;max-width:750px}\n.cs2-tag{display:inline-block;padding:8px 20px;border:1px solid #00ffcc;color:#00ffcc;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;margin-bottom:30px}\n.cs2 h1{font-size:clamp(44px,7vw,90px);font-weight:900;color:#fff;margin:0 0 10px;letter-spacing:-2px;text-transform:uppercase;line-height:1}\n.cs2 h1 span{color:#00ffcc;text-shadow:0 0 30px #00ffcc}\n.cs2 p{color:#666;font-size:16px;margin:0 0 40px}\n.cs2-countdown{display:flex;justify-content:center;gap:5px;margin-bottom:40px}\n.cs2-block{padding:20px 25px;border:1px solid #1a1a1a;min-width:100px;position:relative}\n.cs2-block::before{content:'';position:absolute;top:0;left:0;width:100%;height:1px;background:linear-gradient(to right,transparent,#00ffcc,transparent)}\n.cs2-num{font-size:50px;font-weight:900;color:#00ffcc;line-height:1;text-shadow:0 0 20px #00ffcc}\n.cs2-lbl{font-size:11px;color:#555;letter-spacing:2px;text-transform:uppercase;margin-top:8px}\n.cs2-form{display:flex;gap:0;max-width:480px;margin:0 auto}\n.cs2-input{flex:1;padding:15px 20px;background:#111;border:1px solid #333;color:#fff;font-size:14px;outline:none;border-right:none}\n.cs2-input:focus{border-color:#00ffcc}\n.cs2-btn{padding:15px 30px;background:#00ffcc;color:#000;border:none;font-size:14px;font-weight:800;cursor:pointer;text-transform:uppercase;letter-spacing:1px}\n</style>\n<section class=\"cs2\">\n  <div class=\"cs2-grid\"></div>\n  <div class=\"cs2-line\"></div>\n  <div class=\"cs2-content\">\n    <div class=\"cs2-tag\">// Launching Soon //</div>\n    <h1>The Future<br>Is <span>Loading</span></h1>\n    <p>Something extraordinary is being built. Join the waitlist.</p>\n    <div class=\"cs2-countdown\">\n      <div class=\"cs2-block\"><div class=\"cs2-num\" id=\"cs2-d\">30</div><div class=\"cs2-lbl\">Days</div></div>\n      <div class=\"cs2-block\"><div class=\"cs2-num\" id=\"cs2-h\">12</div><div class=\"cs2-lbl\">Hours</div></div>\n      <div class=\"cs2-block\"><div class=\"cs2-num\" id=\"cs2-m\">45</div><div class=\"cs2-lbl\">Min</div></div>\n      <div class=\"cs2-block\"><div class=\"cs2-num\" id=\"cs2-s\">00</div><div class=\"cs2-lbl\">Sec</div></div>\n    </div>\n    <div class=\"cs2-form\">\n      <input class=\"cs2-input\" type=\"email\" placeholder=\"your@email.com\">\n      <button class=\"cs2-btn\">Join</button>\n    </div>\n  </div>\n</section>\n<script>(function(){var t=new Date();t.setDate(t.getDate()+30);function u(){var n=new Date(),d=t-n;if(d<=0)return;document.getElementById('cs2-d').textContent=String(Math.floor(d/864e5)).padStart(2,'0');document.getElementById('cs2-h').textContent=String(Math.floor((d%864e5)/36e5)).padStart(2,'0');document.getElementById('cs2-m').textContent=String(Math.floor((d%36e5)/6e4)).padStart(2,'0');document.getElementById('cs2-s').textContent=String(Math.floor((d%6e4)/1e3)).padStart(2,'0');}u();setInterval(u,1000);})();</script>"
