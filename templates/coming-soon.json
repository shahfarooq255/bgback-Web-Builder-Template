      "name": "Split Layout Coming Soon",
      "html": "\n<style>\n.cs5{min-height:100vh;background:#fff;font-family:'Inter',sans-serif;display:flex;flex-wrap:wrap}\n.cs5-left{flex:1;min-width:300px;background:#111;display:flex;align-items:center;justify-content:center;padding:60px 50px}\n.cs5-right{flex:1;min-width:300px;display:flex;align-items:center;justify-content:center;padding:60px 50px;background:#f9fafb}\n.cs5-logo{font-size:32px;font-weight:900;color:#fff;letter-spacing:2px;margin-bottom:30px;display:block}\n.cs5-left h1{font-size:clamp(36px,4vw,60px);font-weight:900;color:#fff;margin:0 0 20px;line-height:1.1}\n.cs5-left p{color:#888;font-size:15px;line-height:1.7}\n.cs5-form-area{max-width:400px;width:100%}\n.cs5-form-area h2{font-size:28px;font-weight:800;color:#111;margin:0 0 10px}\n.cs5-form-area p{color:#666;font-size:15px;margin:0 0 30px}\n.cs5-countdown{display:flex;gap:15px;margin-bottom:30px;flex-wrap:wrap}\n.cs5-block{text-align:center;background:#fff;border:2px solid #111;padding:15px 12px;min-width:75px;box-shadow:4px 4px 0 #111}\n.cs5-num{font-size:32px;font-weight:900;color:#111;line-height:1}\n.cs5-lbl{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#666;margin-top:5px}\n.cs5-field{display:flex;flex-direction:column;gap:15px}\n.cs5-input{padding:14px 16px;border:2px solid #e5e7eb;font-size:15px;color:#111;outline:none;background:#fff}\n.cs5-input:focus{border-color:#111}\n.cs5-btn{padding:16px;background:#111;color:#fff;border:none;font-size:15px;font-weight:700;cursor:pointer;text-align:center;transition:background 0.3s}\n.cs5-btn:hover{background:#f43f5e}\n</style>\n<section class=\"cs5\">\n  <div class=\"cs5-left\">\n    <div>\n      <span class=\"cs5-logo\">◈ BRAND</span>\n      <h1>Big Things<br>Coming Soon</h1>\n      <p>We are crafting something bold and unprecedented. Stay tuned.</p>\n    </div>\n  </div>\n  <div class=\"cs5-right\">\n    <div class=\"cs5-form-area\">\n      <h2>Be First to Know</h2>\n      <p>Get exclusive early access when we launch.</p>\n      <div class=\"cs5-countdown\">\n        <div class=\"cs5-block\"><div class=\"cs5-num\" id=\"cs5-d\">30</div><div class=\"cs5-lbl\">Days</div></div>\n        <div class=\"cs5-block\"><div class=\"cs5-num\" id=\"cs5-h\">12</div><div class=\"cs5-lbl\">Hrs</div></div>\n        <div class=\"cs5-block\"><div class=\"cs5-num\" id=\"cs5-m\">45</div><div class=\"cs5-lbl\">Min</div></div>\n        <div class=\"cs5-block\"><div class=\"cs5-num\" id=\"cs5-s\">00</div><div class=\"cs5-lbl\">Sec</div></div>\n      </div>\n      <div class=\"cs5-field\">\n        <input class=\"cs5-input\" type=\"email\" placeholder=\"your@email.com\">\n        <button class=\"cs5-btn\">Notify Me</button>\n      </div>\n    </div>\n  </div>\n</section>\n<script>(function(){var t=new Date();t.setDate(t.getDate()+30);function u(){var n=new Date(),d=t-n;if(d<=0)return;document.getElementById('cs5-d').textContent=String(Math.floor(d/864e5)).padStart(2,'0');document.getElementById('cs5-h').textContent=String(Math.floor((d%864e5)/36e5)).padStart(2,'0');document.getElementById('cs5-m').textContent=String(Math.floor((d%36e5)/6e4)).padStart(2,'0');document.getElementById('cs5-s').textContent=String(Math.floor((d%6e4)/1e3)).padStart(2,'0');}u();setInterval(u,1000);})();</script>"
