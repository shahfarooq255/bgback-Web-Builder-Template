    {
      "id": "product-details-1",
      "name": "Classic Split Detail",
      "description": "Image on left, full product info on right - clean & conversion-focused",
      "html": "\n                        <style>\n                          .prd1-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prd1-inner{max-width:1100px;margin:0 auto;display:flex;gap:60px;align-items:flex-start;}\n                          .prd1-imgs{flex:1;min-width:0;}\n                          .prd1-main-img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:16px;background:#f1f5f9;}\n                          .prd1-thumbs{display:flex;gap:10px;margin-top:12px;}\n                          .prd1-thumb{width:70px;height:70px;border-radius:8px;object-fit:cover;border:2px solid #e5e7eb;cursor:pointer;}\n                          .prd1-thumb.active{border-color:#111;}\n                          .prd1-info{flex:1;min-width:0;}\n                          .prd1-badge{display:inline-block;background:#dcfce7;color:#16a34a;font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;margin-bottom:12px;}\n                          .prd1-name{font-size:clamp(26px,4vw,36px);font-weight:800;color:#111;margin:0 0 10px;line-height:1.2;}\n                          .prd1-stars{color:#f59e0b;font-size:14px;margin-bottom:15px;}\n                          .prd1-price{font-size:38px;font-weight:900;color:#111;margin-bottom:5px;}\n                          .prd1-old{font-size:18px;color:#9ca3af;text-decoration:line-through;margin-bottom:25px;}\n                          .prd1-label{font-size:13px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;}\n                          .prd1-sizes{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:25px;}\n                          .prd1-size{padding:10px 18px;border:2px solid #e5e7eb;border-radius:8px;font-weight:600;cursor:pointer;font-size:14px;}\n                          .prd1-size.active,.prd1-size:hover{border-color:#111;background:#111;color:#fff;}\n                          .prd1-qty{display:flex;align-items:center;gap:0;margin-bottom:25px;border:2px solid #e5e7eb;border-radius:10px;overflow:hidden;width:fit-content;}\n                          .prd1-qty button{background:#fff;border:none;padding:12px 18px;font-size:20px;cursor:pointer;}\n                          .prd1-qty span{padding:12px 20px;font-size:16px;font-weight:700;border-left:2px solid #e5e7eb;border-right:2px solid #e5e7eb;}\n                          .prd1-actions{display:flex;gap:12px;}\n                          .prd1-cart{flex:1;padding:15px;background:#111;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;}\n                          .prd1-wish{width:52px;height:52px;border:2px solid #e5e7eb;border-radius:12px;background:#fff;font-size:22px;cursor:pointer;}\n                          @media(max-width:800px){.prd1-inner{flex-direction:column;gap:30px;} .prd1-main-img{max-height:350px;}}\n                        </style>\n                        <section class=\"prd1-wrap\">\n                          <div class=\"prd1-inner\">\n                            <div class=\"prd1-imgs\">\n                              <img class=\"prd1-main-img\" src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=800&auto=format&fit=crop\" alt=\"Watch\">\n                              <div class=\"prd1-thumbs\">\n                                <img class=\"prd1-thumb active\" src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                                <img class=\"prd1-thumb\" src=\"https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                                <img class=\"prd1-thumb\" src=\"https://images.unsplash.com/photo-1594534475808-b18fc33b045e?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                              </div>\n                            </div>\n                            <div class=\"prd1-info\">\n                              <span class=\"prd1-badge\">✅ In Stock - Ships in 24h</span>\n                              <h1 class=\"prd1-name\">Apex Chronograph Pro Watch</h1>\n                              <div class=\"prd1-stars\">★★★★★ <span style=\"color:#6b7280;\">(214 reviews)</span></div>\n                              <div class=\"prd1-price\">$249</div>\n                              <div class=\"prd1-old\">$329</div>\n                              <div class=\"prd1-label\">Strap Size</div>\n                              <div class=\"prd1-sizes\">\n                                <div class=\"prd1-size\">Small</div>\n                                <div class=\"prd1-size active\">Medium</div>\n                                <div class=\"prd1-size\">Large</div>\n                                <div class=\"prd1-size\">XL</div>\n                              </div>\n                              <div class=\"prd1-label\">Quantity</div>\n                              <div class=\"prd1-qty\">\n                                <button>−</button>\n                                <span>1</span>\n                                <button>+</button>\n                              </div>\n                              <div class=\"prd1-actions\">\n                                <button class=\"prd1-cart\">Add to Cart</button>\n                                <button class=\"prd1-wish\">♡</button>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-details-2",
      "name": "Dark Luxury Detail",
      "description": "Premium dark-mode product page for luxury and fashion brands",
      "html": "\n                        <style>\n                          .prd2-wrap{padding:80px 20px;background:#09090b;font-family:sans-serif;}\n                          .prd2-inner{max-width:1100px;margin:0 auto;display:flex;gap:60px;align-items:flex-start;}\n                          .prd2-imgs{flex:1;min-width:0;}\n                          .prd2-main{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:12px;}\n                          .prd2-thumbs{display:flex;gap:8px;margin-top:10px;}\n                          .prd2-thumb{width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #27272a;cursor:pointer;opacity:0.6;}\n                          .prd2-thumb.active{opacity:1;border-color:#fff;}\n                          .prd2-info{flex:1;min-width:0;padding-top:20px;}\n                          .prd2-brand{color:#d4af37;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;}\n                          .prd2-name{color:#fff;font-size:clamp(28px,4vw,42px);font-weight:800;line-height:1.15;margin:0 0 15px;}\n                          .prd2-tagline{color:#71717a;font-size:16px;margin-bottom:30px;line-height:1.6;border-left:2px solid #d4af37;padding-left:15px;}\n                          .prd2-price{color:#d4af37;font-size:44px;font-weight:900;margin-bottom:30px;}\n                          .prd2-colors{display:flex;gap:12px;margin-bottom:25px;}\n                          .prd2-color{width:28px;height:28px;border-radius:50%;border:3px solid #27272a;cursor:pointer;}\n                          .prd2-color.active{border-color:#fff;}\n                          .prd2-btn{width:100%;padding:18px;background:#d4af37;color:#000;border:none;font-size:16px;font-weight:800;letter-spacing:1px;cursor:pointer;border-radius:4px;margin-bottom:12px;}\n                          .prd2-wish{width:100%;padding:16px;background:transparent;color:#fff;border:1px solid #27272a;font-size:15px;font-weight:600;cursor:pointer;border-radius:4px;}\n                          @media(max-width:800px){.prd2-inner{flex-direction:column;gap:30px;}}\n                        </style>\n                        <section class=\"prd2-wrap\">\n                          <div class=\"prd2-inner\">\n                            <div class=\"prd2-imgs\">\n                              <img class=\"prd2-main\" src=\"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=800&auto=format&fit=crop\" alt=\"Bag\">\n                              <div class=\"prd2-thumbs\">\n                                <img class=\"prd2-thumb active\" src=\"https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                                <img class=\"prd2-thumb\" src=\"https://images.unsplash.com/photo-1594938298603-c8148c4dae35?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                                <img class=\"prd2-thumb\" src=\"https://images.unsplash.com/photo-1566150905458-1bf1fc113f0d?q=80&w=200&auto=format&fit=crop\" alt=\"\">\n                              </div>\n                            </div>\n                            <div class=\"prd2-info\">\n                              <div class=\"prd2-brand\">Maison Luxe</div>\n                              <h1 class=\"prd2-name\">Caviar Quilted Leather Bag</h1>\n                              <div class=\"prd2-tagline\">Handcrafted in Italy from the finest calfskin leather. A timeless silhouette for the discerning collector.</div>\n                              <div class=\"prd2-price\">$849</div>\n                              <div style=\"color:#71717a;font-size:13px;margin-bottom:15px;\">SELECT COLOR</div>\n                              <div class=\"prd2-colors\">\n                                <div class=\"prd2-color active\" style=\"background:#1c1c1c;\"></div>\n                                <div class=\"prd2-color\" style=\"background:#c0a882;\"></div>\n                                <div class=\"prd2-color\" style=\"background:#8b4513;\"></div>\n                              </div>\n                              <button class=\"prd2-btn\">ADD TO COLLECTION</button>\n                              <button class=\"prd2-wish\">♡ Save to Wishlist</button>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-details-3",
      "name": "Tabbed Info Detail",
      "description": "Product page with Description / Specs / Reviews tabs below the fold",
      "html": "\n                        <style>\n                          .prd3-wrap{padding:60px 20px;background:#f9fafb;font-family:sans-serif;}\n                          .prd3-top{max-width:1100px;margin:0 auto;display:flex;gap:50px;align-items:flex-start;margin-bottom:60px;}\n                          .prd3-img{flex:1;min-width:0;}\n                          .prd3-img img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:20px;background:#e2e8f0;}\n                          .prd3-info{flex:1;min-width:0;background:#fff;padding:40px;border-radius:20px;box-shadow:0 8px 30px rgba(0,0,0,0.04);}\n                          .prd3-name{font-size:clamp(24px,3.5vw,34px);font-weight:800;color:#111;margin:0 0 5px;}\n                          .prd3-sku{color:#9ca3af;font-size:13px;margin-bottom:15px;}\n                          .prd3-price{font-size:36px;font-weight:900;color:#111;margin-bottom:5px;}\n                          .prd3-vat{color:#6b7280;font-size:13px;margin-bottom:25px;}\n                          .prd3-colors{display:flex;gap:10px;margin-bottom:25px;}\n                          .prd3-coloropt{width:32px;height:32px;border-radius:50%;border:3px solid transparent;cursor:pointer;}\n                          .prd3-coloropt.active{border-color:#111;}\n                          .prd3-add{width:100%;padding:15px;background:#111;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;margin-bottom:10px;}\n                          .prd3-tabs-section{max-width:1100px;margin:0 auto;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,0.04);}\n                          .prd3-tab-nav{display:flex;border-bottom:2px solid #f1f5f9;}\n                          .prd3-tab-btn{padding:18px 30px;font-size:15px;font-weight:700;color:#6b7280;border:none;background:transparent;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;}\n                          .prd3-tab-btn.active{color:#111;border-bottom-color:#111;}\n                          .prd3-tab-content{padding:35px;color:#374151;font-size:16px;line-height:1.7;}\n                          @media(max-width:800px){.prd3-top{flex-direction:column;gap:20px;} .prd3-info{padding:25px;} .prd3-tab-btn{padding:14px 16px;font-size:14px;}}\n                        </style>\n                        <section class=\"prd3-wrap\">\n                          <div class=\"prd3-top\">\n                            <div class=\"prd3-img\"><img src=\"https://images.unsplash.com/photo-1491553895911-0055eca6402d?q=80&w=800&auto=format&fit=crop\" alt=\"Shoe\"></div>\n                            <div class=\"prd3-info\">\n                              <h1 class=\"prd3-name\">UltraRun Apex Pro Shoe</h1>\n                              <div class=\"prd3-sku\">SKU: UR-AP-2026-BLK</div>\n                              <div class=\"prd3-price\">$189</div>\n                              <div class=\"prd3-vat\">Incl. VAT &bull; Free shipping over $100</div>\n                              <div style=\"font-size:13px;font-weight:700;color:#374151;margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;\">Color</div>\n                              <div class=\"prd3-colors\">\n                                <div class=\"prd3-coloropt active\" style=\"background:#111;\"></div>\n                                <div class=\"prd3-coloropt\" style=\"background:#dc2626;\"></div>\n                                <div class=\"prd3-coloropt\" style=\"background:#3b82f6;\"></div>\n                                <div class=\"prd3-coloropt\" style=\"background:#d1d5db;\"></div>\n                              </div>\n                              <div style=\"font-size:13px;font-weight:700;color:#374151;margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;\">Size (EU)</div>\n                              <div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-bottom:25px;\">\n                                <button style=\"padding:8px 14px;border:2px solid #e5e7eb;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;\">40</button>\n                                <button style=\"padding:8px 14px;border:2px solid #111;border-radius:7px;font-size:13px;font-weight:600;background:#111;color:#fff;cursor:pointer;\">41</button>\n                                <button style=\"padding:8px 14px;border:2px solid #e5e7eb;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;\">42</button>\n                                <button style=\"padding:8px 14px;border:2px solid #e5e7eb;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;\">43</button>\n                                <button style=\"padding:8px 14px;border:2px solid #e5e7eb;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;\">44</button>\n                              </div>\n                              <button class=\"prd3-add\">Add to Cart &mdash; $189</button>\n                            </div>\n                          </div>\n                          <div class=\"prd3-tabs-section\">\n                            <div class=\"prd3-tab-nav\">\n                              <button class=\"prd3-tab-btn active\">Description</button>\n                              <button class=\"prd3-tab-btn\">Specifications</button>\n                              <button class=\"prd3-tab-btn\">Reviews (214)</button>\n                            </div>\n                            <div class=\"prd3-tab-content\">\n                              <p>The UltraRun Apex Pro is engineered for serious runners who demand the very best. With a dual-density foam midsole and a high-traction carbon rubber outsole, every stride is propelled forward with maximum energy return and minimal ground impact.</p>\n                              <p>The breathable engineered mesh upper provides a sock-like fit, keeping your feet cool and secure through the longest of runs. Available in 4 colorways.</p>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-details-4",
      "name": "Sticky CTA Detail",
      "description": "Tall image gallery with a sticky buy panel that scrolls alongside",
      "html": "\n                        <style>\n                          .prd4-wrap{padding:60px 20px;background:#fff;font-family:sans-serif;}\n                          .prd4-inner{max-width:1100px;margin:0 auto;display:flex;gap:50px;align-items:flex-start;}\n                          .prd4-gallery{flex:1.2;display:flex;flex-direction:column;gap:12px;}\n                          .prd4-gallery img{width:100%;border-radius:12px;object-fit:cover;}\n                          .prd4-gallery img:first-child{aspect-ratio:1;}\n                          .prd4-gallery img:not(:first-child){height:280px;}\n                          .prd4-panel{flex:1;position:sticky;top:30px;align-self:flex-start;}\n                          .prd4-cat{color:#10b981;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px;}\n                          .prd4-name{font-size:clamp(26px,3.5vw,36px);font-weight:800;color:#111;margin:10px 0 5px;line-height:1.2;}\n                          .prd4-rating{display:flex;align-items:center;gap:8px;margin-bottom:20px;}\n                          .prd4-price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:25px;}\n                          .prd4-price{font-size:40px;font-weight:900;color:#111;}\n                          .prd4-save{background:#fef3c7;color:#92400e;padding:4px 10px;border-radius:6px;font-size:13px;font-weight:700;}\n                          .prd4-desc{color:#6b7280;font-size:15px;line-height:1.7;margin-bottom:25px;padding-bottom:25px;border-bottom:1px solid #f1f5f9;}\n                          .prd4-btn{width:100%;padding:16px;background:#111;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;margin-bottom:10px;}\n                          .prd4-secondary{width:100%;padding:14px;background:#fff;color:#111;border:2px solid #111;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;}\n                          .prd4-trust{display:flex;gap:15px;margin-top:20px;flex-wrap:wrap;}\n                          .prd4-trust-item{font-size:13px;color:#6b7280;display:flex;align-items:center;gap:5px;}\n                          @media(max-width:850px){.prd4-inner{flex-direction:column;} .prd4-panel{position:static;} .prd4-gallery img:not(:first-child){height:200px;}}\n                        </style>\n                        <section class=\"prd4-wrap\">\n                          <div class=\"prd4-inner\">\n                            <div class=\"prd4-gallery\">\n                              <img src=\"https://images.unsplash.com/photo-1585386959984-a4155224a1ad?q=80&w=800&auto=format&fit=crop\" alt=\"main\">\n                              <img src=\"https://images.unsplash.com/photo-1619994403073-2cec844b8e63?q=80&w=800&auto=format&fit=crop\" alt=\"alt1\">\n                              <img src=\"https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?q=80&w=800&auto=format&fit=crop\" alt=\"alt2\">\n                            </div>\n                            <div class=\"prd4-panel\">\n                              <div class=\"prd4-cat\">Fragrance</div>\n                              <h1 class=\"prd4-name\">Midnight Elixir EDP - 100ml</h1>\n                              <div class=\"prd4-rating\">\n                                <span style=\"color:#f59e0b;\">★★★★★</span>\n                                <span style=\"color:#6b7280;font-size:13px;\">4.9 / 5 (312 reviews)</span>\n                              </div>\n                              <div class=\"prd4-price-row\">\n                                <div class=\"prd4-price\">$89</div>\n                                <span class=\"prd4-save\">Save 30%</span>\n                              </div>\n                              <p class=\"prd4-desc\">Notes of dark oud, smoky vetiver, and warm amber. A bold, mysterious fragrance for those who leave a lasting impression.</p>\n                              <button class=\"prd4-btn\">Buy Now</button>\n                              <button class=\"prd4-secondary\">Add to Wishlist</button>\n                              <div class=\"prd4-trust\">\n                                <div class=\"prd4-trust-item\">📦 Free Shipping</div>\n                                <div class=\"prd4-trust-item\">🔄 Free Returns</div>\n                                <div class=\"prd4-trust-item\">🔒 Secure Checkout</div>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "product-details-5",
      "name": "Full-Width Hero Detail",
      "description": "Immersive product hero banner followed by specs and CTA",
      "html": "\n                        <style>\n                          .prd5-wrap{font-family:sans-serif;background:#fff;}\n                          .prd5-hero{min-height:70vh;background:url('https://images.unsplash.com/photo-1593305841991-05c297ba4575?q=80&w=1600&auto=format&fit=crop') center/cover;display:flex;align-items:center;position:relative;}\n                          .prd5-overlay{position:absolute;inset:0;background:linear-gradient(to right,rgba(0,0,0,0.85) 0%,rgba(0,0,0,0.2) 60%, transparent 100%);}\n                          .prd5-hero-content{position:relative;z-index:1;padding:80px 60px;max-width:600px;}\n                          .prd5-label{display:inline-block;background:#6366f1;color:#fff;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:700;letter-spacing:1px;margin-bottom:15px;}\n                          .prd5-name{color:#fff;font-size:clamp(36px,5vw,60px);font-weight:900;line-height:1.1;margin:0 0 15px;}\n                          .prd5-sub{color:#d1d5db;font-size:18px;margin:0 0 30px;}\n                          .prd5-hero-price{color:#fff;font-size:48px;font-weight:900;margin-bottom:30px;}\n                          .prd5-hero-btn{display:inline-block;padding:16px 36px;background:#6366f1;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;margin-right:12px;}\n                          .prd5-hero-btn2{display:inline-block;padding:16px 36px;background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4);border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;}\n                          .prd5-specs{padding:60px 20px;background:#f9fafb;}\n                          .prd5-specs-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:30px;}\n                          .prd5-spec-item{background:#fff;padding:25px;border-radius:14px;text-align:center;box-shadow:0 4px 15px rgba(0,0,0,0.04);}\n                          .prd5-spec-icon{font-size:36px;margin-bottom:10px;}\n                          .prd5-spec-val{font-size:24px;font-weight:800;color:#111;margin-bottom:4px;}\n                          .prd5-spec-key{color:#6b7280;font-size:13px;}\n                          @media(max-width:900px){.prd5-specs-inner{grid-template-columns:repeat(2,1fr);}}\n                          @media(max-width:600px){.prd5-hero-content{padding:50px 25px;} .prd5-hero-btn2{margin-top:10px;} .prd5-specs-inner{grid-template-columns:1fr 1fr;}}\n                        </style>\n                        <section class=\"prd5-wrap\">\n                          <div class=\"prd5-hero\">\n                            <div class=\"prd5-overlay\"></div>\n                            <div class=\"prd5-hero-content\">\n                              <span class=\"prd5-label\">GAMING AUDIO</span>\n                              <h1 class=\"prd5-name\">ProSound X7 Headset</h1>\n                              <p class=\"prd5-sub\">Surround sound. Zero compromise.</p>\n                              <div class=\"prd5-hero-price\">$299</div>\n                              <button class=\"prd5-hero-btn\">Buy Now</button>\n                              <button class=\"prd5-hero-btn2\">Learn More</button>\n                            </div>\n                          </div>\n                          <div class=\"prd5-specs\">\n                            <div class=\"prd5-specs-inner\">\n                              <div class=\"prd5-spec-item\"><div class=\"prd5-spec-icon\">🔊</div><div class=\"prd5-spec-val\">7.1 CH</div><div class=\"prd5-spec-key\">Surround Sound</div></div>\n                              <div class=\"prd5-spec-item\"><div class=\"prd5-spec-icon\">🔋</div><div class=\"prd5-spec-val\">40hr</div><div class=\"prd5-spec-key\">Battery Life</div></div>\n                              <div class=\"prd5-spec-item\"><div class=\"prd5-spec-icon\">🎤</div><div class=\"prd5-spec-val\">-35dB</div><div class=\"prd5-spec-key\">Noise Cancellation</div></div>\n                              <div class=\"prd5-spec-item\"><div class=\"prd5-spec-icon\">📡</div><div class=\"prd5-spec-val\">10m</div><div class=\"prd5-spec-key\">Wireless Range</div></div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    }
  ]
