    {
      "id": "ct-3",
      "name": "Side-by-Side Cards",
      "html": "\n<style>\n.ct3{padding:100px 20px;background:#f9fafb;font-family:'Inter',sans-serif}\n.ct3-head{text-align:center;margin-bottom:60px}\n.ct3-head h2{font-size:40px;font-weight:800;color:#0f172a;margin:0 0 15px}\n.ct3-head p{color:#64748b;font-size:16px}\n.ct3-grid{max-width:900px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px}\n.ct3-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:2px solid #f1f5f9;transition:transform 0.3s}\n.ct3-card:hover{transform:translateY(-5px)}\n.ct3-card-featured{border-color:#6366f1;box-shadow:0 15px 40px rgba(99,102,241,0.15)}\n.ct3-card-head{padding:30px 28px;border-bottom:1px solid #f1f5f9}\n.ct3-card-featured .ct3-card-head{background:linear-gradient(135deg,#6366f1,#8b5cf6);border-bottom:none}\n.ct3-plan{font-size:13px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}\n.ct3-card-featured .ct3-plan{color:rgba(255,255,255,0.8)}\n.ct3-card-featured .ct3-plan-name{color:#fff}\n.ct3-card-featured .ct3-price-num{color:#fff}\n.ct3-card-featured .ct3-price-per{color:rgba(255,255,255,0.7)}\n.ct3-plan-name{font-size:24px;font-weight:800;color:#0f172a;margin:0 0 15px}\n.ct3-price-num{font-size:48px;font-weight:900;color:#0f172a;line-height:1}\n.ct3-price-per{font-size:14px;color:#94a3b8;margin-left:4px}\n.ct3-features{padding:28px}\n.ct3-feature{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f8fafc;font-size:14px;color:#475569}\n.ct3-feature:last-child{border-bottom:none}\n.ct3-feature-icon{color:#10b981;font-size:16px}\n.ct3-btn{display:block;text-align:center;padding:14px;background:#f1f5f9;color:#0f172a;font-weight:700;border:none;cursor:pointer;width:100%;font-size:15px;transition:background 0.3s}\n.ct3-btn:hover{background:#e2e8f0}\n.ct3-btn-featured{background:#6366f1;color:#fff}\n.ct3-btn-featured:hover{background:#4f46e5}\n</style>\n<section class=\"ct3\">\n  <div class=\"ct3-head\">\n    <h2>Simple, Honest Pricing</h2>\n    <p>Start free. Grow with us at your own pace.</p>\n  </div>\n  <div class=\"ct3-grid\">\n    <div class=\"ct3-card\">\n      <div class=\"ct3-card-head\">\n        <div class=\"ct3-plan\">Starter</div>\n        <div class=\"ct3-plan-name\">Basic</div>\n        <div><span class=\"ct3-price-num\">$0</span><span class=\"ct3-price-per\">/month</span></div>\n      </div>\n      <div class=\"ct3-features\">\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> 5 projects</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> 2 GB storage</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Community support</div>\n        <div class=\"ct3-feature\"><span style=\"color:#cbd5e1\">✕</span> Custom domain</div>\n      </div>\n      <button class=\"ct3-btn\">Get Started Free</button>\n    </div>\n    <div class=\"ct3-card ct3-card-featured\">\n      <div class=\"ct3-card-head\">\n        <div class=\"ct3-plan\">Most Popular</div>\n        <div class=\"ct3-plan-name\">Pro</div>\n        <div><span class=\"ct3-price-num\">$29</span><span class=\"ct3-price-per\">/month</span></div>\n      </div>\n      <div class=\"ct3-features\">\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Unlimited projects</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> 100 GB storage</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Priority support</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Custom domain</div>\n      </div>\n      <button class=\"ct3-btn ct3-btn-featured\">Start Pro Trial</button>\n    </div>\n    <div class=\"ct3-card\">\n      <div class=\"ct3-card-head\">\n        <div class=\"ct3-plan\">Enterprise</div>\n        <div class=\"ct3-plan-name\">Business</div>\n        <div><span class=\"ct3-price-num\">$99</span><span class=\"ct3-price-per\">/month</span></div>\n      </div>\n      <div class=\"ct3-features\">\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Unlimited everything</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> 5 TB storage</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> Dedicated manager</div>\n        <div class=\"ct3-feature\"><span class=\"ct3-feature-icon\">✓</span> SLA guarantee</div>\n      </div>\n      <button class=\"ct3-btn\">Contact Sales</button>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ct-4",
      "name": "Colorful Horizontal Bars",
      "html": "\n<style>\n.ct4{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.ct4-wrap{max-width:1000px;margin:0 auto}\n.ct4-head{text-align:center;margin-bottom:60px}\n.ct4-head h2{font-size:40px;font-weight:900;color:#0f172a;margin:0 0 15px}\n.ct4-head p{color:#64748b}\n.ct4-legend{display:flex;justify-content:center;gap:30px;margin-bottom:40px;flex-wrap:wrap}\n.ct4-legend-item{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:#334155}\n.ct4-dot{width:14px;height:14px;border-radius:3px}\n.ct4-d1{background:#6366f1}\n.ct4-d2{background:#10b981}\n.ct4-d3{background:#f59e0b}\n.ct4-feature-row{margin-bottom:20px}\n.ct4-feature-label{font-size:15px;font-weight:700;color:#0f172a;margin-bottom:10px}\n.ct4-bars{display:flex;flex-direction:column;gap:8px}\n.ct4-bar-row{display:flex;align-items:center;gap:15px}\n.ct4-bar-bg{flex:1;height:32px;background:#f1f5f9;border-radius:8px;overflow:hidden;position:relative}\n.ct4-bar-fill{height:100%;border-radius:8px;display:flex;align-items:center;padding-left:12px;font-size:12px;font-weight:700;color:#fff;white-space:nowrap;min-width:30px}\n.ct4-bar-label{font-size:13px;color:#64748b;width:70px;text-align:right;flex-shrink:0}\n</style>\n<section class=\"ct4\">\n  <div class=\"ct4-wrap\">\n    <div class=\"ct4-head\">\n      <h2>How We Compare</h2>\n      <p>See how our features stack up against the competition</p>\n    </div>\n    <div class=\"ct4-legend\">\n      <div class=\"ct4-legend-item\"><div class=\"ct4-dot ct4-d1\"></div>Our Product</div>\n      <div class=\"ct4-legend-item\"><div class=\"ct4-dot ct4-d2\"></div>Competitor A</div>\n      <div class=\"ct4-legend-item\"><div class=\"ct4-dot ct4-d3\"></div>Competitor B</div>\n    </div>\n    <div class=\"ct4-feature-row\">\n      <div class=\"ct4-feature-label\">Performance Score</div>\n      <div class=\"ct4-bars\">\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Us</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:96%;background:#6366f1\">96/100</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp A</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:72%;background:#10b981\">72/100</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp B</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:60%;background:#f59e0b\">60/100</div></div></div>\n      </div>\n    </div>\n    <div class=\"ct4-feature-row\">\n      <div class=\"ct4-feature-label\">Customer Satisfaction</div>\n      <div class=\"ct4-bars\">\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Us</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:99%;background:#6366f1\">99%</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp A</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:78%;background:#10b981\">78%</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp B</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:65%;background:#f59e0b\">65%</div></div></div>\n      </div>\n    </div>\n    <div class=\"ct4-feature-row\">\n      <div class=\"ct4-feature-label\">Uptime Guarantee</div>\n      <div class=\"ct4-bars\">\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Us</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:99.9%;background:#6366f1\">99.9%</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp A</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:95%;background:#10b981\">95%</div></div></div>\n        <div class=\"ct4-bar-row\"><div class=\"ct4-bar-label\">Comp B</div><div class=\"ct4-bar-bg\"><div class=\"ct4-bar-fill\" style=\"width:80%;background:#f59e0b\">80%</div></div></div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ct-5",
      "name": "Neo-Brutalism Comparison",
      "html": "\n<style>\n.ct5{padding:100px 20px;background:#fef9c3;font-family:'Inter',sans-serif}\n.ct5-wrap{max-width:1000px;margin:0 auto}\n.ct5-title{font-size:44px;font-weight:900;color:#000;text-transform:uppercase;margin:0 0 50px;border-bottom:4px solid #000;padding-bottom:20px;letter-spacing:-1px}\n.ct5-table{width:100%;border-collapse:collapse}\n.ct5-table th,.ct5-table td{padding:16px 20px;text-align:center;border:3px solid #000;font-size:15px}\n.ct5-table thead{background:#000;color:#fff}\n.ct5-table thead th{font-size:18px;font-weight:900;text-transform:uppercase;letter-spacing:1px}\n.ct5-table thead th:first-child{text-align:left}\n.ct5-table td:first-child{text-align:left;font-weight:700;color:#000;background:#fff}\n.ct5-table tbody tr:nth-child(odd) td:not(:first-child){background:#fff}\n.ct5-table tbody tr:nth-child(even) td:not(:first-child){background:#fefce8}\n.ct5-table tbody tr:hover td{background:#fde68a}\n.ct5-hot-col{background:#4ade80!important;font-weight:900!important}\n.ct5-check{font-size:20px;color:#16a34a;font-weight:900}\n.ct5-cross{font-size:20px;color:#dc2626;font-weight:900}\n</style>\n<section class=\"ct5\">\n  <div class=\"ct5-wrap\">\n    <h2 class=\"ct5-title\">Feature Breakdown</h2>\n    <table class=\"ct5-table\">\n      <thead>\n        <tr>\n          <th>Feature</th>\n          <th>Basic</th>\n          <th class=\"ct5-hot-col\">Pro ★</th>\n          <th>Enterprise</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr><td>Users</td><td>1</td><td class=\"ct5-hot-col\">50</td><td>Unlimited</td></tr>\n        <tr><td>Storage</td><td>1 GB</td><td class=\"ct5-hot-col\">250 GB</td><td>10 TB</td></tr>\n        <tr><td>Integrations</td><td>3</td><td class=\"ct5-hot-col\">50+</td><td>Custom</td></tr>\n        <tr><td>Priority Support</td><td><span class=\"ct5-cross\">✕</span></td><td class=\"ct5-hot-col\"><span class=\"ct5-check\">✓</span></td><td><span class=\"ct5-check\">✓</span></td></tr>\n        <tr><td>White Label</td><td><span class=\"ct5-cross\">✕</span></td><td class=\"ct5-hot-col\"><span class=\"ct5-cross\">✕</span></td><td><span class=\"ct5-check\">✓</span></td></tr>\n        <tr><td>Price/Month</td><td>Free</td><td class=\"ct5-hot-col\">$39</td><td>Custom</td></tr>\n      </tbody>\n    </table>\n  </div>\n</section>"
    },
    {
      "id": "ct-6",
      "name": "Glassmorphism Pricing Comparison",
      "html": "\n<style>\n.ct6{padding:100px 20px;background:linear-gradient(135deg,#1e1b4b,#0f172a);font-family:'Inter',sans-serif;position:relative;overflow:hidden}\n.ct6-blob{position:absolute;width:500px;height:500px;background:#4f46e5;border-radius:50%;filter:blur(120px);top:-150px;right:-150px;opacity:0.3}\n.ct6-wrap{position:relative;z-index:2;max-width:1000px;margin:0 auto}\n.ct6-head{text-align:center;margin-bottom:60px;color:#fff}\n.ct6-head h2{font-size:42px;font-weight:900;margin:0 0 15px}\n.ct6-head p{color:#94a3b8;font-size:16px}\n.ct6-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}\n.ct6-card{background:rgba(255,255,255,0.04);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.08);border-radius:24px;overflow:hidden;color:#fff}\n.ct6-card-featured{border-color:rgba(99,102,241,0.6);background:rgba(99,102,241,0.08);box-shadow:0 0 60px rgba(99,102,241,0.15)}\n.ct6-card-top{padding:30px 28px;border-bottom:1px solid rgba(255,255,255,0.06)}\n.ct6-plan-name{font-size:14px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}\n.ct6-card-featured .ct6-plan-name{color:#a78bfa}\n.ct6-plan-price{font-size:52px;font-weight:900;margin:0;line-height:1}\n.ct6-plan-per{font-size:14px;color:#64748b}\n.ct6-features{padding:28px;display:flex;flex-direction:column;gap:14px}\n.ct6-f{display:flex;align-items:center;gap:12px;font-size:14px;color:#cbd5e1}\n.ct6-f-icon{color:#6366f1;font-size:16px;flex-shrink:0}\n.ct6-card-featured .ct6-f-icon{color:#a78bfa}\n.ct6-cta{display:block;margin:0 28px 28px;text-align:center;padding:14px;background:rgba(255,255,255,0.08);color:#fff;border:1px solid rgba(255,255,255,0.15);border-radius:10px;font-weight:700;font-size:14px;cursor:pointer;transition:background 0.3s}\n.ct6-cta:hover{background:rgba(255,255,255,0.15)}\n.ct6-cta-featured{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none}\n</style>\n<section class=\"ct6\">\n  <div class=\"ct6-blob\"></div>\n  <div class=\"ct6-wrap\">\n    <div class=\"ct6-head\">\n      <h2>Pricing Plans</h2>\n      <p>All plans include a 14-day free trial. No credit card needed.</p>\n    </div>\n    <div class=\"ct6-grid\">\n      <div class=\"ct6-card\">\n        <div class=\"ct6-card-top\">\n          <div class=\"ct6-plan-name\">Starter</div>\n          <div class=\"ct6-plan-price\">$0<span style=\"font-size:20px;font-weight:400\"> /mo</span></div>\n        </div>\n        <div class=\"ct6-features\">\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> 3 active projects</div>\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> 1 GB storage</div>\n          <div class=\"ct6-f\"><span style=\"color:#3f3f46\" class=\"ct6-f-icon\">✕</span> <span style=\"color:#52525b\">Team access</span></div>\n        </div>\n        <button class=\"ct6-cta\">Get Started</button>\n      </div>\n      <div class=\"ct6-card ct6-card-featured\">\n        <div class=\"ct6-card-top\">\n          <div class=\"ct6-plan-name\">Pro — Most Popular</div>\n          <div class=\"ct6-plan-price\">$49<span style=\"font-size:20px;font-weight:400\"> /mo</span></div>\n        </div>\n        <div class=\"ct6-features\">\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> Unlimited projects</div>\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> 500 GB storage</div>\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> Up to 25 team members</div>\n        </div>\n        <button class=\"ct6-cta ct6-cta-featured\">Start Free Trial</button>\n      </div>\n      <div class=\"ct6-card\">\n        <div class=\"ct6-card-top\">\n          <div class=\"ct6-plan-name\">Enterprise</div>\n          <div class=\"ct6-plan-price\" style=\"font-size:36px\">Custom</div>\n        </div>\n        <div class=\"ct6-features\">\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> Unlimited everything</div>\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> Dedicated account manager</div>\n          <div class=\"ct6-f\"><span class=\"ct6-f-icon\">✓</span> SLA & compliance</div>\n        </div>\n        <button class=\"ct6-cta\">Contact Sales</button>\n      </div>\n    </div>\n  </div>\n</section>"
    }
  ]
}
