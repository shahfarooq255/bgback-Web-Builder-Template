      "id": "ct-1",
      "name": "Feature Comparison Table",
      "html": "\n<style>\n.ct1{padding:100px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.ct1 h2{text-align:center;font-size:clamp(30px,4vw,44px);font-weight:800;color:#0f172a;margin:0 0 15px}\n.ct1>p{text-align:center;color:#64748b;font-size:16px;margin:0 0 60px}\n.ct1-table{max-width:900px;margin:0 auto;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.08)}\n.ct1-header{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;background:#0f172a}\n.ct1-row{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;background:#fff;border-bottom:1px solid #f1f5f9}\n.ct1-row:last-child{border-bottom:none}\n.ct1-row:nth-child(even){background:#f8fafc}\n.ct1-cell{padding:18px 20px;font-size:14px;display:flex;align-items:center}\n.ct1-header .ct1-cell{color:#fff;font-weight:700;font-size:15px;justify-content:center}\n.ct1-header .ct1-cell:first-child{justify-content:flex-start}\n.ct1-feature{font-weight:600;color:#0f172a}\n.ct1-val{justify-content:center;color:#475569}\n.ct1-check{font-size:18px;color:#16a34a}\n.ct1-cross{font-size:18px;color:#dc2626}\n.ct1-highlight{background:linear-gradient(135deg,#6366f1,#8b5cf6)!important}\n</style>\n<section class=\"ct1\">\n  <h2>Compare Plans</h2>\n  <p>Choose the plan that's right for your business</p>\n  <div class=\"ct1-table\">\n    <div class=\"ct1-header\">\n      <div class=\"ct1-cell\">Features</div>\n      <div class=\"ct1-cell\">Starter</div>\n      <div class=\"ct1-cell ct1-highlight\">Pro</div>\n      <div class=\"ct1-cell\">Enterprise</div>\n    </div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Users</div><div class=\"ct1-cell ct1-val\">1 User</div><div class=\"ct1-cell ct1-val\">10 Users</div><div class=\"ct1-cell ct1-val\">Unlimited</div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Storage</div><div class=\"ct1-cell ct1-val\">5 GB</div><div class=\"ct1-cell ct1-val\">100 GB</div><div class=\"ct1-cell ct1-val\">1 TB</div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Custom Domain</div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-cross\">✗</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Analytics</div><div class=\"ct1-cell ct1-val\">Basic</div><div class=\"ct1-cell ct1-val\">Advanced</div><div class=\"ct1-cell ct1-val\">Custom</div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">API Access</div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-cross\">✗</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Priority Support</div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-cross\">✗</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div><div class=\"ct1-cell ct1-val\"><span class=\"ct1-check\">✓</span></div></div>\n    <div class=\"ct1-row\"><div class=\"ct1-cell ct1-feature\">Price/Month</div><div class=\"ct1-cell ct1-val\">Free</div><div class=\"ct1-cell ct1-val\" style=\"color:#6366f1;font-weight:700\">$29</div><div class=\"ct1-cell ct1-val\">Custom</div></div>\n  </div>\n</section>"
    },
    {
      "id": "ct-2",
      "name": "Dark Pro Comparison",
      "html": "\n<style>\n.ct2{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;color:#fff}\n.ct2-head{text-align:center;margin-bottom:60px}\n.ct2-head h2{font-size:42px;font-weight:900;color:#fff;margin:0 0 15px}\n.ct2-head p{color:#71717a;font-size:16px}\n.ct2-table{max-width:950px;margin:0 auto;border-radius:16px;overflow:hidden;border:1px solid #27272a}\n.ct2-hrow{display:grid;grid-template-columns:2.5fr 1fr 1fr 1fr;background:#18181b;border-bottom:1px solid #27272a}\n.ct2-row{display:grid;grid-template-columns:2.5fr 1fr 1fr 1fr;border-bottom:1px solid #1f1f1f;transition:background 0.2s}\n.ct2-row:last-child{border-bottom:none}\n.ct2-row:hover{background:#18181b}\n.ct2-cell{padding:20px 24px;font-size:14px;display:flex;align-items:center;justify-content:center}\n.ct2-cell:first-child{justify-content:flex-start;color:#a1a1aa;font-weight:500}\n.ct2-hrow .ct2-cell{font-size:15px;font-weight:700;color:#fff;justify-content:center}\n.ct2-hrow .ct2-cell:first-child{justify-content:flex-start;color:#71717a}\n.ct2-hot{background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff!important}\n.ct2-hot .ct2-cell{color:#fff!important}\n.ct2-badge{display:block;font-size:10px;color:#a78bfa;margin-top:3px;font-weight:400}\n.ct2-check{color:#10b981;font-size:18px}\n.ct2-cross{color:#3f3f46;font-size:18px}\n.ct2-price{font-size:22px;font-weight:900;color:#fff}\n.ct2-price-free{color:#71717a}\n</style>\n<section class=\"ct2\">\n  <div class=\"ct2-head\">\n    <h2>Pick the Right Plan</h2>\n    <p>Transparent pricing. No hidden fees. Cancel anytime.</p>\n  </div>\n  <div class=\"ct2-table\">\n    <div class=\"ct2-hrow\">\n      <div class=\"ct2-cell\">Features</div>\n      <div class=\"ct2-cell\">Basic<span class=\"ct2-badge\">Free</span></div>\n      <div class=\"ct2-cell ct2-hot\">Pro<span class=\"ct2-badge\">Most Popular</span></div>\n      <div class=\"ct2-cell\">Enterprise<span class=\"ct2-badge\">Custom</span></div>\n    </div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Team Members</div><div class=\"ct2-cell\">1</div><div class=\"ct2-cell\">25</div><div class=\"ct2-cell\">Unlimited</div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Projects</div><div class=\"ct2-cell\">3</div><div class=\"ct2-cell\">Unlimited</div><div class=\"ct2-cell\">Unlimited</div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Storage</div><div class=\"ct2-cell\">2 GB</div><div class=\"ct2-cell\">500 GB</div><div class=\"ct2-cell\">5 TB</div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Custom Branding</div><div class=\"ct2-cell\"><span class=\"ct2-cross\">✕</span></div><div class=\"ct2-cell\"><span class=\"ct2-check\">✓</span></div><div class=\"ct2-cell\"><span class=\"ct2-check\">✓</span></div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Advanced Analytics</div><div class=\"ct2-cell\"><span class=\"ct2-cross\">✕</span></div><div class=\"ct2-cell\"><span class=\"ct2-check\">✓</span></div><div class=\"ct2-cell\"><span class=\"ct2-check\">✓</span></div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Dedicated Support</div><div class=\"ct2-cell\"><span class=\"ct2-cross\">✕</span></div><div class=\"ct2-cell\"><span class=\"ct2-cross\">✕</span></div><div class=\"ct2-cell\"><span class=\"ct2-check\">✓</span></div></div>\n    <div class=\"ct2-row\"><div class=\"ct2-cell\">Monthly Price</div><div class=\"ct2-cell\"><span class=\"ct2-price ct2-price-free\">$0</span></div><div class=\"ct2-cell\"><span class=\"ct2-price\">$49</span></div><div class=\"ct2-cell\"><span class=\"ct2-price\">Custom</span></div></div>\n  </div>\n</section>"
