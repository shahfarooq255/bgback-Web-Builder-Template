    {
      "id": "pricing-1",
      "name": "Classic 3-Tier",
      "description": "A standard 3-tier pricing grid highlighting the middle Pro plan",
      "html": "\n                        <style>\n                          .prc1-wrap{padding:80px 20px;background:#f8fafc;font-family:sans-serif;}\n                          .prc1-head{text-align:center;margin-bottom:50px;}\n                          .prc1-head h2{font-size:clamp(30px,5vw,40px);font-weight:900;color:#0f172a;margin:0 0 10px;}\n                          .prc1-head p{color:#64748b;font-size:18px;max-width:600px;margin:0 auto;}\n                          .prc1-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:30px;max-width:1100px;margin:0 auto;align-items:center;}\n                          .prc1-card{background:#fff;border-radius:16px;padding:40px;width:320px;box-shadow:0 10px 30px rgba(0,0,0,0.05);position:relative;border:1px solid #e2e8f0;transition:transform 0.3s;}\n                          .prc1-card:hover{transform:translateY(-5px);}\n                          .prc1-card.popular{border:2px solid #3b82f6;box-shadow:0 20px 40px rgba(59,130,246,0.15);transform:scale(1.05);}\n                          .prc1-card.popular:hover{transform:scale(1.05) translateY(-5px);}\n                          .prc1-badge{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:#3b82f6;color:#fff;padding:5px 15px;border-radius:20px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;}\n                          .prc1-name{font-size:20px;font-weight:700;color:#0f172a;margin:0 0 15px;}\n                          .prc1-price{font-size:48px;font-weight:900;color:#0f172a;margin:0 0 20px;}\n                          .prc1-price span{font-size:16px;font-weight:500;color:#64748b;}\n                          .prc1-list{list-style:none;padding:0;margin:0 0 30px;}\n                          .prc1-list li{padding:10px 0;color:#475569;display:flex;align-items:center;gap:10px;font-size:15px;}\n                          .prc1-list li::before{content:'✓';color:#10b981;font-weight:bold;}\n                          .prc1-btn{display:block;width:100%;padding:15px;border-radius:8px;text-align:center;font-weight:700;text-decoration:none;transition:all 0.3s;}\n                          .prc1-btn-outline{background:transparent;color:#3b82f6;border:2px solid #3b82f6;}\n                          .prc1-btn-outline:hover{background:#f0f9ff;}\n                          .prc1-btn-solid{background:#3b82f6;color:#fff;border:2px solid #3b82f6;}\n                          .prc1-btn-solid:hover{background:#2563eb;border-color:#2563eb;}\n                          @media(max-width:900px){.prc1-card.popular{transform:scale(1);} .prc1-card.popular:hover{transform:translateY(-5px);}}\n                          @media(max-width:768px){.prc1-card{width:100%;max-width:400px;}}\n                        </style>\n                        <section class=\"prc1-wrap\">\n                          <div class=\"prc1-head\">\n                            <h2>Simple, Transparent Pricing</h2>\n                            <p>Choose the perfect plan for your business needs.</p>\n                          </div>\n                          <div class=\"prc1-grid\">\n                            <div class=\"prc1-card\">\n                              <h3 class=\"prc1-name\">Basic</h3>\n                              <div class=\"prc1-price\">$19<span>/mo</span></div>\n                              <ul class=\"prc1-list\">\n                                <li>1 User Account</li>\n                                <li>5GB Storage</li>\n                                <li>Basic Support</li>\n                                <li>Standard Analytics</li>\n                              </ul>\n                              <a href=\"#\" class=\"prc1-btn prc1-btn-outline\">Get Started</a>\n                            </div>\n                            <div class=\"prc1-card popular\">\n                              <div class=\"prc1-badge\">Most Popular</div>\n                              <h3 class=\"prc1-name\">Pro</h3>\n                              <div class=\"prc1-price\">$49<span>/mo</span></div>\n                              <ul class=\"prc1-list\">\n                                <li>5 User Accounts</li>\n                                <li>50GB Storage</li>\n                                <li>Priority Support</li>\n                                <li>Advanced Analytics</li>\n                                <li>Custom Integrations</li>\n                              </ul>\n                              <a href=\"#\" class=\"prc1-btn prc1-btn-solid\">Start Free Trial</a>\n                            </div>\n                            <div class=\"prc1-card\">\n                              <h3 class=\"prc1-name\">Enterprise</h3>\n                              <div class=\"prc1-price\">$99<span>/mo</span></div>\n                              <ul class=\"prc1-list\">\n                                <li>Unlimited Users</li>\n                                <li>500GB Storage</li>\n                                <li>24/7 Dedicated Support</li>\n                                <li>Custom Reporting</li>\n                              </ul>\n                              <a href=\"#\" class=\"prc1-btn prc1-btn-outline\">Contact Sales</a>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "pricing-2",
      "name": "Monthly/Yearly Toggle",
      "description": "Pricing table with a functional toggle switch for monthly and yearly billing",
      "html": "\n                        <style>\n                          .prc2-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prc2-head{text-align:center;margin-bottom:40px;}\n                          .prc2-head h2{font-size:36px;font-weight:800;color:#111;margin:0 0 20px;}\n                          .prc2-toggle-box{display:flex;align-items:center;justify-content:center;gap:15px;margin-bottom:50px;}\n                          .prc2-toggle-label{font-size:16px;font-weight:600;color:#666;}\n                          .prc2-toggle-label.active{color:#111;}\n                          .prc2-toggle{position:relative;width:60px;height:32px;background:#e5e7eb;border-radius:30px;cursor:pointer;transition:background 0.3s;}\n                          .prc2-toggle.active{background:#10b981;}\n                          .prc2-toggle-circle{position:absolute;top:3px;left:3px;width:26px;height:26px;background:#fff;border-radius:50%;transition:transform 0.3s;box-shadow:0 2px 5px rgba(0,0,0,0.2);}\n                          .prc2-toggle.active .prc2-toggle-circle{transform:translateX(28px);}\n                          .prc2-save{background:#dcfce7;color:#166534;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:700;}\n                          .prc2-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:30px;max-width:1000px;margin:0 auto;}\n                          .prc2-card{border:1px solid #e5e7eb;border-radius:24px;padding:40px;background:#fafafa;}\n                          .prc2-card.featured{background:#111;color:#fff;}\n                          .prc2-name{font-size:24px;margin:0 0 10px;}\n                          .prc2-desc{font-size:15px;color:#6b7280;margin:0 0 30px;}\n                          .prc2-card.featured .prc2-desc{color:#9ca3af;}\n                          .prc2-price-box{display:flex;align-items:flex-end;gap:5px;margin-bottom:30px;}\n                          .prc2-currency{font-size:24px;font-weight:700;line-height:1;}\n                          .prc2-amount{font-size:56px;font-weight:900;line-height:0.9;}\n                          .prc2-period{font-size:16px;color:#6b7280;}\n                          .prc2-btn{display:block;width:100%;padding:16px;border-radius:12px;text-align:center;font-weight:700;text-decoration:none;background:#fff;color:#111;border:1px solid #e5e7eb;}\n                          .prc2-card.featured .prc2-btn{background:#10b981;color:#fff;border:none;}\n                          .prc2-list{list-style:none;padding:0;margin:30px 0 0;}\n                          .prc2-list li{padding:12px 0;border-top:1px solid #e5e7eb;font-size:15px;display:flex;align-items:center;gap:10px;}\n                          .prc2-card.featured .prc2-list li{border-color:#333;color:#e5e7eb;}\n                          .prc2-check{color:#10b981;}\n                        </style>\n                        <section class=\"prc2-wrap\">\n                          <div class=\"prc2-head\">\n                            <h2>Flexible Pricing Plans</h2>\n                            <div class=\"prc2-toggle-box\">\n                              <span class=\"prc2-toggle-label active\" id=\"prc2-mo-lbl\">Monthly</span>\n                              <div class=\"prc2-toggle\" id=\"prc2-toggle-btn\" onclick=\"\n                                this.classList.toggle('active');\n                                const isYearly = this.classList.contains('active');\n                                document.getElementById('prc2-mo-lbl').classList.toggle('active', !isYearly);\n                                document.getElementById('prc2-yr-lbl').classList.toggle('active', isYearly);\n                                document.querySelectorAll('.prc2-amount').forEach(el => el.innerText = isYearly ? el.dataset.yr : el.dataset.mo);\n                                document.querySelectorAll('.prc2-period').forEach(el => el.innerText = isYearly ? '/year' : '/month');\n                              \">\n                                <div class=\"prc2-toggle-circle\"></div>\n                              </div>\n                              <span class=\"prc2-toggle-label\" id=\"prc2-yr-lbl\">Yearly <span class=\"prc2-save\">Save 20%</span></span>\n                            </div>\n                          </div>\n                          <div class=\"prc2-grid\">\n                            <div class=\"prc2-card\">\n                              <h3 class=\"prc2-name\">Starter</h3>\n                              <p class=\"prc2-desc\">Perfect for individuals and small projects.</p>\n                              <div class=\"prc2-price-box\">\n                                <span class=\"prc2-currency\">$</span>\n                                <span class=\"prc2-amount\" data-mo=\"15\" data-yr=\"144\">15</span>\n                                <span class=\"prc2-period\">/month</span>\n                              </div>\n                              <a href=\"#\" class=\"prc2-btn\">Get Started</a>\n                              <ul class=\"prc2-list\">\n                                <li><span class=\"prc2-check\">✓</span> 1 Project</li>\n                                <li><span class=\"prc2-check\">✓</span> Basic Analytics</li>\n                                <li><span class=\"prc2-check\">✓</span> 24-hour Support Response</li>\n                              </ul>\n                            </div>\n                            <div class=\"prc2-card featured\">\n                              <h3 class=\"prc2-name\">Professional</h3>\n                              <p class=\"prc2-desc\">Ideal for growing businesses and teams.</p>\n                              <div class=\"prc2-price-box\">\n                                <span class=\"prc2-currency\">$</span>\n                                <span class=\"prc2-amount\" data-mo=\"45\" data-yr=\"432\">45</span>\n                                <span class=\"prc2-period\">/month</span>\n                              </div>\n                              <a href=\"#\" class=\"prc2-btn\">Get Started</a>\n                              <ul class=\"prc2-list\">\n                                <li><span class=\"prc2-check\">✓</span> Unlimited Projects</li>\n                                <li><span class=\"prc2-check\">✓</span> Advanced Analytics</li>\n                                <li><span class=\"prc2-check\">✓</span> 1-hour Support Response</li>\n                                <li><span class=\"prc2-check\">✓</span> Custom Domain</li>\n                              </ul>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "pricing-3",
      "name": "Dark Premium Matrix",
      "description": "A dark, sleek pricing design with glowing borders, perfect for premium tech products",
      "html": "\n                        <style>\n                          .prc3-wrap{padding:100px 20px;background:#030712;font-family:sans-serif;}\n                          .prc3-head{text-align:center;margin-bottom:60px;}\n                          .prc3-head h2{font-size:clamp(32px,5vw,48px);font-weight:900;color:#fff;margin:0 0 15px;}\n                          .prc3-head p{color:#9ca3af;font-size:18px;}\n                          .prc3-grid{display:flex;justify-content:center;flex-wrap:wrap;gap:20px;max-width:1200px;margin:0 auto;}\n                          .prc3-card{background:#111827;border:1px solid #1f2937;border-radius:24px;padding:40px 30px;width:340px;text-align:center;position:relative;overflow:hidden;}\n                          .prc3-card.premium{border-color:#8b5cf6;box-shadow:0 0 40px rgba(139,92,246,0.15);}\n                          .prc3-card.premium::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg, #8b5cf6, #ec4899);}\n                          .prc3-badge{display:inline-block;background:rgba(139,92,246,0.2);color:#c4b5fd;padding:6px 12px;border-radius:20px;font-size:12px;font-weight:800;letter-spacing:1px;margin-bottom:20px;}\n                          .prc3-name{font-size:22px;color:#fff;margin:0 0 10px;}\n                          .prc3-price{font-size:50px;font-weight:900;color:#fff;margin:0 0 30px;}\n                          .prc3-price span{font-size:18px;color:#6b7280;font-weight:500;}\n                          .prc3-btn{display:block;width:100%;padding:16px;border-radius:12px;font-weight:700;color:#fff;background:#374151;text-decoration:none;margin-bottom:40px;transition:background 0.3s;}\n                          .prc3-btn:hover{background:#4b5563;}\n                          .prc3-card.premium .prc3-btn{background:linear-gradient(90deg, #8b5cf6, #ec4899);}\n                          .prc3-card.premium .prc3-btn:hover{opacity:0.9;}\n                          .prc3-list{list-style:none;padding:0;margin:0;text-align:left;}\n                          .prc3-list li{color:#d1d5db;font-size:15px;padding:12px 0;display:flex;align-items:center;gap:12px;}\n                          .prc3-list li svg{width:20px;height:20px;fill:#10b981;flex-shrink:0;}\n                          @media(max-width:768px){.prc3-card{width:100%;max-width:400px;}}\n                        </style>\n                        <section class=\"prc3-wrap\">\n                          <div class=\"prc3-head\">\n                            <h2>Unlock Your Potential</h2>\n                            <p>Premium features for teams that demand the best.</p>\n                          </div>\n                          <div class=\"prc3-grid\">\n                            <div class=\"prc3-card\">\n                              <h3 class=\"prc3-name\">Developer</h3>\n                              <div class=\"prc3-price\">$29<span>/mo</span></div>\n                              <a href=\"#\" class=\"prc3-btn\">Deploy Now</a>\n                              <ul class=\"prc3-list\">\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> 10,000 API Requests</li>\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> 5 Projects</li>\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> Community Support</li>\n                              </ul>\n                            </div>\n                            <div class=\"prc3-card premium\">\n                              <div class=\"prc3-badge\">RECOMMENDED</div>\n                              <h3 class=\"prc3-name\">Business</h3>\n                              <div class=\"prc3-price\">$99<span>/mo</span></div>\n                              <a href=\"#\" class=\"prc3-btn\">Get Started</a>\n                              <ul class=\"prc3-list\">\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> Unlimited API Requests</li>\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> Unlimited Projects</li>\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> Priority Email Support</li>\n                                <li><svg viewBox=\"0 0 20 20\"><path d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"/></svg> Custom SLA</li>\n                              </ul>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "pricing-4",
      "name": "Minimal Split",
      "description": "A clean, apple-style two-column layout for simple either/or pricing decisions",
      "html": "\n                        <style>\n                          .prc4-wrap{padding:80px 20px;background:#fafafa;font-family:sans-serif;}\n                          .prc4-inner{max-width:900px;margin:0 auto;background:#fff;border-radius:24px;box-shadow:0 10px 40px rgba(0,0,0,0.08);display:flex;overflow:hidden;}\n                          .prc4-card{flex:1;padding:60px 40px;}\n                          .prc4-card:first-child{border-right:1px solid #f0f0f0;}\n                          .prc4-name{font-size:28px;font-weight:700;color:#111;margin:0 0 10px;}\n                          .prc4-desc{color:#666;font-size:15px;margin:0 0 40px;line-height:1.6;}\n                          .prc4-price{font-size:50px;font-weight:800;color:#111;margin:0 0 40px;}\n                          .prc4-price span{font-size:20px;font-weight:500;color:#888;}\n                          .prc4-btn{display:block;width:100%;padding:18px;border-radius:40px;text-align:center;font-weight:700;text-decoration:none;background:#f4f4f5;color:#111;transition:background 0.3s;}\n                          .prc4-btn:hover{background:#e4e4e7;}\n                          .prc4-btn-dark{background:#111;color:#fff;}\n                          .prc4-btn-dark:hover{background:#333;}\n                          .prc4-features{margin-top:40px;}\n                          .prc4-features h4{font-size:14px;text-transform:uppercase;color:#888;letter-spacing:1px;margin:0 0 20px;}\n                          .prc4-list{list-style:none;padding:0;margin:0;}\n                          .prc4-list li{padding:8px 0;color:#333;font-size:15px;}\n                          @media(max-width:768px){.prc4-inner{flex-direction:column;} .prc4-card:first-child{border-right:none;border-bottom:1px solid #f0f0f0;} .prc4-card{padding:40px 30px;}}\n                        </style>\n                        <section class=\"prc4-wrap\">\n                          <div class=\"prc4-inner\">\n                            <div class=\"prc4-card\">\n                              <h3 class=\"prc4-name\">Free</h3>\n                              <p class=\"prc4-desc\">Everything you need to get started and explore the platform.</p>\n                              <div class=\"prc4-price\">$0<span>/mo</span></div>\n                              <a href=\"#\" class=\"prc4-btn\">Create Free Account</a>\n                              <div class=\"prc4-features\">\n                                <h4>Included</h4>\n                                <ul class=\"prc4-list\">\n                                  <li>1 User</li>\n                                  <li>Community Forum</li>\n                                  <li>Basic Templates</li>\n                                </ul>\n                              </div>\n                            </div>\n                            <div class=\"prc4-card\">\n                              <h3 class=\"prc4-name\">Pro</h3>\n                              <p class=\"prc4-desc\">Advanced tools for professionals who need more power.</p>\n                              <div class=\"prc4-price\">$24<span>/mo</span></div>\n                              <a href=\"#\" class=\"prc4-btn prc4-btn-dark\">Upgrade to Pro</a>\n                              <div class=\"prc4-features\">\n                                <h4>Everything in Free, plus:</h4>\n                                <ul class=\"prc4-list\">\n                                  <li>Unlimited Users</li>\n                                  <li>24/7 Priority Support</li>\n                                  <li>Premium Templates</li>\n                                  <li>Custom Domains</li>\n                                </ul>\n                              </div>\n                            </div>\n                          </div>\n                        </section>\n                    "
    },
    {
      "id": "pricing-5",
      "name": "Feature Matrix",
      "description": "A detailed table comparing features across plans, great for B2B SaaS",
      "html": "\n                        <style>\n                          .prc5-wrap{padding:80px 20px;background:#fff;font-family:sans-serif;}\n                          .prc5-inner{max-width:1000px;margin:0 auto;}\n                          .prc5-head{text-align:center;margin-bottom:50px;}\n                          .prc5-head h2{font-size:36px;font-weight:900;color:#111;margin:0;}\n                          .prc5-table{width:100%;border-collapse:collapse;}\n                          .prc5-table th, .prc5-table td{padding:20px;text-align:center;border-bottom:1px solid #eaeaea;}\n                          .prc5-table th:first-child, .prc5-table td:first-child{text-align:left;}\n                          .prc5-th-name{font-size:20px;font-weight:800;color:#111;display:block;margin-bottom:10px;}\n                          .prc5-th-price{font-size:30px;font-weight:900;color:#111;}\n                          .prc5-th-price span{font-size:14px;color:#888;font-weight:500;}\n                          .prc5-btn{display:inline-block;padding:10px 20px;border-radius:6px;background:#111;color:#fff;text-decoration:none;font-weight:600;font-size:14px;margin-top:15px;}\n                          .prc5-table td{color:#444;font-size:15px;}\n                          .prc5-feature{font-weight:600;color:#111;}\n                          .prc5-check{color:#10b981;font-weight:bold;font-size:18px;}\n                          .prc5-dash{color:#ccc;}\n                          @media(max-width:768px){\n                            .prc5-table th, .prc5-table td{padding:10px;font-size:13px;}\n                            .prc5-th-name{font-size:16px;}\n                            .prc5-th-price{font-size:20px;}\n                            .prc5-btn{padding:8px 10px;font-size:12px;}\n                          }\n                        </style>\n                        <section class=\"prc5-wrap\">\n                          <div class=\"prc5-inner\">\n                            <div class=\"prc5-head\">\n                              <h2>Compare Plans</h2>\n                            </div>\n                            <div style=\"overflow-x:auto;\">\n                              <table class=\"prc5-table\">\n                                <thead>\n                                  <tr>\n                                    <th></th>\n                                    <th>\n                                      <span class=\"prc5-th-name\">Basic</span>\n                                      <div class=\"prc5-th-price\">$9<span>/mo</span></div>\n                                      <a href=\"#\" class=\"prc5-btn\">Buy Basic</a>\n                                    </th>\n                                    <th>\n                                      <span class=\"prc5-th-name\">Pro</span>\n                                      <div class=\"prc5-th-price\">$29<span>/mo</span></div>\n                                      <a href=\"#\" class=\"prc5-btn\">Buy Pro</a>\n                                    </th>\n                                    <th>\n                                      <span class=\"prc5-th-name\">Ultra</span>\n                                      <div class=\"prc5-th-price\">$99<span>/mo</span></div>\n                                      <a href=\"#\" class=\"prc5-btn\">Buy Ultra</a>\n                                    </th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  <tr>\n                                    <td class=\"prc5-feature\">Projects</td>\n                                    <td>3</td>\n                                    <td>10</td>\n                                    <td>Unlimited</td>\n                                  </tr>\n                                  <tr>\n                                    <td class=\"prc5-feature\">Storage</td>\n                                    <td>5 GB</td>\n      