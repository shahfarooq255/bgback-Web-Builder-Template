    {
      "id": "sidebar-1",
      "name": "Minimal App Sidebar",
      "description": "A clean, left-aligned application sidebar with icons and a user profile at the bottom",
      "html": "\n                        <style>\n                          .sd1-layout{display:flex;min-height:500px;font-family:sans-serif;background:#f8fafc;}\n                          .sd1-wrap{width:260px;background:#fff;border-right:1px solid #e2e8f0;display:flex;flex-direction:column;padding:25px 20px;}\n                          .sd1-logo{font-size:24px;font-weight:900;color:#0f172a;margin-bottom:40px;display:flex;align-items:center;gap:10px;}\n                          .sd1-nav{display:flex;flex-direction:column;gap:5px;flex:1;}\n                          .sd1-link{display:flex;align-items:center;gap:12px;padding:12px 15px;color:#64748b;text-decoration:none;font-weight:600;font-size:15px;border-radius:10px;transition:all 0.3s;}\n                          .sd1-link:hover{background:#f1f5f9;color:#0f172a;}\n                          .sd1-link.active{background:#3b82f6;color:#fff;}\n                          .sd1-profile{display:flex;align-items:center;gap:12px;padding-top:20px;border-top:1px solid #e2e8f0;margin-top:20px;}\n                          .sd1-avatar{width:40px;height:40px;border-radius:50%;background:#cbd5e1;flex-shrink:0;}\n                          .sd1-info h4{margin:0;font-size:14px;color:#0f172a;font-weight:700;}\n                          .sd1-info p{margin:0;font-size:12px;color:#64748b;}\n                          .sd1-content{flex:1;padding:40px;}\n                          @media(max-width:768px){\n                            .sd1-layout{flex-direction:column;}\n                            .sd1-wrap{width:100%;border-right:none;border-bottom:1px solid #e2e8f0;padding:20px;}\n                            .sd1-nav{flex-direction:row;flex-wrap:wrap;gap:10px;}\n                            .sd1-profile{border-top:none;margin-top:0;padding-top:0;}\n                            .sd1-content{padding:20px;}\n                          }\n                        </style>\n                        <div class=\"sd1-layout\">\n                          <aside class=\"sd1-wrap\">\n                            <div class=\"sd1-logo\"><span>⚡</span> AppName</div>\n                            <nav class=\"sd1-nav\">\n                              <a href=\"#\" class=\"sd1-link active\"><span>📊</span> Dashboard</a>\n                              <a href=\"#\" class=\"sd1-link\"><span>📁</span> Projects</a>\n                              <a href=\"#\" class=\"sd1-link\"><span>👥</span> Team</a>\n                              <a href=\"#\" class=\"sd1-link\"><span>⚙️</span> Settings</a>\n                            </nav>\n                            <div class=\"sd1-profile\">\n                              <div class=\"sd1-avatar\"></div>\n                              <div class=\"sd1-info\">\n                                <h4>John Doe</h4>\n                                <p>Pro Plan</p>\n                              </div>\n                            </div>\n                          </aside>\n                          <div class=\"sd1-content\">\n                            <p style=\"color:#94a3b8;\">Main content area goes here...</p>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "sidebar-2",
      "name": "Dark Mode Dashboard",
      "description": "A sleek, dark-themed sidebar perfect for analytics or admin dashboards",
      "html": "\n                        <style>\n                          .sd2-layout{display:flex;min-height:500px;font-family:sans-serif;background:#0f172a;}\n                          .sd2-wrap{width:280px;background:#1e293b;display:flex;flex-direction:column;padding:30px 20px;color:#fff;}\n                          .sd2-brand{font-size:20px;font-weight:800;letter-spacing:1px;margin-bottom:40px;text-transform:uppercase;color:#38bdf8;}\n                          .sd2-section{margin-bottom:30px;}\n                          .sd2-title{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:15px;padding-left:10px;}\n                          .sd2-nav{display:flex;flex-direction:column;gap:5px;}\n                          .sd2-item{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;color:#cbd5e1;text-decoration:none;font-weight:500;font-size:15px;border-radius:8px;transition:all 0.3s;}\n                          .sd2-item:hover{background:#334155;color:#fff;}\n                          .sd2-item.active{background:#0ea5e9;color:#fff;}\n                          .sd2-badge{background:#ef4444;color:#fff;font-size:11px;font-weight:800;padding:2px 8px;border-radius:20px;}\n                          .sd2-content{flex:1;padding:40px;}\n                          @media(max-width:768px){\n                            .sd2-layout{flex-direction:column;}\n                            .sd2-wrap{width:100%;padding:20px;}\n                            .sd2-content{padding:20px;}\n                          }\n                        </style>\n                        <div class=\"sd2-layout\">\n                          <aside class=\"sd2-wrap\">\n                            <div class=\"sd2-brand\">AnalyticsPro</div>\n                            <div class=\"sd2-section\">\n                              <div class=\"sd2-title\">Menu</div>\n                              <nav class=\"sd2-nav\">\n                                <a href=\"#\" class=\"sd2-item active\"><span>Overview</span></a>\n                                <a href=\"#\" class=\"sd2-item\"><span>Traffic</span></a>\n                                <a href=\"#\" class=\"sd2-item\"><span>Reports</span> <span class=\"sd2-badge\">3</span></a>\n                              </nav>\n                            </div>\n                            <div class=\"sd2-section\">\n                              <div class=\"sd2-title\">Settings</div>\n                              <nav class=\"sd2-nav\">\n                                <a href=\"#\" class=\"sd2-item\"><span>Account</span></a>\n                                <a href=\"#\" class=\"sd2-item\"><span>Billing</span></a>\n                              </nav>\n                            </div>\n                          </aside>\n                          <div class=\"sd2-content\">\n                            <p style=\"color:#475569;\">Main content area goes here...</p>\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "sidebar-3",
      "name": "Blog / Content Sidebar",
      "description": "A traditional right-side widget style sidebar for blogs and news sites",
      "html": "\n                        <style>\n                          .sd3-layout{display:flex;min-height:500px;font-family:sans-serif;background:#fff;gap:40px;padding:40px 20px;max-width:1100px;margin:0 auto;}\n                          .sd3-content{flex:1;}\n                          .sd3-wrap{width:320px;display:flex;flex-direction:column;gap:35px;}\n                          .sd3-widget{background:#f8fafc;padding:30px;border-radius:16px;border:1px solid #e2e8f0;}\n                          .sd3-wtitle{font-size:18px;font-weight:800;color:#111;margin:0 0 20px;padding-bottom:10px;border-bottom:2px solid #cbd5e1;}\n                          .sd3-author{text-align:center;}\n                          .sd3-author img{width:80px;height:80px;border-radius:50%;margin-bottom:15px;background:#cbd5e1;}\n                          .sd3-author h4{margin:0 0 5px;font-size:16px;color:#111;}\n                          .sd3-author p{margin:0;font-size:14px;color:#64748b;line-height:1.5;}\n                          .sd3-list{list-style:none;padding:0;margin:0;}\n                          .sd3-list li{margin-bottom:12px;}\n                          .sd3-list a{color:#334155;text-decoration:none;font-size:15px;font-weight:500;transition:color 0.2s;}\n                          .sd3-list a:hover{color:#3b82f6;}\n                          @media(max-width:850px){\n                            .sd3-layout{flex-direction:column;}\n                            .sd3-wrap{width:100%;}\n                          }\n                        </style>\n                        <div class=\"sd3-layout\">\n                          <div class=\"sd3-content\">\n                            <div style=\"height:300px;background:#f1f5f9;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#94a3b8;\">Article Content Here</div>\n                          </div>\n                          <aside class=\"sd3-wrap\">\n                            <div class=\"sd3-widget sd3-author\">\n                              <img src=\"https://via.placeholder.com/80\" alt=\"Author\">\n                              <h4>Sarah Jenkins</h4>\n                              <p>Web Designer & Developer writing about the future of tech.</p>\n                            </div>\n                            <div class=\"sd3-widget\">\n                              <h3 class=\"sd3-wtitle\">Recent Posts</h3>\n                              <ul class=\"sd3-list\">\n                                <li><a href=\"#\">The Future of UI Design</a></li>\n                                <li><a href=\"#\">Mastering CSS Grid</a></li>\n                                <li><a href=\"#\">Why Typography Matters</a></li>\n                              </ul>\n                            </div>\n                          </aside>\n                        </div>\n                    "
    },
    {
      "id": "sidebar-4",
      "name": "E-commerce Filters",
      "description": "A product filtering sidebar with checkboxes and categories",
      "html": "\n                        <style>\n                          .sd4-layout{display:flex;min-height:500px;font-family:sans-serif;background:#fff;gap:30px;padding:40px 20px;}\n                          .sd4-wrap{width:250px;}\n                          .sd4-block{margin-bottom:30px;}\n                          .sd4-title{font-size:16px;font-weight:700;color:#111;margin:0 0 15px;}\n                          .sd4-check{display:flex;align-items:center;gap:10px;margin-bottom:12px;font-size:14px;color:#4b5563;cursor:pointer;}\n                          .sd4-check input{width:16px;height:16px;cursor:pointer;accent-color:#10b981;}\n                          .sd4-range{width:100%;accent-color:#10b981;margin-bottom:10px;}\n                          .sd4-vals{display:flex;justify-content:space-between;font-size:13px;color:#6b7280;font-weight:600;}\n                          .sd4-content{flex:1;background:#f8fafc;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#94a3b8;}\n                          @media(max-width:768px){\n                            .sd4-layout{flex-direction:column;}\n                            .sd4-wrap{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:20px;}\n                            .sd4-block{margin-bottom:0;}\n                          }\n                          @media(max-width:480px){\n                            .sd4-wrap{grid-template-columns:1fr;}\n                          }\n                        </style>\n                        <div class=\"sd4-layout\">\n                          <aside class=\"sd4-wrap\">\n                            <div class=\"sd4-block\">\n                              <h3 class=\"sd4-title\">Categories</h3>\n                              <label class=\"sd4-check\"><input type=\"checkbox\" checked> Laptops</label>\n                              <label class=\"sd4-check\"><input type=\"checkbox\"> Tablets</label>\n                              <label class=\"sd4-check\"><input type=\"checkbox\"> Accessories</label>\n                            </div>\n                            <div class=\"sd4-block\">\n                              <h3 class=\"sd4-title\">Price Range</h3>\n                              <input type=\"range\" class=\"sd4-range\" min=\"0\" max=\"1000\" value=\"500\">\n                              <div class=\"sd4-vals\"><span>$0</span><span>$1000+</span></div>\n                            </div>\n                            <div class=\"sd4-block\">\n                              <h3 class=\"sd4-title\">Brand</h3>\n                              <label class=\"sd4-check\"><input type=\"checkbox\"> Apple</label>\n                              <label class=\"sd4-check\"><input type=\"checkbox\"> Samsung</label>\n                              <label class=\"sd4-check\"><input type=\"checkbox\"> Dell</label>\n                            </div>\n                          </aside>\n                          <div class=\"sd4-content\">\n                            Products Grid\n                          </div>\n                        </div>\n                    "
    },
    {
      "id": "sidebar-5",
      "name": "Glassmorphism Floating",
      "description": "A stunning floating sidebar with glass effect and smooth hover animations",
      "html": "\n                        <style>\n                          .sd5-layout{display:flex;min-height:500px;font-family:sans-serif;background:url('https://images.unsplash.com/photo-1579546929518-9e396f3cc809?q=80&w=1000&auto=format&fit=crop') center/cover;padding:30px;}\n                          .sd5-wrap{width:80px;background:rgba(255,255,255,0.15);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);border-radius:24px;display:flex;flex-direction:column;align-items:center;padding:30px 0;gap:20px;transition:width 0.4s;overflow:hidden;box-shadow:0 15px 35px rgba(0,0,0,0.1);}\n                          .sd5-wrap:hover{width:220px;}\n                          .sd5-link{display:flex;align-items:center;width:100%;padding:12px 25px;color:#fff;text-decoration:none;font-weight:600;font-size:16px;white-space:nowrap;transition:background 0.3s;}\n                          .sd5-link:hover{background:rgba(255,255,255,0.2);}\n                          .sd5-icon{font-size:24px;min-width:30px;display:flex;justify-content:center;margin-right:20px;}\n                          .sd5-text{opacity:0;transition:opacity 0.4s;transform:translateX(-10px);}\n                          .sd5-wrap:hover .sd5-text{opacity:1;transform:translateX(0);}\n                          .sd5-content{flex:1;}\n                          @media(max-width:768px){\n                            .sd5-layout{flex-direction:column;padding:15px;}\n                            .sd5-wrap{width:100%;flex-direction:row;justify-content:space-around;padding:15px;border-radius:20px;margin-bottom:20px;background:rgba(255,255,255,0.85);backdrop-filter:none;}\n                            .sd5-wrap:hover{width:100%;}\n                            .sd5-link{padding:10px;justify-content:center;color:#111;width:auto;}\n                            .sd5-icon{margin-right:0;}\n                            .sd5-text{display:none;}\n                          }\n                        </style>\n                        <div class=\"sd5-layout\">\n                          <aside class=\"sd5-wrap\">\n                            <a href=\"#\" class=\"sd5-link\"><span class=\"sd5-icon\">🏠</span><span class=\"sd5-text\">Home</span></a>\n                            <a href=\"#\" class=\"sd5-link\"><span class=\"sd5-icon\">🔍</span><span class=\"sd5-text\">Search</span></a>\n                            <a href=\"#\" class=\"sd5-link\"><span class=\"sd5-icon\">❤️</span><span class=\"sd5-text\">Favorites</span></a>\n                            <a href=\"#\" class=\"sd5-link\"><span class=\"sd5-icon\">⚙️</span><span class=\"sd5-text\">Settings</span></a>\n                          </aside>\n                          <div class=\"sd5-content\"></div>\n                        </div>\n                    "
    }
  ]
