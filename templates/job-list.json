      "id": "jl-4",
      "name": "Colorful Cards Grid",
      "html": "\n<style>\n.jl4{padding:100px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.jl4-head{text-align:center;margin-bottom:60px}\n.jl4-head h2{font-size:40px;font-weight:800;color:#0f172a;margin:0 0 15px}\n.jl4-head p{color:#64748b;font-size:16px}\n.jl4-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}\n.jl4-card{background:#fff;border-radius:20px;padding:30px;box-shadow:0 4px 20px rgba(0,0,0,0.05);border-top:4px solid;transition:transform 0.3s}\n.jl4-card:hover{transform:translateY(-8px)}\n.jl4-c1{border-color:#6366f1}.jl4-c2{border-color:#10b981}.jl4-c3{border-color:#f59e0b}.jl4-c4{border-color:#ef4444}.jl4-c5{border-color:#3b82f6}.jl4-c6{border-color:#8b5cf6}\n.jl4-dept{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;padding:4px 10px;border-radius:50px;display:inline-block}\n.jl4-c1 .jl4-dept{background:#eef2ff;color:#6366f1}\n.jl4-c2 .jl4-dept{background:#d1fae5;color:#10b981}\n.jl4-c3 .jl4-dept{background:#fef3c7;color:#d97706}\n.jl4-c4 .jl4-dept{background:#fee2e2;color:#ef4444}\n.jl4-c5 .jl4-dept{background:#dbeafe;color:#3b82f6}\n.jl4-c6 .jl4-dept{background:#ede9fe;color:#8b5cf6}\n.jl4-title{font-size:20px;font-weight:700;color:#0f172a;margin:0 0 12px}\n.jl4-meta{display:flex;flex-direction:column;gap:8px;margin-bottom:25px}\n.jl4-meta-row{display:flex;align-items:center;gap:8px;font-size:14px;color:#64748b}\n.jl4-footer{display:flex;align-items:center;justify-content:space-between}\n.jl4-salary{font-size:18px;font-weight:800;color:#0f172a}\n.jl4-btn{padding:10px 20px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;border:none;color:#fff;transition:opacity 0.3s}\n.jl4-btn:hover{opacity:0.85}\n.jl4-c1 .jl4-btn{background:#6366f1}.jl4-c2 .jl4-btn{background:#10b981}\n.jl4-c3 .jl4-btn{background:#f59e0b}.jl4-c4 .jl4-btn{background:#ef4444}\n.jl4-c5 .jl4-btn{background:#3b82f6}.jl4-c6 .jl4-btn{background:#8b5cf6}\n</style>\n<section class=\"jl4\">\n  <div class=\"jl4-head\">\n    <h2>Explore Open Roles</h2>\n    <p>We're looking for passionate people to join our fast-growing team.</p>\n  </div>\n  <div class=\"jl4-grid\">\n    <div class=\"jl4-card jl4-c1\">\n      <span class=\"jl4-dept\">Engineering</span>\n      <h3 class=\"jl4-title\">Frontend Developer</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 Remote, Worldwide</div><div class=\"jl4-meta-row\">⏱ Full-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$120K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n    <div class=\"jl4-card jl4-c2\">\n      <span class=\"jl4-dept\">Design</span>\n      <h3 class=\"jl4-title\">UX Researcher</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 New York, NY</div><div class=\"jl4-meta-row\">⏱ Full-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$95K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n    <div class=\"jl4-card jl4-c3\">\n      <span class=\"jl4-dept\">Marketing</span>\n      <h3 class=\"jl4-title\">SEO Specialist</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 Remote, USA</div><div class=\"jl4-meta-row\">⏱ Part-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$65K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n    <div class=\"jl4-card jl4-c4\">\n      <span class=\"jl4-dept\">Operations</span>\n      <h3 class=\"jl4-title\">Project Manager</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 London, UK</div><div class=\"jl4-meta-row\">⏱ Full-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$85K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n    <div class=\"jl4-card jl4-c5\">\n      <span class=\"jl4-dept\">Data</span>\n      <h3 class=\"jl4-title\">Data Analyst</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 Remote, Global</div><div class=\"jl4-meta-row\">⏱ Full-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$105K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n    <div class=\"jl4-card jl4-c6\">\n      <span class=\"jl4-dept\">Sales</span>\n      <h3 class=\"jl4-title\">Account Executive</h3>\n      <div class=\"jl4-meta\"><div class=\"jl4-meta-row\">📍 San Francisco</div><div class=\"jl4-meta-row\">⏱ Full-Time</div></div>\n      <div class=\"jl4-footer\"><span class=\"jl4-salary\">$130K</span><button class=\"jl4-btn\">Apply Now</button></div>\n    </div>\n  </div>\n</section>"
    },
