      "id": "jl-5",
      "name": "Editorial Minimal Jobs",
      "html": "\n<style>\n.jl5{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.jl5-wrap{max-width:1000px;margin:0 auto}\n.jl5-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:50px;flex-wrap:wrap;gap:20px}\n.jl5-top h2{font-size:clamp(40px,5vw,64px);font-weight:900;color:#000;margin:0;letter-spacing:-2px;line-height:1}\n.jl5-top-right{text-align:right}\n.jl5-count{font-size:60px;font-weight:900;color:#000;line-height:1}\n.jl5-count-label{font-size:14px;color:#666;text-transform:uppercase;letter-spacing:1px}\n.jl5-list{}\n.jl5-item{display:flex;align-items:center;padding:28px 0;border-bottom:1px solid #000;gap:30px;cursor:pointer;transition:all 0.2s;position:relative}\n.jl5-item:last-child{border-bottom:none}\n.jl5-item:hover{padding-left:20px;padding-right:20px}\n.jl5-item:hover::before{content:'→';position:absolute;right:20px;font-size:24px;font-weight:900}\n.jl5-num{font-size:14px;color:#9ca3af;width:40px;flex-shrink:0;font-weight:600}\n.jl5-title{font-size:24px;font-weight:800;color:#000;flex:1;margin:0}\n.jl5-info{display:flex;gap:20px;align-items:center;flex-shrink:0}\n.jl5-loc{font-size:14px;color:#666;font-weight:500}\n.jl5-salary{font-size:14px;font-weight:700;color:#000;padding:6px 14px;border:2px solid #000;border-radius:50px}\n.jl5-type{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px}\n@media(max-width:768px){.jl5-item{flex-direction:column;align-items:flex-start;gap:10px}.jl5-info{flex-wrap:wrap}}\n</style>\n<section class=\"jl5\">\n  <div class=\"jl5-wrap\">\n    <div class=\"jl5-top\">\n      <h2>We're<br>Hiring</h2>\n      <div class=\"jl5-top-right\"><div class=\"jl5-count\">08</div><div class=\"jl5-count-label\">Open Positions</div></div>\n    </div>\n    <div class=\"jl5-list\">\n      <div class=\"jl5-item\"><div class=\"jl5-num\">01</div><h3 class=\"jl5-title\">Principal Engineer</h3><div class=\"jl5-info\"><span class=\"jl5-loc\">Remote</span><span class=\"jl5-type\">Full-Time</span><span class=\"jl5-salary\">$160K</span></div></div>\n      <div class=\"jl5-item\"><div class=\"jl5-num\">02</div><h3 class=\"jl5-title\">Product Manager</h3><div class=\"jl5-info\"><span class=\"jl5-loc\">New York</span><span class=\"jl5-type\">Full-Time</span><span class=\"jl5-salary\">$130K</span></div></div>\n      <div class=\"jl5-item\"><div class=\"jl5-num\">03</div><h3 class=\"jl5-title\">Design Systems Lead</h3><div class=\"jl5-info\"><span class=\"jl5-loc\">Remote</span><span class=\"jl5-type\">Full-Time</span><span class=\"jl5-salary\">$115K</span></div></div>\n      <div class=\"jl5-item\"><div class=\"jl5-num\">04</div><h3 class=\"jl5-title\">Content Strategist</h3><div class=\"jl5-info\"><span class=\"jl5-loc\">London</span><span class=\"jl5-type\">Contract</span><span class=\"jl5-salary\">$80K</span></div></div>\n    </div>\n  </div>\n</section>"
    },
