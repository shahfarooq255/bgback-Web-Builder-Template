      "id": "jl-6",
      "name": "Neo-Brutalism Job Board",
      "html": "\n<style>\n.jl6{padding:100px 20px;background:#d1fae5;font-family:'Inter',sans-serif}\n.jl6-wrap{max-width:950px;margin:0 auto}\n.jl6-head{margin-bottom:50px}\n.jl6-head h2{font-size:clamp(40px,6vw,72px);font-weight:900;color:#000;text-transform:uppercase;margin:0 0 10px;letter-spacing:-2px;border-bottom:5px solid #000;padding-bottom:20px}\n.jl6-head p{font-size:16px;color:#000;font-weight:600;margin:15px 0 0}\n.jl6-list{display:flex;flex-direction:column;gap:16px}\n.jl6-card{background:#fff;border:4px solid #000;box-shadow:6px 6px 0 #000;padding:25px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;transition:transform 0.2s,box-shadow 0.2s;flex-wrap:wrap}\n.jl6-card:hover{transform:translate(-4px,-4px);box-shadow:10px 10px 0 #000}\n.jl6-left h3{font-size:20px;font-weight:900;color:#000;margin:0 0 10px;text-transform:uppercase}\n.jl6-badges{display:flex;gap:8px;flex-wrap:wrap}\n.jl6-badge{padding:5px 12px;border:2px solid #000;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px}\n.jl6-b-remote{background:#bbf7d0;color:#000}\n.jl6-b-type{background:#fef9c3;color:#000}\n.jl6-b-salary{background:#e0e7ff;color:#000}\n.jl6-btn{padding:14px 28px;background:#000;color:#fff;border:4px solid #000;font-size:14px;font-weight:900;cursor:pointer;text-transform:uppercase;letter-spacing:1px;transition:all 0.2s;flex-shrink:0}\n.jl6-btn:hover{background:#16a34a;border-color:#16a34a}\n</style>\n<section class=\"jl6\">\n  <div class=\"jl6-wrap\">\n    <div class=\"jl6-head\">\n      <h2>Open Jobs</h2>\n      <p>Join us. Build boldly. No bureaucracy.</p>\n    </div>\n    <div class=\"jl6-list\">\n      <div class=\"jl6-card\">\n        <div class=\"jl6-left\"><h3>Full Stack Engineer</h3><div class=\"jl6-badges\"><span class=\"jl6-badge jl6-b-remote\">Remote</span><span class=\"jl6-badge jl6-b-type\">Full-Time</span><span class=\"jl6-badge jl6-b-salary\">$150K</span></div></div>\n        <button class=\"jl6-btn\">Apply Now</button>\n      </div>\n      <div class=\"jl6-card\">\n        <div class=\"jl6-left\"><h3>Brand Designer</h3><div class=\"jl6-badges\"><span class=\"jl6-badge jl6-b-remote\">On-Site</span><span class=\"jl6-badge jl6-b-type\">Full-Time</span><span class=\"jl6-badge jl6-b-salary\">$90K</span></div></div>\n        <button class=\"jl6-btn\">Apply Now</button>\n      </div>\n      <div class=\"jl6-card\">\n        <div class=\"jl6-left\"><h3>DevRel Engineer</h3><div class=\"jl6-badges\"><span class=\"jl6-badge jl6-b-remote\">Remote</span><span class=\"jl6-badge jl6-b-type\">Contract</span><span class=\"jl6-badge jl6-b-salary\">$120K</span></div></div>\n        <button class=\"jl6-btn\">Apply Now</button>\n      </div>\n      <div class=\"jl6-card\">\n        <div class=\"jl6-left\"><h3>Head of Sales</h3><div class=\"jl6-badges\"><span class=\"jl6-badge jl6-b-remote\">Hybrid</span><span class=\"jl6-badge jl6-b-type\">Full-Time</span><span class=\"jl6-badge jl6-b-salary\">$140K</span></div></div>\n        <button class=\"jl6-btn\">Apply Now</button>\n      </div>\n    </div>\n  </div>\n</section>"
    }
  ]
}
