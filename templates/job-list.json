      "id": "jl-2",
      "name": "Dark Job Board",
      "html": "\n<style>\n.jl2{padding:100px 20px;background:#09090b;font-family:'Inter',sans-serif;color:#fff}\n.jl2-top{max-width:900px;margin:0 auto 50px;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px}\n.jl2-top h2{font-size:clamp(32px,5vw,52px);font-weight:900;margin:0;letter-spacing:-1px}\n.jl2-top p{color:#71717a;font-size:14px;margin:0}\n.jl2-badge{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:#18181b;border:1px solid #27272a;border-radius:50px;color:#a1a1aa;font-size:13px;font-weight:600}\n.jl2-badge::before{content:'';width:8px;height:8px;border-radius:50%;background:#22c55e}\n.jl2-list{max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:12px}\n.jl2-card{background:#18181b;border:1px solid #27272a;border-radius:14px;padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;transition:all 0.3s;flex-wrap:wrap}\n.jl2-card:hover{border-color:#6366f1;background:#1e1b4b}\n.jl2-left{display:flex;align-items:center;gap:16px}\n.jl2-logo{width:48px;height:48px;border-radius:10px;background:#27272a;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}\n.jl2-title{font-size:17px;font-weight:700;color:#f8fafc;margin:0 0 8px}\n.jl2-tags{display:flex;gap:8px;flex-wrap:wrap}\n.jl2-tag{padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px}\n.jl2-tag-remote{background:rgba(99,102,241,0.15);color:#a5b4fc}\n.jl2-tag-type{background:rgba(34,197,94,0.15);color:#4ade80}\n.jl2-tag-salary{background:#27272a;color:#a1a1aa}\n.jl2-right{display:flex;align-items:center;gap:15px;flex-shrink:0}\n.jl2-date{font-size:12px;color:#52525b}\n.jl2-btn{padding:10px 22px;background:#6366f1;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:background 0.3s}\n.jl2-btn:hover{background:#4f46e5}\n</style>\n<section class=\"jl2\">\n  <div class=\"jl2-top\">\n    <div>\n      <div class=\"jl2-badge\">12 Open Positions</div>\n      <h2>Work With Us</h2>\n    </div>\n    <p>We're a remote-first team<br>building the future.</p>\n  </div>\n  <div class=\"jl2-list\">\n    <div class=\"jl2-card\">\n      <div class=\"jl2-left\">\n        <div class=\"jl2-logo\">⚛️</div>\n        <div>\n          <h3 class=\"jl2-title\">Senior React Developer</h3>\n          <div class=\"jl2-tags\"><span class=\"jl2-tag jl2-tag-remote\">Remote</span><span class=\"jl2-tag jl2-tag-type\">Full-Time</span><span class=\"jl2-tag jl2-tag-salary\">$140K</span></div>\n        </div>\n      </div>\n      <div class=\"jl2-right\"><span class=\"jl2-date\">2d ago</span><button class=\"jl2-btn\">Apply</button></div>\n    </div>\n    <div class=\"jl2-card\">\n      <div class=\"jl2-left\">\n        <div class=\"jl2-logo\">🎨</div>\n        <div>\n          <h3 class=\"jl2-title\">Lead UI/UX Designer</h3>\n          <div class=\"jl2-tags\"><span class=\"jl2-tag jl2-tag-remote\">Remote</span><span class=\"jl2-tag jl2-tag-type\">Full-Time</span><span class=\"jl2-tag jl2-tag-salary\">$110K</span></div>\n        </div>\n      </div>\n      <div class=\"jl2-right\"><span class=\"jl2-date\">5d ago</span><button class=\"jl2-btn\">Apply</button></div>\n    </div>\n    <div class=\"jl2-card\">\n      <div class=\"jl2-left\">\n        <div class=\"jl2-logo\">🤖</div>\n        <div>\n          <h3 class=\"jl2-title\">AI / ML Engineer</h3>\n          <div class=\"jl2-tags\"><span class=\"jl2-tag jl2-tag-remote\">Hybrid</span><span class=\"jl2-tag jl2-tag-type\">Full-Time</span><span class=\"jl2-tag jl2-tag-salary\">$180K</span></div>\n        </div>\n      </div>\n      <div class=\"jl2-right\"><span class=\"jl2-date\">1w ago</span><button class=\"jl2-btn\">Apply</button></div>\n    </div>\n    <div class=\"jl2-card\">\n      <div class=\"jl2-left\">\n        <div class=\"jl2-logo\">📈</div>\n        <div>\n          <h3 class=\"jl2-title\">Growth Marketing Lead</h3>\n          <div class=\"jl2-tags\"><span class=\"jl2-tag jl2-tag-remote\">Remote</span><span class=\"jl2-tag jl2-tag-type\">Part-Time</span><span class=\"jl2-tag jl2-tag-salary\">$80K</span></div>\n        </div>\n      </div>\n      <div class=\"jl2-right\"><span class=\"jl2-date\">3d ago</span><button class=\"jl2-btn\">Apply</button></div>\n    </div>\n  </div>\n</section>"
