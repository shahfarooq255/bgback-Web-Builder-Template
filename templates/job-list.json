      "name": "Department Grouped Jobs",
      "html": "\n<style>\n.jl3{padding:100px 20px;background:#fff;font-family:'Inter',sans-serif}\n.jl3-wrap{max-width:950px;margin:0 auto}\n.jl3-head{margin-bottom:60px}\n.jl3-head h2{font-size:42px;font-weight:800;color:#0f172a;margin:0 0 10px;letter-spacing:-1px}\n.jl3-head p{color:#64748b;font-size:16px;margin:0}\n.jl3-dept{margin-bottom:50px}\n.jl3-dept-title{font-size:13px;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:2px;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid #e2e8f0}\n.jl3-items{display:flex;flex-direction:column;gap:0}\n.jl3-item{display:flex;align-items:center;justify-content:space-between;padding:22px 0;border-bottom:1px solid #f1f5f9;gap:20px;transition:padding 0.3s}\n.jl3-item:last-child{border-bottom:none}\n.jl3-item:hover{padding-left:16px;background:#f8fafc;padding-right:16px;border-radius:10px}\n.jl3-job-title{font-size:17px;font-weight:700;color:#0f172a;margin:0 0 6px}\n.jl3-job-meta{display:flex;gap:15px;flex-wrap:wrap}\n.jl3-meta-item{font-size:13px;color:#64748b;display:flex;align-items:center;gap:5px}\n.jl3-right{display:flex;align-items:center;gap:15px;flex-shrink:0}\n.jl3-type-badge{padding:6px 14px;background:#f1f5f9;color:#475569;border-radius:50px;font-size:12px;font-weight:600}\n.jl3-apply{padding:10px 22px;background:#0f172a;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block;transition:background 0.3s}\n.jl3-apply:hover{background:#6366f1}\n</style>\n<section class=\"jl3\">\n  <div class=\"jl3-wrap\">\n    <div class=\"jl3-head\">\n      <h2>Join Our Team</h2>\n      <p>We're hiring across all departments. Find your perfect role.</p>\n    </div>\n    <div class=\"jl3-dept\">\n      <div class=\"jl3-dept-title\">Engineering</div>\n      <div class=\"jl3-items\">\n        <div class=\"jl3-item\">\n          <div><h3 class=\"jl3-job-title\">Backend Engineer (Node.js)</h3><div class=\"jl3-job-meta\"><span class=\"jl3-meta-item\">📍 Remote</span><span class=\"jl3-meta-item\">💰 $120-150K</span></div></div>\n          <div class=\"jl3-right\"><span class=\"jl3-type-badge\">Full-Time</span><a href=\"#\" class=\"jl3-apply\">Apply</a></div>\n        </div>\n        <div class=\"jl3-item\">\n          <div><h3 class=\"jl3-job-title\">Mobile Developer (Flutter)</h3><div class=\"jl3-job-meta\"><span class=\"jl3-meta-item\">📍 Hybrid</span><span class=\"jl3-meta-item\">💰 $100-130K</span></div></div>\n          <div class=\"jl3-right\"><span class=\"jl3-type-badge\">Full-Time</span><a href=\"#\" class=\"jl3-apply\">Apply</a></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"jl3-dept\">\n      <div class=\"jl3-dept-title\">Design</div>\n      <div class=\"jl3-items\">\n        <div class=\"jl3-item\">\n          <div><h3 class=\"jl3-job-title\">Senior Product Designer</h3><div class=\"jl3-job-meta\"><span class=\"jl3-meta-item\">📍 Remote</span><span class=\"jl3-meta-item\">💰 $95-125K</span></div></div>\n          <div class=\"jl3-right\"><span class=\"jl3-type-badge\">Full-Time</span><a href=\"#\" class=\"jl3-apply\">Apply</a></div>\n        </div>\n        <div class=\"jl3-item\">\n          <div><h3 class=\"jl3-job-title\">Motion Designer</h3><div class=\"jl3-job-meta\"><span class=\"jl3-meta-item\">📍 Remote</span><span class=\"jl3-meta-item\">💰 $75-95K</span></div></div>\n          <div class=\"jl3-right\"><span class=\"jl3-type-badge\">Contract</span><a href=\"#\" class=\"jl3-apply\">Apply</a></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"jl3-dept\">\n      <div class=\"jl3-dept-title\">Marketing</div>\n      <div class=\"jl3-items\">\n        <div class=\"jl3-item\">\n          <div><h3 class=\"jl3-job-title\">Head of Content</h3><div class=\"jl3-job-meta\"><span class=\"jl3-meta-item\">📍 Remote</span><span class=\"jl3-meta-item\">💰 $80-100K</span></div></div>\n          <div class=\"jl3-right\"><span class=\"jl3-type-badge\">Full-Time</span><a href=\"#\" class=\"jl3-apply\">Apply</a></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
