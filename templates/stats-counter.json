    {
      "id": "stats-10",
      "name": "Timeline Process Stats",
      "html": "\n<style>\n.sc10{padding:80px 20px;background:#f8fafc;font-family:'Inter',sans-serif}\n.sc10-wrap{max-width:1000px;margin:0 auto;position:relative}\n.sc10-wrap::before{content:'';position:absolute;top:40px;left:0;right:0;height:4px;background:#e2e8f0;z-index:1}\n.sc10-grid{display:flex;justify-content:space-between;position:relative;z-index:2;gap:20px}\n.sc10-item{flex:1;text-align:center}\n.sc10-dot{width:24px;height:24px;background:#3b82f6;border:4px solid #fff;border-radius:50%;margin:28px auto 20px;box-shadow:0 0 0 4px #e2e8f0;transition:all 0.3s}\n.sc10-item:hover .sc10-dot{box-shadow:0 0 0 4px #bfdbfe;background:#1d4ed8}\n.sc10-num{font-size:36px;font-weight:900;color:#0f172a;margin-bottom:8px}\n.sc10-lbl{font-size:14px;color:#64748b;font-weight:600;line-height:1.5}\n@media(max-width:768px){\n.sc10-wrap::before{top:0;bottom:0;left:40px;width:4px;height:auto;right:auto}\n.sc10-grid{flex-direction:column;gap:40px}\n.sc10-item{display:flex;text-align:left;align-items:center;gap:20px}\n.sc10-dot{margin:0 28px 0 28px}\n}\n</style>\n<section class=\"sc10\">\n  <div class=\"sc10-wrap\">\n    <div class=\"sc10-grid\">\n      <div class=\"sc10-item\">\n        <div class=\"sc10-dot\"></div>\n        <div class=\"sc10-content\">\n          <div class=\"sc10-num\">2018</div>\n          <div class=\"sc10-lbl\">Company Founded with 3 developers</div>\n        </div>\n      </div>\n      <div class=\"sc10-item\">\n        <div class=\"sc10-dot\"></div>\n        <div class=\"sc10-content\">\n          <div class=\"sc10-num\">10K+</div>\n          <div class=\"sc10-lbl\">First big milestone of active users</div>\n        </div>\n      </div>\n      <div class=\"sc10-item\">\n        <div class=\"sc10-dot\"></div>\n        <div class=\"sc10-content\">\n          <div class=\"sc10-num\">$5M</div>\n          <div class=\"sc10-lbl\">Series A funding secured in 2021</div>\n        </div>\n      </div>\n      <div class=\"sc10-item\">\n        <div class=\"sc10-dot\"></div>\n        <div class=\"sc10-content\">\n          <div class=\"sc10-num\">Global</div>\n          <div class=\"sc10-lbl\">Expanded offices to 5 countries</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
