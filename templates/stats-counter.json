    {
      "id": "stats-9",
      "name": "Circular Ring Stats",
      "html": "\n<style>\n.sc9{padding:100px 20px;background:#18181b;font-family:'Inter',sans-serif;color:#fff}\n.sc9-header{text-align:center;margin-bottom:60px}\n.sc9-header h2{font-size:36px;font-weight:800;margin:0 0 10px}\n.sc9-header p{color:#a1a1aa;font-size:16px;max-width:600px;margin:0 auto}\n.sc9-grid{max-width:1000px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;gap:50px}\n.sc9-item{display:flex;flex-direction:column;align-items:center;text-align:center}\n.sc9-circle{width:160px;height:160px;border-radius:50%;background:conic-gradient(#10b981 85%, #27272a 0);display:flex;align-items:center;justify-content:center;position:relative;margin-bottom:20px;box-shadow:0 10px 30px rgba(16,185,129,0.2)}\n.sc9-circle::before{content:'';position:absolute;inset:10px;background:#18181b;border-radius:50%}\n.sc9-num{position:relative;z-index:2;font-size:32px;font-weight:900;color:#fff}\n.sc9-lbl{font-size:15px;font-weight:600;color:#e4e4e7;text-transform:uppercase;letter-spacing:1px}\n</style>\n<section class=\"sc9\">\n  <div class=\"sc9-header\">\n    <h2>Performance Metrics</h2>\n    <p>We consistently push the boundaries of what is possible, delivering top-tier performance.</p>\n  </div>\n  <div class=\"sc9-grid\">\n    <div class=\"sc9-item\"><div class=\"sc9-circle\" style=\"background:conic-gradient(#10b981 85%, #27272a 0);\"><div class=\"sc9-num\">85%</div></div><div class=\"sc9-lbl\">Efficiency</div></div>\n    <div class=\"sc9-item\"><div class=\"sc9-circle\" style=\"background:conic-gradient(#3b82f6 92%, #27272a 0);\"><div class=\"sc9-num\">92%</div></div><div class=\"sc9-lbl\">Conversion</div></div>\n    <div class=\"sc9-item\"><div class=\"sc9-circle\" style=\"background:conic-gradient(#f43f5e 99%, #27272a 0);\"><div class=\"sc9-num\">99%</div></div><div class=\"sc9-lbl\">Uptime</div></div>\n    <div class=\"sc9-item\"><div class=\"sc9-circle\" style=\"background:conic-gradient(#eab308 75%, #27272a 0);\"><div class=\"sc9-num\">75%</div></div><div class=\"sc9-lbl\">Growth</div></div>\n  </div>\n</section>"
