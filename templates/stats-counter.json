      "id": "stats-1",
      "name": "Dark Gradient Stats",
      "html": "\n<style>\n.sc1{padding:80px 20px;background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);font-family:'Inter',sans-serif;text-align:center}\n.sc1 h2{color:#fff;font-size:clamp(28px,4vw,40px);font-weight:800;margin:0 0 15px;letter-spacing:-1px}\n.sc1 p{color:rgba(255,255,255,.65);font-size:16px;margin:0 0 60px}\n.sc1-grid{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:30px}\n.sc1-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:40px 20px;backdrop-filter:blur(10px)}\n.sc1-num{font-size:52px;font-weight:900;background:linear-gradient(135deg,#a78bfa,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1}\n.sc1-label{color:rgba(255,255,255,.7);font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-top:12px}\n</style>\n<section class=\"sc1\">\n  <h2>Numbers That Speak</h2>\n  <p>Our milestones at a glance</p>\n  <div class=\"sc1-grid\">\n    <div class=\"sc1-card\"><div class=\"sc1-num\">12K+</div><div class=\"sc1-label\">Happy Clients</div></div>\n    <div class=\"sc1-card\"><div class=\"sc1-num\">98%</div><div class=\"sc1-label\">Satisfaction Rate</div></div>\n    <div class=\"sc1-card\"><div class=\"sc1-num\">500+</div><div class=\"sc1-label\">Projects Done</div></div>\n    <div class=\"sc1-card\"><div class=\"sc1-num\">15+</div><div class=\"sc1-label\">Years Experience</div></div>\n  </div>\n</section>"
    },
    {
      "id": "stats-2",
      "name": "Light Clean Stats Grid",
      "html": "\n<style>\n.sc2{padding:80px 20px;background:#fff;font-family:'Inter',sans-serif}\n.sc2-wrap{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n.sc2-left h2{font-size:clamp(32px,4vw,48px);font-weight:800;color:#111;margin:0 0 20px;line-height:1.1}\n.sc2-left p{color:#666;font-size:16px;line-height:1.8;margin:0 0 30px}\n.sc2-btn{display:inline-block;padding:14px 30px;background:#111;color:#fff;border-radius:50px;font-weight:700;text-decoration:none;font-size:14px;transition:transform .3s}\n.sc2-btn:hover{transform:scale(1.05)}\n.sc2-right{display:grid;grid-template-columns:1fr 1fr;gap:25px}\n.sc2-item{border-left:4px solid;padding-left:20px}\n.sc2-item:nth-child(1){border-color:#6366f1}.sc2-item:nth-child(2){border-color:#f43f5e}\n.sc2-item:nth-child(3){border-color:#10b981}.sc2-item:nth-child(4){border-color:#f59e0b}\n.sc2-num{font-size:42px;font-weight:900;color:#111;line-height:1}\n.sc2-lbl{font-size:13px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:1px;margin-top:6px}\n@media(max-width:768px){.sc2-wrap{grid-template-columns:1fr}}\n</style>\n<section class=\"sc2\">\n  <div class=\"sc2-wrap\">\n    <div class=\"sc2-left\">\n      <h2>Trusted by Thousands Worldwide</h2>\n      <p>We've helped businesses from all industries grow, scale, and succeed with our cutting-edge solutions.</p>\n      <a href=\"#\" class=\"sc2-btn\">Our Story →</a>\n    </div>\n    <div class=\"sc2-right\">\n      <div class=\"sc2-item\"><div class=\"sc2-num\">20K+</div><div class=\"sc2-lbl\">Active Users</div></div>\n      <div class=\"sc2-item\"><div class=\"sc2-num\">99.9%</div><div class=\"sc2-lbl\">Uptime SLA</div></div>\n      <div class=\"sc2-item\"><div class=\"sc2-num\">350+</div><div class=\"sc2-lbl\">Team Members</div></div>\n      <div class=\"sc2-item\"><div class=\"sc2-num\">80+</div><div class=\"sc2-lbl\">Countries</div></div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "stats-3",
      "name": "Neon Horizontal Stats Bar",
      "html": "\n<style>\n.sc3{padding:60px 20px;background:#09090b;font-family:'Inter',sans-serif}\n.sc3-bar{max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-around;gap:30px;border:1px solid #27272a;border-radius:20px;padding:50px 30px}\n.sc3-stat{text-align:center;flex:1;min-width:150px}\n.sc3-num{font-size:48px;font-weight:900;color:#fff;line-height:1}\n.sc3-accent{color:#00ffcc}\n.sc3-lbl{font-size:13px;color:#71717a;text-transform:uppercase;letter-spacing:2px;margin-top:10px;font-weight:600}\n.sc3-divider{width:1px;background:#27272a;align-self:stretch}\n@media(max-width:600px){.sc3-divider{display:none}}\n</style>\n<section class=\"sc3\">\n  <div class=\"sc3-bar\">\n    <div class=\"sc3-stat\"><div class=\"sc3-num\">5<span class=\"sc3-accent\">M+</span></div><div class=\"sc3-lbl\">Lines of Code</div></div>\n    <div class=\"sc3-divider\"></div>\n    <div class=\"sc3-stat\"><div class=\"sc3-num\">2<span class=\"sc3-accent\">K+</span></div><div class=\"sc3-lbl\">Projects Shipped</div></div>\n    <div class=\"sc3-divider\"></div>\n    <div class=\"sc3-stat\"><div class=\"sc3-num\">48<span class=\"sc3-accent\">H</span></div><div class=\"sc3-lbl\">Avg Turnaround</div></div>\n    <div class=\"sc3-divider\"></div>\n    <div class=\"sc3-stat\"><div class=\"sc3-num\">4.9<span class=\"sc3-accent\">★</span></div><div class=\"sc3-lbl\">Average Rating</div></div>\n  </div>\n</section>"
    }
  ]
