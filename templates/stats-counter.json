      "name": "Playful Colored Stats",
      "html": "\n<style>\n.sc8{padding:80px 20px;background:#fff;font-family:'Inter',sans-serif}\n.sc8-title{text-align:center;font-size:36px;font-weight:800;color:#111;margin:0 0 50px}\n.sc8-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:25px}\n.sc8-card{padding:50px 30px;border-radius:24px;text-align:center;color:#111;transition:transform 0.3s}\n.sc8-card:hover{transform:translateY(-10px)}\n.sc8-bg1{background:#fef08a}.sc8-bg2{background:#a7f3d0}.sc8-bg3{background:#bfdbfe}.sc8-bg4{background:#fbcfe8}\n.sc8-num{font-size:48px;font-weight:900;margin-bottom:10px}\n.sc8-lbl{font-size:15px;font-weight:600;opacity:0.8;text-transform:uppercase}\n</style>\n<section class=\"sc8\">\n  <h2 class=\"sc8-title\">By the Numbers</h2>\n  <div class=\"sc8-grid\">\n    <div class=\"sc8-card sc8-bg1\"><div class=\"sc8-num\">850+</div><div class=\"sc8-lbl\">Stores Opened</div></div>\n    <div class=\"sc8-card sc8-bg2\"><div class=\"sc8-num\">40M</div><div class=\"sc8-lbl\">Total Revenue</div></div>\n    <div class=\"sc8-card sc8-bg3\"><div class=\"sc8-num\">100%</div><div class=\"sc8-lbl\">Secure</div></div>\n    <div class=\"sc8-card sc8-bg4\"><div class=\"sc8-num\">24H</div><div class=\"sc8-lbl\">Support Available</div></div>\n  </div>\n</section>"
