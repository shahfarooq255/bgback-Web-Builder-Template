      "name": "Neo-Brutalism Stats",
      "html": "\n<style>\n.sc4{padding:80px 20px;background:#fefce8;font-family:'Inter',sans-serif}\n.sc4-grid{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:30px}\n.sc4-card{background:#fff;border:4px solid #000;box-shadow:8px 8px 0 #000;padding:40px 30px;text-align:center;transition:transform 0.2s,box-shadow 0.2s}\n.sc4-card:hover{transform:translate(4px,4px);box-shadow:4px 4px 0 #000}\n.sc4-num{font-size:56px;font-weight:900;color:#000;line-height:1;margin-bottom:10px}\n.sc4-label{font-size:16px;font-weight:700;color:#000;text-transform:uppercase;letter-spacing:1px}\n.sc4-accent{color:#f59e0b}\n</style>\n<section class=\"sc4\">\n  <div class=\"sc4-grid\">\n    <div class=\"sc4-card\"><div class=\"sc4-num\">$10<span class=\"sc4-accent\">M</span></div><div class=\"sc4-label\">Revenue</div></div>\n    <div class=\"sc4-card\"><div class=\"sc4-num\">2.5<span class=\"sc4-accent\">M</span></div><div class=\"sc4-label\">Downloads</div></div>\n    <div class=\"sc4-card\"><div class=\"sc4-num\">50<span class=\"sc4-accent\">+</span></div><div class=\"sc4-label\">Awards</div></div>\n  </div>\n</section>"
