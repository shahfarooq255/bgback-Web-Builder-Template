      "html": "\n<style>\n.sc6{padding:100px 20px;background:url('https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;position:relative;font-family:'Inter',sans-serif;color:#fff}\n.sc6::before{content:'';position:absolute;inset:0;background:rgba(0,0,0,0.7)}\n.sc6-container{position:relative;max-width:1200px;margin:0 auto;z-index:1;text-align:center}\n.sc6-title{font-size:36px;font-weight:800;margin:0 0 50px}\n.sc6-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px}\n.sc6-card{display:flex;flex-direction:column;align-items:center}\n.sc6-icon{width:60px;height:60px;background:rgba(255,255,255,0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;font-size:24px;color:#10b981}\n.sc6-num{font-size:50px;font-weight:900;line-height:1;margin-bottom:10px}\n.sc6-lbl{font-size:16px;color:#a1a1aa;text-transform:uppercase;letter-spacing:1px}\n</style>\n<section class=\"sc6\">\n  <div class=\"sc6-container\">\n    <h2 class=\"sc6-title\">Our Impact in Numbers</h2>\n    <div class=\"sc6-grid\">\n      <div class=\"sc6-card\"><div class=\"sc6-icon\">👥</div><div class=\"sc6-num\">1.2M</div><div class=\"sc6-lbl\">Subscribers</div></div>\n      <div class=\"sc6-card\"><div class=\"sc6-icon\">🌍</div><div class=\"sc6-num\">140</div><div class=\"sc6-lbl\">Countries</div></div>\n      <div class=\"sc6-card\"><div class=\"sc6-icon\">💼</div><div class=\"sc6-num\">3,500</div><div class=\"sc6-lbl\">Partners</div></div>\n      <div class=\"sc6-card\"><div class=\"sc6-icon\">⚡</div><div class=\"sc6-num\">99.9%</div><div class=\"sc6-lbl\">Uptime</div></div>\n    </div>\n  </div>\n</section>"
