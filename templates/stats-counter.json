      "id": "stats-11",
      "name": "Bento Box Stats",
      "html": "\n<style>\n.sc11{padding:80px 20px;background:#000;font-family:'Inter',sans-serif}\n.sc11-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(180px,auto);gap:20px}\n.sc11-card{background:#111;border-radius:24px;padding:30px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;border:1px solid #222}\n.sc11-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at top right, rgba(255,255,255,0.05), transparent);pointer-events:none}\n.sc11-large{grid-column:span 2;grid-row:span 2;background:linear-gradient(135deg,#2563eb,#4f46e5);border:none}\n.sc11-wide{grid-column:span 2}\n.sc11-num{font-size:42px;font-weight:900;color:#fff;line-height:1;margin-bottom:12px}\n.sc11-large .sc11-num{font-size:72px}\n.sc11-lbl{font-size:15px;color:#a1a1aa;font-weight:500;line-height:1.5}\n.sc11-large .sc11-lbl{color:rgba(255,255,255,0.8);font-size:18px}\n@media(max-width:991px){.sc11-grid{grid-template-columns:1fr 1fr}}\n@media(max-width:600px){.sc11-grid{grid-template-columns:1fr};.sc11-large,.sc11-wide{grid-column:span 1;grid-row:span 1}}\n</style>\n<section class=\"sc11\">\n  <div class=\"sc11-grid\">\n    <div class=\"sc11-card sc11-large\">\n      <div class=\"sc11-num\">2.5B+</div>\n      <div class=\"sc11-lbl\">API requests handled every single month with zero downtime and ultra-low latency.</div>\n    </div>\n    <div class=\"sc11-card\">\n      <div class=\"sc11-num\">99.99%</div>\n      <div class=\"sc11-lbl\">Uptime SLA</div>\n    </div>\n    <div class=\"sc11-card\">\n      <div class=\"sc11-num\">0.5ms</div>\n      <div class=\"sc11-lbl\">Avg Latency</div>\n    </div>\n    <div class=\"sc11-card sc11-wide\">\n      <div class=\"sc11-num\">150+</div>\n      <div class=\"sc11-lbl\">Global edge locations ensuring fast delivery.</div>\n    </div>\n  </div>\n</section>"
