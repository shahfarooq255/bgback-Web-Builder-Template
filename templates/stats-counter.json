      "id": "stats-12",
      "name": "Floating 3D Cards",
      "html": "\n<style>\n.sc12{padding:120px 20px;background:#eef2ff;font-family:'Inter',sans-serif;perspective:1000px}\n.sc12-wrap{max-width:1000px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;gap:40px}\n.sc12-card{width:260px;background:#fff;padding:40px 30px;border-radius:20px;text-align:center;box-shadow:0 30px 60px rgba(0,0,0,0.08);transform:rotateY(15deg) rotateX(10deg);transition:transform 0.4s ease,box-shadow 0.4s ease;border:1px solid #fff}\n.sc12-card:hover{transform:rotateY(0) rotateX(0) translateY(-10px);box-shadow:0 40px 80px rgba(0,0,0,0.12)}\n.sc12-icon{width:50px;height:50px;background:#e0e7ff;color:#4f46e5;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 20px}\n.sc12-num{font-size:42px;font-weight:900;color:#1e1b4b;margin-bottom:8px;line-height:1}\n.sc12-lbl{font-size:14px;font-weight:600;color:#6366f1;text-transform:uppercase;letter-spacing:1px}\n</style>\n<section class=\"sc12\">\n  <div class=\"sc12-wrap\">\n    <div class=\"sc12-card\">\n      <div class=\"sc12-icon\">🚀</div>\n      <div class=\"sc12-num\">10x</div>\n      <div class=\"sc12-lbl\">Faster Growth</div>\n    </div>\n    <div class=\"sc12-card\">\n      <div class=\"sc12-icon\">💼</div>\n      <div class=\"sc12-num\">4.5k</div>\n      <div class=\"sc12-lbl\">B2B Clients</div>\n    </div>\n    <div class=\"sc12-card\">\n      <div class=\"sc12-icon\">⭐</div>\n      <div class=\"sc12-num\">#1</div>\n      <div class=\"sc12-lbl\">Market Leader</div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "stats-13",
      "name": "Editorial Typography Stats",
      "html": "\n<style>\n.sc13{padding:100px 20px;background:#fff;font-family:'Playfair Display',serif}\n.sc13-wrap{max-width:1200px;margin:0 auto}\n.sc13-header{font-size:clamp(40px,5vw,70px);color:#000;font-weight:400;margin:0 0 60px;line-height:1.1;border-bottom:2px solid #000;padding-bottom:30px}\n.sc13-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:60px}\n.sc13-item{border-right:1px solid #eaeaea;padding-right:40px}\n.sc13-item:last-child{border-right:none;padding-right:0}\n.sc13-num{font-size:80px;font-weight:400;color:#000;line-height:1;margin-bottom:20px;font-style:italic}\n.sc13-lbl{font-family:'Inter',sans-serif;font-size:14px;color:#555;line-height:1.6;text-transform:uppercase;letter-spacing:1px}\n@media(max-width:768px){.sc13-item{border-right:none;border-bottom:1px solid #eaeaea;padding-right:0;padding-bottom:40px}.sc13-item:last-child{border-bottom:none}}\n</style>\n<section class=\"sc13\">\n  <div class=\"sc13-wrap\">\n    <h2 class=\"sc13-header\">Redefining excellence<br>through numbers.</h2>\n    <div class=\"sc13-grid\">\n      <div class=\"sc13-item\">\n        <div class=\"sc13-num\">18<span style=\"font-size:40px\">yrs</span></div>\n        <div class=\"sc13-lbl\">Of unparalleled craftsmanship and design perfection</div>\n      </div>\n      <div class=\"sc13-item\">\n        <div class=\"sc13-num\">250<span style=\"font-size:40px\">+</span></div>\n        <div class=\"sc13-lbl\">Awards globally recognized for creativity and innovation</div>\n      </div>\n      <div class=\"sc13-item\">\n        <div class=\"sc13-num\">$4<span style=\"font-size:40px\">B</span></div>\n        <div class=\"sc13-lbl\">Total valuation of projects successfully delivered</div>\n      </div>\n    </div>\n  </div>\n</section>"
